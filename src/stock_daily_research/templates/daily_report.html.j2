      function applyPositionToCard(card) {
        var rec = positionStateFor(card);
        var last = numberOrNull(card.dataset.lastClose);
        var prev = numberOrNull(card.dataset.previousClose);
        var shares = numberOrNull(rec.shares);
        var avg = numberOrNull(rec.avg_cost);
        var weight = numberOrNull(rec.portfolio_weight);
        var size = numberOrNull(rec.position_size);
        var stop = numberOrNull(rec.stop_loss);
        if (size == null && shares != null && last != null) size = shares * last;

        var plPct = null;
        var plDollar = null;
        if (avg != null && avg > 0 && last != null) {
          plPct = (last - avg) / avg * 100;
          if (shares != null) plDollar = (last - avg) * shares;
        }
        var impact = null;
        if (weight != null && prev != null && prev !== 0 && last != null) {
          impact = weight * ((last - prev) / prev);
        }

        card.dataset.positionStatus = rec.status || "watchlist";
        card.dataset.positionShares = shares == null ? "" : String(shares);
        card.dataset.positionAvgCost = avg == null ? "" : String(avg);
        card.dataset.positionWeight = weight == null ? "" : String(weight);
        card.dataset.positionSize = size == null ? "" : String(size);
        card.dataset.positionStopLoss = stop == null ? "" : String(stop);
        card.dataset.plPct = plPct == null ? "" : String(plPct);
        card.dataset.bookImpact = impact == null ? "" : String(impact);

        var statusEl = card.querySelector("[data-position-live-status]");
        var weightEl = card.querySelector("[data-position-live-weight]");
        var plEl = card.querySelector("[data-position-live-pl]");
        var impactEl = card.querySelector("[data-position-live-impact]");
        if (statusEl) statusEl.textContent = positionStatusLabel(rec.status || "watchlist");
        if (weightEl) weightEl.textContent = weight == null ? "N/A" : formattedPct(weight).replace(/^\+/, "");
        if (plEl) {
          plEl.textContent = plPct == null ? "N/A" : formattedPct(plPct) + (plDollar == null ? "" : " (" + formattedDollar(plDollar) + ")");
          plEl.classList.remove("change-pos", "change-neg", "change-flat");
          plEl.classList.add("change-" + signClass(plPct));
        }
        if (impactEl) {
          impactEl.textContent = impact == null ? "N/A" : formattedPct(impact);
          impactEl.classList.remove("change-pos", "change-neg", "change-flat");
          impactEl.classList.add("change-" + signClass(impact));
        }
      }

      function symbol(card) { return card.dataset.symbol || ""; }
      function isPinned(card) { return pinned.indexOf(symbol(card)) >= 0; }
      function checklistValues(card) {
        var values = checklist[symbol(card)];
        return Array.isArray(values) ? values : [];
      }
      function reviewState(card) {

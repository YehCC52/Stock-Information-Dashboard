        entryDate: document.getElementById("trade-entry-date"),
        currentStop: document.getElementById("trade-current-stop"),
        entryPrice: document.getElementById("trade-entry-price"),
        shares: document.getElementById("trade-shares"),
        stop: document.getElementById("trade-stop"),
        fxRate: document.getElementById("trade-fx-rate"),
        exitDate: document.getElementById("trade-exit-date"),
        exitPrice: document.getElementById("trade-exit-price"),
        fees: document.getElementById("trade-fees"),
        setup: document.getElementById("trade-setup"),
        note: document.getElementById("trade-note")
      };
      var fillRows = document.getElementById("trade-fill-rows");
      var addFillBtn = document.getElementById("trade-add-fill");
      var clearBtn = document.getElementById("trade-form-clear");
      var formTitle = document.getElementById("trade-form-title");
      var reportDate = "{{ report.report_date.isoformat() }}";
      var activeMarket = "us";
      try { activeMarket = localStorage.getItem("stock-daily-market-tab") || "us"; } catch (e) {}

      function marketGroup(value) {
        if (value === "twse" || value === "tpex" || value === "taiwan") return "taiwan";
        return value || "us";
      }
      function number(value) {
        var parsed = parseFloat(value);
        return isNaN(parsed) ? null : parsed;
      }
      function escapeHtml(value) {
        return String(value == null ? "" : value).replace(/[&<>"']/g, function (char) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char];
        });
      }
      function money(value) {
        return value == null || isNaN(value) ? "N/A" : Number(value).toLocaleString(undefined, { maximumFractionDigits: 2 });
      }
      function signed(value, suffix) {
        if (value == null || isNaN(value)) return "N/A";
        return (value >= 0 ? "+" : "") + Number(value).toFixed(2) + (suffix || "");
      }
      function cardFor(symbol) {
        return document.querySelector('.ticker-card[data-symbol="' + CSS.escape(symbol) + '"]');
      }
      function normalizeFills(trade) {
        var raw = Array.isArray(trade.fills) ? trade.fills : [];
        var valid = raw.filter(function (fill) {
          return fill && (fill.side === "buy" || fill.side === "sell") &&
            number(fill.price) > 0 && number(fill.shares) > 0;
        }).map(function (fill, index) {
          return {
            fill_id: fill.fill_id || ((trade.trade_id || "trade") + "-fill-" + index),
            side: fill.side,
            fill_date: fill.fill_date || "",
            price: number(fill.price),
            shares: number(fill.shares),
            fees: number(fill.fees) || 0,
            note: fill.note || ""
          };
        });
        if (valid.length || trade.status === "planned") return valid;
        var legacy = [];
        if (number(trade.entry_price) > 0 && number(trade.shares) > 0) {
          legacy.push({
            fill_id: (trade.trade_id || "trade") + "-entry",
            side: "buy",
            fill_date: trade.entry_date || "",
            price: number(trade.entry_price),
            shares: number(trade.shares),
            fees: 0,
            note: ""
          });
        }
        if (number(trade.exit_price) > 0 && number(trade.shares) > 0) {
          legacy.push({
            fill_id: (trade.trade_id || "trade") + "-exit",
            side: "sell",
            fill_date: trade.exit_date || "",
            price: number(trade.exit_price),
            shares: number(trade.shares),
            fees: 0,
            note: ""
          });
        }
        return legacy;
      }
      function fillAverage(fills) {
        var quantity = fills.reduce(function (sum, fill) { return sum + number(fill.shares); }, 0);
        if (!quantity) return null;
        return fills.reduce(function (sum, fill) {
          return sum + number(fill.price) * number(fill.shares);
        }, 0) / quantity;
      }
      function addFillRow(fill) {
        if (!fillRows) return;
        fill = fill || {};
        var row = document.createElement("div");
        row.className = "trade-fill-row";
        row.dataset.fillId = fill.fill_id || ("fill-" + Date.now().toString(36) + "-" + fillRows.children.length);
        row.innerHTML =
          '<select data-fill-side aria-label="\u6210\u4ea4\u65b9\u5411"><option value="buy">\u8cb7\u9032</option><option value="sell">\u8ce3\u51fa</option></select>' +
          '<input data-fill-date type="date" required aria-label="\u6210\u4ea4\u65e5\u671f">' +
          '<input data-fill-price type="number" min="0" step="any" inputmode="decimal" required placeholder="\u50f9\u683c" aria-label="\u6210\u4ea4\u50f9">' +
          '<input data-fill-shares type="number" min="0" step="any" inputmode="decimal" required placeholder="\u6578\u91cf" aria-label="\u6210\u4ea4\u6578\u91cf">' +
          '<input data-fill-fees type="number" min="0" step="any" inputmode="decimal" value="0" placeholder="\u8cbb\u7528" aria-label="\u6210\u4ea4\u8cbb\u7528">' +
          '<button type="button" class="icon-button" data-fill-remove title="\u79fb\u9664\u9019\u7b46\u6210\u4ea4" aria-label="\u79fb\u9664\u9019\u7b46\u6210\u4ea4">&times;</button>';
        row.querySelector("[data-fill-side]").value = fill.side === "sell" ? "sell" : "buy";
        row.querySelector("[data-fill-date]").value = fill.fill_date || reportDate;
        row.querySelector("[data-fill-price]").value = fill.price == null ? "" : fill.price;
        row.querySelector("[data-fill-shares]").value = fill.shares == null ? "" : fill.shares;
        row.querySelector("[data-fill-fees]").value = fill.fees == null ? 0 : fill.fees;
        fillRows.appendChild(row);
      }
      function readFillRows() {
        if (!fillRows) return [];
        return Array.prototype.map.call(fillRows.querySelectorAll(".trade-fill-row"), function (row) {
          return {
            fill_id: row.dataset.fillId,
            side: row.querySelector("[data-fill-side]").value,
            fill_date: row.querySelector("[data-fill-date]").value,
            price: number(row.querySelector("[data-fill-price]").value),
            shares: number(row.querySelector("[data-fill-shares]").value),
            fees: number(row.querySelector("[data-fill-fees]").value) || 0,
            note: ""
          };
        }).filter(function (fill) {
          return fill.fill_date && fill.price != null && fill.price > 0 &&
            fill.shares != null && fill.shares > 0;
        });
      }
      function markLocalDraft() {
        var status = document.getElementById("save-status");
        if (!status) return;
        status.textContent = "\u672c\u6a5f\u8349\u7a3f\uff0c\u5c1a\u672a\u540c\u6b65";
        status.className = "save-status is-local";
      }
      function metrics(trade) {
        var fills = normalizeFills(trade);
        var buys = fills.filter(function (fill) { return fill.side === "buy"; });
        var sells = fills.filter(function (fill) { return fill.side === "sell"; });
        var entry = fillAverage(buys);
        var bought = buys.reduce(function (sum, fill) { return sum + number(fill.shares); }, 0);
        var rawSold = sells.reduce(function (sum, fill) { return sum + number(fill.shares); }, 0);
        var sold = Math.min(bought, rawSold);
        var remaining = Math.max(0, bought - sold);
        var exit = fillAverage(sells);
        var planned = trade.status === "planned";
        if (planned) {
          entry = number(trade.entry_price);
          bought = number(trade.shares) || 0;
          remaining = 0;
        }
        var stop = number(trade.initial_stop);
        var currentStop = number(trade.current_stop);
        if (currentStop == null) currentStop = stop;
        var risk = number(trade.initial_risk);
        if (risk == null && entry != null && stop != null && bought > 0 && entry > stop) {
          if (buys.length) {
            risk = buys.reduce(function (sum, fill) {
              return sum + Math.max(0, number(fill.price) - stop) * number(fill.shares);
            }, 0);
          } else {
            risk = (entry - stop) * bought;
          }
        }
        var card = cardFor(trade.ticker);
        var mark = number(card && card.dataset.lastClose);
        var closed = !planned && (trade.status === "closed" || (bought > 0 && remaining <= bought * 1e-8));
        if (closed && exit != null) mark = exit;
        var realized = entry != null && exit != null ? (exit - entry) * sold : 0;
        var unrealized = entry != null && mark != null ? (mark - entry) * remaining : 0;
        var hasValue = !planned && entry != null && (sold > 0 || (remaining > 0 && mark != null));
        var fees = (number(trade.fees) || 0) + fills.reduce(function (sum, fill) {
          return sum + (number(fill.fees) || 0);
        }, 0);
        var net = hasValue ? realized + unrealized - fees : null;
        var currentRisk = !planned && mark != null && currentStop != null && remaining > 0
          ? Math.max(0, mark - currentStop) * remaining
          : planned ? 0 : null;
        var dates = buys.map(function (fill) { return fill.fill_date; }).filter(Boolean).sort();
        return {
          planned: planned,
          closed: closed,
          entry: entry,
          exit: exit,
          entryDate: dates[0] || trade.entry_date || "",
          bought: bought,
          sold: sold,
          remaining: remaining,
          fillCount: fills.length,
          currentStop: currentStop,
          currentRisk: currentRisk,
          risk: risk,
          net: net,
          netBase: net == null ? null : net * (number(trade.fx_rate_to_base) || 1),
          r: risk && net != null ? net / risk : null
        };
      }
      function persist() {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(trades)); } catch (e) {}
        window.__tradeJournal = trades;
        markLocalDraft();
      }
      function render() {
        var visibleTrades = trades.filter(function (trade) { return trade && trade.status !== "cancelled"; });
        if (!visibleTrades.length) {
          body.innerHTML = '<tr class="journal-empty-row"><td colspan="9" class="journal-empty">\u5c1a\u7121\u4ea4\u6613\u8a18\u9304</td></tr>';
        } else {
          body.innerHTML = visibleTrades.map(function (trade) {
            var result = metrics(trade);
            var market = marketGroup(trade.market);
            var hidden = market !== activeMarket ? " is-market-hidden" : "";
            var statusLabel = result.planned ? "\u898f\u5283\u4e2d" : result.closed ? "\u5df2\u5b8c\u6210" : "\u9032\u884c\u4e2d";
            var statusClass = result.planned ? "planned" : result.closed ? "closed" : "open";
            var plClass = result.net == null ? "" : result.net >= 0 ? " change-pos" : " change-neg";
            var note = trade.setup || trade.note || "";
            var quantity = result.planned ? number(trade.shares) : result.remaining;
            var fillMeta = result.fillCount
              ? '<div class="muted">' + result.fillCount + ' \u7b46\u6210\u4ea4</div>'
              : result.planned ? '<div class="muted">\u5c1a\u672a\u6210\u4ea4</div>' : "";
            var riskMeta = result.risk != null
              ? '<div class="muted">\u521d\u59cb 1R ' + escapeHtml(trade.currency || "") + ' ' + money(result.risk) + '</div>'
              : "";
            if (result.currentRisk != null && !result.planned) {
              riskMeta += '<div class="muted">\u76ee\u524d\u98a8\u96aa ' + money(result.currentRisk) + '</div>';
            }
            return '<tr class="' + hidden.trim() + '" data-trade-id="' + escapeHtml(trade.trade_id) + '" data-symbol="' + escapeHtml(trade.ticker) + '" data-market="' + escapeHtml(trade.market) + '">' +
              '<td class="symbol-cell"><a href="#ticker-' + escapeHtml(String(trade.ticker).toLowerCase()) + '">' + escapeHtml(trade.ticker) + '</a><div class="journal-note">' + escapeHtml(note) + '</div></td>' +
              '<td><span class="journal-status ' + statusClass + '">' + statusLabel + '</span></td>' +
              '<td>' + escapeHtml(result.entryDate || "N/A") + '<div class="muted">' + escapeHtml(trade.currency || "") + ' ' + money(result.entry) + '</div></td>' +
              '<td class="num">' + money(quantity) + fillMeta + '</td>' +
              '<td class="num">' + money(result.currentStop) + riskMeta + '</td>' +
              '<td class="num change' + plClass + '">' + (result.net == null ? "N/A" : escapeHtml(trade.currency || "") + ' ' + signed(result.net)) + '</td>' +
              '<td class="num change' + (result.r == null ? "" : result.r >= 0 ? " change-pos" : " change-neg") + '">' + signed(result.r, "R") + '</td>' +
              '<td class="num muted">\u7522\u6a94\u5f8c\u66f4\u65b0</td>' +
              '<td><button type="button" class="icon-button" data-trade-edit="' + escapeHtml(trade.trade_id) + '" title="\u7de8\u8f2f\u4ea4\u6613" aria-label="\u7de8\u8f2f\u4ea4\u6613">&#x270E;</button>' +
              '<button type="button" class="icon-button" data-trade-cancel="' + escapeHtml(trade.trade_id) + '" title="\u79fb\u9664\u4ea4\u6613" aria-label="\u79fb\u9664\u4ea4\u6613">&#x2715;</button></td></tr>';
          }).join("");
        }
        var results = visibleTrades.map(function (trade) { return metrics(trade); });
        var planned = results.filter(function (result) { return result.planned; }).length;
        var open = results.filter(function (result) { return !result.planned && !result.closed; }).length;
        var closed = results.filter(function (result) { return result.closed; }).length;
        var plannedNode = document.querySelector('[data-journal-stat="planned"]');
        var openNode = document.querySelector('[data-journal-stat="open"]');
        var closedNode = document.querySelector('[data-journal-stat="closed"]');
        if (plannedNode) plannedNode.textContent = planned;
        if (openNode) openNode.textContent = open;
        if (closedNode) closedNode.textContent = closed;
      }
      function resetForm() {
        form.reset();
        fields.id.value = "";
        fields.initialRisk.value = "";
        fields.entryDate.value = reportDate;
        fields.fees.value = "0";
        fields.fxRate.value = "1";
        fields.status.value = "planned";
        fields.currentStop.value = "";
        fields.entryPrice.setCustomValidity("");
        fields.shares.setCustomValidity("");
        fields.stop.setCustomValidity("");
        fields.exitPrice.setCustomValidity("");
        if (fillRows) fillRows.innerHTML = "";
        if (formTitle) formTitle.textContent = "\u65b0\u589e\u4ea4\u6613";
        filterTickerOptions(activeMarket);
      }
      function filterTickerOptions(market) {
        var first = null;
        Array.prototype.forEach.call(fields.ticker.options, function (option) {
          var matches = marketGroup(option.dataset.market) === market;
          option.hidden = !matches;
          option.disabled = !matches;
          if (matches && !first) first = option;
        });
        if (!fields.ticker.selectedOptions.length || fields.ticker.selectedOptions[0].disabled) {
          if (first) fields.ticker.value = first.value;
        }
      }
      function editTrade(id) {
        var trade = trades.find(function (row) { return row.trade_id === id; });
        if (!trade) return;
        fields.id.value = trade.trade_id || "";
        fields.initialRisk.value = trade.initial_risk == null ? "" : trade.initial_risk;
        fields.ticker.value = trade.ticker || "";
        fields.status.value = ["planned", "open", "closed"].indexOf(trade.status) >= 0 ? trade.status : "open";
        fields.entryDate.value = trade.entry_date || "";
        fields.entryPrice.value = trade.entry_price == null ? "" : trade.entry_price;
        fields.shares.value = trade.shares == null ? "" : trade.shares;
        fields.stop.value = trade.initial_stop == null ? "" : trade.initial_stop;
        fields.currentStop.value = trade.current_stop == null ? "" : trade.current_stop;
        fields.exitDate.value = trade.exit_date || "";
        fields.exitPrice.value = trade.exit_price == null ? "" : trade.exit_price;
        fields.fees.value = trade.fees == null ? 0 : trade.fees;
        fields.fxRate.value = trade.fx_rate_to_base == null ? 1 : trade.fx_rate_to_base;
        fields.setup.value = trade.setup || "";
        fields.note.value = trade.note || "";
        if (fillRows) {
          fillRows.innerHTML = "";
          normalizeFills(trade).forEach(addFillRow);
        }
        if (formTitle) formTitle.textContent = "\u7de8\u8f2f " + trade.ticker;
        form.scrollIntoView({ behavior: "smooth", block: "center" });
      }

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        fields.entryPrice.setCustomValidity("");
        fields.shares.setCustomValidity("");
        fields.stop.setCustomValidity("");
        fields.exitPrice.setCustomValidity("");

        var fills = readFillRows();
        var buys = fills.filter(function (fill) { return fill.side === "buy"; });
        var sells = fills.filter(function (fill) { return fill.side === "sell"; });
        var entry = buys.length ? fillAverage(buys) : number(fields.entryPrice.value);
        var shares = buys.length
          ? buys.reduce(function (sum, fill) { return sum + number(fill.shares); }, 0)
          : number(fields.shares.value);
        var exit = sells.length ? fillAverage(sells) : number(fields.exitPrice.value);
        var soldShares = sells.reduce(function (sum, fill) { return sum + number(fill.shares); }, 0);
        var stop = number(fields.stop.value);
        if (entry == null || entry <= 0) {
          fields.entryPrice.setCustomValidity("\u8acb\u586b\u9032\u5834\u50f9\uff0c\u6216\u65b0\u589e\u4e00\u7b46\u8cb7\u9032\u6210\u4ea4");
        }
        if (shares == null || shares <= 0) {
          fields.shares.setCustomValidity("\u8acb\u586b\u4ea4\u6613\u6578\u91cf\uff0c\u6216\u65b0\u589e\u4e00\u7b46\u8cb7\u9032\u6210\u4ea4");
        }
        if (stop == null || (entry != null && stop >= entry)) {
          fields.stop.setCustomValidity("\u521d\u59cb\u505c\u640d\u5fc5\u9808\u4f4e\u65bc\u9032\u5834\u50f9");
        }
        if (fields.status.value === "closed" && (exit == null || exit <= 0)) {
          fields.exitPrice.setCustomValidity("\u5df2\u5b8c\u6210\u4ea4\u6613\u9700\u8981\u51fa\u5834\u50f9");
        }
        if (!form.reportValidity()) return;

        var option = fields.ticker.selectedOptions[0];
        var id = fields.id.value || ("trade-" + Date.now().toString(36));
        var index = trades.findIndex(function (row) { return row.trade_id === id; });
        var existing = index >= 0 ? trades[index] : {};
        var buyDates = buys.map(function (fill) { return fill.fill_date; }).filter(Boolean).sort();
        var sellDates = sells.map(function (fill) { return fill.fill_date; }).filter(Boolean).sort();
        var entryDate = buyDates[0] || fields.entryDate.value;
        var exitDate = sellDates.length ? sellDates[sellDates.length - 1] : fields.exitDate.value;
        var initialRisk = number(fields.initialRisk.value);
        if (initialRisk == null && entry != null && stop != null && shares != null) {
          initialRisk = buys.length
            ? buys.reduce(function (sum, fill) {
                return sum + Math.max(0, number(fill.price) - stop) * number(fill.shares);

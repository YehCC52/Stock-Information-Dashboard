    // Save to database functionality
    (function () {
      var saveBtn = document.getElementById("save-to-db");
      var saveStatus = document.getElementById("save-status");

      if (!saveBtn) return;

      saveBtn.addEventListener("click", function () {
        saveBtn.disabled = true;
        saveStatus.textContent = "正在儲存...";
        saveStatus.className = "save-status is-saving";

        // Collect research state from localStorage drafts, falling back to the
        // server-rendered state for any ticker/field the user did NOT edit this
        // session. Without this fallback, saving would blank thesis/note/plan for
        // every untouched ticker (full-overwrite upsert on the backend).
        var researchState = {};
        var serverState = (window.__serverResearch) || {};

        function readDraft(key, fallback) {
          var raw = localStorage.getItem(key);
          if (raw == null) return null;            // key absent => never touched
          try { return JSON.parse(raw); } catch (e) { return fallback; }
        }

        // null means "this category was never touched" => use server values wholesale.
        var pinsDraft = readDraft("stock-daily-draft-pins", null);
        var tags = readDraft("stock-daily-draft-tags", {});
        var thesisStates = readDraft("stock-daily-draft-thesis", {});
        var thesisTriggers = readDraft("stock-daily-draft-thesis-triggers", {});
        var thesisTexts = readDraft("stock-daily-draft-thesis-text", {});
        var notes = readDraft("stock-daily-draft-notes", {});
        var checklists = readDraft("stock-daily-draft-checklist", {});
        var plans = readDraft("stock-daily-draft-plans", {});
        var earningsQuestions = readDraft("stock-daily-draft-earnings-questions", {});
        var positions = readDraft("stock-daily-draft-positions", {});
        var postEarnings = readDraft("stock-daily-draft-post-earnings", {});

        // Per-ticker draft value if present, else the server value. Uses key
        // presence (not truthiness) so an intentional empty edit is preserved.
        function pick(draft, sym, serverVal) {
          if (draft && Object.prototype.hasOwnProperty.call(draft, sym) && draft[sym] != null) {
            return draft[sym];
          }
          return serverVal;
        }

        // Collect all tickers from the page (cards + valuation table share data-symbol)
        var cards = document.querySelectorAll("[data-symbol]");
        var allSymbols = [];
        cards.forEach(function (card) {
          var sym = card.dataset.symbol;
          if (sym && allSymbols.indexOf(sym) === -1) allSymbols.push(sym);
        });

        // Build research state for each ticker (draft overlaid on server value)
        allSymbols.forEach(function (sym) {
          var srv = serverState[sym] || {};
          var noteRec = (notes && Object.prototype.hasOwnProperty.call(notes, sym)) ? notes[sym] : null;
          var planRec = (plans && Object.prototype.hasOwnProperty.call(plans, sym)) ? plans[sym] : null;
          researchState[sym] = {
            ticker: sym,
            pinned: pinsDraft ? (pinsDraft.indexOf(sym) !== -1) : !!srv.pinned,
            tag: pick(tags, sym, srv.tag || ""),
            thesis_state: pick(thesisStates, sym, srv.thesis_state || ""),
            thesis_trigger: pick(thesisTriggers, sym, srv.thesis_trigger || ""),
            thesis_text: pick(thesisTexts, sym, srv.thesis_text || ""),
            note: noteRec ? (noteRec.note || "") : (srv.note || ""),
            revisit_date: noteRec ? (noteRec.revisit || null) : (srv.revisit_date || null),
            checklist: pick(checklists, sym, srv.checklist || []),
            bull_case: planRec ? (planRec.bull_case || "") : (srv.bull_case || ""),
            bear_case: planRec ? (planRec.bear_case || "") : (srv.bear_case || ""),
            entry_plan: planRec ? (planRec.entry_plan || "") : (srv.entry_plan || ""),
            add_zone: planRec ? (planRec.add_zone || "") : (srv.add_zone || ""),
            reduce_zone: planRec ? (planRec.reduce_zone || "") : (srv.reduce_zone || ""),
            stop_loss: planRec ? (planRec.stop_loss || "") : (srv.stop_loss || ""),
            earnings_questions: pick(earningsQuestions, sym, srv.earnings_questions || []),
            position: pick(positions, sym, srv.position || {}),
            post_earnings_review: pick(postEarnings, sym, srv.post_earnings_review || {})
          };
        });

        // Send to API
        var payload = { research_state: researchState };

        fetch("http://127.0.0.1:8765/api/save-research-state", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        })
          .then(function (response) {
            if (response.ok) return response.json();
            throw new Error("API response: " + response.status);
          })
          .then(function (data) {
            saveStatus.textContent = data.message || "已成功儲存到資料庫";
            saveStatus.className = "save-status is-ok";
            setTimeout(function () {
              saveStatus.textContent = "";
              saveStatus.className = "save-status";
              saveBtn.disabled = false;
            }, 3000);
          })
          .catch(function (error) {
            console.error("Save error:", error);
            saveStatus.textContent = "儲存失敗：" + error.message + "（請確認 API 服務正在執行）";
            saveStatus.className = "save-status is-error";
            saveBtn.disabled = false;
          });
      });
    })();

    // Sector map follows the single market switcher at the top of the page.
    (function () {
      var panels = Array.prototype.slice.call(document.querySelectorAll(".map-market-panel[data-market-panel]"));
      if (!panels.length) return;
      var STORAGE_KEY = "stock-daily-market-tab";
      function activate(key) {
        var matched = panels.some(function (panel) { return panel.dataset.marketPanel === key; });
        if (!matched) return;
        panels.forEach(function (panel) { panel.classList.toggle("active", panel.dataset.marketPanel === key); });
      }
      var saved = "us";
      try { saved = localStorage.getItem(STORAGE_KEY) || "us"; } catch (e) {}
      activate(saved);
      document.addEventListener("stock-daily:market", function (event) {
        activate((event.detail || {}).market);
      });
    })();

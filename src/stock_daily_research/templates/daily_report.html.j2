<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Daily Stock Research - {{ report.report_date.isoformat() }}</title>
  <script>
    // Apply persisted theme before paint to avoid a flash. Falls back to OS preference.
    (function () {
      try {
        var t = localStorage.getItem("stock-daily-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f7f9;
      --surface: #ffffff;
      --surface-soft: #eef2f7;
      --surface-alt: #f8fafc;
      --text: #17202a;
      --muted: #657184;
      --border: #d8dee8;
      --border-soft: #e5e7eb;
      --accent: #0f766e;
      --link: #075985;
      --warning: #b45309;
      --warning-bg: #fff7ed;
      --danger: #b91c1c;
      --danger-bg: #fef2f2;
      --good: #15803d;
      --good-bg: #f0fdf4;
      --info: #1d4ed8;
      --info-bg: #eff6ff;
      --shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    }

    /* Dark tokens applied two ways: when OS prefers dark and no manual override,
       OR when the user explicitly picks dark via the toggle. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #0f172a;
        --surface: #1e293b;
        --surface-soft: #243144;
        --surface-alt: #182234;
        --text: #e2e8f0;
        --muted: #94a3b8;
        --border: #334155;
        --border-soft: #2a384e;
        --link: #7dd3fc;
        --warning: #fbbf24;
        --warning-bg: #3b2c10;
        --danger: #fca5a5;
        --danger-bg: #3b1717;
        --good: #86efac;
        --good-bg: #0f2e1c;
        --info: #93c5fd;
        --info-bg: #16243f;
        --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
      }
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-soft: #243144;
      --surface-alt: #182234;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --border: #334155;
      --border-soft: #2a384e;
      --link: #7dd3fc;
      --warning: #fbbf24;
      --warning-bg: #3b2c10;
      --danger: #fca5a5;
      --danger-bg: #3b1717;
      --good: #86efac;
      --good-bg: #0f2e1c;
      --info: #93c5fd;
      --info-bg: #16243f;
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    }
    :root[data-theme="light"] {
      color-scheme: light;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.45;
      font-feature-settings: "tnum" 1, "cv11" 1;
    }
    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .page { max-width: 1480px; margin: 0 auto; padding: 24px; }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 18px;
    }
    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    .top-tools {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      width: min(100%, 560px);
    }
    .export-status {
      flex-basis: 100%;
      color: var(--muted);
      font-size: 11px;
      text-align: right;
    }
    .search-box, .control-input, .control-select, .tag-select, .note-input, .revisit-input {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
    }
    .search-box {
      min-width: 240px;
      flex: 1 1 240px;
      padding: 8px 10px;
      box-shadow: var(--shadow);
    }
    .control-input, .control-select, .tag-select, .revisit-input { padding: 6px 8px; }
    .tool-button, .icon-button {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .tool-button { padding: 7px 10px; }
    .icon-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      font-size: 15px;
    }
    .tool-button:hover, .icon-button:hover { background: var(--surface-soft); text-decoration: none; }
    .tool-button:focus-visible, .icon-button:focus-visible, .search-box:focus-visible,
    .control-select:focus-visible, .tag-select:focus-visible, .note-input:focus-visible,
    .revisit-input:focus-visible {
      outline: 2px solid var(--info);
      outline-offset: 2px;
    }
    .theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .theme-toggle:hover { background: var(--surface-soft); }
    .theme-toggle:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
    .theme-toggle .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
    }
    :root[data-theme="dark"] .theme-toggle .dot { background: var(--info); }
    :root[data-theme="light"] .theme-toggle .dot { background: var(--warning); }
    h1 { margin: 0; font-size: 28px; }
    h2 { margin: 0 0 12px; font-size: 17px; display: flex; align-items: center; gap: 10px; }
    h2 .count { color: var(--muted); font-size: 13px; font-weight: 500; }
    h3 { margin: 0; font-size: 15px; }
    .muted { color: var(--muted); font-size: 13px; }

    .toc {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      padding: 8px 24px;
      margin: 0 -24px 18px;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      border-bottom: 1px solid var(--border-soft);
      position: sticky;
      top: 0;
      z-index: 5;
      backdrop-filter: blur(8px);
    }
    .toc a {
      padding: 2px 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      letter-spacing: 0.01em;
    }
    .toc a:hover { color: var(--text); text-decoration: none; }
    .toc .toc-pill {
      padding: 1px 8px;
      border-radius: 999px;
      background: var(--danger-bg);
      color: var(--danger);
      font-weight: 700;
    }

    /* Command center: hero left, summary + top alerts right */
    .command-center {
      display: grid;
      grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
      gap: 14px;
      margin-bottom: 18px;
      align-items: stretch;
    }
    .command-hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }
    .command-side {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
    }
    .command-side .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 0;
    }
    .command-alerts {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: var(--shadow);
      padding: 10px 12px;
    }
    .command-alerts-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .cc-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .cc-more { font-size: 11px; color: var(--link); }
    .command-alert-list { list-style: none; margin: 0; padding: 0; }
    .command-alert {
      border-left: 3px solid var(--border);
      padding: 5px 8px;
      margin: 4px 0;
      border-radius: 0 4px 4px 0;
      background: var(--surface-alt);
    }
    .command-alert.danger { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger-bg) 60%, var(--surface-alt)); }
    .command-alert.warning, .command-alert.warn { border-left-color: var(--warning); background: color-mix(in srgb, var(--warning-bg) 60%, var(--surface-alt)); }
    .command-alert.info { border-left-color: var(--info); }
    .command-alert a { display: flex; gap: 8px; align-items: baseline; color: var(--text); }
    .command-alert .ca-label { font-weight: 800; font-size: 12px; min-width: 48px; }
    .command-alert .ca-title { font-size: 12px; color: var(--text); line-height: 1.3; }

    /* Hero card itself (used inside .command-hero) */
    .hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }
    .hero-card {
      display: block;
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      box-shadow: var(--shadow);
      color: var(--text);
      position: relative;
      transition: transform 80ms ease, box-shadow 80ms ease;
    }
    .hero-card:hover { transform: translateY(-1px); text-decoration: none; }
    .hero-card.imminent { border-color: var(--danger); background: var(--danger-bg); }
    .hero-card.soon { border-color: var(--warning); background: var(--warning-bg); }
    .hero-card.info { border-color: var(--info); background: var(--info-bg); }
    .hero-card .hero-label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 6px; }
    .hero-card.imminent .hero-label { color: var(--danger); }
    .hero-card.soon .hero-label { color: var(--warning); }
    .hero-card.info .hero-label { color: var(--info); }
    .hero-card .hero-headline { display: block; font-size: 17px; font-weight: 700; line-height: 1.3; margin-bottom: 4px; }
    .hero-card .hero-sub { display: block; color: var(--muted); font-size: 12px; }

    /* Header focus line */
    .focus-line { font-size: 12px; font-weight: 600; color: var(--text); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .focus-line .sep { color: var(--border); }
    .focus-line .focus-num { font-variant-numeric: tabular-nums; }
    .disclaimer { font-size: 11px; opacity: 0.75; }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(140px, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }
    .stat, .section, .ticker-card {
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 8px;
    }
    .stat { padding: 12px 14px; }
    .stat-value { display: block; font-size: 24px; font-weight: 700; line-height: 1.1; }
    .stat-label { display: block; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
    .stat.alert .stat-value { color: var(--warning); }
    .stat.alert.danger .stat-value { color: var(--danger); }

    .section { padding: 16px; margin-bottom: 18px; }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .section-header h2 { margin-bottom: 0; }
    .section-empty { color: var(--muted); font-size: 13px; padding: 6px 0; }
    .priority-list, .alert-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 10px;
    }
    .priority-item, .alert-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
    }
    .priority-item:hover, .alert-item:hover { text-decoration: none; background: var(--info-bg); }
    .priority-label, .alert-label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }
    .priority-headline, .alert-title { display: block; font-weight: 800; line-height: 1.3; }
    .priority-subtitle, .alert-detail { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .alert-item.danger { border-color: var(--danger); background: var(--danger-bg); }
    .alert-item.warn { border-color: var(--warning); background: var(--warning-bg); }
    .morning-grid, .catalyst-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }
    .morning-tile, .catalyst-card {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
      min-width: 0;
    }
    .morning-tile .label, .catalyst-card .label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .morning-tile .value {
      display: block;
      font-size: 20px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
    }
    .morning-tile .sub, .catalyst-card .sub {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .mover-list, .catalyst-list { list-style: none; margin: 0; padding: 0; }
    .mover-list li, .catalyst-list li {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .mover-list li:last-child, .catalyst-list li:last-child { border-bottom: none; }
    .macro-risk {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 10px;
    }
    .risk-meter {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      padding: 9px 10px;
      background: var(--surface-alt);
    }
    .risk-meter .risk-name { display: block; font-size: 12px; font-weight: 800; }
    .risk-meter .risk-level {
      display: inline-flex;
      margin-top: 4px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .risk-meter.low .risk-level { color: var(--good); background: var(--good-bg); }
    .risk-meter.medium .risk-level { color: var(--warning); background: var(--warning-bg); }
    .risk-meter.high .risk-level { color: var(--danger); background: var(--danger-bg); }
    .risk-meter .risk-detail { display: block; color: var(--muted); font-size: 11px; margin-top: 4px; }
    .focus-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .focus-column {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
    }
    .focus-column h3 {
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .focus-list { list-style: none; margin: 0; padding: 0; }
    .focus-list li {
      padding: 8px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .focus-list li:last-child { border-bottom: none; }
    .focus-list a { font-weight: 800; color: var(--text); }
    .focus-reason { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .heatmap-table .symbols { color: var(--muted); font-size: 12px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .position-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: 8px 0;
    }
    .position-chip {
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 6px 8px;
      background: var(--surface-alt);
      min-width: 0;
    }
    .position-chip .label { display: block; color: var(--muted); font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .position-chip .value { display: block; font-weight: 800; font-size: 13px; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mode-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }
    .mode-button[aria-pressed="true"] {
      color: var(--info);
      border-color: var(--info);
      background: var(--info-bg);
    }
    .mode-hint {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      margin-left: auto;
    }
    .change-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .change-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
      font-size: 13px;
    }
    .change-item:hover { text-decoration: none; background: var(--info-bg); }
    .change-item strong { display: block; margin-bottom: 2px; }

    .macro-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 10px;
    }
    .macro-card {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .macro-card.rates { border-color: var(--warning); background: var(--warning-bg); }
    .macro-card.jobs { border-color: var(--info); background: var(--info-bg); }
    .macro-card .name { display: block; font-weight: 800; }
    .macro-card .time { display: block; margin-top: 2px; font-size: 13px; }
    .macro-card .note { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
    .macro-card .note.long {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-height: 3em;
    }
    .sort-hint {
      color: var(--muted);
      font-size: 11px;
      margin: -8px 0 10px;
      letter-spacing: 0.02em;
    }
    .head-link {
      font-size: 11px;
      font-weight: 600;
      color: var(--danger);
      white-space: nowrap;
      margin-left: 4px;
    }
    .head-link:hover { text-decoration: underline; }

    /* Earnings pills */
    .earnings-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
    }
    .earnings-pill {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .earnings-pill.imminent {
      border-color: var(--danger);
      border-width: 2px;
      background: var(--danger-bg);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 20%, transparent), 0 4px 8px rgba(185, 28, 28, 0.15);
    }
    .earnings-pill.soon { border-color: var(--warning); background: var(--warning-bg); }
    .earnings-pill.week { border-color: var(--good); background: var(--good-bg); }
    .earnings-pill .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .earnings-pill .symbol { font-weight: 800; font-size: 16px; }
    .earnings-pill .when { font-size: 12px; font-weight: 600; }
    .earnings-pill.imminent .when { color: var(--danger); }
    .earnings-pill.soon .when { color: var(--warning); }
    .earnings-pill.week .when { color: var(--good); }
    .earnings-pill .name { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .earnings-pill .date { color: var(--muted); font-size: 11px; }

    /* Tables */
    .table-wrap {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: auto;
      max-height: 560px;
    }
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }
    thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--surface-alt);
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    th.num, td.num { text-align: right; }
    tbody td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: middle;
    }
    tbody tr:nth-child(even) td { background: var(--surface-alt); }
    tbody tr:hover td { background: var(--info-bg); }
    tbody tr:last-child td { border-bottom: none; }
    .symbol-cell a { color: var(--text); font-weight: 800; }
    .valuation-controls, .ticker-controls, .export-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }
    .control-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }
    .control-label.checkbox { color: var(--text); }
    .is-hidden { display: none !important; }
    .dimmed { opacity: 0.48; }

    /* P/E heatmap hints */
    .pe-elevated { color: var(--warning); }
    .pe-high { color: var(--danger); font-weight: 600; }
    .pe-extreme { color: var(--danger); font-weight: 800; background: var(--danger-bg); padding: 1px 6px; border-radius: 4px; }
    .pe-neg { color: var(--muted); }
    .rsi-high, .rsi-extreme { color: var(--danger); font-weight: 700; }
    .rsi-low, .rsi-extreme-low { color: var(--info); font-weight: 700; }
    .rsi-extreme, .rsi-extreme-low { background: var(--info-bg); padding: 1px 6px; border-radius: 4px; }
    .rsi-extreme { background: var(--danger-bg); }

    .sentiment-panel {
      display: grid;
      grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr);
      gap: 12px;
      align-items: stretch;
    }
    .sentiment-score {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      padding: 14px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .sentiment-score strong { font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums; }
    .sentiment-score span { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .sentiment-components {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
    }
    .sentiment-component {
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      font-size: 12px;
    }
    .sentiment-component strong { display: block; margin-bottom: 3px; }
    .sentiment-component .component-score { color: var(--muted); }

    /* Daily change & 52w distance signs */
    .change.change-pos { color: var(--good); font-weight: 600; }
    .change.change-neg { color: var(--danger); font-weight: 600; }
    .change.change-flat { color: var(--muted); }

    /* Sector tag under company name */
    .ticker-sector {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.02em;
      margin-top: 2px;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      background: var(--surface-soft);
      color: var(--muted);
      letter-spacing: 0.02em;
    }
    .badge.warn { color: var(--warning); background: var(--warning-bg); }
    .badge.danger { color: var(--danger); background: var(--danger-bg); }
    .badge.good { color: var(--good); background: var(--good-bg); }
    .badge.info { color: var(--info); background: var(--info-bg); }

    /* News */
    .news-list { margin: 0; padding: 0; list-style: none; }
    .news-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px;
      padding: 10px 12px;
      border-left: 3px solid transparent;
      border-bottom: 1px solid var(--border-soft);
      align-items: baseline;
      margin: 0 -12px;
    }
    .news-item:last-child { border-bottom: none; }
    .news-item.tier-top { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger-bg) 50%, transparent); }
    .news-item.tier-primary { border-left-color: var(--warning); }
    .news-item.editor-pick .symbol::after {
      content: "Pick";
      display: inline-flex;
      margin-left: 6px;
      padding: 1px 6px;
      border-radius: 999px;
      color: var(--info);
      background: var(--info-bg);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      vertical-align: middle;
    }
    .news-item.tier-minor .title a { color: var(--muted); }
    .news-item.tier-minor .symbol { opacity: 0.7; }
    .news-item .symbol { font-weight: 800; font-size: 13px; min-width: 56px; }
    .news-item .title { font-size: 14px; line-height: 1.35; }
    .news-item .title a { color: var(--text); }
    .news-item .news-why {
      font-size: 11px;
      color: var(--muted);
      margin-top: 3px;
      font-style: italic;
    }
    .news-item .news-why .why-label {
      font-style: normal;
      font-weight: 700;
      color: var(--info);
      letter-spacing: 0.02em;
    }

    /* Watchlist-only mode */
    body.watchlist-mode #watchlist-mode-toggle {
      background: var(--info);
      color: var(--bg);
      border-color: var(--info);
    }
    body.watchlist-mode .ticker-card:not(.is-pinned) { display: none; }
    /* Hide everything that isn't the daily-driver core when in watchlist mode */
    body.watchlist-mode #overextended,
    body.watchlist-mode #market-sentiment,
    body.watchlist-mode #changes,
    body.watchlist-mode #valuation,
    body.watchlist-mode #news,
    body.watchlist-mode .legend,
    body.watchlist-mode .filter-row { display: none; }
    /* Bigger pinned cards */
    body.watchlist-mode .ticker-grid {
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 16px;
    }
    body.watchlist-mode .ticker-card {
      padding: 18px 20px;
    }
    body.watchlist-mode .ticker-card .ticker-symbol { font-size: 22px; }
    body.watchlist-mode .ticker-card .ticker-name { font-size: 14px; }
    /* Surface review status, revisit, and notes preview directly — no need to expand Manage */
    body.watchlist-mode .ticker-card .note-preview { display: block; }
    body.watchlist-mode .ticker-card .review-status { display: inline-flex; }
    body.watchlist-mode .ticker-card .insights {
      font-size: 13px;
    }

    /* Post-earnings review banner */
    .post-earnings {
      margin: 8px 0;
      padding: 8px 10px;
      background: var(--info-bg);
      border: 1px solid color-mix(in srgb, var(--info) 30%, var(--border));
      border-radius: 6px;
    }
    .post-earnings > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .post-earnings > summary::-webkit-details-marker { display: none; }
    .post-earnings > summary::before {
      content: "▸ ";
      font-size: 10px;
      color: var(--info);
    }
    .post-earnings[open] > summary::before { content: "▾ "; }
    .pe-pill {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--info);
      background: var(--surface);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .pe-meta { color: var(--muted); font-size: 11px; }
    .pe-status { color: var(--good); font-size: 11px; font-weight: 700; margin-left: auto; }
    .pe-status:empty::before { content: "Not reviewed yet"; color: var(--warning); font-weight: 600; }
    .post-earnings-form {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 8px;
    }
    .pe-row { display: flex; align-items: center; gap: 8px; }
    .pe-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      width: 64px;
    }
    .pe-buttons { display: flex; gap: 4px; }
    .pe-buttons button {
      padding: 4px 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 11px;
      border-radius: 4px;
      cursor: pointer;
    }
    .pe-buttons button:hover { background: var(--surface-soft); }
    .pe-buttons button[aria-pressed="true"] {
      background: var(--info-bg);
      border-color: var(--info);
      color: var(--info);
      font-weight: 700;
    }
    .pe-buttons button[data-pe-value="miss"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="down"][aria-pressed="true"] {
      background: var(--danger-bg);
      border-color: var(--danger);
      color: var(--danger);
    }
    .pe-buttons button[data-pe-value="beat"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="up"][aria-pressed="true"] {
      background: var(--good-bg);
      border-color: var(--good);
      color: var(--good);
    }
    .pe-text {
      width: 100%;
      min-height: 36px;
      resize: vertical;
      padding: 6px 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      border-radius: 4px;
    }
    .scoreboard-status {
      display: inline-flex;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--surface-soft);
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      min-width: 72px;
      justify-content: center;
    }
    .scoreboard-status.done { color: var(--good); background: var(--good-bg); }
    .scoreboard-status.partial { color: var(--warning); background: var(--warning-bg); }

    /* Macro overlay (rates + breadth) — sits next to market sentiment */
    .macro-overlay {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }
    @media (max-width: 760px) { .macro-overlay { grid-template-columns: 1fr; } }
    .rates-list, .breadth-list { list-style: none; margin: 6px 0 8px; padding: 0; }
    .rate-row, .breadth-row {
      display: grid;
      gap: 12px;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .rate-row { grid-template-columns: 56px 1fr auto; }
    .breadth-row { grid-template-columns: 1fr auto; }
    .rate-row:last-child, .breadth-row:last-child { border-bottom: none; }
    .rate-name { font-weight: 800; color: var(--muted); letter-spacing: 0.04em; }
    .rate-last { font-variant-numeric: tabular-nums; }
    .rate-change { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
    .change-pos { color: var(--good); }
    .change-neg { color: var(--danger); }
    .change-flat { color: var(--muted); }
    .breadth-label { font-weight: 700; }
    .breadth-spread { font-weight: 800; font-variant-numeric: tabular-nums; }
    .rates-interp, .breadth-hint {
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
      font-style: italic;
    }
    .regime-pill {
      display: inline-flex;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--info-bg);
      color: var(--info);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-left: auto;
      cursor: help;
    }

    /* Overextended list (top-of-dashboard danger panel) */
    .overextended-section {
      border: 1px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 25%, var(--surface));
    }
    .overextended-section h2 { color: var(--danger); }
    .overextended-list { list-style: none; margin: 6px 0 0; padding: 0; }
    .overextended-item {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 12px;
      align-items: baseline;
      padding: 8px 12px;
      margin: 4px -12px;
      border-left: 3px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 30%, transparent);
      border-radius: 0 4px 4px 0;
    }
    .overextended-item:nth-child(odd) { background: color-mix(in srgb, var(--danger-bg) 45%, transparent); }
    .overextended-item .symbol { font-weight: 800; font-size: 14px; color: var(--text); }
    .overextended-item .ext-reasons { font-size: 12px; color: var(--text); }
    .overextended-item .ext-score {
      font-weight: 800;
      font-size: 13px;
      color: var(--danger);
      font-variant-numeric: tabular-nums;
    }
    .news-item .meta { color: var(--muted); font-size: 12px; white-space: nowrap; display: flex; gap: 8px; align-items: center; }

    /* Event-typed badges */
    .event-badge { font-size: 10px; }
    .event-badge.event-earnings { color: var(--danger); background: var(--danger-bg); }
    .event-badge.event-guidance, .event-badge.event-supply { color: var(--warning); background: var(--warning-bg); }
    .event-badge.event-ma, .event-badge.event-antitrust, .event-badge.event-lawsuit, .event-badge.event-regulation { color: var(--info); background: var(--info-bg); }
    .event-badge.event-ai, .event-badge.event-product { color: var(--good); background: var(--good-bg); }
    .event-badge.event-analyst_call, .event-badge.event-management, .event-badge.event-macro, .event-badge.event-other { color: var(--muted); background: var(--surface-soft); }

    /* Ticker grid */
    .ticker-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 12px;
    }
    .ticker-card { padding: 14px; min-width: 0; scroll-margin-top: 80px; position: relative; overflow: hidden; }
    .ticker-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: transparent;
    }
    .ticker-card.hot { border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); }
    .ticker-card.hot::before { background: var(--danger); }
    .ticker-card.warn { border-color: color-mix(in srgb, var(--warning) 40%, var(--border)); }
    .ticker-card.warn::before { background: var(--warning); }
    .ticker-card.warm::before { background: var(--good); opacity: 0.4; }
    .ticker-card.warm { border-color: var(--border); }
    .ticker-card.quiet { opacity: 0.55; border-color: var(--border-soft); }
    .ticker-card.quiet:hover { opacity: 1; }
    .ticker-card.quiet .ticker-name { color: var(--muted); }

    /* Insight rows: Setup / Risk / Watch */
    /* Legend below the tickers heading */
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      padding: 8px 10px;
      margin-bottom: 12px;
      background: var(--surface-alt);
      border-radius: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .legend .badge { font-size: 10px; }
    .legend-sep { color: var(--border); }

    .insights {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 10px 0;
      padding: 8px 10px;
      background: var(--surface-alt);
      border-radius: 6px;
    }
    .insight-row {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 8px;
      font-size: 12px;
      line-height: 1.4;
      align-items: baseline;
    }
    .insight-label {
      text-transform: uppercase;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-weight: 700;
    }
    .insight-row.action .insight-label { color: var(--info); }
    .insight-row.action .insight-text { color: var(--info); font-weight: 700; }
    .insight-row.rs .insight-label { color: var(--muted); }
    .insight-row.rs.trend-up .insight-label { color: var(--good); }
    .insight-row.rs.trend-down .insight-label { color: var(--danger); }
    .insight-row.rs.trend-down .insight-text { color: var(--danger); }
    .insight-row.rs.trend-mixed .insight-label { color: var(--warning); }
    .insight-row.setup .insight-label { color: var(--good); }
    .insight-row.trend .insight-label { color: var(--muted); }
    .insight-row.trend.trend-up .insight-label { color: var(--good); }
    .insight-row.trend.trend-down .insight-label { color: var(--danger); }
    .insight-row.trend.trend-mixed .insight-label { color: var(--warning); }
    .insight-row.trend.trend-down .insight-text { color: var(--danger); }
    .insight-row.trend[title] { cursor: help; }
    .insight-row.risk .insight-label { color: var(--danger); }
    .insight-row.watch .insight-label { color: var(--info); }
    .insight-row .insight-text { color: var(--text); }
    .insight-row.risk .insight-text { color: var(--danger); }
    .ticker-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
      align-items: flex-start;
    }
    .ticker-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      max-width: 200px;
    }
    .review-status.reviewed { color: var(--good); background: var(--good-bg); }
    .review-status.in-progress { color: var(--info); background: var(--info-bg); }
    .review-status.not-reviewed { color: var(--muted); background: var(--surface-soft); }
    .user-tools-details {
      margin-top: 10px;
    }
    .user-tools-details > summary {
      cursor: pointer;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      padding: 4px 0;
      list-style: none;
    }
    .user-tools-details > summary::-webkit-details-marker { display: none; }
    .user-tools-details > summary::before {
      content: "> ";
      font-size: 10px;
      margin-right: 4px;
    }
    .user-tools-details[open] > summary::before { content: "v "; }
    .user-tools-details > summary:hover { color: var(--text); }
    .pin-button { width: auto; padding: 0 8px; }
    .pin-button[aria-pressed="true"] {
      color: var(--warning);
      border-color: var(--warning);
      background: var(--warning-bg);
    }
    .compare-label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }
    .user-tools {
      display: grid;
      gap: 7px;
      margin-top: 10px;
      padding: 7px 9px;
      border-radius: 6px;
      background: var(--surface-alt);
      border: 1px solid var(--border-soft);
    }
    .tag-row, .revisit-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .tag-badge { display: none; }
    .tag-badge.has-tag { display: inline-flex; }
    .note-preview {
      display: block;
      margin-top: 8px;
      padding: 6px 8px;
      border-radius: 6px;
      background: var(--info-bg);
      color: var(--info);
      font-size: 12px;
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    body[data-work-mode="prep"] .note-preview,
    body[data-work-mode="prep"] .user-tools-details > summary,
    body[data-work-mode="prep"] .compare-label,
    body[data-work-mode="review"] .review-status {
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--info) 18%, transparent);
    }
    body[data-work-mode="prep"] .user-tools {
      border-color: var(--info);
      background: color-mix(in srgb, var(--info-bg) 70%, var(--surface-alt));
    }
    .note-input {
      width: 100%;
      min-height: 42px;
      resize: vertical;
      padding: 8px;
      line-height: 1.4;
    }
    .manage-panel {
      margin-top: 0;
      padding-top: 2px;
    }
    .manage-panel summary {
      font-size: 12px;
      color: var(--muted);
    }
    .manage-panel[open] {
      padding-top: 6px;
      border-top: 1px solid var(--border-soft);
    }
    .advanced-tools {
      display: grid;
      gap: 8px;
      margin-top: 8px;
    }
    .checklist {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 6px;
      margin: 0;
    }
    .checklist label {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }
    .countdown { margin-top: 2px; color: var(--muted); font-size: 11px; }
    .compare-panel {
      margin: 0 0 12px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface-alt);
    }
    .compare-panel h3 {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .compare-table-wrap { overflow: auto; }
    .compare-table-wrap td.trend-up { color: var(--good); }
    .compare-table-wrap td.trend-down { color: var(--danger); }
    .compare-table-wrap td.trend-mixed { color: var(--warning); }
    .compare-table-wrap td.change-pos { color: var(--good); font-weight: 600; }
    .compare-table-wrap td.change-neg { color: var(--danger); font-weight: 600; }
    .ticker-symbol { font-weight: 800; font-size: 18px; line-height: 1.1; }
    .ticker-name { color: var(--muted); font-size: 12px; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: 10px 0;
    }
    .metric {
      background: var(--surface-alt);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 6px 8px;
    }
    .metric-label { display: block; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.03em; }
    .metric-value { display: block; font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; }

    .warning-list { margin: 8px 0 0; padding-left: 18px; color: var(--warning); font-size: 12px; }
    .warning-list li { margin: 2px 0; }
    details { margin-top: 10px; }
    summary { cursor: pointer; color: var(--link); font-weight: 600; font-size: 13px; }
    details ul { margin: 8px 0 0; padding-left: 18px; }
    details ul li { margin: 4px 0; font-size: 13px; }

    .footer {
      margin-top: 24px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 1100px) {
      .command-center { grid-template-columns: 1fr; }
      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 760px) {
      .page { padding: 14px; }
      .header { flex-direction: column; align-items: flex-start; }
      .header-right { align-items: stretch; width: 100%; }
      .top-tools { justify-content: flex-start; width: 100%; }
      .search-box { min-width: 0; flex-basis: 100%; }
      .export-status { text-align: left; }
      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sentiment-panel { grid-template-columns: 1fr; }
      .toc { position: static; }
      .news-item { grid-template-columns: 1fr; }
      .news-item .meta { white-space: normal; }
    }
    @media (max-width: 480px) {
      .summary-grid { grid-template-columns: 1fr 1fr; }
      .metrics { grid-template-columns: 1fr; }
      .ticker-actions { max-width: 100%; }
    }

    @media print {
      :root { color-scheme: light; }
      body { background: white; }
      .toc, details, .theme-toggle { display: none; }
      .section, .ticker-card, .stat { break-inside: avoid; box-shadow: none; }
      .table-wrap { max-height: none; overflow: visible; }
    }
  </style>
</head>
<body>
  <main class="page">
    <header class="header">
      <div>
        <h1>Daily Stock Research</h1>
        <div class="muted">{{ report.report_date.isoformat() }} | Generated {{ report.generated_at.strftime("%Y-%m-%d %H:%M %Z") }}</div>
      </div>
      <div class="header-right">
        <div class="top-tools" aria-label="Dashboard tools">
          <input id="quick-search" class="search-box" type="search" placeholder="Search ticker or company" autocomplete="off">
          <button id="watchlist-mode-toggle" type="button" class="tool-button" aria-pressed="false" title="Show only pinned tickers; everything else is hidden">Watchlist only</button>
          <button id="export-watchlist" type="button" class="tool-button" title="TXT: ticker, state, earnings timing, tag">Export watchlist</button>
          <button id="export-notes" type="button" class="tool-button" title="JSON: notes and revisit dates saved in this browser">Export notes</button>
          <button id="export-earnings" type="button" class="tool-button" title="JSON: ticker, company, earnings timing">Export earnings</button>
          <div id="export-status" class="export-status" aria-live="polite">Exports: watchlist TXT | notes JSON | earnings JSON</div>
        </div>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Cycle theme: Auto, Light, Dark">
          <span class="dot" aria-hidden="true"></span>
          <span class="theme-label">Auto</span>
        </button>
        <div class="focus-line">
          <span><span class="focus-num">{{ summary.ticker_count }}</span> tickers</span>
          <span class="sep">|</span>
          <span><span class="focus-num">{{ summary.earnings_soon_count }}</span> earnings <=7d</span>
          <span class="sep">|</span>
          <span><span class="focus-num">{{ summary.economic_event_count }}</span> macro</span>
        </div>
      </div>
    </header>

    <nav class="toc" aria-label="Sections">
      {% if hero %}<a href="#hero">Today</a>{% endif %}
      <a href="#summary">Summary</a>
      <a href="#todays-focus">Focus</a>
      {% if report.premarket %}<a href="#premarket">Premarket</a>{% endif %}
      <a href="#today-catalysts">Catalysts</a>
      {% if sector_leadership %}<a href="#sector-leadership">Sectors</a>{% endif %}
      {% if post_earnings_items %}<a href="#post-earnings-scoreboard">Post-Earnings</a>{% endif %}
      {% if overextended %}<a href="#overextended" class="toc-pill">Stretched {{ overextended|length }}</a>{% endif %}
      {% if rule_alerts %}<a href="#rule-alerts" class="toc-pill">Alerts {{ rule_alerts|length }}</a>{% endif %}
      {% if report.warnings %}<a href="#global-warnings" class="toc-pill">Warnings {{ report.warnings|length }}</a>{% endif %}
      {% if report.market_sentiment %}<a href="#market-sentiment">Sentiment</a>{% endif %}
      {% if report.market_context and report.market_context.rates %}<a href="#rates">Rates</a>{% endif %}
      {% if report.market_context and report.market_context.breadth %}<a href="#breadth">Breadth</a>{% endif %}
      <a href="#macro">Macro ({{ report.economic_events|length }})</a>
      <a href="#earnings">Earnings ({{ earnings_soon|length }})</a>
      <a href="#news">News ({{ important_news|length }})</a>
      <a href="#valuation">Valuation</a>
      <a href="#tickers">Tickers ({{ report.ticker_reports|length }})</a>
    </nav>

    <section class="command-center" aria-label="Today">
      {% if hero %}
      <div id="hero" class="command-hero">
        {% for item in hero %}
        <a class="hero-card {{ item.tone }}" href="{{ item.anchor }}">
          <span class="hero-label">{{ item.label }}</span>
          <span class="hero-headline">{{ item.headline }}</span>
          <span class="hero-sub">{{ item.subtitle }}</span>
        </a>
        {% endfor %}
      </div>
      {% endif %}
      <aside class="command-side" id="summary">
        <div class="mode-bar" role="group" aria-label="Today work mode">
          <button type="button" class="tool-button mode-button" data-mode="overview" aria-pressed="true">Overview</button>
          <button type="button" class="tool-button mode-button" data-mode="review" aria-pressed="false">Review mode</button>
          <button type="button" class="tool-button mode-button" data-mode="prep" aria-pressed="false">Prep mode</button>
          <span id="mode-hint" class="mode-hint">Full dashboard view</span>
        </div>
        <div class="summary-grid" aria-label="Summary">
          <div class="stat {% if summary.hot_count %}alert danger{% endif %}" title="Tickers with earnings today or 2+ top stories"><span class="stat-value">{{ summary.hot_count }}</span><span class="stat-label">Hot</span></div>
          <div class="stat {% if summary.premarket_gap_count %}alert{% endif %}" title="Watchlist names moving more than +/-2% in premarket/latest quote"><span class="stat-value">{{ summary.premarket_gap_count }}</span><span class="stat-label">Premarket gaps</span></div>
          <div class="stat {% if summary.earnings_soon_count %}alert{% endif %}" title="Earnings reports within the next 7 days"><span class="stat-value">{{ summary.earnings_soon_count }}</span><span class="stat-label">Earnings <=7d</span></div>
          <div class="stat {% if summary.economic_event_count %}alert{% endif %}" title="Tracked macro events"><span class="stat-value">{{ summary.economic_event_count }}</span><span class="stat-label">Macro</span></div>
          <div class="stat"><span class="stat-value">{{ summary.ticker_count }}</span><span class="stat-label">Tickers</span></div>
          <div class="stat" title="Checklist-based review status in this browser"><span class="stat-value" id="reviewed-count">0 / {{ summary.ticker_count }}</span><span class="stat-label">Reviewed</span></div>
          {% if report.market_sentiment %}
          <div class="stat {% if report.market_sentiment.score <= 24 or report.market_sentiment.score >= 76 %}alert danger{% elif report.market_sentiment.score <= 44 or report.market_sentiment.score >= 56 %}alert{% endif %}" title="Free yfinance proxy, not a proprietary index"><span class="stat-value">{{ report.market_sentiment.score }}</span><span class="stat-label">{{ report.market_sentiment.label }}</span></div>
          {% endif %}
          <div class="stat {% if summary.rsi_overbought_count or summary.rsi_oversold_count %}alert{% endif %}" title="RSI 14 extremes across ticker cards"><span class="stat-value">{{ summary.rsi_overbought_count }} / {{ summary.rsi_oversold_count }}</span><span class="stat-label">RSI high / low</span></div>
        </div>
        {% if rule_alerts %}
        <div class="command-alerts">
          <div class="command-alerts-head">
            <span class="cc-label">Top alerts</span>
            {% if rule_alerts|length > 3 %}<a href="#rule-alerts" class="cc-more">+{{ rule_alerts|length - 3 }} more</a>{% endif %}
          </div>
          <ul class="command-alert-list">
            {% for alert in rule_alerts[:3] %}
            <li class="command-alert {{ alert.tone }}">
              <a href="{{ alert.anchor }}">
                <span class="ca-label">{{ alert.symbol }}</span>
                <span class="ca-title">{{ alert.title }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </aside>
    </section>

    <section id="todays-focus" class="section">
      <div class="section-header">
        <h2>Today's Focus</h2>
      </div>
      <div class="focus-grid">
        <div class="focus-column">
          <h3>Review first</h3>
          {% if todays_focus.review_first %}
          <ul class="focus-list">
            {% for row in todays_focus.review_first %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ') }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">No urgent review queue.</div>{% endif %}
        </div>
        <div class="focus-column">
          <h3>Do not chase</h3>
          {% if todays_focus.do_not_chase %}
          <ul class="focus-list">
            {% for row in todays_focus.do_not_chase %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ') }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">No obvious chase-risk names.</div>{% endif %}
        </div>
        <div class="focus-column">
          <h3>Watch for pullback</h3>
          {% if todays_focus.watch_pullback %}
          <ul class="focus-list">
            {% for row in todays_focus.watch_pullback %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ') }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">No clean pullback watch.</div>{% endif %}
        </div>
      </div>
    </section>

    {% if report.premarket %}
    <section id="premarket" class="section">
      <div class="section-header">
        <h2>Overnight / Premarket <span class="count">({{ report.premarket.retrieved_at.strftime("%H:%M UTC") }})</span></h2>
      </div>
      {% if report.premarket.benchmarks %}
      <div class="morning-grid" aria-label="Premarket benchmarks">
        {% for move in report.premarket.benchmarks %}
        <div class="morning-tile">
          <span class="label">{{ move.name }}</span>
          <span class="value change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span>
          <span class="sub">{{ move.symbol }} at {{ move.last|metric_value }} | {{ move.source }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if report.premarket.watchlist_movers %}
      <div class="catalyst-grid" style="margin-top: 10px;">
        <div class="catalyst-card">
          <span class="label">Watchlist top movers</span>
          <ul class="mover-list">
            {% for move in report.premarket.watchlist_movers[:6] %}
            <li><a href="#ticker-{{ move.symbol|lower }}">{{ move.symbol }}</a><span class="change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span></li>
            {% endfor %}
          </ul>
        </div>
        <div class="catalyst-card">
          <span class="label">Gap &gt; +/-2%</span>
          {% if report.premarket.gap_movers %}
          <ul class="mover-list">
            {% for move in report.premarket.gap_movers[:8] %}
            <li><a href="#ticker-{{ move.symbol|lower }}">{{ move.symbol }}</a><span class="change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span></li>
            {% endfor %}
          </ul>
          {% else %}
          <span class="sub">No watchlist gaps above threshold.</span>
          {% endif %}
        </div>
      </div>
      {% endif %}
      {% if premarket_triage.catalyst_backed or premarket_triage.unclear %}
      <div class="catalyst-grid" style="margin-top: 10px;">
        <div class="catalyst-card">
          <span class="label">Catalyst-backed</span>
          {% if premarket_triage.catalyst_backed %}
          <ul class="mover-list">
            {% for row in premarket_triage.catalyst_backed %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="change change-{{ row.move.change_pct|change_class }}">{{ row.move.change_pct|format_pct }} | {{ row.reasons|join(', ') }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">No mover with clear catalyst support.</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">Unclear / noisy</span>
          {% if premarket_triage.unclear %}
          <ul class="mover-list">
            {% for row in premarket_triage.unclear %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="change change-{{ row.move.change_pct|change_class }}">{{ row.move.change_pct|format_pct }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">No unexplained high-priority movers.</span>{% endif %}
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <section id="today-catalysts" class="section">
      <div class="section-header">
        <h2>Today's Catalysts</h2>
      </div>
      <div class="catalyst-grid">
        <div class="catalyst-card">
          <span class="label">Before open earnings</span>
          {% if todays_catalysts.before_open %}
          <ul class="catalyst-list">
            {% for item in todays_catalysts.before_open %}
            <li><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a><span>{{ item.ticker.company_name }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">None on watchlist.</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">After close earnings</span>
          {% if todays_catalysts.after_close %}
          <ul class="catalyst-list">
            {% for item in todays_catalysts.after_close %}
            <li><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a><span>{{ item.ticker.company_name }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">None on watchlist.</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">Macro today</span>
          {% if todays_catalysts.macro %}
          <ul class="catalyst-list">
            {% for event in todays_catalysts.macro %}
            <li><a href="{{ event.source_url }}" target="_blank" rel="noopener">{{ event.name }}</a><span>{{ event.event_datetime.strftime("%H:%M %Z") }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">No tracked macro event today.</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">Revisit due today</span>
          <ul id="revisit-due-list" class="catalyst-list">
            <li><span class="muted">Loading local revisit dates</span><span></span></li>
          </ul>
        </div>
      </div>
    </section>

    {% if post_earnings_items %}
    <section id="post-earnings-scoreboard" class="section">
      <div class="section-header">
        <h2>Post-Earnings Scoreboard <span class="count">({{ post_earnings_items|length }})</span></h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Ticker</th>
              <th class="num">Reported</th>
              <th>EPS</th>
              <th class="num">EPS surprise</th>
              <th>Revenue</th>
              <th class="num">Revenue surprise</th>
              <th>Guidance</th>
              <th class="num">Price reaction</th>
              <th>Review</th>
            </tr>
          </thead>
          <tbody>
            {% for row in post_earnings_items %}
            {% set item = row.item %}
            <tr data-pe-score-row="{{ item.ticker.symbol }}">
              <td class="symbol-cell"><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a></td>
              <td class="num">{{ row.days_ago }}d ago</td>
              <td data-pe-score-field="eps">N/A</td>
              <td class="num change" data-pe-score-field="eps_surprise">N/A</td>
              <td data-pe-score-field="rev">N/A</td>
              <td class="num change" data-pe-score-field="rev_surprise">N/A</td>
              <td data-pe-score-field="guide">N/A</td>
              <td class="num change change-{{ row.reaction|change_class }}">{{ row.reaction|format_pct }}</td>
              <td><span class="scoreboard-status" data-pe-score-field="review">Not reviewed</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if overextended %}
    <section id="overextended" class="section overextended-section">
      <div class="section-header">
        <h2>Overextended <span class="count">({{ overextended|length }})</span></h2>
      </div>
      <div class="sort-hint">Two or more of: RSI ≥ 70 · near 52w high · P/E ≥ 100 — caution on entry.</div>
      <ul class="overextended-list">
        {% for entry in overextended %}
        <li class="overextended-item">
          <a class="symbol" href="#{{ entry.item.ticker.symbol|ticker_anchor }}">{{ entry.item.ticker.symbol }}</a>
          <span class="ext-reasons">{{ entry.reasons|join(' · ') }}</span>
          <span class="ext-score" title="Number of danger flags (max 3)">{{ entry.score }}/3</span>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if report.market_sentiment %}
    <section id="market-sentiment" class="section">
      <div class="section-header">
        <h2>Market Sentiment <span class="count">({{ report.market_sentiment.source }})</span></h2>
      </div>
      <div class="sentiment-panel">
        <div class="sentiment-score">
          <strong>{{ report.market_sentiment.score }}</strong>
          <span>{{ report.market_sentiment.label }}</span>
          <div class="muted">Fear &amp; Greed style proxy from public market data.</div>
        </div>
        <div class="sentiment-components">
          {% for component in report.market_sentiment.components %}
          <div class="sentiment-component">
            <strong>{{ component.name }}</strong>
            <div>{{ component.detail }}</div>
            <div class="component-score">{{ "%.0f"|format(component.score) }} / 100 - {{ component.label }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if report.market_context and (report.market_context.rates or report.market_context.breadth) %}
    <section class="macro-overlay">
      {% if report.market_context.rates %}
      <div id="rates" class="section">
        <div class="section-header">
          <h2>Rates, Dollar &amp; Energy</h2>
          {% set regime = report|market_regime %}
          {% if regime %}<span class="regime-pill" title="Combined yields + dollar + oil + sentiment framing">{{ regime }}</span>{% endif %}
        </div>
        <ul class="rates-list">
          {% for r in report.market_context.rates %}
          <li class="rate-row">
            <span class="rate-name">{{ r.name }}</span>
            <span class="rate-last">{% if r.name == "WTI" %}${% endif %}{{ "%.2f"|format(r.last) }}{% if r.unit == "bp" %}%{% endif %}</span>
            <span class="rate-change change-{{ 'pos' if r.change > 0 else 'neg' if r.change < 0 else 'flat' }}">
              {{ "+%.1f"|format(r.change) if r.change > 0 else "%.1f"|format(r.change) }}{{ r.unit }}
            </span>
          </li>
          {% endfor %}
        </ul>
        {% set tip = report.market_context.rates|rates_interpretation %}
        {% if tip %}<div class="rates-interp">{{ tip }}</div>{% endif %}
        {% if macro_risk %}
        <div class="macro-risk" aria-label="Macro risk meter">
          {% for risk in macro_risk %}
          <div class="risk-meter {{ risk.level }}">
            <span class="risk-name">{{ risk.name }}</span>
            <span class="risk-level">{{ risk.level }}</span>
            <span class="risk-detail">{{ risk.detail }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if report.market_context.breadth %}
      <div id="breadth" class="section">
        <div class="section-header">
          <h2>Breadth (20D)</h2>
        </div>
        <ul class="breadth-list">
          {% for b in report.market_context.breadth %}
          <li class="breadth-row">
            <span class="breadth-label">{{ b.label }}</span>
            <span class="breadth-spread change-{{ 'pos' if b.spread > 0.5 else 'neg' if b.spread < -0.5 else 'flat' }}" title="{{ b.a_symbol }} {{ '%+.2f'|format(b.a_return) }}% vs {{ b.b_symbol }} {{ '%+.2f'|format(b.b_return) }}%">
              {{ "%+.2f"|format(b.spread) }}%
            </span>
          </li>
          {% endfor %}
        </ul>
        <div class="breadth-hint">Positive = first leg outperformed. Negative cap-weight (e.g. QQQ−QQQE &lt; 0) hints at narrow leadership.</div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if sector_leadership %}
    <section id="sector-leadership" class="section">
      <div class="section-header">
        <h2>Sector Leadership <span class="count">({{ sector_leadership|length }} groups)</span></h2>
      </div>
      <div class="table-wrap">
        <table class="heatmap-table">
          <thead>
            <tr>
              <th>Group</th>
              <th>Names</th>
              <th class="num">1D</th>
              <th class="num">5D</th>
              <th class="num">20D</th>
              <th class="num">Vs SPY 20D</th>
            </tr>
          </thead>
          <tbody>
            {% for row in sector_leadership %}
            <tr>
              <td class="symbol-cell">{{ row.label }}</td>
              <td class="symbols" title="{{ row.symbols }}">{{ row.symbols }}</td>
              <td class="num change change-{{ row.one_day|change_class }}">{{ row.one_day|format_pct }}</td>
              <td class="num change change-{{ row.ret_5d|change_class }}">{{ row.ret_5d|format_pct }}</td>
              <td class="num change change-{{ row.ret_20d|change_class }}">{{ row.ret_20d|format_pct }}</td>
              <td class="num change change-{{ row.rel_spy|change_class }}">{{ row.rel_spy|format_pct }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    <section id="changes" class="section">
      <div class="section-header">
        <h2>Since Last Report</h2>
      </div>
      <div id="changes-body" class="change-list">
        <div class="section-empty">Open another dated report in this browser to compare dashboard snapshots.</div>
      </div>
    </section>

    {% if rule_alerts %}
    <section id="rule-alerts" class="section">
      <div class="section-header">
        <h2>Rule Alerts <span class="count">({{ rule_alerts|length }} tickers)</span></h2>
        {% if rule_alerts|length > 6 %}<button id="toggle-alerts" type="button" class="tool-button">Show all</button>{% endif %}
      </div>
      <div class="alert-list">
        {% for alert in rule_alerts %}
        <a class="alert-item {{ alert.tone }}{% if loop.index0 >= 6 %} alert-extra is-hidden{% endif %}" href="{{ alert.anchor }}">
          <span class="alert-label">{{ alert.symbol }}</span>
          <span class="alert-title">{{ alert.title }}</span>
          <span class="alert-detail">{{ alert.detail }}</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if report.warnings %}
    <section id="global-warnings" class="section">
      <h2>Global Warnings <span class="count">({{ report.warnings|length }})</span></h2>
      <ul class="warning-list">
        {% for warning in report.warnings %}<li>{{ warning }}</li>{% endfor %}
      </ul>
    </section>
    {% endif %}

    <section id="macro" class="section">
      <h2>Macro Calendar <span class="count">(next events)</span></h2>
      {% if report.economic_events %}
      <div class="macro-row">
        {% for event in report.economic_events %}
        <a class="macro-card {{ event.category }}" href="{{ event.source_url }}" target="_blank" rel="noopener">
          <span class="name">{{ event.name }}</span>
          <span class="time">{{ event.event_datetime.strftime("%Y-%m-%d %H:%M %Z") }}</span>
          <span class="note">{{ event.source }}{% if event.source_time_label %} / {{ event.source_time_label }}{% endif %}</span>
          {% if event.notes %}<span class="note long" title="{{ event.notes }}">{{ event.notes }}</span>{% endif %}
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="section-empty">No upcoming macro events found for this run.</div>
      {% endif %}
    </section>

    <section id="earnings" class="section">
      <h2>Earnings Soon <span class="count">(next 7 days)</span></h2>
      {% if earnings_soon %}
      <div class="earnings-row">
        {% for item in earnings_soon %}
        {% set urgency = item.earnings.earnings_date|earnings_urgency %}
        <a class="earnings-pill {{ urgency }}" href="#{{ item.ticker.symbol|ticker_anchor }}">
          <div class="top">
            <span class="symbol">{{ item.ticker.symbol }}</span>
            <span class="when">{{ item.earnings.earnings_date|days_until }}</span>
          </div>
          <span class="name">{{ item.ticker.company_name }}</span>
          <span class="date">{{ item.earnings.earnings_date|date_or_na }} | {{ item.earnings.source }}</span>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="section-empty">No earnings dates within the next 7 days.</div>
      {% endif %}
    </section>

    <section id="news" class="section">
      <div class="section-header">
        <h2>Important News <span class="count">({{ important_news[:5]|length }} picks / {{ important_news|length }} total)</span></h2>
        {% if important_news|length > 5 %}<button id="toggle-news" type="button" class="tool-button">Show backlog</button>{% endif %}
      </div>
      {% if important_news %}
      <ul class="news-list">
        {% for item, article, tier in important_news %}
        {% set rationale = article|news_rationale %}
        <li class="news-item tier-{{ tier }} {% if loop.index <= 5 %}editor-pick{% else %}news-extra is-hidden{% endif %}">
          <a class="symbol" href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a>
          <div class="title">
            <a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a>
            {% if rationale %}<div class="news-why"><span class="why-label">Why:</span> {{ rationale }}</div>{% endif %}
          </div>
          <div class="meta">
            <span class="badge info">{{ news_triage_label(item, article) }}</span>
            <span class="badge event-badge event-{{ article.event_type }}">{{ article.event_type|event_label }}</span>
            <span>{{ article.source }}</span>
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="section-empty">No high-priority news (importance >=0.8) found for this run.</div>
      {% endif %}
    </section>

    <section id="valuation" class="section">
      <div class="section-header">
        <h2>Valuation Snapshot <span class="count">({{ report.ticker_reports|length }} tickers)</span></h2>
        <button id="toggle-valuation" type="button" class="tool-button" aria-expanded="true">Collapse</button>
      </div>
      <div id="valuation-body">
      <div class="valuation-controls">
        <label class="control-label" for="valuation-sort">Sort</label>
        <select id="valuation-sort" class="control-select">
          <option value="symbol">Ticker A-Z</option>
          <option value="market_cap_desc">Market cap high-low</option>
          <option value="forward_pe_asc">Forward P/E low-high</option>
          <option value="forward_pe_desc">Forward P/E high-low</option>
          <option value="rsi_asc">RSI low-high</option>
          <option value="rsi_desc">RSI high-low</option>
          <option value="earnings_soon">Earnings nearest</option>
        </select>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Ticker</th>
              {% for key in valuation_keys %}
              <th class="num">{{ key|metric_label }}</th>
              {% if key == "last_close" %}<th class="num">Daily %</th>{% endif %}
              {% if key == "market_cap" %}<th class="num">From High</th>{% endif %}
              {% endfor %}
              <th class="num">Earnings</th>
            </tr>
          </thead>
          <tbody id="valuation-rows">
            {% for item in valuation_rows %}
            {% set delta = item|earnings_delta %}
            {% set chg = item|daily_change %}
            {% set fh = item|from_52w_high %}
            <tr data-symbol="{{ item.ticker.symbol }}" data-company="{{ item.ticker.company_name|lower }}" data-market-cap="{{ item|metric_raw('market_cap') }}" data-forward-pe="{{ item|metric_raw('forward_pe') }}" data-rsi="{{ item|metric_raw('rsi_14') }}" data-earnings-days="{% if delta is not none %}{{ delta }}{% endif %}">
              <td class="symbol-cell"><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a></td>
              {% for key in valuation_keys %}
              {% set raw = item.valuation.metrics.get(key) if item.valuation else None %}
              <td class="num {% if key in ('trailing_pe', 'forward_pe', 'ev_to_ebitda') %}pe-{{ raw|pe_class }}{% endif %}{% if key == 'rsi_14' %} rsi-{{ raw|rsi_class }}{% endif %}{% if key == 'gap_percent' %} change change-{{ raw|change_class }}{% endif %}{% if key == 'fy1_eps_revision_30d' %} change change-{{ raw|eps_revision_class }}{% endif %}{% if key == 'eps_growth_pct' %} change change-{{ raw|change_class }}{% endif %}"{% if key == 'rsi_14' %} title="{{ raw|rsi_label }}"{% endif %}>{% if not item.valuation %}N/A{% elif key == 'volume_vs_20d' %}{{ raw|format_ratio }}{% elif key in ('gap_percent', 'fy1_eps_revision_30d') %}{{ raw|format_pct }}{% elif key in ('atr_20_percent', 'eps_growth_pct') %}{{ raw|format_pct(sign=False) }}{% else %}{{ raw|metric_value }}{% endif %}</td>
              {% if key == "last_close" %}
              <td class="num change change-{{ chg|change_class }}">{{ chg|format_pct }}</td>
              {% endif %}
              {% if key == "market_cap" %}
              <td class="num change change-{{ fh|change_class }}">{{ fh|format_pct }}</td>
              {% endif %}
              {% endfor %}
              <td class="num">
                {% if item.earnings and item.earnings.earnings_date %}
                <span title="{{ item.earnings.earnings_date|date_or_na }}">{{ item.earnings.earnings_date|days_until }}</span>
                {% else %}<span class="muted">N/A</span>{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div>
    </section>

    <section id="tickers" class="section">
      <div class="section-header">
        <h2>Ticker Cards <span class="count" id="ticker-count">({{ report.ticker_reports|length }})</span></h2>
        <button id="toggle-quiet" type="button" class="tool-button">Show Quiet</button>
      </div>
      <div class="sort-hint">Sorted by market cap (largest first)</div>
      <div class="legend" aria-label="Card state legend">
        <span class="badge danger">Hot</span> earnings today or 2+ top stories
        <span class="legend-sep">|</span>
        <span class="badge good">Warm</span> news or earnings <=7d
        <span class="legend-sep">|</span>
        <span class="badge warn">Warn</span> data warnings
        <span class="legend-sep">|</span>
        <span class="badge">Quiet</span> no major catalyst
      </div>
      <div class="ticker-controls">
        <label class="control-label" for="focus-filter">Focus</label>
        <select id="focus-filter" class="control-select">
          <option value="all">All</option>
          <option value="watchlist">My watchlist</option>
          <option value="reviewed">Reviewed</option>
          <option value="unreviewed">Unreviewed</option>
        </select>
        <label class="control-label" for="state-filter">State</label>
        <select id="state-filter" class="control-select">
          <option value="all">All active</option>
          <option value="hot">Hot</option>
          <option value="warm">Warm</option>
          <option value="warn">Warn</option>
          <option value="quiet">Quiet</option>
        </select>
        <label class="control-label" for="earnings-filter">Earnings</label>
        <select id="earnings-filter" class="control-select">
          <option value="all">Any date</option>
          <option value="today">Today</option>
          <option value="tomorrow">Tomorrow</option>
          <option value="7d">Next 7d</option>
        </select>
        <label class="control-label" for="rsi-filter">RSI</label>
        <select id="rsi-filter" class="control-select">
          <option value="all">Any RSI</option>
          <option value="oversold">Oversold &lt;=30</option>
          <option value="neutral">Neutral 30-70</option>
          <option value="overbought">Overbought &gt;=70</option>
        </select>
        <label class="control-label" for="topic-filter">Topic</label>
        <select id="topic-filter" class="control-select">
          <option value="all">All topics</option>
          <option value="ai">AI</option>
          <option value="cloud">Cloud</option>
          <option value="memory">Memory</option>
          <option value="ev">EV</option>
        </select>
        {% if sectors %}
        <label class="control-label" for="sector-filter">Sector</label>
        <select id="sector-filter" class="control-select">
          <option value="all">All sectors</option>
          {% for sec in sectors %}<option value="{{ sec|lower }}">{{ sec }}</option>{% endfor %}
        </select>
        {% endif %}
        <label class="control-label checkbox"><input id="risk-filter" type="checkbox"> Risk only</label>
      </div>
      <div id="compare-panel" class="compare-panel is-hidden" aria-live="polite"></div>
      <div class="ticker-grid" id="ticker-grid">
        {% for item in ticker_cards %}
        {% set state = item|card_state %}
        {% set insights = item|ticker_insights %}
        {% set delta = item|earnings_delta %}
        {% set sector = item.valuation.metrics.get("sector") if item.valuation else None %}
        {% set dchg = item|daily_change %}
        {% set fhigh = item|from_52w_high %}
        {% set pmchg = item|premarket_change %}
        {% set pos = item|position_view %}
        <article class="ticker-card {{ state }}" id="{{ item.ticker.symbol|ticker_anchor }}" data-symbol="{{ item.ticker.symbol }}" data-company="{{ item.ticker.company_name|lower }}" data-state="{{ state }}" data-has-risk="{{ '1' if item|has_risk_signal else '0' }}" data-earnings-days="{% if delta is not none %}{{ delta }}{% endif %}" data-topics="{{ item|topic_tags|join(' ') }}" data-market-cap="{{ item|metric_raw('market_cap') }}" data-trailing-pe="{{ item|metric_raw('trailing_pe') }}" data-forward-pe="{{ item|metric_raw('forward_pe') }}" data-eps-growth="{{ item|metric_raw('eps_growth_pct') }}" data-eps-rev-30d="{{ item|metric_raw('fy1_eps_revision_30d') }}" data-rsi="{{ item|metric_raw('rsi_14') }}" data-volume-x="{{ item|metric_raw('volume_vs_20d') }}" data-gap-pct="{{ item|metric_raw('gap_percent') }}" data-atr-pct="{{ item|metric_raw('atr_20_percent') }}" data-premarket-change="{% if pmchg is not none %}{{ pmchg }}{% endif %}" data-position-status="{{ pos.status }}" data-position-weight="{% if pos.portfolio_weight is not none %}{{ pos.portfolio_weight }}{% endif %}" data-pl-pct="{% if pos.pl_pct is not none %}{{ pos.pl_pct }}{% endif %}" data-book-impact="{% if pos.book_impact is not none %}{{ pos.book_impact }}{% endif %}" data-watch="{{ item.ticker.keywords[:3]|join(', ') }}" data-news-count="{{ item.articles|length }}" data-top-news-count="{{ item|top_news_count }}" data-top-news-signatures="{{ item|top_news_signatures }}" data-valuation-risk="{{ item|valuation_risk }}" data-sector="{{ (sector or '')|lower }}" data-daily-change="{% if dchg is not none %}{{ dchg }}{% endif %}" data-from-high="{% if fhigh is not none %}{{ fhigh }}{% endif %}" data-trend="{{ insights.trend|join(' / ') if insights.trend else '' }}" data-trend-tone="{{ insights.trend_tone }}">
          <div class="ticker-head">
            <div>
              <div class="ticker-symbol">{{ item.ticker.symbol }}</div>
              <div class="ticker-name">{{ item.ticker.company_name }}</div>
              {% if sector %}<div class="ticker-sector">{{ sector }}</div>{% endif %}
              {% if item.earnings and item.earnings.earnings_date %}<div class="countdown" data-countdown="{{ item.earnings.earnings_date.isoformat() }}" data-time-of-day="{{ item.earnings.time_of_day }}"></div>{% endif %}
            </div>
            <div class="ticker-actions">
              <button type="button" class="icon-button pin-button" aria-label="Pin {{ item.ticker.symbol }}" aria-pressed="false" data-pin="{{ item.ticker.symbol }}">Pin</button>
              <button type="button" class="icon-button quick-done" aria-label="Mark all checklist items reviewed" data-quick-done="{{ item.ticker.symbol }}" title="Mark earnings/guidance/valuation/news/thesis as reviewed">Done</button>
              <button type="button" class="icon-button quick-revisit" aria-label="Bump revisit date by one day" data-quick-revisit="{{ item.ticker.symbol }}" title="Set revisit to today + 1d (or push existing date forward)">+1d</button>
              {% if state == "hot" %}<span class="badge danger">Hot</span>
              {% elif state == "warn" %}<span class="badge warn">Warn</span>
              {% elif state == "warm" %}<span class="badge good">Warm</span>
              {% else %}<span class="badge">Quiet</span>{% endif %}
              <span class="badge review-status not-reviewed" data-review-status="{{ item.ticker.symbol }}">Not reviewed</span>
            </div>
          </div>

          <div class="metrics metrics-compact">
            <div class="metric">
              <span class="metric-label">Earnings</span>
              <span class="metric-value">
                {% if item.earnings and item.earnings.earnings_date %}
                  {{ item.earnings.earnings_date|days_until }}
                {% else %}N/A{% endif %}
              </span>
            </div>
            <div class="metric">
              <span class="metric-label">Market Cap</span>
              <span class="metric-value">{{ item.valuation.metrics.get("market_cap")|metric_value if item.valuation else "N/A" }}</span>
            </div>
            <div class="metric">
              {% set rsi = item.valuation.metrics.get("rsi_14") if item.valuation else None %}
              <span class="metric-label">RSI 14</span>
              <span class="metric-value rsi-{{ rsi|rsi_class }}" title="{{ rsi|rsi_label }}">{{ rsi|metric_value if item.valuation else "N/A" }}</span>
            </div>
          </div>

          <div class="position-row">
            <div class="position-chip">
              <span class="label">Position</span>
              <span class="value">{{ pos.status }}</span>
            </div>
            <div class="position-chip">
              <span class="label">Weight / Impact</span>
              <span class="value">{% if pos.portfolio_weight is not none %}{{ pos.portfolio_weight|format_pct(sign=False) }}{% else %}N/A{% endif %}{% if pos.book_impact is not none %} / {{ pos.book_impact|format_pct }}{% endif %}</span>
            </div>
            <div class="position-chip">
              <span class="label">Avg cost</span>
              <span class="value">{{ pos.avg_cost|metric_value }}</span>
            </div>
            <div class="position-chip">
              <span class="label">P/L</span>
              <span class="value change change-{{ pos.pl_pct|change_class }}">{{ pos.pl_pct|format_pct }}</span>
            </div>
          </div>

          {% if insights.setup or insights.quality or insights.trend or insights.risk or insights.watch or insights.action %}
          <div class="insights">
            {% if insights.action %}<div class="insight-row action"><span class="insight-label">Action</span><span class="insight-text">{{ insights.action }}</span></div>{% endif %}
            {% if insights.setup %}<div class="insight-row setup"><span class="insight-label">Setup</span><span class="insight-text">{{ insights.setup|join(' | ') }}</span></div>{% endif %}
            {% if insights.quality %}<div class="insight-row"><span class="insight-label">Quality</span><span class="insight-text">{{ insights.quality|join(' | ') }}</span></div>{% endif %}
            {% if insights.trend %}<div class="insight-row trend trend-{{ insights.trend_tone }}"{% if insights.trend_title %} title="{{ insights.trend_title }}"{% endif %}><span class="insight-label">Trend</span><span class="insight-text">{{ insights.trend|join(' | ') }}</span></div>{% endif %}
            {% if insights.rs %}<div class="insight-row rs trend-{{ insights.rs_tone }}"><span class="insight-label">Strength</span><span class="insight-text">{{ insights.rs|join(' · ') }}</span></div>{% endif %}
            {% if insights.risk %}<div class="insight-row risk"><span class="insight-label">Risk</span><span class="insight-text">{{ insights.risk|join(' | ') }}</span></div>{% endif %}
            {% if insights.watch %}<div class="insight-row watch"><span class="insight-label">Watch</span><span class="insight-text">{{ insights.watch|join(' | ') }}</span></div>{% endif %}
          </div>
          {% endif %}

          {% if item.warnings %}
          <ul class="warning-list">
            {% for warning in item.warnings %}<li>{{ warning }}</li>{% endfor %}
          </ul>
          {% endif %}

          {% set post_er = item|post_earnings %}
          {% if post_er %}
          <details class="post-earnings" data-post-earnings="{{ item.ticker.symbol }}" data-earnings-date="{{ post_er.earnings_date.isoformat() }}">
            <summary>
              <span class="pe-pill">Post-earnings review</span>
              <span class="pe-meta">reported {{ post_er.days_ago }}d ago · {{ post_er.earnings_date.isoformat() }}</span>
              <span class="pe-status" data-pe-status="{{ item.ticker.symbol }}"></span>
            </summary>
            <div class="post-earnings-form">
              <div class="pe-row">
                <label class="pe-label">EPS</label>
                <div class="pe-buttons" data-pe-field="eps" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="beat">Beat</button>
                  <button type="button" data-pe-value="inline">In line</button>
                  <button type="button" data-pe-value="miss">Miss</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label">Revenue</label>
                <div class="pe-buttons" data-pe-field="rev" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="beat">Beat</button>
                  <button type="button" data-pe-value="inline">In line</button>
                  <button type="button" data-pe-value="miss">Miss</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label">Guidance</label>
                <div class="pe-buttons" data-pe-field="guide" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="up">Up</button>
                  <button type="button" data-pe-value="flat">Flat</button>
                  <button type="button" data-pe-value="down">Down</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label" for="eps-surprise-{{ item.ticker.symbol }}">EPS surprise %</label>
                <input id="eps-surprise-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="eps_surprise" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="+8.5">
              </div>
              <div class="pe-row">
                <label class="pe-label" for="rev-surprise-{{ item.ticker.symbol }}">Revenue surprise %</label>
                <input id="rev-surprise-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="rev_surprise" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="+2.1">
              </div>
              <textarea class="pe-text" data-pe-field="conclusion" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="Conclusion: thesis intact / cracked / pivoting"></textarea>
              <textarea class="pe-text" data-pe-field="next_step" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="Next step: hold / add / trim / re-evaluate at $X"></textarea>
            </div>
          </details>
          {% endif %}

          <div class="note-preview is-hidden" data-note-preview="{{ item.ticker.symbol }}"></div>

          <details class="user-tools-details">
            <summary>Manage</summary>
            <div class="user-tools">
              <label class="compare-label"><input type="checkbox" class="compare-check" value="{{ item.ticker.symbol }}"> Add to compare</label>
              <div class="tag-row">
                <label class="control-label" for="tag-{{ item.ticker.symbol }}">Tag</label>
                <select id="tag-{{ item.ticker.symbol }}" class="tag-select" data-tag="{{ item.ticker.symbol }}">
                  <option value="">None</option>
                  <option value="High conviction">High conviction</option>
                  <option value="Watch closely">Watch closely</option>
                  <option value="Overvalued">Overvalued</option>
                  <option value="Post-earnings review">Post-earnings review</option>
                  <option value="Do not chase">Do not chase</option>
                </select>
                <span class="badge info tag-badge" data-tag-badge="{{ item.ticker.symbol }}"></span>
              </div>
              <div class="tag-row">
                <label class="control-label" for="thesis-{{ item.ticker.symbol }}">Thesis</label>
                <select id="thesis-{{ item.ticker.symbol }}" class="tag-select" data-thesis="{{ item.ticker.symbol }}">
                  <option value="">Unmarked</option>
                  <option value="intact">Intact</option>
                  <option value="improving">Improving</option>
                  <option value="weakening">Weakening</option>
                  <option value="broken">Broken</option>
                </select>
              </div>
              <textarea class="note-input" rows="2" data-note="{{ item.ticker.symbol }}" placeholder="Notes: thesis, risk, what to watch"></textarea>
              <div class="revisit-row">
                <label class="control-label" for="revisit-{{ item.ticker.symbol }}">Revisit</label>
                <input id="revisit-{{ item.ticker.symbol }}" class="revisit-input" type="date" data-revisit="{{ item.ticker.symbol }}">
              </div>
              <div class="checklist" data-checklist="{{ item.ticker.symbol }}">
                <label><input type="checkbox" value="earnings"> earnings reviewed</label>
                <label><input type="checkbox" value="guidance"> guidance reviewed</label>
                <label><input type="checkbox" value="valuation"> valuation reviewed</label>
                <label><input type="checkbox" value="news"> news reviewed</label>
                <label><input type="checkbox" value="thesis"> thesis updated</label>
              </div>
            </div>
          </details>

          <details>
            <summary>News &amp; X signals</summary>
            {% if item.articles %}
            <ul>
              {% for article in item.articles %}
              <li><a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a> <span class="muted">- {{ article.source }}</span></li>
              {% endfor %}
            </ul>
            {% else %}
            <p class="muted" style="margin: 8px 0 0;">No trusted news found.</p>
            {% endif %}
            {% if item.x_signals %}
            <ul>
              {% for signal in item.x_signals %}
              <li>@{{ signal.author_handle }}: {{ signal.text }}{% if signal.url %} <a href="{{ signal.url }}" target="_blank" rel="noopener">source</a>{% endif %}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </details>
        </article>
        {% endfor %}
      </div>
    </section>

    <footer class="footer">
      stock-daily-research | {{ report.report_date.isoformat() }} | <a href="#summary">Back to top</a>
      <div class="disclaimer" style="margin-top: 6px;">Personal research | Not investment advice</div>
    </footer>
  </main>
  <script>
    (function () {
      var STORAGE_KEY = "stock-daily-theme";
      var ORDER = ["auto", "light", "dark"];
      var LABEL = { auto: "Auto", light: "Light", dark: "Dark" };
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      var label = btn.querySelector(".theme-label");

      function read() {
        try {
          var t = localStorage.getItem(STORAGE_KEY);
          return ORDER.indexOf(t) >= 0 ? t : "auto";
        } catch (e) { return "auto"; }
      }

      function apply(t) {
        if (t === "auto") {
          document.documentElement.removeAttribute("data-theme");
        } else {
          document.documentElement.setAttribute("data-theme", t);
        }
        if (label) label.textContent = LABEL[t];
      }

      apply(read());

      btn.addEventListener("click", function () {
        var current = read();
        var next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
        try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
        apply(next);
      });
    })();

    (function () {
      var grid = document.getElementById("ticker-grid");
      if (!grid) return;

      var cards = Array.prototype.slice.call(grid.querySelectorAll(".ticker-card"));
      var search = document.getElementById("quick-search");
      var focusFilter = document.getElementById("focus-filter");
      var stateFilter = document.getElementById("state-filter");
      var earningsFilter = document.getElementById("earnings-filter");
      var rsiFilter = document.getElementById("rsi-filter");
      var topicFilter = document.getElementById("topic-filter");
      var sectorFilter = document.getElementById("sector-filter");
      var riskFilter = document.getElementById("risk-filter");
      var tickerCount = document.getElementById("ticker-count");
      var reviewedCount = document.getElementById("reviewed-count");
      var toggleQuiet = document.getElementById("toggle-quiet");
      var modeButtons = Array.prototype.slice.call(document.querySelectorAll("[data-mode]"));
      var modeHint = document.getElementById("mode-hint");
      var currentMode = "overview";
      var reportDate = "{{ report.report_date.isoformat() }}";
      var showQuiet = false;
      var pinned = readJson("stock-daily-pins", []);
      var tags = readJson("stock-daily-tags", {});
      var thesis = readJson("stock-daily-thesis", {});
      var notes = readJson("stock-daily-notes", {});
      var checklist = readJson("stock-daily-checklist", {});

      function readJson(key, fallback) {
        try {
          var raw = localStorage.getItem(key);
          return raw ? JSON.parse(raw) : fallback;
        } catch (e) { return fallback; }
      }

      function writeJson(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) {}
      }

      function numberOrNull(value) {
        if (value === "" || value == null) return null;
        var n = Number(value);
        return Number.isFinite(n) ? n : null;
      }

      function formattedNumber(value, suffix) {
        var n = numberOrNull(value);
        if (n == null) return "N/A";
        if (suffix) return n.toFixed(1).replace(/\.0$/, "") + suffix;
        if (Math.abs(n) >= 1e12) return (n / 1e12).toFixed(2).replace(/\.00$/, "") + "T";
        if (Math.abs(n) >= 1e9) return (n / 1e9).toFixed(1).replace(/\.0$/, "") + "B";
        if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, "") + "M";
        return n.toLocaleString();
      }

      function symbol(card) { return card.dataset.symbol || ""; }
      function isPinned(card) { return pinned.indexOf(symbol(card)) >= 0; }
      function checklistValues(card) {
        var values = checklist[symbol(card)];
        return Array.isArray(values) ? values : [];
      }
      function reviewState(card) {
        var count = checklistValues(card).length;
        if (count >= 4) return "reviewed";
        if (count >= 1) return "in-progress";
        return "not-reviewed";
      }
      function reviewLabel(state) {
        if (state === "reviewed") return "Reviewed";
        if (state === "in-progress") return "In progress";
        return "Not reviewed";
      }
      function topWatch(card) {
        var watch = (card.dataset.watch || "").split(",").map(function (x) { return x.trim(); }).filter(Boolean);
        return watch[0] || "N/A";
      }
      function valuationRisk(card) {
        return card.dataset.valuationRisk || "None";
      }
      function thesisState(card) {
        return thesis[symbol(card)] || "Unmarked";
      }
      function isExtremeRisk(value) {
        return value === "Extreme" || value === "High";
      }

      function reorderCards() {
        cards
          .slice()
          .sort(function (a, b) {
            var am = modeSortKey(a);
            var bm = modeSortKey(b);
            if (am !== bm) return am - bm;
            var ap = isPinned(a) ? 0 : 1;
            var bp = isPinned(b) ? 0 : 1;
            if (ap !== bp) return ap - bp;
            return cards.indexOf(a) - cards.indexOf(b);
          })
          .forEach(function (card) { grid.appendChild(card); });
      }

      function modeSortKey(card) {
        var days = numberOrNull(card.dataset.earningsDays);
        if (currentMode === "review") {
          if (days === 0) return 0;
          if (days === 1) return 1;
          if (card.dataset.state === "hot") return 2;
          return 3;
        }
        if (currentMode === "prep") {
          return days == null || days < 0 ? 999 : days;
        }
        return 0;
      }

      function earningsMatch(card, mode) {
        if (mode === "all") return true;
        var days = numberOrNull(card.dataset.earningsDays);
        if (days == null) return false;
        if (mode === "today") return days === 0;
        if (mode === "tomorrow") return days === 1;
        if (mode === "7d") return days >= 0 && days <= 7;
        return true;
      }

      function rsiMatch(card, mode) {
        if (mode === "all") return true;
        var rsi = numberOrNull(card.dataset.rsi);
        if (rsi == null) return false;
        if (mode === "oversold") return rsi <= 30;
        if (mode === "overbought") return rsi >= 70;
        if (mode === "neutral") return rsi > 30 && rsi < 70;
        return true;
      }

      function focusMatch(card, mode) {
        if (mode === "watchlist") return isPinned(card);
        if (mode === "reviewed") return reviewState(card) === "reviewed";
        if (mode === "unreviewed") return reviewState(card) === "not-reviewed";
        return true;
      }

      function workModeMatch(card) {
        var days = numberOrNull(card.dataset.earningsDays);
        if (currentMode === "review") {
          return card.dataset.state === "hot" || days === 0 || days === 1;
        }
        if (currentMode === "prep") {
          return days != null && days >= 0 && days <= 7;
        }
        return true;
      }

      function applyFilters() {
        var q = (search && search.value || "").trim().toLowerCase();
        var focus = focusFilter ? focusFilter.value : "all";
        var state = stateFilter ? stateFilter.value : "all";
        var earnings = earningsFilter ? earningsFilter.value : "all";
        var rsi = rsiFilter ? rsiFilter.value : "all";
        var topic = topicFilter ? topicFilter.value : "all";
        var sector = sectorFilter ? sectorFilter.value : "all";
        var riskOnly = !!(riskFilter && riskFilter.checked);
        var watchlistOnly = document.body.classList.contains("watchlist-mode");
        var visible = 0;

        cards.forEach(function (card) {
          var textMatch = !q || symbol(card).toLowerCase().indexOf(q) >= 0 || (card.dataset.company || "").indexOf(q) >= 0;
          var stateMatch = state === "all" ? (showQuiet || focus !== "all" || watchlistOnly || card.dataset.state !== "quiet") : card.dataset.state === state;
          var topicMatch = topic === "all" || (" " + (card.dataset.topics || "") + " ").indexOf(" " + topic + " ") >= 0;
          var sectorMatch = sector === "all" || (card.dataset.sector || "") === sector;
          var riskMatch = !riskOnly || card.dataset.hasRisk === "1";
          var pinnedMatch = !watchlistOnly || card.classList.contains("is-pinned");
          var match = pinnedMatch && textMatch && focusMatch(card, focus) && stateMatch && earningsMatch(card, earnings) && rsiMatch(card, rsi) && topicMatch && sectorMatch && riskMatch && workModeMatch(card);
          card.classList.toggle("is-hidden", !match);
          syncModeDetails(card, match);
          if (match) visible += 1;
        });

        if (tickerCount) tickerCount.textContent = "(" + visible + "/" + cards.length + ")";
        reorderCards();
        updateReviewSummary();
        renderCompare();
      }

      function syncModeDetails(card, visible) {
        var details = card.querySelector(".user-tools-details");
        if (!details) return;
        if (currentMode === "prep" && visible) details.open = true;
        if (currentMode === "overview" && !details.dataset.userOpened) details.open = false;
      }

      function jumpToSearchResult() {
        var q = (search && search.value || "").trim().toLowerCase();
        if (!q) return;
        var exact = cards.find(function (card) { return symbol(card).toLowerCase() === q; });
        var target = exact || cards.find(function (card) { return !card.classList.contains("is-hidden"); });
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function setupPins() {
        cards.forEach(function (card) {
          var btn = card.querySelector("[data-pin]");
          if (!btn) return;
          function paint() {
            var on = isPinned(card);
            btn.setAttribute("aria-pressed", on ? "true" : "false");
            btn.textContent = on ? "Pinned" : "Pin";
          }
          btn.addEventListener("click", function () {
            var s = symbol(card);
            pinned = isPinned(card) ? pinned.filter(function (x) { return x !== s; }) : pinned.concat([s]);
            writeJson("stock-daily-pins", pinned);
            paint();
            persistAndRenderChanges();
            applyFilters();
          });
          paint();
        });
        reorderCards();
      }

      function setupUserState() {
        cards.forEach(function (card) {
          var s = symbol(card);
          var tagSelect = card.querySelector("[data-tag]");
          var tagBadge = card.querySelector("[data-tag-badge]");
          var thesisSelect = card.querySelector("[data-thesis]");
          var noteInput = card.querySelector("[data-note]");
          var revisitInput = card.querySelector("[data-revisit]");
          var details = card.querySelector(".user-tools-details");
          var boxes = Array.prototype.slice.call(card.querySelectorAll("[data-checklist] input"));
          var noteState = notes[s] || {};
          if (details) {
            details.addEventListener("toggle", function () {
              if (currentMode === "overview") details.dataset.userOpened = details.open ? "1" : "";
            });
          }

          if (tagSelect) {
            tagSelect.value = tags[s] || "";
            tagSelect.addEventListener("change", function () {
              if (tagSelect.value) tags[s] = tagSelect.value;
              else delete tags[s];
              writeJson("stock-daily-tags", tags);
              paintTag(tagSelect, tagBadge);
              persistAndRenderChanges();
              renderCompare();
            });
            paintTag(tagSelect, tagBadge);
          }

          if (thesisSelect) {
            thesisSelect.value = thesis[s] || "";
            card.dataset.thesisState = thesisSelect.value || "";
            thesisSelect.addEventListener("change", function () {
              if (thesisSelect.value) thesis[s] = thesisSelect.value;
              else delete thesis[s];
              card.dataset.thesisState = thesisSelect.value || "";
              writeJson("stock-daily-thesis", thesis);
              persistAndRenderChanges();
              renderCompare();
            });
          }

          if (noteInput) {
            noteInput.value = noteState.note || "";
            noteInput.addEventListener("input", function () {
              notes[s] = Object.assign({}, notes[s], { note: noteInput.value });
              writeJson("stock-daily-notes", notes);
              paintNotePreview(card);
              persistAndRenderChanges();
              renderCompare();
            });
            paintNotePreview(card);
          }
          if (revisitInput) {
            revisitInput.value = noteState.revisit || "";
            revisitInput.addEventListener("change", function () {
              notes[s] = Object.assign({}, notes[s], { revisit: revisitInput.value });
              writeJson("stock-daily-notes", notes);
              renderRevisitDueToday();
              persistAndRenderChanges();
            });
          }

          boxes.forEach(function (box) {
            box.checked = (checklist[s] || []).indexOf(box.value) >= 0;
            box.addEventListener("change", function () {
              var values = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
              if (values.length) checklist[s] = values;
              else delete checklist[s];
              writeJson("stock-daily-checklist", checklist);
              paintReviewStatus(card);
              updateReviewSummary();
              persistAndRenderChanges();
              applyFilters();
            });
          });
          paintReviewStatus(card);
        });
        updateReviewSummary();
      }

      function paintNotePreview(card) {
        var preview = card.querySelector("[data-note-preview]");
        if (!preview) return;
        var state = notes[symbol(card)] || {};
        var note = (state.note || "").trim().replace(/\s+/g, " ");
        if (!note) {
          preview.classList.add("is-hidden");
          preview.textContent = "";
          return;
        }
        preview.textContent = "Note: " + (note.length > 92 ? note.slice(0, 89) + "..." : note);
        preview.classList.remove("is-hidden");
      }

      function paintReviewStatus(card) {
        var badge = card.querySelector("[data-review-status]");
        var state = reviewState(card);
        card.dataset.reviewStatus = state;
        if (!badge) return;
        badge.textContent = reviewLabel(state);
        badge.classList.remove("reviewed", "in-progress", "not-reviewed");
        badge.classList.add(state);
      }

      function updateReviewSummary() {
        var reviewed = cards.filter(function (card) { return reviewState(card) === "reviewed"; }).length;
        if (reviewedCount) reviewedCount.textContent = reviewed + " / " + cards.length;
      }

      function renderRevisitDueToday() {
        var list = document.getElementById("revisit-due-list");
        if (!list) return;
        var due = cards
          .map(function (card) {
            var s = symbol(card);
            var rec = notes[s] || {};
            return { symbol: s, revisit: rec.revisit || "", card: card };
          })
          .filter(function (row) { return row.revisit && row.revisit <= reportDate; })
          .sort(function (a, b) { return a.revisit.localeCompare(b.revisit) || a.symbol.localeCompare(b.symbol); });
        if (!due.length) {
          list.innerHTML = "<li><span class=\"muted\">No revisit dates due today.</span><span></span></li>";
          return;
        }
        list.innerHTML = due.slice(0, 10).map(function (row) {
          return "<li><a href=\"#" + row.card.id + "\">" + escapeHtml(row.symbol) + "</a><span>" + escapeHtml(row.revisit) + "</span></li>";
        }).join("");
      }

      function paintTag(select, badge) {
        if (!badge) return;
        badge.textContent = select.value;
        badge.classList.toggle("has-tag", !!select.value);
      }

      function setupCompare() {
        cards.forEach(function (card) {
          var box = card.querySelector(".compare-check");
          if (!box) return;
          box.addEventListener("change", function () {
            var selected = selectedCompare();
            if (selected.length > 4) {
              box.checked = false;
              return;
            }
            renderCompare();
          });
        });
      }

      function selectedCompare() {
        return cards.filter(function (card) {
          var box = card.querySelector(".compare-check");
          return box && box.checked;
        });
      }

      function tagFor(card) {
        return tags[symbol(card)] || "None";
      }

      function revisitFor(sym) {
        var rec = notes[sym];
        return (rec && rec.revisit) || "—";
      }

      function reviewStatusFor(sym) {
        var rec = notes[sym] || {};
        var checks = rec.checklist || {};
        var keys = ["earnings", "guidance", "valuation", "news", "thesis"];
        var done = keys.filter(function (k) { return checks[k]; }).length;
        if (done === 0) return "—";
        if (done === keys.length) return "✓ done";
        return done + "/" + keys.length;
      }

      function formattedPct(value) {
        var num = numberOrNull(value);
        if (num == null) return "—";
        var sign = num >= 0 ? "+" : "";
        return sign + num.toFixed(2) + "%";
      }

      function signClass(value) {
        var num = numberOrNull(value);
        if (num == null) return "flat";
        if (num > 0) return "pos";
        if (num < 0) return "neg";
        return "flat";
      }

      function renderCompare() {
        var panel = document.getElementById("compare-panel");
        if (!panel) return;
        var selected = selectedCompare();
        if (!selected.length) {
          panel.classList.add("is-hidden");
          panel.innerHTML = "";
          return;
        }
        panel.classList.remove("is-hidden");
        var rows = selected.map(function (card) {
          var sym = symbol(card);
          return "<tr><td><a href=\"#" + card.id + "\">" + sym + "</a></td>" +
            "<td>" + escapeHtml(card.dataset.state || "") + "</td>" +
            "<td class=\"trend-" + escapeHtml(card.dataset.trendTone || "") + "\">" + escapeHtml(card.dataset.trend || "—") + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.dailyChange) + "\">" + formattedPct(card.dataset.dailyChange) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.fromHigh) + "\">" + formattedPct(card.dataset.fromHigh) + "</td>" +
            "<td>" + earningsText(card.dataset.earningsDays) + "</td>" +
            "<td>" + escapeHtml(reviewStatusFor(sym)) + "</td>" +
            "<td>" + escapeHtml(tagFor(card)) + "</td>" +
            "<td>" + escapeHtml(thesisState(card)) + "</td>" +
            "<td>" + escapeHtml(revisitFor(sym)) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.premarketChange) + "\">" + formattedPct(card.dataset.premarketChange) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.gapPct) + "\">" + formattedPct(card.dataset.gapPct) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.volumeX, "x") + "</td>" +
            "<td class=\"num\">" + formattedPct(card.dataset.atrPct) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.epsGrowth) + "\">" + formattedPct(card.dataset.epsGrowth) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.epsRev30d) + "\">" + formattedPct(card.dataset.epsRev30d) + "</td>" +
            "<td>" + escapeHtml(card.dataset.positionStatus || "watchlist") + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.bookImpact) + "\">" + formattedPct(card.dataset.bookImpact) + "</td>" +
            "<td>" + escapeHtml(topWatch(card)) + "</td>" +
            "<td>" + escapeHtml(valuationRisk(card)) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.rsi) + "</td>" +
            "<td class=\"num\">" + (card.dataset.topNewsCount || "0") + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.marketCap) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.forwardPe, "x") + "</td></tr>";
        }).join("");
        panel.innerHTML = "<h3>Compare mode <button id=\"export-compare\" type=\"button\" class=\"tool-button\">Export compare</button></h3>" +
          "<div class=\"compare-table-wrap\"><table><thead><tr>" +
          "<th>Ticker</th><th>State</th><th>Trend</th><th class=\"num\">Daily %</th><th class=\"num\">From High</th>" +
          "<th>Next earnings</th><th>Review</th><th>User tag</th><th>Thesis</th><th>Revisit</th>" +
          "<th class=\"num\">Premarket</th><th class=\"num\">Gap</th><th class=\"num\">Vol/20D</th><th class=\"num\">ATR %</th><th class=\"num\">EPS growth</th><th class=\"num\">EPS rev 30D</th><th>Position</th><th class=\"num\">Book impact</th>" +
          "<th>Top watch</th><th>Valuation risk</th><th class=\"num\">RSI 14</th><th class=\"num\">Top news</th>" +
          "<th class=\"num\">Market Cap</th><th class=\"num\">Forward P/E</th>" +
          "</tr></thead><tbody>" +
          rows + "</tbody></table></div>";
        var exportBtn = document.getElementById("export-compare");
        if (exportBtn) exportBtn.addEventListener("click", exportCompare);
      }

      function earningsText(daysValue) {
        var days = numberOrNull(daysValue);
        if (days == null) return "N/A";
        if (days < 0) return Math.abs(days) + "d ago";
        if (days === 0) return "today";
        if (days === 1) return "tomorrow";
        return "in " + days + "d";
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (ch) {
          return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" })[ch];
        });
      }

      function setupValuationSort() {
        var select = document.getElementById("valuation-sort");
        var tbody = document.getElementById("valuation-rows");
        if (!select || !tbody) return;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));
        select.addEventListener("change", function () {
          rows.slice().sort(function (a, b) {
            if (select.value === "market_cap_desc") return sortNumberDesc(a.dataset.marketCap, b.dataset.marketCap, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "forward_pe_asc") return sortNumberAsc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "forward_pe_desc") return sortNumberDesc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_asc") return sortNumberAsc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_desc") return sortNumberDesc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "earnings_soon") return sortNumberAsc(a.dataset.earningsDays, b.dataset.earningsDays, a.dataset.symbol, b.dataset.symbol);
            return (a.dataset.symbol || "").localeCompare(b.dataset.symbol || "");
          }).forEach(function (row) { tbody.appendChild(row); });
        });
      }

      function sortNumberAsc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return an - bn || as.localeCompare(bs);
      }

      function sortNumberDesc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return bn - an || as.localeCompare(bs);
      }

      function setupCountdowns() {
        var today = new Date("{{ report.report_date.isoformat() }}T00:00:00");
        cards.forEach(function (card) {
          var el = card.querySelector("[data-countdown]");
          if (!el) return;
          var target = new Date(el.dataset.countdown + "T00:00:00");
          var days = Math.round((target - today) / 86400000);
          var session = { before_market: "before open", after_market: "after close", during_market: "during market", unknown: "time TBD" }[el.dataset.timeOfDay] || el.dataset.timeOfDay;
          el.textContent = days <= 0 ? "Earnings today | " + session : "Earnings in " + days + "d | " + session;
        });
      }

      function setupCollapsers() {
        var newsBtn = document.getElementById("toggle-news");
        if (newsBtn) {
          newsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".news-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            newsBtn.textContent = hidden ? "Show picks" : "Show backlog";
          });
        }
        var alertsBtn = document.getElementById("toggle-alerts");
        if (alertsBtn) {
          alertsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".alert-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            alertsBtn.textContent = hidden ? "Show top 6" : "Show all";
          });
        }
        var valuationBtn = document.getElementById("toggle-valuation");
        var valuationBody = document.getElementById("valuation-body");
        if (valuationBtn && valuationBody) {
          valuationBtn.addEventListener("click", function () {
            var hidden = valuationBody.classList.toggle("is-hidden");
            valuationBtn.textContent = hidden ? "Expand" : "Collapse";
            valuationBtn.setAttribute("aria-expanded", hidden ? "false" : "true");
          });
        }
        if (toggleQuiet) {
          toggleQuiet.addEventListener("click", function () {
            showQuiet = !showQuiet;
            toggleQuiet.textContent = showQuiet ? "Hide Quiet" : "Show Quiet";
            applyFilters();
          });
        }
      }

      function setupWorkModes() {
        if (!modeButtons.length) return;
        modeButtons.forEach(function (button) {
          button.addEventListener("click", function () {
            setWorkMode(button.dataset.mode || "overview");
          });
        });
        setWorkMode("overview");
      }

      function setWorkMode(mode) {
        currentMode = mode;
        document.body.dataset.workMode = mode;
        modeButtons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.dataset.mode === mode ? "true" : "false");
        });
        var hints = {
          overview: "Full dashboard view",
          review: "Hot catalysts and earnings today/tomorrow, sorted for review",
          prep: "Earnings within 7 days, with notes and revisit fields open",
        };
        if (modeHint) modeHint.textContent = hints[mode] || hints.overview;
        applyFilters();
      }

      function setupQuickActions() {
        cards.forEach(function (card) {
          var sym = symbol(card);
          var doneBtn = card.querySelector("[data-quick-done]");
          var bumpBtn = card.querySelector("[data-quick-revisit]");

          if (doneBtn) {
            doneBtn.addEventListener("click", function () {
              var rec = notes[sym] || {};
              rec.checklist = rec.checklist || {};
              ["earnings", "guidance", "valuation", "news", "thesis"].forEach(function (k) {
                rec.checklist[k] = true;
              });
              notes[sym] = rec;
              writeJson("stock-daily-notes", notes);
              // Reflect in checkboxes if Manage is open
              card.querySelectorAll("[data-checklist] input").forEach(function (cb) {
                cb.checked = true;
              });
              updateReviewSummary();
              applyFilters();
            });
          }

          if (bumpBtn) {
            bumpBtn.addEventListener("click", function () {
              var rec = notes[sym] || {};
              var current = rec.revisit ? new Date(rec.revisit + "T00:00:00") : new Date();
              current.setDate(current.getDate() + 1);
              var iso = current.toISOString().slice(0, 10);
              rec.revisit = iso;
              notes[sym] = rec;
              writeJson("stock-daily-notes", notes);
              var input = card.querySelector("[data-revisit]");
              if (input) input.value = iso;
              renderRevisitDueToday();
              applyFilters();
            });
          }
        });
      }

      function setupPostEarnings() {
        var STORAGE_KEY = "stock-daily-post-earnings";
        var state;
        try { state = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}"); } catch (e) { state = {}; }
        function persist() {
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
        }
        function statusOf(rec) {
          if (!rec) return "";
          var parts = [];
          if (rec.eps) parts.push("EPS " + rec.eps);
          if (rec.rev) parts.push("Rev " + rec.rev);
          if (rec.guide) parts.push("Guide " + rec.guide);
          return parts.join(" / ");
        }
        function updateScoreboard(sym) {
          var row = document.querySelector("[data-pe-score-row=\"" + sym + "\"]");
          if (!row) return;
          var rec = state[sym] || {};
          ["eps", "rev", "guide"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (cell) cell.textContent = rec[field] || "N/A";
          });
          ["eps_surprise", "rev_surprise"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (!cell) return;
            var value = numberOrNull(rec[field]);
            cell.textContent = value == null ? "N/A" : formattedPct(value);
            cell.classList.remove("change-pos", "change-neg", "change-flat");
            cell.classList.add("change-" + signClass(value));
          });
          var review = row.querySelector("[data-pe-score-field=\"review\"]");
          if (review) {
            var done = ["eps", "rev", "guide"].filter(function (field) { return !!rec[field]; }).length;
            review.textContent = done >= 3 ? "Reviewed" : done > 0 ? "Partial" : "Not reviewed";
            review.classList.remove("done", "partial");
            if (done >= 3) review.classList.add("done");
            else if (done > 0) review.classList.add("partial");
          }
        }
        cards.forEach(function (card) {
          var details = card.querySelector("[data-post-earnings]");
          var sym = details ? details.dataset.postEarnings : symbol(card);
          var rec = state[sym] || {};
          updateScoreboard(sym);
          if (!details) return;
          var statusEl = details.querySelector("[data-pe-status]");
          if (statusEl) statusEl.textContent = statusOf(rec);

          // Buttons (eps / rev / guide)
          var buttonGroups = details.querySelectorAll("[data-pe-field]");
          buttonGroups.forEach(function (group) {
            var field = group.dataset.peField;
            var buttons = group.querySelectorAll("button[data-pe-value]");
            buttons.forEach(function (btn) {
              var val = btn.dataset.peValue;
              btn.setAttribute("aria-pressed", rec[field] === val ? "true" : "false");
              btn.addEventListener("click", function () {
                rec = state[sym] || {};
                rec[field] = rec[field] === val ? null : val;
                state[sym] = rec;
                persist();
                buttons.forEach(function (b) {
                  b.setAttribute("aria-pressed", rec[field] === b.dataset.peValue ? "true" : "false");
                });
                if (statusEl) statusEl.textContent = statusOf(rec);
                updateScoreboard(sym);
              });
            });
          });

          // Textareas (conclusion / next_step)
          var textareas = details.querySelectorAll("textarea[data-pe-field]");
          textareas.forEach(function (ta) {
            var field = ta.dataset.peField;
            ta.value = (rec[field] || "");
            ta.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = ta.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });

          var inputs = details.querySelectorAll("input[data-pe-field]");
          inputs.forEach(function (input) {
            var field = input.dataset.peField;
            input.value = (rec[field] || "");
            input.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = input.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });
        });
      }

      function setupWatchlistMode() {
        var btn = document.getElementById("watchlist-mode-toggle");
        if (!btn) return;
        var STORAGE_KEY = "stock-daily-watchlist-mode";
        var active;
        try { active = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) { active = false; }
        function apply() {
          document.body.classList.toggle("watchlist-mode", active);
          btn.setAttribute("aria-pressed", active ? "true" : "false");
          btn.textContent = active ? "Exit watchlist" : "Watchlist only";
          // Force-open user-tools details for pinned cards in watchlist mode
          if (active) {
            cards.forEach(function (card) {
              if (card.classList.contains("is-pinned")) {
                var d = card.querySelector(".user-tools-details");
                if (d) d.open = true;
              }
            });
          }
          applyFilters();
        }
        btn.addEventListener("click", function () {
          active = !active;
          try { localStorage.setItem(STORAGE_KEY, active ? "1" : "0"); } catch (e) {}
          apply();
        });
        apply();
      }

      function cardSnapshot(card) {
        var s = symbol(card);
        var noteState = notes[s] || {};
        return {
          symbol: s,
          state: card.dataset.state || "",
          earningsDays: numberOrNull(card.dataset.earningsDays),
          valuationRisk: valuationRisk(card),
          rsi: numberOrNull(card.dataset.rsi),
          topNews: (card.dataset.topNewsSignatures || "").split("|").filter(Boolean),
          tag: tags[s] || "",
          thesis: thesis[s] || "",
          note: (noteState.note || "").trim(),
          revisit: noteState.revisit || "",
          review: reviewState(card),
          pinned: isPinned(card),
        };
      }

      function currentSnapshot() {
        var tickers = {};
        cards.forEach(function (card) { tickers[symbol(card)] = cardSnapshot(card); });
        return { date: reportDate, tickers: tickers };
      }

      function previousSnapshot(snapshots) {
        return Object.keys(snapshots)
          .filter(function (dateKey) { return dateKey < reportDate; })
          .sort()
          .map(function (dateKey) { return snapshots[dateKey]; })
          .pop() || null;
      }

      function persistAndRenderChanges() {
        var key = "stock-daily-report-snapshots";
        var snapshots = readJson(key, {});
        var prev = previousSnapshot(snapshots);
        var current = currentSnapshot();
        renderChanges(prev, current);
        snapshots[reportDate] = current;
        Object.keys(snapshots).sort().slice(0, -10).forEach(function (dateKey) { delete snapshots[dateKey]; });
        writeJson(key, snapshots);
      }

      function renderChanges(prev, current) {
        var body = document.getElementById("changes-body");
        if (!body) return;
        if (!prev) {
          body.innerHTML = "<div class=\"section-empty\">No previous browser snapshot yet. This report has now been saved as the baseline.</div>";
          return;
        }
        var changes = [];
        Object.keys(current.tickers).sort().forEach(function (s) {
          var now = current.tickers[s];
          var before = prev.tickers[s] || {};
          if (now.state === "hot" && before.state !== "hot") {
            changes.push(changeCard(s, "New hot ticker", "State moved to hot."));
          }
          var newTopNews = now.topNews.filter(function (newsKey) { return (before.topNews || []).indexOf(newsKey) < 0; });
          if (newTopNews.length) {
            changes.push(changeCard(s, "New top news", newTopNews.length + " new top-tier headline(s)."));
          }
          if (now.earningsDays != null && before.earningsDays != null && now.earningsDays >= 0 && now.earningsDays < before.earningsDays) {
            changes.push(changeCard(s, "Earnings moved closer", earningsText(now.earningsDays) + " from " + earningsText(before.earningsDays) + "."));
          }
          if (now.valuationRisk === "Extreme" && before.valuationRisk !== "Extreme") {
            changes.push(changeCard(s, "Valuation moved extreme", "Risk bucket is now Extreme."));
          }
          if (now.rsi != null && now.rsi >= 70 && (before.rsi == null || before.rsi < 70)) {
            changes.push(changeCard(s, "RSI moved overbought", "RSI 14 is now " + now.rsi.toFixed(1) + "."));
          }
          if (now.rsi != null && now.rsi <= 30 && (before.rsi == null || before.rsi > 30)) {
            changes.push(changeCard(s, "RSI moved oversold", "RSI 14 is now " + now.rsi.toFixed(1) + "."));
          }
          if (now.tag && now.tag !== before.tag) {
            changes.push(changeCard(s, "New tag", now.tag + "."));
          }
          if (now.thesis && now.thesis !== before.thesis) {
            changes.push(changeCard(s, "Thesis state changed", now.thesis + "."));
          }
          if (now.note && now.note !== before.note) {
            changes.push(changeCard(s, "New note", (now.note.length > 80 ? now.note.slice(0, 77) + "..." : now.note) + "."));
          }
          if (now.review !== before.review && now.review === "reviewed") {
            changes.push(changeCard(s, "Review completed", reviewLabel(now.review) + "."));
          }
        });
        if (!changes.length) {
          body.innerHTML = "<div class=\"section-empty\">No material changes versus " + escapeHtml(prev.date || "previous report") + ".</div>";
          return;
        }
        body.innerHTML = changes.slice(0, 12).join("");
      }

      function changeCard(symbolText, title, detail) {
        return "<a class=\"change-item\" href=\"#ticker-" + symbolText.toLowerCase() + "\"><strong>" + escapeHtml(symbolText + ": " + title) + "</strong><span>" + escapeHtml(detail) + "</span></a>";
      }

      function download(name, text, type, statusText) {
        var blob = new Blob([text], { type: type || "text/plain;charset=utf-8" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        var status = document.getElementById("export-status");
        if (status && statusText) status.textContent = statusText;
      }

      function exportWatchlist() {
        var lines = cards.map(function (card) {
          var s = symbol(card);
          return [s, card.dataset.state, "earnings " + earningsText(card.dataset.earningsDays), reviewLabel(reviewState(card)), "tag " + (tags[s] || "None")].join(" | ");
        });
        download("watchlist-{{ report.report_date.isoformat() }}.txt", lines.join("\n"), "text/plain;charset=utf-8", "Exported watchlist TXT: " + lines.length + " tickers - fields ticker/state/earnings/review/tag");
      }

      function exportNotes() {
        var noteCount = Object.keys(notes).filter(function (key) { return notes[key] && (notes[key].note || notes[key].revisit); }).length;
        download("notes-{{ report.report_date.isoformat() }}.json", JSON.stringify(notes, null, 2), "application/json;charset=utf-8", "Exported notes JSON: " + noteCount + " saved ticker notes/revisit dates");
      }

      function exportEarnings() {
        var rows = cards
          .filter(function (card) { return numberOrNull(card.dataset.earningsDays) != null; })
          .sort(function (a, b) { return sortNumberAsc(a.dataset.earningsDays, b.dataset.earningsDays, symbol(a), symbol(b)); })
          .map(function (card) { return { ticker: symbol(card), company: card.dataset.company, when: earningsText(card.dataset.earningsDays) }; });
        download("earnings-{{ report.report_date.isoformat() }}.json", JSON.stringify(rows, null, 2), "application/json;charset=utf-8", "Exported earnings JSON: " + rows.length + " dated tickers");
      }

      function exportCompare() {
        var rows = selectedCompare().map(function (card) {
          return {
            ticker: symbol(card),
            state: card.dataset.state || "",
            next_earnings: earningsText(card.dataset.earningsDays),
            top_watch_item: topWatch(card),
            valuation_risk: valuationRisk(card),
            recent_top_news_count: Number(card.dataset.topNewsCount || 0),
            user_tag: tagFor(card),
            thesis_state: thesisState(card),
            premarket_change: numberOrNull(card.dataset.premarketChange),
            gap_percent: numberOrNull(card.dataset.gapPct),
            volume_vs_20d: numberOrNull(card.dataset.volumeX),
            atr_percent: numberOrNull(card.dataset.atrPct),
            eps_growth: numberOrNull(card.dataset.epsGrowth),
            fy1_eps_revision_30d: numberOrNull(card.dataset.epsRev30d),
            position_status: card.dataset.positionStatus || "watchlist",
            portfolio_weight: numberOrNull(card.dataset.positionWeight),
            book_impact: numberOrNull(card.dataset.bookImpact),
            market_cap: numberOrNull(card.dataset.marketCap),
            trailing_pe: numberOrNull(card.dataset.trailingPe),
            forward_pe: numberOrNull(card.dataset.forwardPe),
            rsi_14: numberOrNull(card.dataset.rsi),
            watch: card.dataset.watch || "",
            headlines: Number(card.dataset.newsCount || 0),
          };
        });
        download("compare-{{ report.report_date.isoformat() }}.json", JSON.stringify(rows, null, 2), "application/json;charset=utf-8", "Exported compare JSON: " + rows.length + " selected tickers");
      }

      [search, focusFilter, stateFilter, earningsFilter, rsiFilter, topicFilter, sectorFilter, riskFilter].forEach(function (el) {
        if (!el) return;
        el.addEventListener(el === search ? "input" : "change", applyFilters);
      });
      if (search) {
        search.addEventListener("keydown", function (event) {
          if (event.key === "Enter") jumpToSearchResult();
        });
      }
      var exportWatchlistBtn = document.getElementById("export-watchlist");
      var exportNotesBtn = document.getElementById("export-notes");
      var exportEarningsBtn = document.getElementById("export-earnings");
      if (exportWatchlistBtn) exportWatchlistBtn.addEventListener("click", exportWatchlist);
      if (exportNotesBtn) exportNotesBtn.addEventListener("click", exportNotes);
      if (exportEarningsBtn) exportEarningsBtn.addEventListener("click", exportEarnings);

      setupPins();
      setupUserState();
      setupCompare();
      setupValuationSort();
      setupCountdowns();
      setupCollapsers();
      setupWorkModes();
      setupQuickActions();
      setupPostEarnings();
      setupWatchlistMode();
      renderRevisitDueToday();
      persistAndRenderChanges();
      applyFilters();
    })();
  </script>
</body>
</html>

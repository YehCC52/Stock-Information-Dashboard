            "<td class=\"num\">" + formattedPct(card.dataset.atrPct) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.epsGrowth) + "\">" + formattedPct(card.dataset.epsGrowth) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "epsRev30d", "data-eps-rev-30d")) + "\">" + formattedPct(attrValue(card, "epsRev30d", "data-eps-rev-30d")) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")) + "\">" + formattedPct(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")) + "\">" + formattedPct(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")) + "</td>" +
            "<td>" + escapeHtml(card.dataset.positionStatus || "watchlist") + "</td>" +
            weightCells +
            "<td>" + escapeHtml(topWatch(card)) + "</td>" +
            "<td>" + escapeHtml(valuationRisk(card)) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.rsi) + "</td>" +
            "<td class=\"num\">" + (card.dataset.topNewsCount || "0") + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.marketCap) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.forwardPe, "x") + "</td></tr>";
        }).join("");
        var headerWeightCols = hideWeightColumns ? "" : "<th class=\"num\">Weight</th><th class=\"num\">Book impact</th>";
        panel.innerHTML = "<h3>Compare mode <button id=\"export-compare\" type=\"button\" class=\"tool-button\">Export compare</button></h3>" +
          "<div class=\"compare-table-wrap\"><table><thead><tr>" +
          "<th>Ticker</th><th>State</th><th>Score</th><th>Trend</th><th class=\"num\">Daily %</th><th class=\"num\">From High</th>" +
          "<th>Next earnings</th><th>Review</th><th>User tag</th><th>Thesis</th><th>Trigger</th><th>Revisit</th>" +
          "<th class=\"num\">Premarket</th><th class=\"num\">Gap</th><th class=\"num\">Vol/20D</th><th class=\"num\">ATR %</th><th class=\"num\">EPS growth</th><th class=\"num\">EPS rev 30D</th><th class=\"num\">FY1 rev rev</th><th class=\"num\">NextQ rev rev</th><th>Position</th>" +
          headerWeightCols +
          "<th>Top watch</th><th>Valuation risk</th><th class=\"num\">RSI 14</th><th class=\"num\">Top news</th>" +
          "<th class=\"num\">Market Cap</th><th class=\"num\">Forward P/E</th>" +
          "</tr></thead><tbody>" +
          rows + "</tbody></table></div>";
        var exportBtn = document.getElementById("export-compare");
        if (exportBtn) exportBtn.addEventListener("click", exportCompare);
      }

      function earningsText(daysValue) {
        var days = numberOrNull(daysValue);
        if (days == null) return "N/A";
        if (days < 0) return Math.abs(days) + "d ago";
        if (days === 0) return "today";
        if (days === 1) return "tomorrow";
        return "in " + days + "d";
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (ch) {
          return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" })[ch];
        });
      }

      function setupValuationSort() {
        var select = document.getElementById("valuation-sort");
        var tbody = document.getElementById("valuation-rows");
        if (!select || !tbody) return;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));
        select.addEventListener("change", function () {
          rows.slice().sort(function (a, b) {
            if (select.value === "market_cap_desc") return sortNumberDesc(a.dataset.marketCap, b.dataset.marketCap, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "forward_pe_asc") return sortNumberAsc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "forward_pe_desc") return sortNumberDesc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_asc") return sortNumberAsc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_desc") return sortNumberDesc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "earnings_soon") return sortNumberAsc(a.dataset.earningsDays, b.dataset.earningsDays, a.dataset.symbol, b.dataset.symbol);
            return (a.dataset.symbol || "").localeCompare(b.dataset.symbol || "");
          }).forEach(function (row) { tbody.appendChild(row); });
        });
      }

      function sortNumberAsc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return an - bn || as.localeCompare(bs);
      }

      function sortNumberDesc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return bn - an || as.localeCompare(bs);
      }

      function setupCountdowns() {
        var today = new Date("{{ report.report_date.isoformat() }}T00:00:00");
        cards.forEach(function (card) {
          var el = card.querySelector("[data-countdown]");
          if (!el) return;
          var target = new Date(el.dataset.countdown + "T00:00:00");
          var days = Math.round((target - today) / 86400000);
          var session = { before_market: "before open", after_market: "after close", during_market: "during market", unknown: "time TBD" }[el.dataset.timeOfDay] || el.dataset.timeOfDay;
          el.textContent = days <= 0 ? "Earnings today | " + session : "Earnings in " + days + "d | " + session;
        });
      }

      function setupCollapsers() {
        var newsBtn = document.getElementById("toggle-news");
        if (newsBtn) {
          newsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".news-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            newsBtn.textContent = hidden ? "Show picks" : "Show backlog";
          });
        }
        var alertsBtn = document.getElementById("toggle-alerts");
        if (alertsBtn) {
          alertsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".alert-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            alertsBtn.textContent = hidden ? "Show top 6" : "Show all";
          });
        }
        var valuationBtn = document.getElementById("toggle-valuation");
        var valuationBody = document.getElementById("valuation-body");
        if (valuationBtn && valuationBody) {
          valuationBtn.addEventListener("click", function () {
            var hidden = valuationBody.classList.toggle("is-hidden");
            valuationBtn.textContent = hidden ? "Expand" : "Collapse";
            valuationBtn.setAttribute("aria-expanded", hidden ? "false" : "true");
          });
        }
        if (toggleQuiet) {
          toggleQuiet.addEventListener("click", function () {
            showQuiet = !showQuiet;
            toggleQuiet.textContent = showQuiet ? "Hide Quiet" : "Show Quiet";
            applyFilters();
          });
        }
      }

      function setupWorkModes() {
        if (!modeButtons.length) return;
        modeButtons.forEach(function (button) {
          button.addEventListener("click", function () {
            setWorkMode(button.dataset.mode || "overview");
          });
        });
        setWorkMode("overview");
      }

      function setWorkMode(mode) {
        currentMode = mode;
        document.body.dataset.workMode = mode;
        modeButtons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.dataset.mode === mode ? "true" : "false");
        });
        var hints = {
          overview: "Full dashboard view",
          review: "Hot catalysts and earnings today/tomorrow, sorted for review",
          prep: "Earnings within 7 days, with notes and revisit fields open",
        };
        if (modeHint) modeHint.textContent = hints[mode] || hints.overview;
        applyFilters();
      }

      function setupQuickActions() {
        cards.forEach(function (card) {
          var sym = symbol(card);
          var doneBtn = card.querySelector("[data-quick-done]");
          var bumpBtn = card.querySelector("[data-quick-revisit]");

          if (doneBtn) {
            doneBtn.addEventListener("click", function () {
              checklist[sym] = ["earnings", "guidance", "valuation", "news", "thesis"];
              writeJson("stock-daily-draft-checklist", checklist);
              // Reflect in checkboxes if Manage is open
              card.querySelectorAll("[data-checklist] input").forEach(function (cb) {
                cb.checked = true;
              });
              paintReviewStatus(card);
              updateReviewSummary();
              applyFilters();
            });
          }

          if (bumpBtn) {
            bumpBtn.addEventListener("click", function () {
              var rec = notes[sym] || {};
              var current = rec.revisit ? new Date(rec.revisit + "T00:00:00") : new Date();
              current.setDate(current.getDate() + 1);
              var iso = current.toISOString().slice(0, 10);
              rec.revisit = iso;
              notes[sym] = rec;
              writeJson("stock-daily-draft-notes", notes);
              var input = card.querySelector("[data-revisit]");
              if (input) input.value = iso;
              renderRevisitDueToday();
              applyFilters();
            });
          }
        });
      }

      function setupPostEarnings() {
        var STORAGE_KEY = "stock-daily-draft-post-earnings";
        var state = {};
        Object.keys(tickerState).forEach(function (sym) {
          state[sym] = Object.assign({}, (tickerState[sym] && tickerState[sym].post_earnings_review) || {});
        });
        try { state = Object.assign(state, JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}")); } catch (e) {}
        window.postEarningsState = state;
        function persist() {
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
        }
        function statusOf(rec) {
          if (!rec) return "";
          var parts = [];
          if (rec.eps) parts.push("EPS " + rec.eps);
          if (rec.rev) parts.push("Rev " + rec.rev);
          if (rec.guide) parts.push("Guide " + rec.guide);
          return parts.join(" / ");
        }
        function updateScoreboard(sym) {
          var row = document.querySelector("[data-pe-score-row=\"" + sym + "\"]");
          if (!row) return;
          var rec = state[sym] || {};
          ["eps", "rev", "guide"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (cell) cell.textContent = rec[field] || cell.dataset.default || "N/A";
          });
          ["eps_surprise", "rev_surprise", "fy1_eps_revision_after", "fy1_revenue_revision_after"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (!cell) return;
            var value = numberOrNull(rec[field]);
            if (value == null) value = numberOrNull(cell.dataset.default);
            cell.textContent = value == null ? "N/A" : formattedPct(value);
            cell.classList.remove("change-pos", "change-neg", "change-flat");
            cell.classList.add("change-" + signClass(value));
          });
          var review = row.querySelector("[data-pe-score-field=\"review\"]");
          if (review) {
            var fields = ["eps", "rev", "guide", "eps_surprise", "rev_surprise", "fy1_eps_revision_after", "fy1_revenue_revision_after"];
            var done = fields.filter(function (field) {
              var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
              return !!rec[field] || !!(cell && cell.dataset.default);
            }).length;
            review.textContent = done >= 5 ? "Reviewed" : done > 0 ? done + "/7" : "Not reviewed";
            review.classList.remove("done", "partial");
            if (done >= 5) review.classList.add("done");
            else if (done > 0) review.classList.add("partial");
          }
        }
        cards.forEach(function (card) {
          var details = card.querySelector("[data-post-earnings]");
          var sym = details ? details.dataset.postEarnings : symbol(card);
          var rec = state[sym] || {};
          updateScoreboard(sym);
          if (!details) return;
          var statusEl = details.querySelector("[data-pe-status]");
          if (statusEl) statusEl.textContent = statusOf(rec);

          // Buttons (eps / rev / guide)
          var buttonGroups = details.querySelectorAll("[data-pe-field]");
          buttonGroups.forEach(function (group) {
            var field = group.dataset.peField;
            var buttons = group.querySelectorAll("button[data-pe-value]");
            buttons.forEach(function (btn) {
              var val = btn.dataset.peValue;
              btn.setAttribute("aria-pressed", rec[field] === val ? "true" : "false");
              btn.addEventListener("click", function () {
                rec = state[sym] || {};
                rec[field] = rec[field] === val ? null : val;
                state[sym] = rec;
                persist();
                buttons.forEach(function (b) {
                  b.setAttribute("aria-pressed", rec[field] === b.dataset.peValue ? "true" : "false");
                });
                if (statusEl) statusEl.textContent = statusOf(rec);
                updateScoreboard(sym);
              });
            });
          });

          // Textareas (conclusion / next_step)
          var textareas = details.querySelectorAll("textarea[data-pe-field]");
          textareas.forEach(function (ta) {
            var field = ta.dataset.peField;
            ta.value = (rec[field] || "");
            ta.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = ta.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });

          var inputs = details.querySelectorAll("input[data-pe-field]");
          inputs.forEach(function (input) {
            var field = input.dataset.peField;
            input.value = (rec[field] || "");
            input.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = input.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });
        });
      }

      function enhanceFocusFromLocalState() {
        var reviewList = document.querySelector("#research-queue .focus-column:first-child .focus-list");
        if (!reviewList) return;
        cards.forEach(function (card) {
          var state = thesisState(card);
          if (state !== "weakening" && state !== "broken") return;
          var sym = symbol(card);
          if (reviewList.querySelector("[data-local-focus=\"" + sym + "\"]")) return;
          var li = document.createElement("li");
          li.setAttribute("data-local-focus", sym);
          var trigger = thesisTrigger(card);
          var reason = "thesis " + state + (trigger !== "None" ? " | trigger: " + trigger : "");
          li.innerHTML = "<span class=\"focus-rank\">!</span><span><a href=\"#" + card.id + "\">" + escapeHtml(sym) + "</a><span class=\"focus-reason\">" + escapeHtml(reason) + "</span></span>";
          reviewList.insertBefore(li, reviewList.firstChild);
        });
      }

      function setupWatchlistMode() {
        var btn = document.getElementById("watchlist-mode-toggle");
        if (!btn) return;
        var STORAGE_KEY = "stock-daily-watchlist-mode";
        var active;
        try { active = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) { active = false; }
        function apply() {
          document.body.classList.toggle("watchlist-mode", active);
          btn.setAttribute("aria-pressed", active ? "true" : "false");
          btn.textContent = active ? "Exit watchlist" : "Watchlist only";
          // Force-open user-tools details for pinned cards in watchlist mode
          if (active) {
            cards.forEach(function (card) {
              if (card.classList.contains("is-pinned")) {
                var d = card.querySelector(".user-tools-details");
                if (d) d.open = true;
              }
            });
          }
          applyFilters();
        }
        btn.addEventListener("click", function () {
          active = !active;
          try { localStorage.setItem(STORAGE_KEY, active ? "1" : "0"); } catch (e) {}
          apply();
        });
        apply();
      }

      function cardSnapshot(card) {
        var s = symbol(card);
        var noteState = notes[s] || {};
        return {
          symbol: s,
          state: card.dataset.state || "",
          earningsDays: numberOrNull(card.dataset.earningsDays),
          valuationRisk: valuationRisk(card),
          rsi: numberOrNull(card.dataset.rsi),
          topNews: (card.dataset.topNewsSignatures || "").split("|").filter(Boolean),
          tag: tags[s] || "",
          thesis: thesis[s] || "",
          thesisTrigger: thesisTriggers[s] || "",
          note: (noteState.note || "").trim(),
          revisit: noteState.revisit || "",
          review: reviewState(card),
          pinned: isPinned(card),
        };
      }

      function currentSnapshot() {
        var tickers = {};
        cards.forEach(function (card) { tickers[symbol(card)] = cardSnapshot(card); });
        return { date: reportDate, tickers: tickers };
      }

      function previousSnapshot(snapshots) {
        return Object.keys(snapshots)
          .filter(function (dateKey) { return dateKey < reportDate; })
          .sort()
          .map(function (dateKey) { return snapshots[dateKey]; })
          .pop() || null;
      }

      function persistAndRenderChanges() {
        return;
      }

      function renderChanges(prev, current) {
        var body = document.getElementById("changes-body");
        if (!body) return;
        if (!prev) {
          body.innerHTML = "<div class=\"section-empty\">No previous browser snapshot yet. This report has now been saved as the baseline.</div>";
          return;
        }
        var changes = [];
        Object.keys(current.tickers).sort().forEach(function (s) {
          var now = current.tickers[s];
          var before = prev.tickers[s] || {};
          if (now.state === "hot" && before.state !== "hot") {
            changes.push(changeCard(s, "New hot ticker", "State moved to hot."));
          }
          var newTopNews = now.topNews.filter(function (newsKey) { return (before.topNews || []).indexOf(newsKey) < 0; });
          if (newTopNews.length) {
            changes.push(changeCard(s, "New top news", newTopNews.length + " new top-tier headline(s)."));
          }
          if (now.earningsDays != null && before.earningsDays != null && now.earningsDays >= 0 && now.earningsDays < before.earningsDays) {
            changes.push(changeCard(s, "Earnings moved closer", earningsText(now.earningsDays) + " from " + earningsText(before.earningsDays) + "."));
          }
          if (now.valuationRisk === "Extreme" && before.valuationRisk !== "Extreme") {
            changes.push(changeCard(s, "Valuation moved extreme", "Risk bucket is now Extreme."));
          }
          if (now.rsi != null && now.rsi >= 70 && (before.rsi == null || before.rsi < 70)) {
            changes.push(changeCard(s, "RSI moved overbought", "RSI 14 is now " + now.rsi.toFixed(1) + "."));
          }
          if (now.rsi != null && now.rsi <= 30 && (before.rsi == null || before.rsi > 30)) {
            changes.push(changeCard(s, "RSI moved oversold", "RSI 14 is now " + now.rsi.toFixed(1) + "."));
          }
          if (now.tag && now.tag !== before.tag) {
            changes.push(changeCard(s, "New tag", now.tag + "."));
          }
          if (now.thesis && now.thesis !== before.thesis) {
            changes.push(changeCard(s, "Thesis state changed", now.thesis + "."));
          }
          if (now.thesisTrigger && now.thesisTrigger !== before.thesisTrigger) {
            changes.push(changeCard(s, "Thesis trigger changed", now.thesisTrigger + "."));
          }
          if (now.note && now.note !== before.note) {
            changes.push(changeCard(s, "New note", (now.note.length > 80 ? now.note.slice(0, 77) + "..." : now.note) + "."));
          }
          if (now.review !== before.review && now.review === "reviewed") {
            changes.push(changeCard(s, "Review completed", reviewLabel(now.review) + "."));
          }
        });
        if (!changes.length) {
          body.innerHTML = "<div class=\"section-empty\">No material changes versus " + escapeHtml(prev.date || "previous report") + ".</div>";
          return;
        }
        body.innerHTML = changes.slice(0, 12).join("");
      }

      function changeCard(symbolText, title, detail) {
        return "<a class=\"change-item\" href=\"#ticker-" + symbolText.toLowerCase() + "\"><strong>" + escapeHtml(symbolText + ": " + title) + "</strong><span>" + escapeHtml(detail) + "</span></a>";
      }

      function download(name, text, type, statusText) {
        var blob = new Blob([text], { type: type || "text/plain;charset=utf-8" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        var status = document.getElementById("export-status");
        if (status && statusText) status.textContent = statusText;
      }

      function exportWatchlist() {
        var lines = cards.map(function (card) {
          var s = symbol(card);
          return [s, card.dataset.state, "earnings " + earningsText(card.dataset.earningsDays), reviewLabel(reviewState(card)), "tag " + (tags[s] || "None")].join(" | ");
        });
        download("watchlist-{{ report.report_date.isoformat() }}.txt", lines.join("\n"), "text/plain;charset=utf-8", "Exported watchlist TXT: " + lines.length + " tickers - fields ticker/state/earnings/review/tag");
      }

      function exportResearchState() {
        var payload = {
          version: 1,
          exported_at: new Date().toISOString(),
          tickers: {}
        };
        cards.forEach(function (card) {
          var sym = symbol(card);
          var base = tickerState[sym] || {};
          var plan = plans[sym] || {};
          payload.tickers[sym] = {
            tag: tags[sym] || "",
            thesis_state: thesis[sym] || "",
            thesis_trigger: thesisTriggers[sym] || "",
            thesis_text: thesisTextFor(sym),
            note: (notes[sym] && notes[sym].note) || "",
            checklist: checklist[sym] || [],
            revisit_date: (notes[sym] && notes[sym].revisit) || "",
            pinned: isPinned(card),
            review_status: reviewState(card),
            last_reviewed_at: base.last_reviewed_at || "",
            bull_case: plan.bull_case || "",
            bear_case: plan.bear_case || "",
            entry_plan: plan.entry_plan || "",
            add_zone: plan.add_zone || "",
            reduce_zone: plan.reduce_zone || "",
            stop_loss: plan.stop_loss || "",
            earnings_questions: (earningsQuestions[sym] || []).filter(function (q) { return (q || "").trim(); }),
            position: cleanPosition(positions[sym] || positionStateFor(card)),
            post_earnings_review: (window.postEarningsState && window.postEarningsState[sym]) || {}
          };
        });
        download(
          "research-state-{{ report.report_date.isoformat() }}.json",
          JSON.stringify(payload, null, 2),
          "application/json;charset=utf-8",
          "Exported research JSON: import it with --import-research-state"
        );
      }

      function exportEarnings() {
        var rows = cards
          .filter(function (card) { return numberOrNull(card.dataset.earningsDays) != null; })
          .sort(function (a, b) { return sortNumberAsc(a.dataset.earningsDays, b.dataset.earningsDays, symbol(a), symbol(b)); })
          .map(function (card) { return { ticker: symbol(card), company: card.dataset.company, when: earningsText(card.dataset.earningsDays) }; });
        download("earnings-{{ report.report_date.isoformat() }}.json", JSON.stringify(rows, null, 2), "application/json;charset=utf-8", "Exported earnings JSON: " + rows.length + " dated tickers");
      }

      function exportCompare() {
        var rows = selectedCompare().map(function (card) {
          return {
            ticker: symbol(card),
            state: card.dataset.state || "",
            next_earnings: earningsText(card.dataset.earningsDays),
            top_watch_item: topWatch(card),
            valuation_risk: valuationRisk(card),
            recent_top_news_count: Number(card.dataset.topNewsCount || 0),
            user_tag: tagFor(card),
            thesis_state: thesisState(card),
            thesis_trigger: thesisTrigger(card),
            premarket_change: numberOrNull(card.dataset.premarketChange),
            gap_percent: numberOrNull(card.dataset.gapPct),
            volume_vs_20d: numberOrNull(card.dataset.volumeX),
            atr_percent: numberOrNull(card.dataset.atrPct),
            eps_growth: numberOrNull(card.dataset.epsGrowth),
            fy1_eps_revision_30d: numberOrNull(attrValue(card, "epsRev30d", "data-eps-rev-30d")),
            fy1_revenue_revision_30d: numberOrNull(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")),
            next_q_revenue_revision_30d: numberOrNull(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")),
            position_status: card.dataset.positionStatus || "watchlist",
            portfolio_weight: numberOrNull(card.dataset.positionWeight),
            book_impact: numberOrNull(card.dataset.bookImpact),
            market_cap: numberOrNull(card.dataset.marketCap),
            trailing_pe: numberOrNull(card.dataset.trailingPe),
            forward_pe: numberOrNull(card.dataset.forwardPe),
            rsi_14: numberOrNull(card.dataset.rsi),
            watch: card.dataset.watch || "",
            headlines: Number(card.dataset.newsCount || 0),
          };
        });
        download("compare-{{ report.report_date.isoformat() }}.json", JSON.stringify(rows, null, 2), "application/json;charset=utf-8", "Exported compare JSON: " + rows.length + " selected tickers");
      }

      function lastReviewedText(value) {
        if (!value) return "";
        var text = String(value);
        return text.length >= 10 ? text.slice(0, 10) : text;
      }

      function renderCompare() {
        var panel = document.getElementById("compare-panel");
        if (!panel) return;
        var selected = selectedCompare();
        if (!selected.length) {
          panel.classList.add("is-hidden");
          panel.innerHTML = "";
          return;
        }
        panel.classList.remove("is-hidden");
        var hideWeightColumns = selected.every(function (c) { return !c.dataset.positionWeight; });
        var rows = selected.map(function (card) {
          var sym = symbol(card);
          var revisions = [
            "EPS " + formattedPct(attrValue(card, "epsRev30d", "data-eps-rev-30d")),
            "FY1 rev " + formattedPct(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")),
            "NextQ rev " + formattedPct(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d"))
          ].join(" / ");
          var weightCells = hideWeightColumns ? "" : ("<td class=\"num\">" + formattedPct(card.dataset.positionWeight) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.bookImpact) + "\">" + formattedPct(card.dataset.bookImpact) + "</td>");
          return "<tr><td><a href=\"#" + card.id + "\">" + sym + "</a></td>" +
            "<td>" + escapeHtml(card.dataset.state || "") + "</td>" +
            "<td>" + escapeHtml(thesisState(card)) + "</td>" +
            "<td>" + escapeHtml(thesisTrigger(card)) + "</td>" +
            "<td>" + escapeHtml(reviewStatusFor(sym)) + "</td>" +
            "<td>" + escapeHtml(lastReviewedText(card.dataset.lastReviewedAt)) + "</td>" +
            "<td>" + earningsText(card.dataset.earningsDays) + "</td>" +
            "<td class=\"num\">" + formattedPct(card.dataset.newsBurst, false) + "</td>" +
            "<td class=\"num\">" + (card.dataset.topNewsCount || "0") + "</td>" +
            "<td>" + escapeHtml(valuationRisk(card)) + "</td>" +
            "<td>" + escapeHtml(revisions) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.attentionScore) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.premarketChange) + "\">" + formattedPct(card.dataset.premarketChange) + "</td>" +
            "<td>" + escapeHtml(card.dataset.positionStatus || "watchlist") + "</td>" +
            weightCells +
            "<td>" + escapeHtml(tagFor(card)) + "</td>" +
            "<td>" + escapeHtml(revisitFor(sym)) + "</td></tr>";
        }).join("");
        var headerWeightCols = hideWeightColumns ? "" : "<th class=\"num\">Weight</th><th class=\"num\">Book impact</th>";
        panel.innerHTML = "<h3>Compare mode <button id=\"export-compare\" type=\"button\" class=\"tool-button\">Export compare</button></h3>" +
          "<div class=\"compare-table-wrap\"><table><thead><tr>" +
          "<th>Ticker</th><th>State</th><th>Thesis</th><th>Trigger</th><th>Review</th><th>Last reviewed</th>" +
          "<th>Next earnings</th><th class=\"num\">News burst</th><th class=\"num\">Top news</th><th>Valuation risk</th><th>30D revisions</th>" +
          "<th class=\"num\">Attention</th><th class=\"num\">Premarket</th><th>Position</th>" +
          headerWeightCols + "<th>User tag</th><th>Revisit</th>" +
          "</tr></thead><tbody>" +
          rows + "</tbody></table></div>";
        var exportBtn = document.getElementById("export-compare");
        if (exportBtn) exportBtn.addEventListener("click", exportCompare);
      }

      function exportCompare() {
        var rows = selectedCompare().map(function (card) {
          return {
            ticker: symbol(card),
            state: card.dataset.state || "",
            thesis_state: thesisState(card),
            thesis_trigger: thesisTrigger(card),
            review_status: reviewStatusFor(symbol(card)),
            last_reviewed_at: card.dataset.lastReviewedAt || "",
            next_earnings: earningsText(card.dataset.earningsDays),
            news_burst_score: numberOrNull(card.dataset.newsBurst),
            recent_top_news_count: Number(card.dataset.topNewsCount || 0),
            valuation_risk: valuationRisk(card),
            attention_score: numberOrNull(card.dataset.attentionScore),
            fy1_eps_revision_30d: numberOrNull(attrValue(card, "epsRev30d", "data-eps-rev-30d")),
            fy1_revenue_revision_30d: numberOrNull(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")),
            next_q_revenue_revision_30d: numberOrNull(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")),
            premarket_change: numberOrNull(card.dataset.premarketChange),
            position_status: card.dataset.positionStatus || "watchlist",
            portfolio_weight: numberOrNull(card.dataset.positionWeight),
            book_impact: numberOrNull(card.dataset.bookImpact),
            shares: numberOrNull(card.dataset.positionShares),
            avg_cost: numberOrNull(card.dataset.positionAvgCost),
            position_size: numberOrNull(card.dataset.positionSize),
            user_tag: tagFor(card),
            revisit_date: revisitFor(symbol(card)),
          };
        });
        download("compare-{{ report.report_date.isoformat() }}.json", JSON.stringify(rows, null, 2), "application/json;charset=utf-8", "Exported compare JSON: " + rows.length + " selected tickers");
      }

      [search, focusFilter, stateFilter, scoreFilter, earningsFilter, rsiFilter, topicFilter, sectorFilter, clusterFilter, riskFilter].forEach(function (el) {
        if (!el) return;
        el.addEventListener(el === search ? "input" : "change", applyFilters);
      });
      if (search) {
        search.addEventListener("keydown", function (event) {
          if (event.key === "Enter") jumpToSearchResult();
        });
      }
      var exportWatchlistBtn = document.getElementById("export-watchlist");
      var exportResearchBtn = document.getElementById("export-research");
      var exportEarningsBtn = document.getElementById("export-earnings");
      if (exportWatchlistBtn) exportWatchlistBtn.addEventListener("click", exportWatchlist);
      if (exportResearchBtn) exportResearchBtn.addEventListener("click", exportResearchState);
      if (exportEarningsBtn) exportEarningsBtn.addEventListener("click", exportEarnings);

      setupPins();
      setupUserState();
      setupCompare();
      setupValuationSort();
      setupCountdowns();
      setupCollapsers();
      setupWorkModes();
      setupQuickActions();
      setupPostEarnings();
      setupWatchlistMode();
      enhanceFocusFromLocalState();
      renderRevisitDueToday();
      applyFilters();
    })();

    (function () {
      var NEWS_READ_KEY = "stock-daily-read-news";
      var readNews = (function () {
        try { var raw = localStorage.getItem(NEWS_READ_KEY); return raw ? JSON.parse(raw) : {}; } catch (e) { return {}; }
      })();

      function saveReadNews() {
        try { localStorage.setItem(NEWS_READ_KEY, JSON.stringify(readNews)); } catch (e) {}
      }

      var items = Array.prototype.slice.call(document.querySelectorAll(".news-item[data-article-url]"));
      items.forEach(function (li) {
        var url = li.dataset.articleUrl;
        if (!url) return;
        if (readNews[url]) li.classList.add("is-read");
        var btn = li.querySelector(".news-read-btn");
        if (!btn) return;
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          var wasRead = li.classList.contains("is-read");
          if (wasRead) {
            li.classList.remove("is-read");
            delete readNews[url];
          } else {
            li.classList.add("is-read");
            readNews[url] = true;
          }
          saveReadNews();
        });
      });
    })();
  </script>
</body>
</html>

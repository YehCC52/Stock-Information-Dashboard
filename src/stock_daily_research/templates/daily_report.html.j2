    .save-status.is-local { color: var(--warning); }

    .execution-plan {
      margin: 12px 0 0;
      padding: 11px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .execution-plan-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 9px;
    }
    .execution-plan-head strong { font-size: 13px; }
    .execution-status {
      display: inline-flex;
      align-items: center;
      min-height: 22px;
      padding: 2px 8px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 12px;
      max-width: 100%;
      white-space: normal;
      text-align: center;
      overflow-wrap: anywhere;
    }
    .execution-status.ready { color: var(--good); border-color: var(--good); }
    .execution-status.watch { color: var(--warning); border-color: var(--warning); }
    .execution-status.blocked { color: var(--danger); border-color: var(--danger); }
    .execution-plan-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
    }
    .execution-metric { min-width: 0; }
    .execution-plan-secondary {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--border);
    }
    .execution-metric .label { display: block; color: var(--muted); font-size: 11px; }
    .execution-metric .value { display: block; margin-top: 2px; font-weight: 700; overflow-wrap: anywhere; }
    .execution-waiting {
      display: grid;
      gap: 5px;
      padding: 8px 0;
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
    }
    .execution-waiting-title { color: var(--text); font-size: 12px; }
    .execution-waiting-detail { color: var(--muted); font-size: 11px; line-height: 1.5; }
    .execution-watch-references {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 3px;
    }
    .execution-watch-reference {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3px 8px;
      min-width: 0;
      padding-top: 5px;
      border-top: 1px dashed var(--border);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    .execution-watch-reference .label { color: var(--muted); }
    .execution-watch-reference .value { color: var(--text); font-weight: 700; text-align: right; }
    .execution-watch-reference .distance { grid-column: 1 / -1; color: var(--muted); }
    .execution-waiting-source { color: var(--muted); font-size: 10px; overflow-wrap: anywhere; }
    .execution-gates { margin-top: 8px; }
    .execution-gates summary { color: var(--link); font-size: 12px; cursor: pointer; }
    .execution-gate-list { display: grid; gap: 5px; margin: 8px 0 0; padding: 0; list-style: none; }
    .execution-gate-list li {
      display: grid;
      grid-template-columns: 14px minmax(90px, auto) minmax(0, 1fr);
      gap: 7px;
      align-items: start;
      color: var(--muted);
      font-size: 12px;
    }
    .execution-gate-list .gate-mark { color: var(--danger); font-weight: 700; }
    .execution-gate-list .passed .gate-mark { color: var(--good); }
    .execution-gate-list .optional .gate-mark { color: var(--muted); }
    .execution-gate-list .gate-name { color: var(--text); font-weight: 600; }

    .market-reading {
      margin: 10px 0;
      padding: 8px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .market-reading-main {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 10px;
      align-items: center;
    }
    .market-reading-heading {
      display: flex;
      min-width: 0;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
    }
    .market-reading-label {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
    }
    .market-reading-summary {
      min-width: 0;
      color: var(--text);
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .market-reading-strength {
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }
    .market-reading-action {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 6px 8px;
      align-items: baseline;
      font-size: 11px;
    }
    .market-reading-status { font-weight: 800; }
    .reading-up .market-reading-status { color: var(--good); }
    .reading-down .market-reading-status { color: var(--danger); }
    .reading-mixed .market-reading-status { color: var(--warning); }
    .market-reading-invalidation {
      grid-column: 1 / -1;
      justify-self: end;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .market-reading details { margin-top: 6px; }
    .market-reading details > summary {
      color: var(--link);
      cursor: pointer;
      font-size: 11px;
    }
    .framework-evidence-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 6px;
      border-top: 1px solid var(--border-soft);
    }
    .framework-evidence-row {
      min-width: 0;
      padding: 6px 8px 6px 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .framework-evidence-row:nth-child(odd) {
      padding-right: 10px;
      border-right: 1px solid var(--border-soft);
    }
    .framework-evidence-row:nth-child(even) { padding-left: 10px; }
    .framework-evidence-row strong {
      display: block;
      margin-bottom: 2px;
      color: var(--muted);
      font-size: 10px;
    }
    .framework-evidence-row span {
      display: block;
      color: var(--text);
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .framework-evidence-detail { margin-top: 2px; color: var(--muted) !important; }
    .framework-caveat { color: var(--warning) !important; }

    .price-structure { margin-top: 10px; }
    .price-structure summary { color: var(--link); cursor: pointer; font-size: 12px; }
    .price-structure-svg { display: block; width: 100%; height: auto; min-height: 130px; margin-top: 8px; }
    .price-line-close, .price-line-sma20, .price-line-sma60 {
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .price-line-close { stroke: var(--text); stroke-width: 2; }
    .price-line-sma20 { stroke: var(--info); stroke-width: 1.4; }
    .price-line-sma60 { stroke: var(--warning); stroke-width: 1.3; }
    .price-line-adam {
      fill: none;
      stroke: var(--warning);
      stroke-width: 1.5;
      stroke-dasharray: 5 4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .price-chart-scenario-divider {
      stroke: var(--border);
      stroke-width: 1;
      stroke-dasharray: 2 4;
    }
    .price-chart-scenario-label { fill: var(--warning); }

    .price-volume-bars { fill: var(--border); opacity: 0.72; }
    .price-chart-divider { stroke: var(--border); stroke-width: 1; }
    .price-level-pivot { stroke: var(--good); stroke-width: 1; stroke-dasharray: 5 4; }
    .price-level-stop { stroke: var(--danger); stroke-width: 1; stroke-dasharray: 4 4; }
    .price-chart-date { fill: var(--muted); font-size: 10px; }
    .price-chart-legend { display: flex; gap: 12px; margin-top: 5px; color: var(--muted); font-size: 11px; flex-wrap: wrap; }
    .price-chart-legend span::before { content: ""; display: inline-block; width: 12px; height: 2px; margin-right: 5px; vertical-align: middle; background: var(--text); }
    .price-chart-legend .sma20::before { background: var(--info); }
    .price-chart-legend .sma60::before { background: var(--warning); }
    .price-chart-legend .pivot::before { background: var(--good); }
    .price-chart-legend .stop::before { background: var(--danger); }
    .price-chart-legend .adam::before {
      height: 0;
      background: transparent;
      border-top: 2px dashed var(--warning);
    }

    @media (max-width: 1100px) {
      .journal-layout { grid-template-columns: 1fr; }
      .journal-form { grid-template-columns: repeat(4, minmax(0, 1fr)); padding-left: 0; padding-top: 16px; border-left: 0; border-top: 1px solid var(--border); }
      .portfolio-risk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .risk-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 760px) {
      .journal-form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .execution-plan-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .portfolio-risk-grid { grid-template-columns: 1fr; }
      .trade-fill-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .trade-fill-row .icon-button { justify-self: end; }
      .market-reading-main { grid-template-columns: 1fr; }
      .market-reading-strength { justify-self: start; }
      .framework-evidence-grid { grid-template-columns: 1fr; }
      .framework-evidence-row:nth-child(odd) {
        padding-right: 0;
        border-right: 0;
      }
      .framework-evidence-row:nth-child(even) { padding-left: 0; }

    }
    @media (max-width: 480px) {
      .journal-form { grid-template-columns: 1fr; }
      .execution-watch-references { grid-template-columns: 1fr; }
      .journal-form label, .journal-form h3, .journal-form .form-actions, .journal-form .wide { grid-column: 1; }
      .journal-headline { align-items: flex-start; }
      .execution-gate-list li { grid-template-columns: 14px minmax(0, 1fr); }
      .execution-gate-list .gate-detail { grid-column: 2; }
      .risk-kpis { grid-template-columns: 1fr; }
      .analysis-tool-meta { display: none; }
      .trade-fill-row { grid-template-columns: 1fr; }
      .trade-fill-row .icon-button { justify-self: stretch; }
      .market-reading-action { grid-template-columns: 1fr; }
      .market-reading-invalidation { white-space: normal; }

    }
    @media print {
      :root { color-scheme: light; }
      body { background: white; }
      .toc, details, .theme-toggle { display: none; }
      .section, .ticker-card, .stat { break-inside: avoid; box-shadow: none; }
      .table-wrap { max-height: none; overflow: visible; }
      /* Sector map: print every market stacked, with its title. */
      .map-market-panel { display: block; }
      .map-panel-title { display: block; }
    }
  </style>
</head>
<body>
  <main id="page-top" class="page">
    <header class="header">
      <div>
        <h1>每日股票研究</h1>
        <div class="muted">{{ report.report_date.isoformat() }} | 產生時間：{{ report.generated_at|twn_datetime|replace('Taiwan Time', '台灣時間') }}</div>
      </div>
      <div class="header-right">
        <div class="top-tools" aria-label="Dashboard tools">
          <input id="quick-search" class="search-box" type="search" placeholder="搜尋代碼或公司名稱" autocomplete="off" data-i18n="label_search">
          <button id="watchlist-mode-toggle" type="button" class="tool-button" aria-pressed="false" title="只顯示釘選的股票">只看釘選</button>
          <button id="save-to-db" type="button" class="tool-button tool-button-success" title="儲存所有變更到資料庫">💾 保存</button>
          <details class="tools-menu">
            <summary class="tool-button">匯出</summary>
            <div class="tools-menu-panel">
              <button id="export-watchlist" type="button" class="tool-button tool-button-secondary" title="TXT: ticker, state, earnings timing, tag">觀察清單 TXT</button>
              <button id="export-research" type="button" class="tool-button tool-button-primary" title="JSON: current research state for CLI import back into SQLite">研究狀態 JSON</button>
              <button id="export-earnings" type="button" class="tool-button tool-button-secondary" title="JSON: ticker, company, earnings timing">財報數據 JSON</button>
              <div id="export-status" class="export-status" aria-live="polite">可匯出觀察清單、研究狀態、財報數據</div>
            </div>
          </details>
          <div id="save-status" class="save-status is-local" aria-live="polite">&#x672C;&#x6A5F;&#x8349;&#x7A3F;</div>
        </div>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Cycle theme: Auto, Light, Dark">
          <span class="dot" aria-hidden="true"></span>
          <span class="theme-label">自動</span>
        </button>
        <button id="language-toggle" type="button" class="language-toggle" aria-label="Toggle language: 中文 / English" title="切換語言 / Toggle language">
          <span class="lang-label">中文</span>
        </button>
        <div class="focus-line">
          <span><span id="market-header-ticker-count" class="focus-num">{{ summary.ticker_count }}</span> 檔股票</span>
          <span class="sep">|</span>
          <span><span id="market-header-earnings-count" class="focus-num">{{ summary.earnings_soon_count }}</span> 財報 7 天內</span>
          <span id="market-header-macro-separator" class="sep">|</span>
          <span id="market-header-macro"><span class="focus-num">{{ summary.economic_event_count }}</span> 總經事件</span>
        </div>
      </div>
    </header>
    <section id="market-workspace" class="market-workspace" aria-label="&#x5E02;&#x5834;&#x5DE5;&#x4F5C;&#x5340;">
      <div class="market-workspace-copy">
        <span id="market-workspace-title" class="market-workspace-title">&#x7F8E;&#x80A1;&#x5DE5;&#x4F5C;&#x5340;</span>
        <span id="market-workspace-subtitle" class="market-workspace-subtitle">&#x6458;&#x8981;&#x3001;&#x65B0;&#x805E;&#x3001;&#x4F30;&#x503C;&#x8207;&#x500B;&#x80A1;&#x5C07;&#x540C;&#x6B65;&#x5207;&#x63DB;</span>
      </div>
      <div class="market-tabs" role="tablist" aria-label="&#x5E02;&#x5834;&#x5207;&#x63DB;">
        <button type="button" class="market-tab" role="tab" data-market-tab="us">&#x7F8E;&#x80A1;<span class="market-tab-count">{{ summary.market_counts.get("us", 0) }}</span></button>
        <button type="button" class="market-tab" role="tab" data-market-tab="taiwan">&#x53F0;&#x80A1;<span class="market-tab-count">{{ summary.market_counts.get("twse", 0) + summary.market_counts.get("tpex", 0) }}</span></button>
        <button type="button" class="market-tab" role="tab" data-market-tab="crypto">&#x52A0;&#x5BC6;&#x8CA8;&#x5E63;<span class="market-tab-count">{{ summary.market_counts.get("crypto", 0) }}</span></button>
      </div>
      <div class="market-workspace-stats" aria-live="polite">
        <div class="market-workspace-stat"><strong id="market-stat-tickers">0</strong><span>&#x8FFD;&#x8E64;&#x6A19;&#x7684;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-holdings">0</strong><span>&#x6301;&#x6709;&#x90E8;&#x4F4D;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-weight">&#x2014;</strong><span>&#x6301;&#x80A1;&#x6BD4;&#x91CD;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-impact">&#x2014;</strong><span>&#x4ECA;&#x65E5;&#x5F71;&#x97FF;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-attention">0</strong><span>&#x9700;&#x7559;&#x610F;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-news">0</strong><span>&#x4ECA;&#x65E5;&#x65B0;&#x805E;</span></div>
      </div>
      {% if taiwan_margin.visible %}
      <div id="taiwan-margin-context" class="taiwan-margin-context tone-{{ taiwan_margin.tone }}" data-market-context="taiwan" hidden title="{{ taiwan_margin.method }}；{{ taiwan_margin.disclaimer }}">
        <div class="taiwan-margin-heading">
          <strong>上市大盤融資維持率（估算）</strong>
          <span class="taiwan-margin-status">{{ taiwan_margin.status }}</span>
        </div>
        <strong class="taiwan-margin-value">{{ taiwan_margin.ratio_label }}</strong>
        <div class="taiwan-margin-detail">
          {% if taiwan_margin.available %}
          <span class="taiwan-margin-metrics">
            {{ taiwan_margin.reference_label }} · {{ taiwan_margin.balance_label }}{% if taiwan_margin.balance_change_label %} · {{ taiwan_margin.balance_change_label }}{% endif %}
          </span>
          {% endif %}
          <span>{{ taiwan_margin.detail }}</span>
        </div>
        <span class="taiwan-margin-source">
          {{ taiwan_margin.source_label }}{% if taiwan_margin.available %} · {{ taiwan_margin.coverage_label }}{% endif %}
        </span>
      </div>
      {% endif %}
    </section>

    <nav class="toc" aria-label="Sections">
      {% if morning_actions %}<a href="#morning-actions" class="toc-pill" style="background:var(--danger-bg);color:var(--danger)">行動 {{ morning_actions|length }}</a>{% endif %}
      <a href="#daily-summary">摘要</a>
      <a href="#strategy-screener">策略選股</a>
      <a href="#portfolio-heat">&#x7D44;&#x5408;&#x98A8;&#x96AA;</a>
      <a href="#right-side-validation">&#x53F3;&#x5074;&#x9A57;&#x8B49;</a>
      <a href="#trade-journal">&#x4EA4;&#x6613;&#x65E5;&#x8A8C;</a>
      <a href="#hero">盤前快照</a>
      <a href="#todays-focus">焦點</a>
      {% if portfolio and portfolio.holdings %}<a href="#my-book" class="toc-pill" style="background:var(--info-bg);color:var(--info)">持股 {{ portfolio.holdings|length }}</a>{% elif book_today %}<a href="#book-today">持股</a>{% endif %}
      {% if overextended %}<a href="#overextended" class="toc-pill">過熱 {{ overextended|length }}</a>{% endif %}
      {% if rule_alerts %}<a href="#rule-alerts" class="toc-pill">警示 {{ rule_alerts|length }}</a>{% endif %}
      {% if report.warnings %}<a href="#global-warnings" class="toc-pill">警告 {{ report.warnings|length }}</a>{% endif %}
      {% if data_quality.flagged %}<a href="#data-quality" class="toc-pill">資料 {{ data_quality.flagged|length }}</a>{% endif %}
      <a href="#macro">總經</a>
      <a href="#earnings">財報</a>
      <a href="#news">新聞 ({{ important_news|length }})</a>
      <a href="#valuation">估值</a>
      <a href="#tickers">個股 ({{ report.ticker_reports|length }})</a>
    </nav>

    {% if morning_actions %}
    <section id="morning-actions" class="section morning-actions" aria-label="早盤行動">
      <div class="section-header">
        <h2>早盤行動 <span class="muted">— 先決定這些</span></h2>
      </div>
      <ul class="morning-actions-list">
        {% for action in morning_actions %}
        <li class="morning-action tone-{{ action.tone }}">
          <a href="{{ action.anchor }}">
            <span class="ma-label">{{ action.display_label }}</span>
            <span class="ma-headline">{{ action.display_headline }}</span>
            <span class="ma-detail">{{ action.display_detail }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section id="daily-summary" class="section daily-summary {{ daily_summary.tone }}" aria-label="Daily summary">
      <div class="daily-summary-head">
        <h2>今日摘要</h2>
        <span id="market-summary-detail" class="daily-summary-detail">{{ daily_summary.headline }} · {{ daily_summary.detail }}</span>
      </div>
      <div class="daily-summary-body">
        <ul id="market-summary-list" class="daily-summary-list">
          {% for item in daily_summary["items"] %}
          <li class="daily-summary-item {{ item.tone }}">
            <a href="{{ item.anchor }}">
              <span class="daily-summary-label">{{ item.label }}</span>
              <span class="daily-summary-title">{{ item.headline }}</span>
              <span class="daily-summary-text">{{ item.detail }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        <div class="brief-metrics" aria-label="Key metrics">
          <div class="brief-metric {% if summary.hot_count %}alert danger{% endif %}"><span class="brief-metric-value">{{ summary.hot_count }}</span><span class="brief-metric-label">熱點</span></div>
          <div class="brief-metric {% if summary.premarket_gap_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.premarket_gap_count }}</span><span class="brief-metric-label">盤前缺口</span></div>
          <div class="brief-metric {% if summary.earnings_soon_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.earnings_soon_count }}</span><span class="brief-metric-label">財報 7 天內</span></div>
          <div id="market-summary-macro" class="brief-metric {% if summary.economic_event_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.economic_event_count }}</span><span class="brief-metric-label">總經事件</span></div>
          <div class="brief-metric"><span class="brief-metric-value" id="reviewed-count">{{ summary.reviewed_count }} / {{ summary.ticker_count }}</span><span class="brief-metric-label">已檢視</span></div>
          <div class="brief-metric {% if summary.rsi_overbought_count or summary.rsi_oversold_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.rsi_overbought_count }} / {{ summary.rsi_oversold_count }}</span><span class="brief-metric-label">RSI 高/低</span></div>
        </div>
      </div>
    </section>

    <section id="strategy-screener" class="section strategy-screener" aria-label="策略選股雷達">
      <div class="strategy-screener-head">
        <div class="strategy-screener-title">
          <h2>策略選股雷達</h2>
          <span class="strategy-screener-basis">{{ strategy_screener.updated_basis }}，不是盤中即時訊號</span>
        </div>
        <div class="strategy-screener-control">
          <label for="strategy-screen-select">選股策略</label>
          <select id="strategy-screen-select">
            {% for strategy in strategy_screener.strategies %}
            <option value="{{ strategy.key }}" data-description="{{ strategy.description }}"{% if strategy.key == strategy_screener.default_strategy %} selected{% endif %}>{{ strategy.label }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <p id="strategy-screen-description" class="strategy-screen-description">
        {% for strategy in strategy_screener.strategies %}{% if strategy.key == strategy_screener.default_strategy %}{{ strategy.description }}{% endif %}{% endfor %}
      </p>
      {% for strategy in strategy_screener.strategies %}
      <div class="strategy-screen-panel" data-strategy-panel="{{ strategy.key }}"{% if strategy.key != strategy_screener.default_strategy %} hidden{% endif %}>
        <ol class="strategy-screen-list">
          {% for row in strategy.rows %}
          <li class="strategy-screen-row" data-market="{{ row.market }}" data-symbol="{{ row.ticker }}">
            <span class="strategy-rank">{{ row.rank }}</span>
            <a class="strategy-identity" href="#{{ row.anchor }}">
              <span class="strategy-symbol">{{ row.display_symbol }}</span>
              <span class="strategy-company">{{ row.company }}</span>
            </a>
            {% set row_health_trend = score_trend(row.ticker, 'health') if strategy.key == 'overall' else None %}
            <span class="strategy-score health-tone-{{ row.health.tone }}" title="五維健診 {{ row.health.score if row.health.score is not none else 'N/A' }}/100{% if row_health_trend %} · {{ row_health_trend.title }}{% endif %}">
              {{ row.score }}{% if row_health_trend %}<span class="score-trend {{ row_health_trend.css_class }}" aria-label="{{ row_health_trend.title }}">{{ row_health_trend.arrow }} {{ row_health_trend.delta_label }}</span>{% endif %}
            </span>
            <div class="health-dimension-strip" aria-label="五維健診">
              {% for dimension in row.health.dimensions %}
              <span class="health-mini health-tone-{{ dimension.tone }}" title="{{ dimension.label }}：{% if dimension.score is not none %}{{ dimension.score }} 分{% else %}資料不足{% endif %}{% if dimension.evidence %} · {{ dimension.evidence|join('；') }}{% endif %}">
                <span>{{ dimension.short_label }}</span>
                <span class="health-mini-bar" style="--health-value: {{ dimension.score if dimension.score is not none else 0 }}%"></span>
              </span>
              {% endfor %}
            </div>
            <div class="strategy-reason">
              {{ row.reason }}
              <span class="strategy-action">下一步：{{ row.action }}</span>
            </div>
          </li>
          {% endfor %}
        </ol>
        <p class="strategy-empty"{% if strategy.rows %} hidden{% endif %}>目前市場沒有符合這項條件的標的。</p>
      </div>
      {% endfor %}
    </section>
    {% if portfolio_risk and (portfolio_risk.currencies or portfolio_risk.missing_stops or portfolio_risk.liquidity_alerts) %}
    {% set heat = portfolio_risk.consolidated %}
    <section id="portfolio-heat" class="section section-primary" aria-label="Portfolio heat">
      <div class="portfolio-heat-head">
        <div>
          <h2>&#x7D44;&#x5408;&#x98A8;&#x96AA;</h2>
          <span class="muted">&#x5148;&#x78BA;&#x8A8D;&#x5E33;&#x6236;&#x9084;&#x80FD;&#x627F;&#x53D7;&#x591A;&#x5C11;&#x98A8;&#x96AA;&#xFF0C;&#x518D;&#x770B;&#x500B;&#x80A1;&#x8A0A;&#x865F;</span>
        </div>
        <span id="portfolio-heat-source" class="portfolio-heat-source">
          {% if heat.complete %}&#x5168;&#x5E02;&#x5834;&#x5DF2;&#x63DB;&#x7B97;&#x70BA; {{ heat.base_currency }}{% else %}&#x90E8;&#x5206;&#x532F;&#x7387;&#x672A;&#x53D6;&#x5F97;&#xFF0C;&#x4E0D;&#x52A0;&#x7E3D;&#x6DF7;&#x7B97;{% endif %}
        </span>
      </div>
      <div class="risk-kpis">
        <div class="risk-kpi">
          <span class="label">&#x5DF2;&#x6301;&#x6709;&#x505C;&#x640D;&#x98A8;&#x96AA;</span>
          <span id="portfolio-risk-open" class="value">{{ heat.base_currency }} {{ "{:,.0f}".format(heat.open_risk) if heat.complete else "N/A" }}</span>
          <span id="portfolio-risk-open-detail" class="detail">{% if heat.risk_pct is not none %}{{ heat.risk_pct|format_pct(sign=False) }} &#x5360;&#x5DF2;&#x63DB;&#x7B97;&#x5E02;&#x503C;{% else %}&#x4F9D;&#x6709;&#x6548;&#x505C;&#x640D;&#x8A08;&#x7B97;{% endif %}</span>
        </div>
        <div class="risk-kpi{% if heat.pending_risk %} alert{% endif %}">
          <span class="label">&#x5F85;&#x57F7;&#x884C;&#x4FDD;&#x7559;&#x98A8;&#x96AA;</span>
          <span id="portfolio-risk-pending" class="value">{{ heat.base_currency }} {{ "{:,.0f}".format(heat.pending_risk) if heat.complete else "N/A" }}</span>
          <span id="portfolio-risk-pending-detail" class="detail">{{ portfolio_risk.planned_count }} &#x7B46;&#x898F;&#x5283;&#x4E2D;&#x4EA4;&#x6613;</span>
        </div>
        <div class="risk-kpi alert">
          <span class="label">&#x8DF3;&#x7A7A;&#x58D3;&#x529B;&#x640D;&#x5931;</span>
          <span id="portfolio-risk-stress" class="value">{{ heat.base_currency }} {{ "{:,.0f}".format(heat.stress_risk) if heat.complete else "N/A" }}</span>
          <span class="detail">&#x505C;&#x640D;&#x98A8;&#x96AA;&#x52A0;&#x4E00;&#x500B; ATR &#x6216; 3% &#x7F3A;&#x53E3;</span>
        </div>
        <div class="risk-kpi{% if portfolio_risk.missing_stops %} alert{% endif %}">
          <span class="label">&#x7121;&#x6CD5;&#x8A08;&#x7B97;&#x7684;&#x90E8;&#x4F4D;</span>
          <span id="portfolio-risk-missing" class="value">{{ portfolio_risk.missing_stops|length }}</span>
          <span class="detail">&#x672A;&#x8A2D;&#x6709;&#x6548;&#x505C;&#x640D;&#x7684;&#x6301;&#x80A1;&#x6216;&#x898F;&#x5283;</span>
        </div>
      </div>
      <div class="portfolio-risk-grid">
        {% for risk in portfolio_risk.currencies %}
        <div class="portfolio-risk-item{% if risk.over_budget %} alert{% endif %}" data-market="{{ risk.market }}">
          <strong>{{ risk.currency }} &#x5DF2;&#x7528; {{ "{:,.0f}".format(risk.open_risk + risk.pending_risk) }}</strong>
          <span>&#x6301;&#x6709; {{ "{:,.0f}".format(risk.open_risk) }} &middot; &#x4FDD;&#x7559; {{ "{:,.0f}".format(risk.pending_risk) }} &middot; &#x58D3;&#x529B; {{ "{:,.0f}".format(risk.stress_risk) }}</span>
          {% if risk.risk_budget is not none %}
          <span>&#x9810;&#x7B97;&#x4F7F;&#x7528; {{ risk.budget_usage_pct|format_pct(sign=False) }} &middot; &#x5269;&#x9918; {{ "{:,.0f}".format(risk.remaining_budget) }}</span>
          {% else %}
          <span>&#x5C1A;&#x672A;&#x8A2D;&#x5B9A; {{ risk.currency }} &#x5E33;&#x6236;&#x98A8;&#x96AA;&#x9810;&#x7B97;</span>
          {% endif %}
        </div>
        {% endfor %}
        {% for alert in portfolio_risk.liquidity_alerts %}
        <div class="portfolio-risk-item alert" data-market="{{ alert.market }}">
          <strong>{{ alert.symbol }} &#x6D41;&#x52D5;&#x6027;&#x58D3;&#x529B;</strong>
          <span>{% if alert.kind == 'planned' %}&#x898F;&#x5283;&#x8A02;&#x55AE;{% else %}&#x73FE;&#x6709;&#x90E8;&#x4F4D;{% endif %}&#x4F54; 20D ADV {{ alert.adv_pct|format_pct(sign=False) }} &middot; 10% &#x53C3;&#x8207;&#x7387;&#x9700; {{ "%.2f"|format(alert.days_to_liquidate) }} &#x65E5;</span>
        </div>
        {% endfor %}
        {% for missing in portfolio_risk.missing_stops %}
        <div class="portfolio-risk-item alert" data-market="{{ missing.market }}">
          <strong>{{ missing.symbol }} &#x672A;&#x8A2D;&#x6709;&#x6548;&#x505C;&#x640D;</strong>
          <span>&#x5148;&#x5B9A;&#x7FA9;&#x5931;&#x6548;&#x50F9;&#xFF0C;&#x518D;&#x589E;&#x52A0;&#x90E8;&#x4F4D;</span>
        </div>
        {% endfor %}
        {% for pair in portfolio_risk.correlated_pairs[:4] %}
        <div class="portfolio-risk-item alert" data-market="{{ pair.market }}">
          <strong>{{ pair.left }} / {{ pair.right }} &#x76F8;&#x95DC; {{ "%.2f"|format(pair.correlation) }}</strong>
          <span>{{ pair.sessions }} &#x500B;&#x4EA4;&#x6613;&#x65E5; &middot; &#x5408;&#x8A08;&#x6BD4;&#x91CD; {{ pair.combined_weight|format_pct(sign=False) }}</span>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <details id="right-side-validation" class="section signal-validation analysis-tool">
      <summary class="analysis-tool-summary">
        <span class="analysis-tool-title">&#x7B56;&#x7565;&#x9A57;&#x8B49;</span>
        <span class="analysis-tool-meta">{{ right_side_validation.signals_recorded }} &#x6B21;&#x8A0A;&#x865F; &middot; &#x4EA4;&#x6613;&#x65E5;&#x671F;&#x671B;&#x503C;</span>
      </summary><div class="analysis-tool-body">
      <div class="signal-validation-head">
        <div>
          <h2>&#x53F3;&#x5074;&#x8A0A;&#x865F;&#x9A57;&#x8B49;</h2>
          <span class="muted">&#x4F7F;&#x7528;&#x5BE6;&#x969B;&#x5E02;&#x5834;&#x4EA4;&#x6613;&#x65E5;&#xFF0C;&#x4E26;&#x4EE5;&#x521D;&#x59CB;&#x98A8;&#x96AA; R &#x8A08;&#x7B97;&#x671F;&#x671B;&#x503C;&#xFF1B;&#x6A23;&#x672C;&#x672A;&#x6EFF; {{ right_side_validation.minimum_sample }} &#x7B46;&#x50C5;&#x4F9B;&#x89C0;&#x5BDF;</span>
        </div>
        <span class="signal-validation-stat">&#x5DF2;&#x8A18;&#x9304; {{ right_side_validation.signals_recorded }} &#x6B21;&#x8A0A;&#x865F;</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>&#x5E02;&#x5834;</th><th>&#x6301;&#x6709;&#x671F;</th><th class="num">&#x5B8C;&#x6574;&#x6A23;&#x672C;</th><th class="num">&#x52DD;&#x7387;</th><th class="num">&#x671F;&#x671B;&#x503C;</th><th class="num">&#x5E73;&#x5747; / &#x4E2D;&#x4F4D;</th><th class="num">&#x7372;&#x5229; / &#x8667;&#x640D;</th><th class="num">&#x5C3E;&#x7AEF; / &#x5F85;&#x8FFD;&#x8E64;</th></tr></thead>
          <tbody>
            {% for market in right_side_validation.markets %}
              {% for row in market.horizons %}
              <tr data-market="{{ market.key }}">
                <td>{% if market.key == 'us' %}&#x7F8E;&#x80A1;{% elif market.key == 'taiwan' %}&#x53F0;&#x80A1;{% elif market.key == 'crypto' %}&#x52A0;&#x5BC6;&#x8CA8;&#x5E63;{% else %}{{ market.label }}{% endif %}</td>
                <td>{{ row.sessions }} &#x500B;&#x4EA4;&#x6613;&#x65E5;</td>
                <td class="num"><span class="signal-sample{% if row.reliable %} validated{% endif %}">{{ row.sample_size }} / {{ row.minimum_sample }}</span></td>
                <td class="num">{% if row.win_rate is not none %}{{ "%.1f"|format(row.win_rate) }}%{% else %}N/A{% endif %}</td>
                <td class="num {% if row.expectancy_r is not none %}change change-{{ row.expectancy_r|change_class }}{% endif %}">{% if row.expectancy_r is not none %}{{ "%+.2f"|format(row.expectancy_r) }}R<div class="muted">n={{ row.r_sample_size }}</div>{% else %}N/A{% endif %}</td>
                <td class="num">{% if row.average_return is not none %}{{ row.average_return|format_pct }} / {{ row.median_return|format_pct }}{% else %}N/A{% endif %}</td>
                <td class="num">{% if row.average_win is not none %}{{ row.average_win|format_pct }} / {{ row.average_loss|format_pct }}{% if row.payoff_ratio is not none %}<div class="muted">&#x640D;&#x76CA;&#x6BD4; {{ "%.2f"|format(row.payoff_ratio) }}</div>{% endif %}{% else %}N/A{% endif %}</td>
                <td class="num">{% if row.worst_return is not none %}{{ row.worst_return|format_pct }}{% else %}N/A{% endif %}<div class="muted">{{ row.pending }} &#x5F85;&#x8FFD;&#x8E64;{% if row.unavailable %} &middot; {{ row.unavailable }} &#x8D85;&#x51FA;&#x6B77;&#x53F2;{% endif %}</div></td>
              </tr>
              {% endfor %}
            {% else %}
              <tr><td colspan="8" class="journal-empty">&#x5C1A;&#x7121;&#x53EF;&#x5B8C;&#x6210;&#x9A57;&#x8B49;&#x7684;&#x8A0A;&#x865F;&#x6A23;&#x672C;</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div></details>

    <details id="trade-journal" class="section trade-journal analysis-tool">
      <summary class="analysis-tool-summary">
        <span class="analysis-tool-title">&#x4EA4;&#x6613;&#x65E5;&#x8A8C;</span>
        <span class="analysis-tool-meta">{{ trade_journal.planned_count }} &#x898F;&#x5283; &middot; {{ trade_journal.open_count }} &#x9032;&#x884C;&#x4E2D; &middot; {{ trade_journal.closed_count }} &#x5B8C;&#x6210;</span>
      </summary><div class="analysis-tool-body">
      <div class="journal-headline">
        <div>
          <h2>&#x4EA4;&#x6613;&#x65E5;&#x8A8C;</h2>
          <span class="muted">&#x4EE5;&#x521D;&#x59CB;&#x505C;&#x640D;&#x56FA;&#x5B9A; 1R&#xFF0C;&#x7528;&#x76F8;&#x540C;&#x5C3A;&#x5EA6;&#x8907;&#x76E4;&#x9032;&#x51FA;&#x5834;</span>
        </div>
        <div class="journal-stats" aria-label="Trade journal statistics">
          <span>&#x9032;&#x884C;&#x4E2D; <strong data-journal-stat="open">{{ trade_journal.open_count }}</strong></span>
          <span>&#x898F;&#x5283;&#x4E2D; <strong data-journal-stat="planned">{{ trade_journal.planned_count }}</strong></span>
          <span>&#x5DF2;&#x5B8C;&#x6210; <strong data-journal-stat="closed">{{ trade_journal.closed_count }}</strong></span>
          <span>&#x671F;&#x671B;&#x503C; <strong>{% if trade_journal.expectancy_r is not none %}{{ "%+.2f"|format(trade_journal.expectancy_r) }}R{% else %}N/A{% endif %}</strong></span>
          <span>&#x52DD;&#x7387; <strong>{% if trade_journal.win_rate is not none %}{{ "%.1f"|format(trade_journal.win_rate) }}%{% else %}N/A{% endif %}</strong></span>
          <span>&#x640D;&#x76CA;&#x6BD4; <strong>{% if trade_journal.payoff_ratio is not none %}{{ "%.2f"|format(trade_journal.payoff_ratio) }}{% else %}N/A{% endif %}</strong></span>
          <span class="signal-sample{% if trade_journal.reliable %} validated{% endif %}">{{ trade_journal.measured_count }} / {{ trade_journal.minimum_sample }} &#x7B46;</span>
        </div>
      </div>
      <div class="journal-layout">
        <div class="table-wrap">
          <table class="journal-table">
            <thead><tr><th>&#x6A19;&#x7684;</th><th>&#x72C0;&#x614B;</th><th>&#x9032;&#x5834;</th><th class="num">&#x90E8;&#x4F4D;</th><th class="num">&#x505C;&#x640D;</th><th class="num">&#x6DE8;&#x640D;&#x76CA;</th><th class="num">R</th><th class="num">MFE / MAE</th><th>&#x8A2D;&#x5B9A;</th></tr></thead>
            <tbody id="trade-journal-rows">
              {% for row in trade_journal.rows %}
              {% set trade = row.trade %}
              <tr data-trade-id="{{ trade.trade_id }}" data-symbol="{{ trade.ticker }}" data-market="{{ trade.market }}">
                <td class="symbol-cell"><a href="#{{ trade.ticker|ticker_anchor }}">{{ trade.ticker }}</a><div class="journal-note">{{ trade.setup or trade.note }}</div></td>
                <td><span class="journal-status {{ 'planned' if row.planned else ('closed' if row.closed else 'open') }}">{% if row.planned %}&#x898F;&#x5283;&#x4E2D;{% elif row.closed %}&#x5DF2;&#x5B8C;&#x6210;{% else %}&#x9032;&#x884C;&#x4E2D;{% endif %}</span></td>
                <td>{{ row.entry_date.isoformat() if row.entry_date else 'N/A' }}<div class="muted">{{ trade.currency }} {{ row.average_entry|metric_value }}</div></td>
                <td class="num">{% if row.planned %}{{ row.planned_shares|metric_value }}{% else %}{{ row.remaining_shares|metric_value }}{% endif %}<div class="muted">{{ row.fill_count }} &#x7B46;&#x6210;&#x4EA4;</div></td>
                <td class="num">{{ row.current_stop|metric_value }}{% if row.planned_risk is not none %}<div class="muted">&#x521D;&#x59CB; 1R {{ trade.currency }} {{ "{:,.0f}".format(row.planned_risk) }}</div>{% endif %}{% if row.current_risk is not none %}<div class="muted">&#x76EE;&#x524D;&#x98A8;&#x96AA; {{ "{:,.0f}".format(row.current_risk) }}</div>{% endif %}</td>
                <td class="num change change-{{ row.net_pl|change_class }}">{% if row.net_pl is not none %}{{ trade.currency }} {{ "{:+,.0f}".format(row.net_pl) }}{% else %}N/A{% endif %}</td>
                <td class="num change change-{{ row.r_multiple|change_class }}">{% if row.r_multiple is not none %}{{ "%+.2f"|format(row.r_multiple) }}R{% else %}N/A{% endif %}</td>
                <td class="num">{% if row.mfe_r is not none %}{{ "%+.1f"|format(row.mfe_r) }}R / {{ "%+.1f"|format(row.mae_r) }}R{% if not row.path_complete %}<div class="muted">&#x50C5;&#x542B;&#x76EE;&#x524D;&#x50F9;&#x683C;&#x6B77;&#x53F2;</div>{% endif %}{% else %}N/A{% endif %}</td>
                <td><button type="button" class="icon-button" data-trade-edit="{{ trade.trade_id }}" title="&#x7DE8;&#x8F2F;&#x4EA4;&#x6613;" aria-label="&#x7DE8;&#x8F2F;&#x4EA4;&#x6613;">&#x270E;</button></td>
              </tr>
              {% else %}
              <tr class="journal-empty-row"><td colspan="9" class="journal-empty">&#x5C1A;&#x7121;&#x4EA4;&#x6613;&#x8A18;&#x9304;</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <form id="trade-journal-form" class="journal-form" novalidate>
          <h3 id="trade-form-title">&#x65B0;&#x589E;&#x4EA4;&#x6613;</h3>
          <input id="trade-id" type="hidden">
          <input id="trade-initial-risk" type="hidden">
          <label>&#x6A19;&#x7684;<select id="trade-ticker" required>{% for item in report.ticker_reports %}<option value="{{ item.ticker.symbol }}" data-market="{{ item.ticker.market }}" data-currency="{{ item.ticker.currency }}">{{ item.ticker.display_symbol }} &middot; {{ item.ticker.company_name }}</option>{% endfor %}</select></label>
          <label>&#x72C0;&#x614B;<select id="trade-status"><option value="planned">&#x898F;&#x5283;&#x4E2D;</option><option value="open">&#x9032;&#x884C;&#x4E2D;</option><option value="closed">&#x5DF2;&#x5B8C;&#x6210;</option></select></label>
          <label>&#x9032;&#x5834;&#x65E5;<input id="trade-entry-date" type="date"></label>
          <label>&#x9032;&#x5834;&#x50F9;<input id="trade-entry-price" type="number" min="0" step="any" inputmode="decimal"></label>
          <label>&#x6578;&#x91CF;<input id="trade-shares" type="number" min="0" step="any" inputmode="decimal"></label>
          <label>&#x521D;&#x59CB;&#x505C;&#x640D;<input id="trade-stop" type="number" min="0" step="any" inputmode="decimal"></label>
          <label>&#x76EE;&#x524D;&#x505C;&#x640D;<input id="trade-current-stop" type="number" min="0" step="any" inputmode="decimal"></label>
          <label>&#x51FA;&#x5834;&#x65E5;<input id="trade-exit-date" type="date"></label>
          <label>&#x51FA;&#x5834;&#x50F9;<input id="trade-exit-price" type="number" min="0" step="any" inputmode="decimal"></label>
          <label>&#x8CBB;&#x7528;<input id="trade-fees" type="number" min="0" step="any" inputmode="decimal" value="0"></label>
          <label>&#x532F;&#x7387;&#xFF08;&#x8F49;&#x672C;&#x4F4D;&#x5E63;&#xFF09;<input id="trade-fx-rate" type="number" min="0" step="any" inputmode="decimal" value="1"></label>
          <label>&#x4EA4;&#x6613;&#x578B;&#x614B;<input id="trade-setup" type="text" maxlength="60" placeholder="&#x7A81;&#x7834; / &#x62C9;&#x56DE;"></label>
          <div class="wide fill-editor">
            <div class="fill-editor-head">
              <strong>&#x5206;&#x6279;&#x6210;&#x4EA4;</strong>
              <button id="trade-add-fill" type="button" class="icon-button" title="&#x65B0;&#x589E;&#x4E00;&#x7B46;&#x6210;&#x4EA4;" aria-label="&#x65B0;&#x589E;&#x4E00;&#x7B46;&#x6210;&#x4EA4;">+</button>
            </div>
            <div id="trade-fill-rows" class="trade-fill-rows"></div>
            <p class="fill-editor-help">&#x898F;&#x5283;&#x4E2D;&#x53EF;&#x5148;&#x4E0D;&#x586B;&#xFF1B;&#x5BE6;&#x969B;&#x9032;&#x51FA;&#x5834;&#x5F8C;&#xFF0C;&#x9010;&#x7B46;&#x8A18;&#x9304;&#x8CB7;&#x9032;&#x3001;&#x8CE3;&#x51FA;&#x3001;&#x6578;&#x91CF;&#x8207;&#x8CBB;&#x7528;&#x3002;</p>
          </div>
          <label class="wide">&#x8907;&#x76E4;&#x5099;&#x8A3B;<textarea id="trade-note" maxlength="240"></textarea></label>
          <div class="form-actions"><button id="trade-form-clear" type="button" class="tool-button tool-button-secondary">&#x6E05;&#x9664;</button><button type="submit" class="tool-button tool-button-primary">&#x5132;&#x5B58;&#x4EA4;&#x6613;</button></div>
        </form>
      </div>
      </div></details>


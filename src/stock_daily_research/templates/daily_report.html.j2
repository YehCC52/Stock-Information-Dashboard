            : Math.max(0, entry - stop) * shares;
        }
        var status = fields.status.value;
        if (fills.length && status === "planned") status = "open";
        if (shares > 0 && soldShares >= shares) status = "closed";
        var currentStop = number(fields.currentStop.value);
        if (currentStop == null) currentStop = stop;
        var fxRate = number(fields.fxRate.value);
        if (fxRate == null || fxRate <= 0) fxRate = 1;
        var trade = Object.assign({}, existing, {
          trade_id: id,
          ticker: fields.ticker.value,
          market: option ? option.dataset.market || "us" : "us",
          currency: option ? option.dataset.currency || "USD" : "USD",
          status: status,
          entry_date: entryDate,
          entry_price: entry,
          shares: shares,
          initial_stop: stop,
          current_stop: currentStop,
          initial_risk: initialRisk,
          exit_date: exitDate,
          exit_price: exit,
          fees: number(fields.fees.value) || 0,
          fx_rate_to_base: fxRate,
          fills: fills,
          setup: fields.setup.value.trim(),

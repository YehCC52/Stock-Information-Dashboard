    .rate-name { font-weight: 800; color: var(--muted); letter-spacing: 0.04em; }
    .rate-last { font-variant-numeric: tabular-nums; }
    .rate-change { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
    .change-pos { color: var(--good); }
    .change-neg { color: var(--danger); }
    .change-flat { color: var(--muted); }
    .breadth-label { font-weight: 700; }
    .breadth-spread { font-weight: 800; font-variant-numeric: tabular-nums; }
    .rates-interp, .breadth-hint {
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
      font-style: italic;
    }
    .regime-pill {
      display: inline-flex;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--info-bg);
      color: var(--info);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-left: auto;
      cursor: help;
    }

    /* My Book Today — portfolio impact summary */
    .my-book-section {
      border: 1px solid color-mix(in srgb, var(--info) 40%, var(--border));
      background: color-mix(in srgb, var(--info-bg) 20%, var(--surface));
    }
    .my-book-section h2 { color: var(--info); }
    .my-book-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .my-book-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 8px 10px;
    }
    .my-book-card.winners { border-left: 3px solid var(--good); }
    .my-book-card.losers { border-left: 3px solid var(--danger); }
    .my-book-card.events { border-left: 3px solid var(--warning); }
    .my-book-card.risks { border-left: 3px solid var(--info); }
    .mb-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .mb-list { list-style: none; margin: 0; padding: 0; }
    .mb-list li {
      display: grid;
      grid-template-columns: 56px auto 1fr;
      gap: 8px;
      align-items: baseline;
      padding: 3px 0;
      font-size: 12px;
    }
    .mb-list li a { font-weight: 800; color: var(--text); }
    .mb-pct { font-weight: 700; font-variant-numeric: tabular-nums; }
    .mb-detail { color: var(--muted); font-size: 11px; }
    .mb-empty { color: var(--muted); font-size: 11px; font-style: italic; }
    .my-book-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 4px 0 10px;
      font-size: 12px;
    }
    .my-book-stats .stat {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 4px 10px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 110px;
    }
    .my-book-stats .stat .label {
      font-size: 10px;
      text-transform: uppercase;
      color: var(--muted);
      letter-spacing: 0.05em;
    }
    .my-book-stats .stat .value {
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .my-book-card.sectors { border-left: 3px solid var(--info); }
    .my-book-card.stops { border-left: 3px solid var(--danger); }
    .sector-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      font-size: 12px;
      padding: 2px 0;
    }
    .sector-row.over-cap { color: var(--danger); font-weight: 700; }
    .sector-row .tickers { color: var(--muted); font-size: 11px; font-weight: 400; }
    .concentration-warning {
      margin: 10px 0; padding: 10px 14px; border-radius: 8px;
      background: var(--warning-bg); border: 1px solid var(--warning, #d97706);
      border-left: 4px solid var(--warning, #d97706); font-size: 0.88rem; line-height: 1.5;
    }
    .concentration-warning strong { color: var(--warning, #d97706); }
    .concentration-warning a { font-weight: 600; }
    .stop-row {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 8px;
      font-size: 12px;
      padding: 2px 0;
    }
    .stop-row.tone-danger { color: var(--danger); font-weight: 700; }
    .stop-row.tone-warn { color: var(--warning); }
    .stop-row .detail { font-size: 11px; color: var(--muted); }
    .position-chip.tone-danger .value { color: var(--danger); font-weight: 700; }
    .position-chip.tone-warn .value { color: var(--warning); }
    .position-chip.tone-ok .value { color: var(--good); }

    /* Overextended list (top-of-dashboard danger panel) */
    .overextended-section {
      border: 1px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 25%, var(--surface));
    }
    .overextended-section h2 { color: var(--danger); }
    .overextended-list { list-style: none; margin: 6px 0 0; padding: 0; }
    .overextended-item {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 12px;
      align-items: baseline;
      padding: 8px 12px;
      margin: 4px -12px;
      border-left: 3px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 30%, transparent);
      border-radius: 0 4px 4px 0;
    }
    .overextended-item:nth-child(odd) { background: color-mix(in srgb, var(--danger-bg) 45%, transparent); }
    .overextended-item .symbol { font-weight: 800; font-size: 14px; color: var(--text); }
    .overextended-item .ext-reasons { font-size: 12px; color: var(--text); }
    .overextended-item .ext-score {
      font-weight: 800;
      font-size: 13px;
      color: var(--danger);
      font-variant-numeric: tabular-nums;
    }
    .news-item .meta { color: var(--muted); font-size: 12px; white-space: nowrap; display: flex; gap: 8px; align-items: center; }

    /* Event-typed badges */
    .event-badge { font-size: 10px; }
    .event-badge.event-earnings { color: var(--danger); background: var(--danger-bg); }
    .event-badge.event-guidance, .event-badge.event-supply { color: var(--warning); background: var(--warning-bg); }
    .event-badge.event-ma, .event-badge.event-antitrust, .event-badge.event-lawsuit, .event-badge.event-regulation { color: var(--info); background: var(--info-bg); }
    .event-badge.event-ai, .event-badge.event-product { color: var(--good); background: var(--good-bg); }
    .event-badge.event-analyst_call, .event-badge.event-management, .event-badge.event-macro, .event-badge.event-other { color: var(--muted); background: var(--surface-soft); }

    /* Event clusters — cross-source story grouping */
    .cluster-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .cluster-item {
      border: 1px solid var(--border-soft);
      border-left: 3px solid var(--muted);
      border-radius: 6px;
      padding: 8px 12px;
      background: var(--surface);
    }
    .cluster-item.confidence-high { border-left-color: var(--good); }
    .cluster-item.confidence-medium { border-left-color: var(--warning); }
    .cluster-item.confidence-low { border-left-color: var(--muted); }
    .cluster-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
    }
    .cluster-headline { font-weight: 700; font-size: 13px; color: var(--text); }
    .cluster-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 6px;
      font-size: 12px;
      color: var(--text);
    }
    .cluster-field .cf-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-right: 4px;
    }
    .cluster-field a { color: var(--text); font-weight: 700; }
    .conf-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 1px 6px;
      border-radius: 4px;
    }
    .conf-tag.conf-high { color: var(--good); background: var(--good-bg); }
    .conf-tag.conf-medium { color: var(--warning); background: var(--warning-bg); }
    .conf-tag.conf-low { color: var(--muted); background: var(--surface-soft); }
    .cluster-action { margin-top: 6px; font-size: 11px; color: var(--muted); font-style: italic; }

    /* Ticker grid */
    .ticker-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 12px;
    }
    .ticker-card { padding: 14px; min-width: 0; scroll-margin-top: 80px; position: relative; overflow: hidden; }
    .ticker-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: transparent;
    }
    .ticker-card.hot { border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); }
    .ticker-card.hot::before { background: var(--danger); }
    .ticker-card.warn { border-color: color-mix(in srgb, var(--warning) 40%, var(--border)); }
    .ticker-card.warn::before { background: var(--warning); }
    .ticker-card.warm::before { background: var(--good); opacity: 0.4; }
    .ticker-card.warm { border-color: var(--border); }
    .ticker-card.quiet { opacity: 0.55; border-color: var(--border-soft); }
    .ticker-card.quiet:hover { opacity: 1; }
    .ticker-card.quiet .ticker-name { color: var(--muted); }

    /* Insight rows: Setup / Risk / Watch */
    /* Legend below the tickers heading */
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      padding: 8px 10px;
      margin-bottom: 12px;
      background: var(--surface-alt);
      border-radius: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .legend .badge { font-size: 10px; }
    .legend-sep { color: var(--border); }

    .insights {
      display: flex;
      flex-direction: column;
      gap: 4px;

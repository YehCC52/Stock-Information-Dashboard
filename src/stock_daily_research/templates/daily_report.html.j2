            {% if insights.trend %}<div class="insight-row trend trend-{{ insights.trend_tone }}"{% if insights.trend_title %} title="{{ insights.trend_title|zh_text }}"{% endif %}><span class="insight-label">趨勢</span><span class="insight-text">{{ insights.trend|join(' | ')|zh_text }}</span></div>{% endif %}
            {% if insights.rs %}<div class="insight-row rs trend-{{ insights.rs_tone }}"><span class="insight-label">相對強度</span><span class="insight-text">{{ insights.rs|join(' · ')|zh_text }}</span></div>{% endif %}
            {% if insights.risk %}<div class="insight-row risk"><span class="insight-label">風險</span><span class="insight-text">{{ insights.risk|join(' | ')|zh_text }}</span></div>{% endif %}
            {% if insights.score or technical or right_side or insights.trend or insights.rs %}
            <details class="decision-evidence">
              <summary>&#x5206;&#x6790;&#x4F9D;&#x64DA;</summary>
              <div class="decision-evidence-grid">
                {% if insights.score %}
                <div class="decision-evidence-row"><strong>&#x7B56;&#x7565;&#x8A55;&#x5206;</strong><span>{{ insights.score.score }}/100 &middot; {{ insights.score.status|zh_text }}</span></div>
                {% if insights.score.reasons %}<div class="decision-evidence-row"><strong>&#x8A55;&#x5206;&#x4F9D;&#x64DA;</strong><span>{{ insights.score.reasons|join(' / ')|zh_text }}</span></div>{% endif %}
                {% endif %}
                {% if technical %}
                <div class="decision-evidence-row"><strong>&#x6280;&#x8853;&#x7D50;&#x69CB;</strong><span>{{ technical.status|zh_text }}</span></div>
                {% if technical.criteria %}<div class="decision-evidence-row"><strong>&#x7D50;&#x69CB;&#x4F9D;&#x64DA;</strong><span>{{ technical.criteria|join(' / ')|zh_text }}</span></div>{% endif %}
                {% endif %}
                {% if right_side %}
                <div class="decision-evidence-row"><strong>&#x53F3;&#x5074;&#x6AA2;&#x6838;</strong><span>{{ right_side.pathway_status|zh_text }} &middot; {{ right_side.status|zh_text }}</span></div>
                <div class="decision-evidence-row">
                  <strong>&#x6AA2;&#x6838;&#x7D30;&#x9805;</strong>
                  <span>{% for check in right_side.checks %}{{ check.label|zh_text }}&#xFF1A;{{ check.status|zh_text }}{% if check.detail %} ({{ check.detail|zh_text }}){% endif %}{% if not loop.last %} / {% endif %}{% endfor %}</span>
                </div>
                {% endif %}
                {% if insights.trend %}
                <div class="decision-evidence-row"><strong>&#x8DA8;&#x52E2;</strong><span>{{ insights.trend|join(' / ')|zh_text }}</span></div>
                {% endif %}
                {% if insights.rs %}
                <div class="decision-evidence-row"><strong>&#x76F8;&#x5C0D;&#x5F37;&#x5EA6;</strong><span>{{ insights.rs|join(' / ')|zh_text }}</span></div>
                {% endif %}
              </div>
            </details>
            {% endif %}
          </div>
          {% endif %}

          {% set analyst_view = item|analyst_consensus %}
          {% set firm_targets = item|named_analyst_targets %}
          {% if insights.quality or insights.watch or analyst_view.available or firm_targets %}
          <details class="card-secondary card-extras">

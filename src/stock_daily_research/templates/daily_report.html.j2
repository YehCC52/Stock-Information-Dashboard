      function marketGroup(value) {
        if (value === "twse" || value === "tpex") return "taiwan";
        return value || "us";
      }
      function labelsForMarket(value) { return { us: "美股", taiwan: "台股", crypto: "加密貨幣" }[value] || "市場"; }


      function marketsForElement(element) {
        var found = [];
        function add(value) {
          value = marketGroup(value);
          if (["us", "taiwan", "crypto"].indexOf(value) >= 0 && found.indexOf(value) < 0) found.push(value);
        }
        if (element.dataset.market) add(element.dataset.market);
        if (element.dataset.symbol) {
          var direct = cards.find(function (card) { return symbol(card) === element.dataset.symbol; });
          if (direct) add(direct.dataset.market);
        }
        function addTickerLink(anchor) {
          var target = document.getElementById(anchor.getAttribute("href").slice(1));
          if (target && target.classList.contains("ticker-card")) add(target.dataset.market);
        }
        if (element.matches('a[href^="#ticker-"]')) addTickerLink(element);
        Array.prototype.forEach.call(element.querySelectorAll('a[href^="#ticker-"]'), addTickerLink);
        return found;
      }

      function updateMarketSummary(selectedCards, values) {
        var labels = { us: "美股", taiwan: "台股", crypto: "加密貨幣" };
        var list = document.getElementById("market-summary-list");
        var detail = document.getElementById("market-summary-detail");
        var section = document.getElementById("daily-summary");
        function priority(card) {
          var stateWeight = { hot: 500, warn: 420, warm: 260, quiet: 80 }[card.dataset.state] || 0;
          var earningsDays = parseInt(card.dataset.earningsDays, 10);
          var earningsWeight = !isNaN(earningsDays) && earningsDays >= 0 && earningsDays <= 7 ? 180 - earningsDays * 12 : 0;
          return stateWeight + earningsWeight + (card.dataset.hasRisk === "1" ? 220 : 0) +
            (parseInt(card.dataset.newsCount, 10) || 0) * 18 +
            (parseFloat(card.dataset.attentionScore) || 0) +
            (card.dataset.positionStatus === "holding" ? 35 : 0) +
            (parseFloat(card.dataset.technicalPriority) || 0) * 20;
        }
        var ranked = selectedCards.slice().sort(function (a, b) {
          return priority(b) - priority(a) || symbol(a).localeCompare(symbol(b));
        });
        var attention = selectedCards.filter(function (card) { return card.dataset.state === "hot" || card.dataset.state === "warn" || card.dataset.hasRisk === "1" || (parseFloat(card.dataset.technicalPriority) || 0) >= 4; }).length;
        if (detail) detail.textContent = labels[activeMarket] + " " + selectedCards.length + " 檔 · " + attention + " 檔需優先留意 · " + values["market-stat-news"] + " 則新聞";
        if (section) {
          section.classList.remove("danger", "warn", "info");
          section.classList.add(attention > 0 ? "warn" : "info");
        }
        if (!list) return;
        if (!ranked.length) {
          list.innerHTML = '<li class="daily-summary-item"><span class="daily-summary-text">目前市場沒有追蹤標的。</span></li>';
          return;
        }
        list.innerHTML = ranked.slice(0, 3).map(function (card, index) {
          var rawSymbol = symbol(card);
          var displaySymbol = rawSymbol.replace(/\.(TW|TWO)$/i, "").replace(/-USD$/i, "");
          var nameNode = card.querySelector(".ticker-name");
          var company = nameNode && nameNode.childNodes.length ? String(nameNode.childNodes[0].textContent || "").trim() : (card.dataset.company || "");
          var earningsDays = parseInt(card.dataset.earningsDays, 10);
          var news = parseInt(card.dataset.newsCount, 10) || 0;
          var technicalPriority = parseFloat(card.dataset.technicalPriority) || 0;
          var technicalLabel = card.dataset.technicalLabel || "";
          var reasons = [];
          if (card.dataset.hasRisk === "1") reasons.push("出現風險訊號");
          if (!isNaN(earningsDays) && earningsDays >= 0 && earningsDays <= 7) reasons.push(earningsDays === 0 ? "今日財報" : earningsDays + " 天內財報");
          if (news > 0) reasons.push(news + " 則新聞");
          if (card.dataset.positionStatus === "holding") reasons.push("持有部位");
          if (technicalPriority >= 4 && technicalLabel) reasons.push(technicalLabel);
          if (!reasons.length) reasons.push("例行觀察");
          var action = card.dataset.hasRisk === "1" ? "檢查風險與持股計畫" :
            (!isNaN(earningsDays) && earningsDays >= 0 && earningsDays <= 7) ? "確認財報預期" :
            news > 0 ? "閱讀最新消息" : technicalPriority >= 4 ? "\u67e5\u770b\u6280\u8853\u4f9d\u64da" : "更新研究狀態";
          var tone = card.dataset.hasRisk === "1" || card.dataset.state === "hot" ? "danger" : card.dataset.state === "warn" ? "warn" : "info";
          return '<li class="daily-summary-item ' + tone + '"><a href="#' + escapeHtml(card.id) + '">' +
            '<span class="daily-summary-label">' + (index === 0 ? "優先檢視" : "接續追蹤") + '</span>' +
            '<span class="daily-summary-title">' + escapeHtml(displaySymbol + " " + company) + '</span>' +
            '<span class="daily-summary-text">' + escapeHtml(reasons.join(" · ")) + ' · <span class="market-summary-action">' + escapeHtml(action) + '</span></span>' +
            '</a></li>';
        }).join("");
      }
      function updatePortfolioRisk() {
        var section = document.getElementById("portfolio-heat");
        if (!section) return;
        var summary = portfolioRiskByMarket[activeMarket];
        section.classList.toggle("is-market-empty", !summary);
        if (!summary) return;

        var baseCurrency = summary.base_currency || "TWD";
        var complete = summary.complete !== false;
        function setText(id, value) {
          var node = document.getElementById(id);
          if (node) node.textContent = value;
        }
        function riskValue(key) {
          if (!complete) return "N/A";
          var value = Number(summary[key] || 0);
          return baseCurrency + " " + Math.round(value).toLocaleString("en-US");
        }

        setText("portfolio-heat-source", complete
          ? labelsForMarket(activeMarket) + "\u98a8\u96aa\u5df2\u63db\u7b97\u70ba " + baseCurrency
          : labelsForMarket(activeMarket) + "\u90e8\u5206\u532f\u7387\u672a\u53d6\u5f97\uff0c\u4e0d\u52a0\u7e3d\u6df7\u7b97");
        setText("portfolio-risk-open", riskValue("open_risk"));
        setText("portfolio-risk-pending", riskValue("pending_risk"));
        setText("portfolio-risk-stress", riskValue("stress_risk"));
        setText("portfolio-risk-missing", String(summary.missing_stops || 0));
        setText("portfolio-risk-pending-detail", String(summary.planned_count || 0) + " \u7b46\u898f\u5283\u4e2d\u4ea4\u6613");
        var riskPct = summary.risk_pct;
        setText("portfolio-risk-open-detail", riskPct == null
          ? "\u4f9d\u6709\u6548\u505c\u640d\u8a08\u7b97"
          : Number(riskPct).toFixed(2) + "% \u5360\u5df2\u63db\u7b97\u5e02\u503c");
      }
      function updateMarketWorkspace() {
        var selectedCards = cards.filter(marketMatch);
        var marketNames = {
          us: "\u7f8e\u80a1\u5de5\u4f5c\u5340",
          taiwan: "\u53f0\u80a1\u5de5\u4f5c\u5340",
          crypto: "\u52a0\u5bc6\u8ca8\u5e63\u5de5\u4f5c\u5340"
        };
        var title = document.getElementById("market-workspace-title");
        if (title) title.textContent = marketNames[activeMarket];
        Array.prototype.forEach.call(document.querySelectorAll("[data-market-context]"), function (context) {
          context.hidden = context.dataset.marketContext !== activeMarket;
        });

        var holdingCards = selectedCards.filter(function (card) { return card.dataset.positionStatus === "holding"; });
        var knownWeights = holdingCards.map(function (card) { return parseFloat(card.dataset.positionWeight); }).filter(function (value) { return !isNaN(value); });
        var knownImpacts = holdingCards.map(function (card) { return parseFloat(card.dataset.bookImpact); }).filter(function (value) { return !isNaN(value); });
        var values = {
          "market-stat-tickers": selectedCards.length,
          "market-stat-holdings": holdingCards.length,
          "market-stat-weight": knownWeights.length ? knownWeights.reduce(function (sum, value) { return sum + value; }, 0).toFixed(1) + "%" : "\u2014",
          "market-stat-impact": knownImpacts.length ? formattedPct(knownImpacts.reduce(function (sum, value) { return sum + value; }, 0)) : "\u2014",
          "market-stat-attention": selectedCards.filter(function (card) { return card.dataset.state === "hot" || card.dataset.state === "warn"; }).length,
          "market-stat-news": selectedCards.reduce(function (sum, card) { return sum + (parseInt(card.dataset.newsCount, 10) || 0); }, 0)
        };
        Object.keys(values).forEach(function (id) {
          var node = document.getElementById(id);
          if (node) node.textContent = values[id];
        });
        ["us", "taiwan", "crypto"].forEach(function (key) {
          var tab = document.querySelector('.market-tab[data-market-tab="' + key + '"] .market-tab-count');
          if (tab) tab.textContent = cards.filter(function (card) { return marketGroup(card.dataset.market) === key; }).length;
        });

        var selectors = [
          "#strategy-screener .strategy-screen-row[data-market]", "#morning-actions .morning-action", "#daily-summary .daily-summary-item", "#hero .hero-card",
          ".command-alert", "#todays-focus .focus-list li", "#capital-allocation tbody tr",
          "#research-queue .focus-list li", "#today-catalysts li", "#post-earnings-scoreboard tbody tr",
          "#overextended li", "#rule-alerts li", "#earnings .earnings-pill",
          "#news-clusters .cluster-item", "#news .news-item", "#valuation-rows tr",
          "#changes .change-item", "#changes-30d .change-item", "#rule-alerts .alert-item",
          "#data-quality tbody tr", "#book-today .morning-tile", "#book-impact tbody tr",
          "#right-side-validation tbody tr[data-market]", ".portfolio-risk-item[data-market]"
        ].join(",");
        Array.prototype.forEach.call(document.querySelectorAll(selectors), function (element) {
          var markets = marketsForElement(element);
          element.classList.toggle("is-market-hidden", markets.length > 0 && markets.indexOf(activeMarket) < 0);
        });

        var scopedSections = [
          ["morning-actions", ".morning-action"], ["todays-focus", ".focus-list li"],
          ["capital-allocation", "tbody tr"], ["research-queue", ".focus-list li"],
          ["today-catalysts", "li"], ["post-earnings-scoreboard", "tbody tr"],
          ["overextended", "li"], ["rule-alerts", "li"], ["earnings", ".earnings-pill"],
          ["news-clusters", ".cluster-item"], ["news", ".news-item"], ["valuation", "#valuation-rows tr"],
          ["changes", ".change-item"], ["changes-30d", ".change-item"], ["rule-alerts", ".alert-item"],
          ["data-quality", "tbody tr"], ["book-today", ".morning-tile"], ["book-impact", "tbody tr"]
        ];
        scopedSections.forEach(function (entry) {
          var section = document.getElementById(entry[0]);
          if (!section) return;
          var items = Array.prototype.slice.call(section.querySelectorAll(entry[1]));
          var visible = items.filter(function (item) { return !item.classList.contains("is-market-hidden"); });
          section.classList.toggle("is-market-empty", items.length > 0 && visible.length === 0);
        });

        ["premarket", "market-sentiment", "today-catalysts", "macro"].forEach(function (id) {
          var section = document.getElementById(id);
          if (section) section.classList.toggle("is-market-hidden", activeMarket !== "us");
        });
        var marketContext = document.getElementById("market-context");
        if (marketContext) marketContext.classList.toggle("is-market-hidden", activeMarket !== "us");
        var hero = document.getElementById("hero");
        var commandCenter = document.querySelector(".command-center");
        if (hero) hero.classList.toggle("is-market-hidden", activeMarket !== "us");
        if (commandCenter) commandCenter.classList.toggle("is-market-hidden", activeMarket !== "us");
        var mapContext = document.getElementById("market-map-context");
        if (mapContext) mapContext.textContent = labelsForMarket(activeMarket) + "產業分組，跟隨頁首市場切換";
        var hasHoldings = selectedCards.some(function (card) { return card.dataset.positionStatus === "holding"; });
        var allHoldingsMatch = cards.filter(function (card) { return card.dataset.positionStatus === "holding"; }).every(marketMatch);
        ["book-today", "book-impact"].forEach(function (id) {
          var section = document.getElementById(id);
          if (section) section.classList.toggle("is-market-hidden", !hasHoldings);
        });

        var myBook = document.getElementById("my-book");
        if (myBook) myBook.classList.toggle("is-market-hidden", !hasHoldings || !allHoldingsMatch);

        updatePortfolioRisk();

        updateMarketSummary(selectedCards, values);

        var valuationCount = document.querySelector("#valuation h2 .count");
        if (valuationCount) valuationCount.textContent = "(" + selectedCards.length + " \u6a94)";
        var newsCount = document.querySelector("#news h2 .count");
        if (newsCount) newsCount.textContent = "(" + values["market-stat-news"] + ")";

        var briefValues = document.querySelectorAll("#daily-summary .brief-metric-value");
        if (briefValues.length >= 6) {
          briefValues[0].textContent = selectedCards.filter(function (card) { return card.dataset.state === "hot"; }).length;
          briefValues[1].textContent = selectedCards.filter(function (card) { var gap = parseFloat(card.dataset.premarketChange || card.dataset.gapPct); return !isNaN(gap) && Math.abs(gap) >= 3; }).length;
          briefValues[2].textContent = selectedCards.filter(function (card) { var days = parseInt(card.dataset.earningsDays, 10); return !isNaN(days) && days >= 0 && days <= 7; }).length;
          briefValues[4].textContent = selectedCards.filter(function (card) { return reviewState(card) === "reviewed"; }).length + "/" + selectedCards.length;
          var rsiValues = selectedCards.map(function (card) { return parseFloat(card.dataset.rsi); }).filter(function (value) { return !isNaN(value); });
          briefValues[5].textContent = rsiValues.length ? Math.max.apply(null, rsiValues).toFixed(0) + "/" + Math.min.apply(null, rsiValues).toFixed(0) : "N/A";
        }

        var headerTickerCount = document.getElementById("market-header-ticker-count");
        if (headerTickerCount) headerTickerCount.textContent = selectedCards.length;
        var headerEarningsCount = document.getElementById("market-header-earnings-count");
        if (headerEarningsCount) headerEarningsCount.textContent = selectedCards.filter(function (card) {
          var days = parseInt(card.dataset.earningsDays, 10);
          return !isNaN(days) && days >= 0 && days <= 7;
        }).length;
        var headerMacro = document.getElementById("market-header-macro");
        if (headerMacro) headerMacro.classList.toggle("is-market-hidden", activeMarket !== "us");
        var headerMacroSeparator = document.getElementById("market-header-macro-separator");
        if (headerMacroSeparator) headerMacroSeparator.classList.toggle("is-market-hidden", activeMarket !== "us");
        var marketSummaryMacro = document.getElementById("market-summary-macro");
        if (marketSummaryMacro) marketSummaryMacro.classList.toggle("is-market-hidden", activeMarket !== "us");
        Array.prototype.forEach.call(document.querySelectorAll(".toc a[href^='#']"), function (link) {
          var section = document.querySelector(link.getAttribute("href"));
          link.classList.toggle("is-market-hidden", !!section && (section.classList.contains("is-market-hidden") || section.classList.contains("is-market-empty")));
        });
      }

      function applyFilters() {
        var q = (search && search.value || "").trim().toLowerCase();
        var focus = focusFilter ? focusFilter.value : "all";
        var state = stateFilter ? stateFilter.value : "all";
        var earnings = earningsFilter ? earningsFilter.value : "all";
        var rsi = rsiFilter ? rsiFilter.value : "all";
        var topic = topicFilter ? topicFilter.value : "all";
        var sector = sectorFilter ? sectorFilter.value : "all";
        var cluster = clusterFilter ? clusterFilter.value : "all";
        var scoreStatus = scoreFilter ? scoreFilter.value : "all";
        var riskOnly = !!(riskFilter && riskFilter.checked);
        var watchlistOnly = document.body.classList.contains("watchlist-mode");
        var marketTotal = cards.filter(marketMatch).length;
        var visible = 0;

        cards.forEach(function (card) {
          var textMatch = !q || symbol(card).toLowerCase().indexOf(q) >= 0 || (card.dataset.company || "").indexOf(q) >= 0;
          var stateMatch = state === "all" ? (showQuiet || focus !== "all" || watchlistOnly || card.dataset.state !== "quiet") : card.dataset.state === state;
          var activeMarketMatch = marketMatch(card);
          var topicMatch = topic === "all" || (" " + (card.dataset.topics || "") + " ").indexOf(" " + topic + " ") >= 0;
          var sectorMatch = sector === "all" || (card.dataset.sector || "") === sector;
          var clusterMatch = cluster === "all" || (card.dataset.cluster || "") === cluster;
          var scoreMatch = scoreStatus === "all" || (card.dataset.rightSideStatus || "") === scoreStatus;
          var riskMatch = !riskOnly || card.dataset.hasRisk === "1";
          var pinnedMatch = !watchlistOnly || card.classList.contains("is-pinned");
          var match = pinnedMatch && textMatch && focusMatch(card, focus) && stateMatch && activeMarketMatch && earningsMatch(card, earnings) && rsiMatch(card, rsi) && topicMatch && sectorMatch && clusterMatch && scoreMatch && riskMatch && workModeMatch(card);
          card.classList.toggle("is-hidden", !match);
          syncModeDetails(card, match);
          if (match) visible += 1;
        });

        if (tickerCount) tickerCount.textContent = "(" + visible + "/" + marketTotal + ")";
        reorderCards();
        updateReviewSummary();
        renderCompare();
      }

      function syncModeDetails(card, visible) {
        var details = card.querySelector(".user-tools-details");
        if (!details) return;
        if (currentMode === "prep" && visible) details.open = true;
        if (currentMode === "overview" && !details.dataset.userOpened) details.open = false;
      }

      function jumpToSearchResult() {
        var q = (search && search.value || "").trim().toLowerCase();
        if (!q) return;
        var exact = cards.find(function (card) { return symbol(card).toLowerCase() === q; });
        var target = exact || cards.find(function (card) { return !card.classList.contains("is-hidden"); });
        if (target) target.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function setupPins() {
        cards.forEach(function (card) {
          var btn = card.querySelector("[data-pin]");
          if (!btn) return;
          function paint() {
            var on = isPinned(card);
            btn.setAttribute("aria-pressed", on ? "true" : "false");
            btn.textContent = on ? "已加入" : "焦點";
          }
          btn.addEventListener("click", function () {
            var s = symbol(card);
            pinned = isPinned(card) ? pinned.filter(function (x) { return x !== s; }) : pinned.concat([s]);
            writeJson("stock-daily-draft-pins", pinned);
            paint();
            persistAndRenderChanges();
            applyFilters();
          });
          paint();
        });
        reorderCards();
      }

      function setupUserState() {
        cards.forEach(function (card) {
          var s = symbol(card);
          var tagSelect = card.querySelector("[data-tag]");
          var tagBadge = card.querySelector("[data-tag-badge]");
          var thesisSelect = card.querySelector("[data-thesis]");
          var draftBtn = card.querySelector("[data-thesis-draft]");
          var triggerSelect = card.querySelector("[data-thesis-trigger]");
          var noteInput = card.querySelector("[data-note]");
          var revisitInput = card.querySelector("[data-revisit]");
          var details = card.querySelector(".user-tools-details");
          var boxes = Array.prototype.slice.call(card.querySelectorAll("[data-checklist] input"));
          var positionInputs = Array.prototype.slice.call(card.querySelectorAll("[data-position-field]"));
          var noteState = notes[s] || {};
          if (details) {
            details.addEventListener("toggle", function () {
              if (currentMode === "overview") details.dataset.userOpened = details.open ? "1" : "";
            });
          }

          if (tagSelect) {
            tagSelect.value = tags[s] || "";
            tagSelect.addEventListener("change", function () {
              if (tagSelect.value) tags[s] = tagSelect.value;
              else delete tags[s];
              writeJson("stock-daily-draft-tags", tags);
              paintTag(tagSelect, tagBadge);
              persistAndRenderChanges();
              renderCompare();
            });
            paintTag(tagSelect, tagBadge);
          }

          if (thesisSelect) {
            thesisSelect.value = thesis[s] || "";
            card.dataset.thesisState = thesisSelect.value || "";
            thesisSelect.addEventListener("change", function () {
              if (thesisSelect.value) thesis[s] = thesisSelect.value;
              else delete thesis[s];
              card.dataset.thesisState = thesisSelect.value || "";
              writeJson("stock-daily-draft-thesis", thesis);
              enhanceFocusFromLocalState();
              persistAndRenderChanges();
              renderCompare();
            });
          }

          if (triggerSelect) {
            triggerSelect.value = thesisTriggers[s] || "";
            card.dataset.thesisTrigger = triggerSelect.value || "";
            triggerSelect.addEventListener("change", function () {
              if (triggerSelect.value) thesisTriggers[s] = triggerSelect.value;
              else delete thesisTriggers[s];
              card.dataset.thesisTrigger = triggerSelect.value || "";
              writeJson("stock-daily-draft-thesis-triggers", thesisTriggers);
              enhanceFocusFromLocalState();
              persistAndRenderChanges();
              renderCompare();
            });
          }

          if (draftBtn) {
            draftBtn.addEventListener("click", function () {
              var originalLabel = draftBtn.textContent;
              draftBtn.disabled = true;
              draftBtn.textContent = "Drafting";
              requestThesisDraft(card).then(function (draft) {
                if (thesisSelect && !thesisSelect.value) {
                  thesisSelect.value = draft.state;
                  thesis[s] = draft.state;
                  card.dataset.thesisState = draft.state;
                  writeJson("stock-daily-draft-thesis", thesis);
                }
                if (triggerSelect && !triggerSelect.value) {
                  triggerSelect.value = draft.trigger;
                  thesisTriggers[s] = draft.trigger;
                  card.dataset.thesisTrigger = draft.trigger;
                  writeJson("stock-daily-draft-thesis-triggers", thesisTriggers);
                }
                if (noteInput && !noteInput.value.trim()) {
                  noteInput.value = draft.note;
                  notes[s] = Object.assign({}, notes[s], { note: draft.note });
                  writeJson("stock-daily-draft-notes", notes);
                  paintNotePreview(card);
                }
                enhanceFocusFromLocalState();
                persistAndRenderChanges();
                renderCompare();
                draftBtn.disabled = false;
                draftBtn.textContent = originalLabel;
              });
            });
          }

          if (noteInput) {
            noteInput.value = noteState.note || "";
            noteInput.addEventListener("input", function () {
              notes[s] = Object.assign({}, notes[s], { note: noteInput.value });
              writeJson("stock-daily-draft-notes", notes);
              paintNotePreview(card);
              persistAndRenderChanges();
              renderCompare();
            });
            paintNotePreview(card);
          }

          var thesisTextInput = card.querySelector("[data-thesis-text]");
          if (thesisTextInput) {
            thesisTextInput.value = thesisText[s] || "";
            thesisTextInput.addEventListener("input", function () {
              var val = thesisTextInput.value;
              if (val) thesisText[s] = val;
              else delete thesisText[s];
              writeJson("stock-daily-draft-thesis-text", thesisText);
              paintThesisPreview(card);
              renderCompare();
            });
            paintThesisPreview(card);
          }

          if (revisitInput) {
            revisitInput.value = noteState.revisit || "";
            revisitInput.addEventListener("change", function () {
              notes[s] = Object.assign({}, notes[s], { revisit: revisitInput.value });
              writeJson("stock-daily-draft-notes", notes);
              renderRevisitDueToday();
              persistAndRenderChanges();
            });
          }

          boxes.forEach(function (box) {
            box.checked = (checklist[s] || []).indexOf(box.value) >= 0;
            box.addEventListener("change", function () {
              var values = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
              if (values.length) checklist[s] = values;
              else delete checklist[s];
              writeJson("stock-daily-draft-checklist", checklist);
              paintReviewStatus(card);
              updateReviewSummary();
              persistAndRenderChanges();
              applyFilters();
            });
          });
          paintReviewStatus(card);

          positionInputs.forEach(function (input) {
            var field = input.dataset.positionField;
            var rec = positionStateFor(card);
            input.value = rec[field] == null ? "" : rec[field];
            input.addEventListener("input", function () {
              var current = Object.assign({}, positions[s] || positionStateFor(card));
              current[field] = field === "status" ? input.value : input.value;
              positions[s] = cleanPosition(current);
              writeJson("stock-daily-draft-positions", positions);
              applyPositionToCard(card);
              renderCompare();
            });
            input.addEventListener("change", function () {
              var current = Object.assign({}, positions[s] || positionStateFor(card));
              current[field] = input.value;
              positions[s] = cleanPosition(current);
              writeJson("stock-daily-draft-positions", positions);
              applyPositionToCard(card);
              renderCompare();
            });
          });
          applyPositionToCard(card);

          var planInputs = Array.prototype.slice.call(card.querySelectorAll("[data-plan-field]"));
          planInputs.forEach(function (input) {
            var field = input.dataset.planField;
            var planState = plans[s] || {};
            input.value = planState[field] || "";
            input.addEventListener("input", function () {
              plans[s] = Object.assign({}, plans[s]);
              plans[s][field] = input.value;
              writeJson("stock-daily-draft-plans", plans);
              paintPlanSummary(card);
            });
          });
          paintPlanSummary(card);

          var eqInputs = Array.prototype.slice.call(card.querySelectorAll("[data-eq-field]"));
          eqInputs.forEach(function (input) {
            var idx = parseInt(input.dataset.eqField, 10);
            var list = earningsQuestions[s] || [];
            input.value = list[idx] || "";
            input.addEventListener("input", function () {
              var current = (earningsQuestions[s] || []).slice();
              while (current.length <= idx) current.push("");
              current[idx] = input.value;
              earningsQuestions[s] = current;
              writeJson("stock-daily-draft-earnings-questions", earningsQuestions);
            });
          });
        });
        updateReviewSummary();
      }

      function paintPlanSummary(card) {
        var details = card.querySelector("[data-plan-card]");
        if (!details) return;
        var summary = details.querySelector("summary");
        if (!summary) return;
        var planState = plans[symbol(card)] || {};
        var filled = PLAN_FIELDS.filter(function (field) {
          return (planState[field] || "").trim();
        }).length;
        summary.textContent = filled ? "投資計畫 (" + filled + "/6)" : "投資計畫";
      }

      function paintNotePreview(card) {
        var preview = card.querySelector("[data-note-preview]");
        if (!preview) return;
        var state = notes[symbol(card)] || {};
        var note = (state.note || "").trim().replace(/\s+/g, " ");
        if (!note) {
          preview.classList.add("is-hidden");
          preview.textContent = "";
          return;
        }
        preview.textContent = "筆記：" + (note.length > 92 ? note.slice(0, 89) + "..." : note);
        preview.classList.remove("is-hidden");
      }

      function paintThesisPreview(card) {
        var preview = card.querySelector("[data-thesis-preview]");
        if (!preview) return;
        var text = (thesisText[symbol(card)] || "").trim();
        if (!text) {
          preview.classList.add("is-hidden");
          preview.textContent = "";
          return;
        }
        preview.textContent = text.length > 100 ? text.slice(0, 97) + "..." : text;
        preview.classList.remove("is-hidden");
      }

      function paintReviewStatus(card) {
        var badge = card.querySelector("[data-review-status]");
        var state = reviewState(card);
        card.dataset.reviewStatus = state;
        if (!badge) return;
        badge.textContent = reviewLabel(state);
        badge.classList.remove("reviewed", "in-progress", "not-reviewed");
        badge.classList.add(state);
      }

      function updateReviewSummary() {
        var reviewed = cards.filter(function (card) { return reviewState(card) === "reviewed"; }).length;
        if (reviewedCount) reviewedCount.textContent = reviewed + " / " + cards.length;
      }

      function renderRevisitDueToday() {
        var list = document.getElementById("revisit-due-list");
        var due = cards
          .map(function (card) {
            var s = symbol(card);
            var rec = notes[s] || {};
            return { symbol: s, revisit: rec.revisit || "", card: card };
          })
          .filter(function (row) { return row.revisit && row.revisit <= reportDate; })
          .sort(function (a, b) { return a.revisit.localeCompare(b.revisit) || a.symbol.localeCompare(b.symbol); });
        syncRevisitHero(due);
        if (!list) return;
        if (!due.length) {
          list.innerHTML = "<li><span class=\"muted\">今天沒有到期的回看項目。</span><span></span></li>";
          return;
        }
        list.innerHTML = due.slice(0, 10).map(function (row) {
          return "<li><a href=\"#" + row.card.id + "\">" + escapeHtml(row.symbol) + "</a><span>" + escapeHtml(row.revisit) + "</span></li>";
        }).join("");
      }

      function syncRevisitHero(due) {
        var hero = document.getElementById("hero");
        if (!hero) return;
        var existing = hero.querySelector("[data-local-revisit-hero]");
        if (!due.length) {
          if (existing) existing.remove();
          return;
        }
        var symbols = due.slice(0, 5).map(function (row) { return row.symbol; }).join(", ");
        var subtitle = due.length + " 檔需要回看";
        var markup = "<a class=\"hero-card imminent hero-kind-revisit\" data-local-revisit-hero=\"1\" href=\"#research-queue\">" +
          "<span class=\"hero-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><line x1=\"12\" y1=\"7\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg></span>" +
          "<div class=\"hero-body\"><span class=\"hero-label\">今日回看</span><span class=\"hero-headline\">" + escapeHtml(symbols) + "</span><span class=\"hero-sub\">" + escapeHtml(subtitle) + "</span></div>" +
          "</a>";
        if (existing) existing.outerHTML = markup;
        else hero.insertAdjacentHTML("afterbegin", markup);
      }

      function paintTag(select, badge) {
        if (!badge) return;
        badge.textContent = select.value;
        badge.classList.toggle("has-tag", !!select.value);
      }

      function setupCompare() {
        cards.forEach(function (card) {
          var box = card.querySelector(".compare-check");
          if (!box) return;
          box.addEventListener("change", function () {
            var selected = selectedCompare();
            if (selected.length > 4) {
              box.checked = false;
              return;
            }
            renderCompare();
          });
        });
      }

      function selectedCompare() {
        return cards.filter(function (card) {
          var box = card.querySelector(".compare-check");
          return box && box.checked;
        });
      }

      function tagFor(card) {
        return tags[symbol(card)] || "None";
      }

      function revisitFor(sym) {
        var rec = notes[sym];
        return (rec && rec.revisit) || "—";
      }

      function reviewStatusFor(sym) {
        var values = checklist[sym] || [];
        if (!values.length) return "—";
        if (values.length >= 4) return "已檢視";
        return values.length + "/5";
      }

      function formattedPct(value) {
        var num = numberOrNull(value);
        if (num == null) return "—";
        var sign = num >= 0 ? "+" : "";
        return sign + num.toFixed(2) + "%";
      }

      function signClass(value) {
        var num = numberOrNull(value);
        if (num == null) return "flat";
        if (num > 0) return "pos";
        if (num < 0) return "neg";
        return "flat";
      }

      function renderCompare() {
        var panel = document.getElementById("compare-panel");
        if (!panel) return;
        var selected = selectedCompare();
        if (!selected.length) {
          panel.classList.add("is-hidden");
          panel.innerHTML = "";
          return;
        }
        panel.classList.remove("is-hidden");
        var hideWeightColumns = selected.every(function (c) { return !c.dataset.positionWeight; });
        var rows = selected.map(function (card) {
          var sym = symbol(card);
          var scoreVal = card.dataset.rightSideScore || "";
          var scoreStatus = scoreStatusLabel(card.dataset.rightSideStatus || "");
          var scoreTone = card.dataset.rightSideTone || "";
          var scoreCell = scoreVal ? scoreVal + "/100 — " + scoreStatus : "—";
          var weightCells = hideWeightColumns ? "" : ("<td class=\"num\">" + formattedPct(card.dataset.positionWeight) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.bookImpact) + "\">" + formattedPct(card.dataset.bookImpact) + "</td>");
          return "<tr><td><a href=\"#" + card.id + "\">" + sym + "</a></td>" +
            "<td>" + escapeHtml(cardStateLabel(card.dataset.state || "")) + "</td>" +
            "<td class=\"score-" + escapeHtml(scoreTone) + "\">" + escapeHtml(scoreCell) + "</td>" +
            "<td class=\"trend-" + escapeHtml(card.dataset.trendTone || "") + "\">" + escapeHtml(phraseLabel(card.dataset.trend || "—")) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.dailyChange) + "\">" + formattedPct(card.dataset.dailyChange) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.fromHigh) + "\">" + formattedPct(card.dataset.fromHigh) + "</td>" +
            "<td>" + earningsText(card.dataset.earningsDays) + "</td>" +
            "<td>" + escapeHtml(reviewStatusFor(sym)) + "</td>" +
            "<td>" + escapeHtml(tagFor(card)) + "</td>" +
            "<td>" + escapeHtml(thesisTextFor(sym) || thesisStateLabel(thesisState(card))) + "</td>" +
            "<td>" + escapeHtml(thesisTriggerLabel(thesisTrigger(card))) + "</td>" +
            "<td>" + escapeHtml(revisitFor(sym)) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.premarketChange) + "\">" + formattedPct(card.dataset.premarketChange) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.gapPct) + "\">" + formattedPct(card.dataset.gapPct) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.volumeX, "x") + "</td>" +
            "<td class=\"num\">" + formattedPct(card.dataset.atrPct) + "</td>" +
            "<td class=\"num change-" + signClass(card.dataset.epsGrowth) + "\">" + formattedPct(card.dataset.epsGrowth) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "epsRev30d", "data-eps-rev-30d")) + "\">" + formattedPct(attrValue(card, "epsRev30d", "data-eps-rev-30d")) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")) + "\">" + formattedPct(attrValue(card, "revenueRev30d", "data-revenue-rev-30d")) + "</td>" +
            "<td class=\"num change-" + signClass(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")) + "\">" + formattedPct(attrValue(card, "nextQRevenueRev30d", "data-next-q-revenue-rev-30d")) + "</td>" +
            "<td>" + escapeHtml(positionStatusLabel(card.dataset.positionStatus || "watchlist")) + "</td>" +
            weightCells +
            "<td>" + escapeHtml(topWatch(card)) + "</td>" +
            "<td>" + escapeHtml(valuationRiskLabel(valuationRisk(card))) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.rsi) + "</td>" +
            "<td class=\"num\">" + (card.dataset.topNewsCount || "0") + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.marketCap) + "</td>" +
            "<td class=\"num\">" + formattedNumber(card.dataset.forwardPe, "x") + "</td></tr>";
        }).join("");
        var headerWeightCols = hideWeightColumns ? "" : "<th class=\"num\">權重</th><th class=\"num\">帳面影響</th>";
        panel.innerHTML = "<h3>比較模式 <button id=\"export-compare\" type=\"button\" class=\"tool-button\">匯出比較</button></h3>" +
          "<div class=\"compare-table-wrap\"><table><thead><tr>" +
          "<th>代碼</th><th>狀態</th><th>分數</th><th>趨勢</th><th class=\"num\">今日 %</th><th class=\"num\">距高點</th>" +
          "<th>下次財報</th><th>檢視</th><th>標籤</th><th>投資論點</th><th>觸發因素</th><th>下次檢視</th>" +
          "<th class=\"num\">盤前</th><th class=\"num\">缺口</th><th class=\"num\">量/20D</th><th class=\"num\">ATR %</th><th class=\"num\">EPS 成長</th><th class=\"num\">EPS 30D修正</th><th class=\"num\">FY1營收修正</th><th class=\"num\">下季營收修正</th><th>持股狀態</th>" +
          headerWeightCols +
          "<th>觀察重點</th><th>估值風險</th><th class=\"num\">RSI 14</th><th class=\"num\">重點新聞</th>" +
          "<th class=\"num\">市值</th><th class=\"num\">預估 P/E</th>" +
          "</tr></thead><tbody>" +
          rows + "</tbody></table></div>";
        var exportBtn = document.getElementById("export-compare");
        if (exportBtn) exportBtn.addEventListener("click", exportCompare);
      }

      function earningsText(daysValue) {
        var days = numberOrNull(daysValue);
        if (days == null) return "N/A";
        if (days < 0) return Math.abs(days) + "d ago";
        if (days === 0) return "today";
        if (days === 1) return "tomorrow";
        return "in " + days + "d";
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function (ch) {
          return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" })[ch];
        });
      }

      function targetUpsideValue(row) {
        var cell = row.querySelector(".analyst-consensus-cell");
        return cell ? cell.dataset.targetUpside : "";
      }

      function setupValuationSort() {
        var select = document.getElementById("valuation-sort");
        var tbody = document.getElementById("valuation-rows");
        if (!select || !tbody) return;
        var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));
        select.addEventListener("change", function () {
          rows.slice().sort(function (a, b) {
            if (select.value === "market_cap_desc") {
              // Market caps are in local currency — only compare within a market.
              var marketDiff = marketRank(a.dataset.market) - marketRank(b.dataset.market);
              if (marketDiff) return marketDiff;
              return sortNumberDesc(a.dataset.marketCap, b.dataset.marketCap, a.dataset.symbol, b.dataset.symbol);
            }
            if (select.value === "forward_pe_asc") return sortNumberAsc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "forward_pe_desc") return sortNumberDesc(a.dataset.forwardPe, b.dataset.forwardPe, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "eps_growth_desc") return sortNumberDesc(a.dataset.epsGrowth, b.dataset.epsGrowth, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "eps_growth_asc") return sortNumberAsc(a.dataset.epsGrowth, b.dataset.epsGrowth, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "target_upside_desc") return sortNumberDesc(targetUpsideValue(a), targetUpsideValue(b), a.dataset.symbol, b.dataset.symbol);
            if (select.value === "target_upside_asc") return sortNumberAsc(targetUpsideValue(a), targetUpsideValue(b), a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_asc") return sortNumberAsc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "rsi_desc") return sortNumberDesc(a.dataset.rsi, b.dataset.rsi, a.dataset.symbol, b.dataset.symbol);
            if (select.value === "earnings_soon") return sortNumberAsc(a.dataset.earningsDays, b.dataset.earningsDays, a.dataset.symbol, b.dataset.symbol);
            return (a.dataset.symbol || "").localeCompare(b.dataset.symbol || "");
          }).forEach(function (row) { tbody.appendChild(row); });
        });
      }

      function setupValuationColumns() {
        var table = document.getElementById("valuation-table");
        var button = document.getElementById("toggle-valuation-columns");
        if (!table || !button) return;
        button.addEventListener("click", function () {
          var compact = table.classList.toggle("is-compact");
          button.setAttribute("aria-pressed", compact ? "false" : "true");
          button.textContent = compact ? "完整欄位" : "精簡欄位";
        });
      }
      function marketRank(market) {
        if (market === "us") return 0;
        if (market === "twse" || market === "tpex") return 1;
        if (market === "crypto") return 2;
        return 3;
      }

      function sortNumberAsc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return an - bn || as.localeCompare(bs);
      }

      function sortNumberDesc(a, b, as, bs) {
        var an = numberOrNull(a);
        var bn = numberOrNull(b);
        if (an == null && bn == null) return as.localeCompare(bs);
        if (an == null) return 1;
        if (bn == null) return -1;
        return bn - an || as.localeCompare(bs);
      }

      function setupCountdowns() {
        var today = new Date("{{ report.report_date.isoformat() }}T00:00:00");
        cards.forEach(function (card) {
          var el = card.querySelector("[data-countdown]");
          if (!el) return;
          var target = new Date(el.dataset.countdown + "T00:00:00");
          var days = Math.round((target - today) / 86400000);
          var session = { before_market: "開盤前", after_market: "收盤後", during_market: "盤中", unknown: "時間待定" }[el.dataset.timeOfDay] || el.dataset.timeOfDay;
          el.textContent = days <= 0 ? "今日財報 | " + session : days === 1 ? "明日財報 | " + session : days + "天後財報 | " + session;
        });
      }

      function setupCollapsers() {
        var newsBtn = document.getElementById("toggle-news");
        if (newsBtn) {
          newsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".news-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            newsBtn.textContent = hidden ? "顯示精選" : "顯示積壓";
          });
        }
        var alertsBtn = document.getElementById("toggle-alerts");
        if (alertsBtn) {
          alertsBtn.addEventListener("click", function () {
            var extras = Array.prototype.slice.call(document.querySelectorAll(".alert-extra"));
            var hidden = extras.some(function (el) { return el.classList.contains("is-hidden"); });
            extras.forEach(function (el) { el.classList.toggle("is-hidden", !hidden); });
            alertsBtn.textContent = hidden ? "顯示前 6 名" : "顯示全部";
          });
        }
        var valuationBtn = document.getElementById("toggle-valuation");
        var valuationBody = document.getElementById("valuation-body");
        if (valuationBtn && valuationBody) {
          valuationBtn.addEventListener("click", function () {
            var hidden = valuationBody.classList.toggle("is-hidden");
            valuationBtn.textContent = hidden ? "展開" : "收合";
            valuationBtn.setAttribute("aria-expanded", hidden ? "false" : "true");
          });
        }
        if (toggleQuiet) {
          toggleQuiet.addEventListener("click", function () {
            showQuiet = !showQuiet;
            toggleQuiet.textContent = showQuiet ? "隱藏平穩股" : "顯示平穩股";
            applyFilters();
          });
        }
      }

      function setupWorkModes() {
        if (!modeButtons.length) return;
        modeButtons.forEach(function (button) {
          button.addEventListener("click", function () {
            setWorkMode(button.dataset.mode || "overview");
          });
        });
        setWorkMode("overview");
      }

      function setWorkMode(mode) {
        currentMode = mode;
        document.body.dataset.workMode = mode;
        modeButtons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.dataset.mode === mode ? "true" : "false");
        });
        var hints = {
          overview: "完整儀表板",
          review: "只看熱點催化與今日/明日財報",
          prep: "展開 7 天內財報、筆記與檢視欄位",
        };
        if (modeHint) modeHint.textContent = hints[mode] || hints.overview;
        applyFilters();
      }

      function setupQuickActions() {
        cards.forEach(function (card) {
          var sym = symbol(card);
          var doneBtn = card.querySelector("[data-quick-done]");
          var bumpBtn = card.querySelector("[data-quick-revisit]");

          if (doneBtn) {
            doneBtn.addEventListener("click", function () {
              checklist[sym] = ["earnings", "guidance", "valuation", "news", "thesis"];
              writeJson("stock-daily-draft-checklist", checklist);
              // Reflect in checkboxes if Manage is open
              card.querySelectorAll("[data-checklist] input").forEach(function (cb) {
                cb.checked = true;
              });
              paintReviewStatus(card);
              updateReviewSummary();
              applyFilters();
            });
          }

          if (bumpBtn) {
            bumpBtn.addEventListener("click", function () {
              var rec = notes[sym] || {};
              var current = rec.revisit ? new Date(rec.revisit + "T00:00:00") : new Date();
              current.setDate(current.getDate() + 1);
              var iso = current.toISOString().slice(0, 10);
              rec.revisit = iso;
              notes[sym] = rec;
              writeJson("stock-daily-draft-notes", notes);
              var input = card.querySelector("[data-revisit]");
              if (input) input.value = iso;
              renderRevisitDueToday();
              applyFilters();
            });
          }
        });
      }

      function setupPostEarnings() {
        var STORAGE_KEY = "stock-daily-draft-post-earnings";
        var state = {};
        Object.keys(tickerState).forEach(function (sym) {
          state[sym] = Object.assign({}, (tickerState[sym] && tickerState[sym].post_earnings_review) || {});
        });
        try { state = Object.assign(state, JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}")); } catch (e) {}
        window.postEarningsState = state;
        function persist() {
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
        }
        function statusOf(rec) {
          if (!rec) return "";
          var parts = [];
          if (rec.eps) parts.push("EPS " + rec.eps);
          if (rec.rev) parts.push("Rev " + rec.rev);
          if (rec.guide) parts.push("Guide " + rec.guide);
          return parts.join(" / ");
        }
        function updateScoreboard(sym) {
          var row = document.querySelector("[data-pe-score-row=\"" + sym + "\"]");
          if (!row) return;
          var rec = state[sym] || {};
          ["eps", "rev", "guide"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (cell) cell.textContent = rec[field] || cell.dataset.default || "N/A";
          });
          ["eps_surprise", "rev_surprise", "fy1_eps_revision_after", "fy1_revenue_revision_after"].forEach(function (field) {
            var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
            if (!cell) return;
            var value = numberOrNull(rec[field]);
            if (value == null) value = numberOrNull(cell.dataset.default);
            cell.textContent = value == null ? "N/A" : formattedPct(value);
            cell.classList.remove("change-pos", "change-neg", "change-flat");
            cell.classList.add("change-" + signClass(value));
          });
          var review = row.querySelector("[data-pe-score-field=\"review\"]");
          if (review) {
            var fields = ["eps", "rev", "guide", "eps_surprise", "rev_surprise", "fy1_eps_revision_after", "fy1_revenue_revision_after"];
            var done = fields.filter(function (field) {
              var cell = row.querySelector("[data-pe-score-field=\"" + field + "\"]");
              return !!rec[field] || !!(cell && cell.dataset.default);
            }).length;
            review.textContent = done >= 5 ? "已檢視" : done > 0 ? done + "/7" : "未檢視";
            review.classList.remove("done", "partial");
            if (done >= 5) review.classList.add("done");
            else if (done > 0) review.classList.add("partial");
          }
        }
        cards.forEach(function (card) {
          var details = card.querySelector("[data-post-earnings]");
          var sym = details ? details.dataset.postEarnings : symbol(card);
          var rec = state[sym] || {};
          updateScoreboard(sym);
          if (!details) return;
          var statusEl = details.querySelector("[data-pe-status]");
          if (statusEl) statusEl.textContent = statusOf(rec);

          // Buttons (eps / rev / guide)
          var buttonGroups = details.querySelectorAll("[data-pe-field]");
          buttonGroups.forEach(function (group) {
            var field = group.dataset.peField;
            var buttons = group.querySelectorAll("button[data-pe-value]");
            buttons.forEach(function (btn) {
              var val = btn.dataset.peValue;
              btn.setAttribute("aria-pressed", rec[field] === val ? "true" : "false");
              btn.addEventListener("click", function () {
                rec = state[sym] || {};
                rec[field] = rec[field] === val ? null : val;
                state[sym] = rec;
                persist();
                buttons.forEach(function (b) {
                  b.setAttribute("aria-pressed", rec[field] === b.dataset.peValue ? "true" : "false");
                });
                if (statusEl) statusEl.textContent = statusOf(rec);
                updateScoreboard(sym);
              });
            });
          });

          // Textareas (conclusion / next_step)
          var textareas = details.querySelectorAll("textarea[data-pe-field]");
          textareas.forEach(function (ta) {
            var field = ta.dataset.peField;
            ta.value = (rec[field] || "");
            ta.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = ta.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });

          var inputs = details.querySelectorAll("input[data-pe-field]");
          inputs.forEach(function (input) {
            var field = input.dataset.peField;
            input.value = (rec[field] || "");
            input.addEventListener("input", function () {
              rec = state[sym] || {};
              rec[field] = input.value;
              state[sym] = rec;
              persist();
              updateScoreboard(sym);
            });
          });
        });
      }

      function enhanceFocusFromLocalState() {
        var reviewList = document.querySelector("#research-queue .focus-column:first-child .focus-list");
        if (!reviewList) return;
        cards.forEach(function (card) {
          var state = thesisState(card);
          if (state !== "weakening" && state !== "broken") return;
          var sym = symbol(card);
          if (reviewList.querySelector("[data-local-focus=\"" + sym + "\"]")) return;
          var li = document.createElement("li");
          li.setAttribute("data-local-focus", sym);
          var trigger = thesisTrigger(card);
          var reason = "thesis " + state + (trigger !== "None" ? " | trigger: " + trigger : "");
          li.innerHTML = "<span class=\"focus-rank\">!</span><span><a href=\"#" + card.id + "\">" + escapeHtml(sym) + "</a><span class=\"focus-reason\">" + escapeHtml(reason) + "</span></span>";
          reviewList.insertBefore(li, reviewList.firstChild);
        });
      }

      function setupWatchlistMode() {
        var btn = document.getElementById("watchlist-mode-toggle");
        if (!btn) return;
        var STORAGE_KEY = "stock-daily-watchlist-mode";
        var active;
        try { active = localStorage.getItem(STORAGE_KEY) === "1"; } catch (e) { active = false; }
        function apply() {
          document.body.classList.toggle("watchlist-mode", active);
          btn.setAttribute("aria-pressed", active ? "true" : "false");
          btn.textContent = active ? "離開釘選" : "只看釘選";
          // Force-open user-tools details for pinned cards in watchlist mode
          if (active) {
            cards.forEach(function (card) {
              if (card.classList.contains("is-pinned")) {
                var d = card.querySelector(".user-tools-details");
                if (d) d.open = true;
              }
            });
          }
          applyFilters();
        }
        btn.addEventListener("click", function () {
          active = !active;
          try { localStorage.setItem(STORAGE_KEY, active ? "1" : "0"); } catch (e) {}
          apply();
        });
        apply();
      }

      function cardSnapshot(card) {
        var s = symbol(card);
        var noteState = notes[s] || {};
        return {
          symbol: s,
          state: card.dataset.state || "",
          earningsDays: numberOrNull(card.dataset.earningsDays),
          valuationRisk: valuationRisk(card),
          rsi: numberOrNull(card.dataset.rsi),
          topNews: (card.dataset.topNewsSignatures || "").split("|").filter(Boolean),
          tag: tags[s] || "",
          thesis: thesis[s] || "",
          thesisTrigger: thesisTriggers[s] || "",
          note: (noteState.note || "").trim(),
          revisit: noteState.revisit || "",
          review: reviewState(card),
          pinned: isPinned(card),
        };
      }

      function currentSnapshot() {
        var tickers = {};
        cards.forEach(function (card) { tickers[symbol(card)] = cardSnapshot(card); });
        return { date: reportDate, tickers: tickers };
      }

      function previousSnapshot(snapshots) {
        return Object.keys(snapshots)
          .filter(function (dateKey) { return dateKey < reportDate; })
          .sort()
          .map(function (dateKey) { return snapshots[dateKey]; })
          .pop() || null;
      }

      function persistAndRenderChanges() {
        return;
      }

      function renderChanges(prev, current) {
        var body = document.getElementById("changes-body");
        if (!body) return;
        if (!prev) {
          body.innerHTML = "<div class=\"section-empty\">瀏覽器本機尚無前次快照；已將本次報告保存為基準。</div>";
          return;
        }
        var changes = [];
        Object.keys(current.tickers).sort().forEach(function (s) {
          var now = current.tickers[s];
          var before = prev.tickers[s] || {};
          if (now.state === "hot" && before.state !== "hot") {
            changes.push(changeCard(s, "新增熱點", "狀態變為熱點。"));
          }
          var newTopNews = now.topNews.filter(function (newsKey) { return (before.topNews || []).indexOf(newsKey) < 0; });
          if (newTopNews.length) {
            changes.push(changeCard(s, "新增重點新聞", newTopNews.length + " 則新的重點新聞。"));
          }
          if (now.earningsDays != null && before.earningsDays != null && now.earningsDays >= 0 && now.earningsDays < before.earningsDays) {
            changes.push(changeCard(s, "財報時間接近", "由 " + earningsText(before.earningsDays) + " 變成 " + earningsText(now.earningsDays) + "。"));
          }
          if (now.valuationRisk === "Extreme" && before.valuationRisk !== "Extreme") {
            changes.push(changeCard(s, "估值風險升高", "估值風險已進入極高區。"));
          }
          if (now.rsi != null && now.rsi >= 70 && (before.rsi == null || before.rsi < 70)) {
            changes.push(changeCard(s, "RSI 進入過熱", "RSI 14 現在是 " + now.rsi.toFixed(1) + "。"));
          }
          if (now.rsi != null && now.rsi <= 30 && (before.rsi == null || before.rsi > 30)) {
            changes.push(changeCard(s, "RSI 進入超賣", "RSI 14 現在是 " + now.rsi.toFixed(1) + "。"));
          }
          if (now.tag && now.tag !== before.tag) {
            changes.push(changeCard(s, "新增標籤", now.tag + "。"));
          }
          if (now.thesis && now.thesis !== before.thesis) {
            changes.push(changeCard(s, "投資論點改變", thesisStateLabel(now.thesis) + "。"));
          }
          if (now.thesisTrigger && now.thesisTrigger !== before.thesisTrigger) {
            changes.push(changeCard(s, "論點觸發因素改變", thesisTriggerLabel(now.thesisTrigger) + "。"));
          }
          if (now.note && now.note !== before.note) {
            changes.push(changeCard(s, "新增筆記", (now.note.length > 80 ? now.note.slice(0, 77) + "..." : now.note) + "。"));
          }
          if (now.review !== before.review && now.review === "reviewed") {
            changes.push(changeCard(s, "檢視完成", reviewLabel(now.review) + "。"));
          }
        });
        if (!changes.length) {
          body.innerHTML = "<div class=\"section-empty\">相較 " + escapeHtml(prev.date || "前次報告") + " 沒有重大變化。</div>";
          return;
        }
        body.innerHTML = changes.slice(0, 12).join("");
      }

      function changeCard(symbolText, title, detail) {
        return "<a class=\"change-item\" href=\"#ticker-" + symbolText.toLowerCase() + "\"><strong>" + escapeHtml(symbolText + ": " + title) + "</strong><span>" + escapeHtml(detail) + "</span></a>";
      }

      function download(name, text, type, statusText) {
        var blob = new Blob([text], { type: type || "text/plain;charset=utf-8" });
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = name;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        var status = document.getElementById("export-status");
        if (status && statusText) status.textContent = statusText;
      }

      function exportWatchlist() {
        var lines = cards.map(function (card) {
          var s = symbol(card);
          return [s, card.dataset.state, "earnings " + earningsText(card.dataset.earningsDays), reviewLabel(reviewState(card)), "tag " + (tags[s] || "None")].join(" | ");
        });
        download("watchlist-{{ report.report_date.isoformat() }}.txt", lines.join("\n"), "text/plain;charset=utf-8", "Exported watchlist TXT: " + lines.length + " tickers - fields ticker/state/earnings/review/tag");
      }

      function exportResearchState() {

      function numberOrNull(value) {
        if (value === "" || value == null) return null;
        var n = Number(value);
        return Number.isFinite(n) ? n : null;
      }

      function attrValue(card, datasetKey, attrName) {
        return card.dataset[datasetKey] || card.getAttribute(attrName) || "";
      }

      function formattedNumber(value, suffix) {
        var n = numberOrNull(value);
        if (n == null) return "N/A";
        if (suffix) return n.toFixed(1).replace(/\.0$/, "") + suffix;
        if (Math.abs(n) >= 1e12) return (n / 1e12).toFixed(2).replace(/\.00$/, "") + "T";
        if (Math.abs(n) >= 1e9) return (n / 1e9).toFixed(1).replace(/\.0$/, "") + "B";
        if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(1).replace(/\.0$/, "") + "M";
        return n.toLocaleString();
      }

      function formattedDollar(value) {
        var n = numberOrNull(value);
        if (n == null) return "N/A";
        var sign = n < 0 ? "-" : "";
        return sign + "$" + Math.abs(n).toLocaleString(undefined, { maximumFractionDigits: 0 });
      }

      function formattedPrice(value) {
        var n = numberOrNull(value);
        return n == null ? "N/A" : "$" + n.toFixed(2);
      }

      function cleanPosition(rec) {
        rec = rec || {};
        var out = {};
        var status = (rec.status || "").trim();
        if (status) out.status = status;
        ["shares", "avg_cost", "portfolio_weight", "position_size", "stop_loss"].forEach(function (field) {
          var value = numberOrNull(rec[field]);
          if (value != null) out[field] = value;
        });
        var sector = (rec.sector || "").trim();
        if (sector) out.sector = sector;
        return out;
      }

      function positionStateFor(card) {
        var s = symbol(card);
        var rec = Object.assign({}, positions[s] || {});
        if (!rec.status) rec.status = card.dataset.positionStatus || "watchlist";
        ["shares", "avg_cost", "portfolio_weight", "position_size", "stop_loss"].forEach(function (field) {
          if (rec[field] == null || rec[field] === "") {
            var key = {
              shares: "positionShares",
              avg_cost: "positionAvgCost",
              portfolio_weight: "positionWeight",
              position_size: "positionSize",
              stop_loss: "positionStopLoss"
            }[field];
            rec[field] = numberOrNull(card.dataset[key]);

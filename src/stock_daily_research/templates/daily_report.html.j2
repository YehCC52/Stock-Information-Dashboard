      function earningsMatch(card, mode) {
        if (mode === "all") return true;
        var days = numberOrNull(card.dataset.earningsDays);
        if (days == null) return false;
        if (mode === "today") return days === 0;
        if (mode === "tomorrow") return days === 1;
        if (mode === "7d") return days >= 0 && days <= 7;
        return true;
      }

      function rsiMatch(card, mode) {
        if (mode === "all") return true;
        var rsi = numberOrNull(card.dataset.rsi);
        if (rsi == null) return false;
        if (mode === "oversold") return rsi <= 30;
        if (mode === "overbought") return rsi >= 70;
        if (mode === "neutral") return rsi > 30 && rsi < 70;
        return true;

              <div class="insight-row">
                <span class="insight-label">共識目標</span>
                <span class="insight-text">
                  {{ analyst_view.reference_kind }} {{ analyst_view.target_label }}
                  {% if analyst_view.upside_label %}<strong class="change change-{{ analyst_view.tone }}">{{ analyst_view.upside_label }}</strong>{% endif %}
                  <span class="insight-meta">Yahoo Finance 分析師共識{% if analyst_view.range_label %}｜區間 {{ analyst_view.range_label }}{% endif %}{% if analyst_view.opinion_count %}｜{{ analyst_view.opinion_count }} 位分析師{% endif %}｜擷取 {{ analyst_view.as_of_label }}{% if analyst_view.stale %}｜資料可能過舊{% endif %}</span>
                </span>

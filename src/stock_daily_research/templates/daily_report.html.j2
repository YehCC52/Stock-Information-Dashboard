      function setupMarketTabs() {
        function paint() {
          marketTabs.forEach(function (tab) {
            var selected = tab.dataset.marketTab === activeMarket;
            tab.classList.toggle("is-active", selected);
            tab.setAttribute("aria-selected", selected ? "true" : "false");
            tab.tabIndex = selected ? 0 : -1;
          });
        }
        function selectMarket(value) {
          activeMarket = value;
          try { localStorage.setItem(MARKET_STORAGE_KEY, value); } catch (e) {}
          paint();
          applyFilters();
          // Market membership is static per render, so the workspace pass runs
          // only on market switches — not on every filter/search keystroke.
          updateMarketWorkspace();
          // The sector map's panel switcher listens for this event.
          document.dispatchEvent(new CustomEvent("stock-daily:market", { detail: { market: value } }));
        }
        marketTabs.forEach(function (tab, index) {
          tab.addEventListener("click", function () { selectMarket(tab.dataset.marketTab); });
          tab.addEventListener("keydown", function (event) {
            if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
            event.preventDefault();
            var offset = event.key === "ArrowRight" ? 1 : -1;
            var next = (index + offset + marketTabs.length) % marketTabs.length;
            marketTabs[next].focus();
            selectMarket(marketTabs[next].dataset.marketTab);
          });
        });
        paint();
      }


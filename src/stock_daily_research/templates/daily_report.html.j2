<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>每日股票研究 - {{ report.report_date.isoformat() }}</title>
  <script>
    // Apply persisted theme before paint to avoid a flash. Falls back to OS preference.
    (function () {
      try {
        var t = localStorage.getItem("stock-daily-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f4f6f9;
      --surface: #ffffff;
      --surface-soft: #eaeef7;
      --surface-alt: #f5f8fc;
      --text: #0f172a;
      --muted: #5a6e81;
      --border: #cbd5e0;
      --border-soft: #e2e8f0;
      --accent: #0d9488;
      --link: #0369a1;
      --warning: #d97706;
      --warning-bg: #fef3c7;
      --danger: #dc2626;
      --danger-bg: #fee2e2;
      --good: #16a34a;
      --good-bg: #ecfdf5;
      --info: #2563eb;
      --info-bg: #eff6ff;
      --shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
      /* Sector-map diverging tiles: 3 intensity steps per side + neutral. */
      --map-up-1: rgba(22, 163, 74, 0.14);
      --map-up-2: rgba(22, 163, 74, 0.30);
      --map-up-3: rgba(22, 163, 74, 0.50);
      --map-down-1: rgba(220, 38, 38, 0.12);
      --map-down-2: rgba(220, 38, 38, 0.26);
      --map-down-3: rgba(220, 38, 38, 0.45);
      --map-flat: rgba(148, 163, 184, 0.16);
    }

    /* Dark tokens applied two ways: when OS prefers dark and no manual override,
       OR when the user explicitly picks dark via the toggle. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #0d1117;
        --surface: #161b22;
        --surface-soft: #1d232d;
        --surface-alt: #0d1117;
        --text: #c9d1d9;
        --muted: #8b949e;
        --border: #30363d;
        --border-soft: #21262d;
        --link: #58a6ff;
        --warning: #fbbf24;
        --warning-bg: #3d2817;
        --danger: #ff7b72;
        --danger-bg: #3d1f1a;
        --good: #3fb950;
        --good-bg: #0d3a1f;
        --info: #79c0ff;
        --info-bg: #1f2d3d;
        --shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        --map-up-1: rgba(63, 185, 80, 0.16);
        --map-up-2: rgba(63, 185, 80, 0.30);
        --map-up-3: rgba(63, 185, 80, 0.45);
        --map-down-1: rgba(255, 123, 114, 0.14);
        --map-down-2: rgba(255, 123, 114, 0.27);
        --map-down-3: rgba(255, 123, 114, 0.40);
        --map-flat: rgba(139, 148, 158, 0.16);
      }
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #0d1117;
      --surface: #161b22;
      --surface-soft: #1d232d;
      --surface-alt: #0d1117;
      --text: #c9d1d9;
      --muted: #8b949e;
      --border: #30363d;
      --border-soft: #21262d;
      --link: #58a6ff;
      --warning: #fbbf24;
      --warning-bg: #3d2817;
      --danger: #ff7b72;
      --danger-bg: #3d1f1a;
      --good: #3fb950;
      --good-bg: #0d3a1f;
      --info: #79c0ff;
      --info-bg: #1f2d3d;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      --map-up-1: rgba(63, 185, 80, 0.16);
      --map-up-2: rgba(63, 185, 80, 0.30);
      --map-up-3: rgba(63, 185, 80, 0.45);
      --map-down-1: rgba(255, 123, 114, 0.14);
      --map-down-2: rgba(255, 123, 114, 0.27);
      --map-down-3: rgba(255, 123, 114, 0.40);
      --map-flat: rgba(139, 148, 158, 0.16);
    }
    :root[data-theme="light"] {
      color-scheme: light;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.45;
      font-feature-settings: "tnum" 1, "cv11" 1;
      overflow-x: hidden;
    }
    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .page { max-width: 1480px; margin: 0 auto; padding: 24px; }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 18px;
    }
    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    .top-tools {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      width: min(100%, 720px);
      align-items: center;
    }
    .export-status {
      flex-basis: 100%;
      color: var(--muted);
      font-size: 11px;
      text-align: right;
      min-height: 16px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    #save-status {
      color: var(--info);
      min-height: 16px;
      font-size: 12px;
      font-weight: 500;
    }
    .search-box, .control-input, .control-select, .tag-select, .note-input, .revisit-input, .plan-input {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
    }
    .search-box {
      min-width: 240px;
      flex: 1 1 240px;
      padding: 8px 10px;
      box-shadow: var(--shadow);
    }
    .control-input, .control-select, .tag-select, .revisit-input { padding: 6px 8px; }
    .tool-button, .icon-button {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .tool-button { padding: 7px 10px; }
    .tool-button-primary {
      background: var(--info);
      color: white;
      border-color: var(--info);
      font-weight: 800;
    }
    .tool-button-primary:hover { background: color-mix(in srgb, var(--info) 90%, black); border-color: var(--info); }
    .tool-button-secondary { opacity: 0.75; }
    .tool-button-secondary:hover { opacity: 1; }
    .tool-button-success {
      background: var(--good);
      color: white;
      border-color: var(--good);
      font-weight: 800;
    }
    .tool-button-success:hover { background: color-mix(in srgb, var(--good) 90%, black); border-color: var(--good); }
    .tool-button-success:disabled { opacity: 0.6; cursor: default; }
    .tools-menu {
      position: relative;
      margin: 0;
    }
    .tools-menu > summary {
      list-style: none;
      display: inline-flex;
      align-items: center;
      min-height: 32px;
    }
    .tools-menu > summary::-webkit-details-marker { display: none; }
    .tools-menu > summary::after {
      content: "▾";
      margin-left: 6px;
      color: var(--muted);
      font-size: 10px;
    }
    .tools-menu-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 6px);
      z-index: 10;
      display: grid;
      gap: 8px;
      min-width: 220px;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }
    .tools-menu-panel .tool-button {
      justify-content: center;
      width: 100%;
    }
    .tools-menu-panel .export-status {
      display: block;
      flex-basis: auto;
      text-align: left;
      white-space: normal;
      min-height: 0;
    }
    .save-status {
      flex-basis: 100%;
      text-align: right;
      font-size: 11px;
      min-height: 14px;
      color: var(--muted);
    }
    .save-status.is-saving { color: var(--info); }
    .save-status.is-ok { color: var(--good); }
    .save-status.is-error { color: var(--danger); }
    .icon-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      font-size: 15px;
    }
    .tool-button:hover, .icon-button:hover { background: var(--surface-soft); text-decoration: none; }
    .tool-button:focus-visible, .icon-button:focus-visible, .search-box:focus-visible,
    .control-select:focus-visible, .tag-select:focus-visible, .note-input:focus-visible,
    .revisit-input:focus-visible, .plan-input:focus-visible {
      outline: 2px solid var(--info);
      outline-offset: 2px;
    }
    .theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .theme-toggle:hover { background: var(--surface-soft); }
    .theme-toggle:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
    .theme-toggle .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
    }
    :root[data-theme="dark"] .theme-toggle .dot { background: var(--info); }
    :root[data-theme="light"] .theme-toggle .dot { background: var(--warning); }
    .language-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .language-toggle:hover { background: var(--surface-soft); }
    .language-toggle:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
    h1 { margin: 0; font-size: 28px; }
    h2 { margin: 0 0 12px; font-size: 17px; display: flex; align-items: center; gap: 10px; }
    h2 .count { color: var(--muted); font-size: 13px; font-weight: 500; }
    h3 { margin: 0; font-size: 15px; }
    .muted { color: var(--muted); font-size: 13px; }

    .toc {
      display: flex;
      flex-wrap: nowrap;
      gap: 14px;
      padding: 8px 0;
      margin: 0 0 18px;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      border-bottom: 1px solid var(--border-soft);
      overflow-x: auto;
      overflow-y: hidden;
      position: sticky;
      top: 0;
      z-index: 5;
      backdrop-filter: blur(8px);
      scrollbar-width: thin;
    }
    .toc::-webkit-scrollbar { height: 6px; }
    .toc::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
    .toc a {
      padding: 2px 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      letter-spacing: 0;
    }
    .toc a:hover { color: var(--text); text-decoration: none; }
    .toc .toc-pill {
      padding: 1px 8px;
      border-radius: 999px;
      background: var(--danger-bg);
      color: var(--danger);
      font-weight: 700;
    }

    /* Command center: hero left, summary + top alerts right */
    .command-center {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.85fr);
      gap: 10px;
      margin-bottom: 14px;
      align-items: stretch;
    }
    .command-hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 8px;
    }
    .command-side {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
    }
    .command-side .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin-bottom: 0;
    }
    .command-side .stat { padding: 10px 12px; }
    .command-side .stat-value { font-size: 20px; }
    .command-alerts {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: var(--shadow);
      padding: 10px 12px;
    }
    .command-alerts-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .cc-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .cc-more { font-size: 11px; color: var(--link); }
    .command-alert-list { list-style: none; margin: 0; padding: 0; }
    .command-alert {
      border-left: 3px solid var(--border);
      padding: 5px 8px;
      margin: 4px 0;
      border-radius: 0 4px 4px 0;
      background: var(--surface-alt);
    }
    .command-alert.danger { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger-bg) 60%, var(--surface-alt)); }
    .command-alert.warning, .command-alert.warn { border-left-color: var(--warning); background: color-mix(in srgb, var(--warning-bg) 60%, var(--surface-alt)); }
    .command-alert.info { border-left-color: var(--info); }
    .command-alert a { display: flex; gap: 8px; align-items: baseline; color: var(--text); }
    .command-alert .ca-label { font-weight: 800; font-size: 12px; min-width: 48px; }
    .command-alert .ca-title { font-size: 12px; color: var(--text); line-height: 1.3; }

    .strategy-screener {
      margin-bottom: 14px;
      scroll-margin-top: 56px;
      border-color: color-mix(in srgb, var(--good) 26%, var(--border));
      background: color-mix(in srgb, var(--surface) 94%, var(--good-bg));
    }
    .strategy-screener::before { background: var(--good); }
    .strategy-screener-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 8px;
    }
    .strategy-screener-title h2 { margin: 0; }
    .strategy-screener-basis {
      display: block;
      margin-top: 3px;
      color: var(--muted);
      font-size: 12px;
    }
    .strategy-screener-control {
      display: grid;
      gap: 3px;
      min-width: min(240px, 100%);
    }
    .strategy-screener-control label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }
    .strategy-screener-control select {
      width: 100%;
      min-height: 36px;
      padding: 6px 30px 6px 9px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 13px;
    }
    .strategy-screen-description {
      margin: 0 0 10px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }
    .strategy-screen-panel[hidden] { display: none; }
    .strategy-screen-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--border);
    }
    .strategy-screen-row {
      display: grid;
      grid-template-columns: 32px minmax(132px, 0.72fr) 62px minmax(210px, 0.9fr) minmax(220px, 1.35fr);
      gap: 10px;
      align-items: center;
      min-height: 58px;
      padding: 8px 4px;
      border-bottom: 1px solid var(--border-soft);
    }
    .strategy-screen-row:hover { background: color-mix(in srgb, var(--surface-alt) 72%, transparent); }
    .strategy-rank {
      color: var(--muted);
      font-size: 12px;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }
    .strategy-identity {
      min-width: 0;
      color: var(--text);
      text-decoration: none;
    }
    .strategy-identity:hover .strategy-symbol { color: var(--link); }
    .strategy-symbol {
      display: block;
      font-size: 15px;
      font-weight: 800;
      overflow-wrap: anywhere;
    }
    .strategy-company {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.25;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .strategy-score {
      display: inline-flex;
      gap: 4px;
      align-items: center;
      justify-content: center;
      min-width: 0;
      font-size: 17px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      text-align: center;
      white-space: nowrap;
    }
    .score-trend {
      display: inline-flex;
      gap: 2px;
      align-items: center;
      font-size: 10px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      white-space: nowrap;
    }
    .score-trend-up { color: var(--good); }
    .score-trend-down { color: var(--danger); }
    .score-trend-flat { color: var(--muted); }
    .health-tone-good { color: var(--good); }
    .health-tone-mixed { color: var(--warning); }
    .health-tone-danger { color: var(--danger); }
    .health-tone-warn { color: var(--warning); }
    .health-tone-na, .health-tone-quiet { color: var(--muted); }
    .health-dimension-strip {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 5px;
      min-width: 0;
    }
    .health-mini {
      display: grid;
      grid-template-columns: 14px minmax(0, 1fr);
      gap: 3px;
      align-items: center;
      min-width: 0;
      color: var(--muted);
      font-size: 10px;
    }
    .health-mini-bar {
      display: block;
      height: 5px;
      overflow: hidden;
      background: var(--border-soft);
    }
    .health-mini-bar::after {
      content: "";
      display: block;
      width: var(--health-value, 0%);
      height: 100%;
      background: var(--warning);
    }
    .health-mini.health-tone-good .health-mini-bar::after { background: var(--good); }
    .health-mini.health-tone-danger .health-mini-bar::after { background: var(--danger); }
    .health-mini.health-tone-na .health-mini-bar::after { background: var(--border); }
    .strategy-reason {
      min-width: 0;
      color: var(--text);
      font-size: 12px;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .strategy-action {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }
    .strategy-empty {
      margin: 0;
      padding: 14px 4px 4px;
      color: var(--muted);
      font-size: 12px;
    }
    .health-diagnostic {
      margin: 9px 0 0;
      padding: 0;
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border-soft);
    }
    .health-diagnostic > summary {
      display: grid;
      grid-template-columns: minmax(78px, 1fr) auto auto auto;
      gap: 8px;
      align-items: center;
      min-height: 34px;
      color: var(--text);
      list-style-position: inside;
    }
    .health-diagnostic-title { font-size: 12px; font-weight: 800; }
    .health-diagnostic-score {
      display: inline-flex;
      gap: 5px;
      align-items: center;
      font-size: 15px;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .health-diagnostic-status { font-size: 12px; font-weight: 700; }
    .health-diagnostic-coverage { color: var(--muted); font-size: 10px; }
    .health-diagnostic-body {
      display: grid;
      gap: 6px;
      padding: 2px 0 9px;
    }
    .health-dimension-row {
      display: grid;
      grid-template-columns: 74px 34px minmax(80px, 0.55fr) minmax(140px, 1.45fr);
      gap: 8px;
      align-items: center;
      min-width: 0;
      font-size: 11px;
    }
    .health-dimension-label { font-weight: 700; }
    .health-dimension-score { font-variant-numeric: tabular-nums; text-align: right; }
    .health-dimension-meter {
      display: block;
      height: 6px;
      overflow: hidden;
      background: var(--border-soft);
    }
    .health-dimension-meter > span {
      display: block;
      width: var(--health-value, 0%);
      height: 100%;
      background: var(--warning);
    }
    .health-dimension-row.health-tone-good .health-dimension-meter > span { background: var(--good); }
    .health-dimension-row.health-tone-danger .health-dimension-meter > span { background: var(--danger); }
    .health-dimension-evidence {
      min-width: 0;
      color: var(--muted);
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .health-diagnostic-action {
      margin-top: 2px;
      padding-top: 7px;
      border-top: 1px solid var(--border-soft);
      color: var(--text);
      font-size: 11px;
      line-height: 1.4;
    }
    .health-diagnostic-action strong { color: var(--muted); }
    .daily-summary {
      border-color: color-mix(in srgb, var(--info) 28%, var(--border));
      background: color-mix(in srgb, var(--surface) 90%, var(--info-bg));
      margin-bottom: 14px;
    }
    .daily-summary::before { background: var(--info); }
    .signal-validation {
      margin-bottom: 14px;
      border-color: color-mix(in srgb, var(--good) 34%, var(--border));
      background: color-mix(in srgb, var(--surface) 92%, var(--good-bg));
    }
    .signal-validation::before { background: var(--good); }
    .signal-validation-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }
    .signal-validation-head h2 { margin: 0; }
    .signal-validation-stat { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
    .signal-validation table { margin: 0; }
    .signal-validation td, .signal-validation th { white-space: nowrap; }
    .daily-summary.danger {
      border-color: color-mix(in srgb, var(--danger) 36%, var(--border));
      background: color-mix(in srgb, var(--surface) 84%, var(--danger-bg));
    }
    .daily-summary.danger::before { background: var(--danger); }
    .daily-summary.warn {
      border-color: color-mix(in srgb, var(--warning) 36%, var(--border));
      background: color-mix(in srgb, var(--surface) 84%, var(--warning-bg));
    }
    .daily-summary.warn::before { background: var(--warning); }
    .daily-summary-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .daily-summary-head h2 { margin: 0; }
    .daily-summary-detail {
      color: var(--muted);
      font-size: 12px;
      text-align: right;
    }
    .daily-summary-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr);
      gap: 12px;
      align-items: start;
    }
    .daily-summary-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 8px;
    }
    .daily-summary-item a {
      display: grid;
      grid-template-columns: minmax(64px, max-content) minmax(0, 1fr);
      gap: 6px 10px;
      align-items: baseline;
      padding: 8px 10px;
      border: 1px solid var(--border-soft);
      border-left: 3px solid var(--info);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      min-height: 52px;
    }
    .daily-summary-item a:hover {
      border-color: var(--border);
      text-decoration: none;
    }
    .daily-summary-item.danger a { border-left-color: var(--danger); }
    .daily-summary-item.warn a,
    .daily-summary-item.warning a { border-left-color: var(--warning); }
    .daily-summary-item.good a { border-left-color: var(--good); }
    .daily-summary-label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }
    .daily-summary-title {
      font-size: 14px;
      font-weight: 800;
      line-height: 1.3;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .daily-summary-text {
      grid-column: 2;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .brief-metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      padding: 8px;
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      background: color-mix(in srgb, var(--surface) 86%, var(--surface-alt));
    }
    .brief-metric {
      min-width: 0;
      padding: 6px 8px;
      border-radius: 5px;
      background: var(--surface);
      border: 1px solid var(--border-soft);
    }
    .brief-metric-value {
      display: block;
      color: var(--text);
      font-size: 18px;
      line-height: 1.1;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    .brief-metric-label {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }
    .brief-metric.alert .brief-metric-value { color: var(--warning); }
    .brief-metric.alert.danger .brief-metric-value { color: var(--danger); }

    /* Hero card itself (used inside .command-hero) */
    .hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }
    .hero-card {
      display: grid;
      grid-template-columns: 30px 1fr;
      gap: 10px;
      align-items: start;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      box-shadow: var(--shadow);
      color: var(--text);
      position: relative;
      transition: transform 80ms ease, box-shadow 80ms ease;
    }
    .hero-card:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.10); }
    .hero-card.imminent { border-color: var(--danger); background: var(--danger-bg); }
    .hero-card.soon { border-color: var(--warning); background: var(--warning-bg); }
    .hero-card.info { border-color: var(--info); background: var(--info-bg); }
    .hero-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: color-mix(in srgb, currentColor 12%, transparent);
      color: var(--muted);
    }
    .hero-card.imminent .hero-icon { color: var(--danger); }
    .hero-card.soon .hero-icon { color: var(--warning); }
    .hero-card.info .hero-icon { color: var(--info); }
    .hero-body { display: flex; flex-direction: column; min-width: 0; }
    .hero-card .hero-label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; }
    .hero-card.imminent .hero-label { color: var(--danger); }
    .hero-card.soon .hero-label { color: var(--warning); }
    .hero-card.info .hero-label { color: var(--info); }
    .hero-card .hero-headline {
      display: block;
      font-size: 16px;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: 0;
      margin-bottom: 3px;
      color: var(--text);
    }
    .hero-card .hero-sub { display: block; color: var(--muted); font-size: 12px; }

    /* Header focus line */
    .focus-line { font-size: 12px; font-weight: 600; color: var(--text); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .focus-line .sep { color: var(--border); }
    .focus-line .focus-num { font-variant-numeric: tabular-nums; }
    .disclaimer { font-size: 11px; opacity: 0.75; }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(140px, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }
    .stat, .section, .ticker-card {
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 8px;
    }
    .stat { padding: 12px 14px; }
    .stat-value { display: block; font-size: 24px; font-weight: 700; line-height: 1.1; }
    .stat-label { display: block; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
    .stat.alert .stat-value { color: var(--warning); }
    .stat.alert.danger .stat-value { color: var(--danger); }

    .section { padding: 16px; margin-bottom: 16px; position: relative; min-width: 0; }
    .section::before {
      content: "";
      position: absolute;
      top: 12px;
      bottom: 12px;
      left: 0;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: transparent;
    }
    .section-primary {
      background: color-mix(in srgb, var(--surface) 88%, var(--info-bg));
      border-color: color-mix(in srgb, var(--info) 28%, var(--border));
    }
    .section-primary::before { background: var(--info); }
    .section-secondary {
      background: color-mix(in srgb, var(--surface) 94%, var(--surface-soft));
    }
    .section-secondary::before { background: color-mix(in srgb, var(--muted) 45%, transparent); }
    .section-tertiary {
      box-shadow: none;
      background: var(--surface);
      border-color: var(--border-soft);
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .section-header h2 { margin-bottom: 0; }
    .section-empty { color: var(--muted); font-size: 13px; padding: 6px 0; }
    .priority-list, .alert-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 10px;
    }
    .priority-item, .alert-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
    }
    .priority-item:hover, .alert-item:hover { text-decoration: none; background: var(--info-bg); }
    .priority-label, .alert-label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }
    .priority-headline, .alert-title { display: block; font-weight: 800; line-height: 1.3; }
    .priority-subtitle, .alert-detail { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .alert-item.danger { border-color: var(--danger); background: var(--danger-bg); }
    .alert-item.warn { border-color: var(--warning); background: var(--warning-bg); }
    .morning-grid, .catalyst-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }
    .morning-tile, .catalyst-card {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
      min-width: 0;
    }
    .morning-tile .label, .catalyst-card .label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .morning-tile .value {
      display: block;
      font-size: 20px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
    }
    .morning-tile .value.change-info { color: var(--info); }
    .morning-tile .value.change-warn { color: var(--warning); }
    .morning-tile .sub, .catalyst-card .sub {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .mover-list, .catalyst-list { list-style: none; margin: 0; padding: 0; }
    .mover-list li, .catalyst-list li {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .mover-list li:last-child, .catalyst-list li:last-child { border-bottom: none; }
    .macro-risk {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 10px;
    }
    .risk-meter {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      padding: 9px 10px;
      background: var(--surface-alt);
    }
    .risk-meter .risk-name { display: block; font-size: 12px; font-weight: 800; }
    .risk-meter .risk-level {
      display: inline-flex;
      margin-top: 4px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .risk-meter.low .risk-level { color: var(--good); background: var(--good-bg); }
    .risk-meter.medium .risk-level { color: var(--warning); background: var(--warning-bg); }
    .risk-meter.high .risk-level { color: var(--danger); background: var(--danger-bg); }
    .risk-meter .risk-detail { display: block; color: var(--muted); font-size: 11px; margin-top: 4px; }
    .focus-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .focus-column {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
      position: relative;
      overflow: hidden;
    }
    .focus-column.review { border-color: color-mix(in srgb, var(--info) 30%, var(--border)); }
    .focus-column.chase { border-color: color-mix(in srgb, var(--danger) 30%, var(--border)); }
    .focus-column.pullback { border-color: color-mix(in srgb, var(--good) 30%, var(--border)); }
    .focus-column::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: var(--border);
    }
    .focus-column.review::before { background: var(--info); }
    .focus-column.chase::before { background: var(--danger); }
    .focus-column.pullback::before { background: var(--good); }
    .focus-column h3 {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .focus-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      color: var(--surface);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0;
    }
    .focus-column.review .focus-icon { background: var(--info); }
    .focus-column.chase .focus-icon { background: var(--danger); }
    .focus-column.pullback .focus-icon { background: var(--good); }
    .focus-list { list-style: none; margin: 0; padding: 0; }
    .focus-list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      column-gap: 8px;
      padding: 8px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .focus-list li:last-child { border-bottom: none; }
    .focus-rank {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-soft);
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      grid-row: span 2;
    }
    .focus-list a { font-weight: 800; color: var(--text); }
    .focus-reason { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .heatmap-table { min-width: 560px; }
    .heatmap-table .symbols { color: var(--muted); font-size: 12px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sector-map {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 12px;
      margin-bottom: 10px;
    }
    .map-group {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px;
      min-width: 0;
    }
    .map-group-head {
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .map-group-name { font-weight: 600; font-size: 14px; }
    .map-group-avg { font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; }
    .map-group-trend { color: var(--muted); font-size: 12px; margin-left: auto; white-space: nowrap; }
    .map-tiles { display: flex; flex-wrap: wrap; gap: 3px; }
    .map-tile {
      flex: 1 1 84px;
      min-width: 72px;
      max-width: 170px;
      border-radius: 6px;
      padding: 8px 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      color: var(--text);
      border: 1px solid transparent;
    }
    .map-tile:hover { text-decoration: none; border-color: var(--border); }
    .map-tile-symbol { font-weight: 700; font-size: 13px; letter-spacing: 0.02em; }
    .map-tile-change { font-size: 12px; font-variant-numeric: tabular-nums; }
    .bin-up-1 { background: var(--map-up-1); }
    .bin-up-2 { background: var(--map-up-2); }
    .bin-up-3 { background: var(--map-up-3); }
    .bin-down-1 { background: var(--map-down-1); }
    .bin-down-2 { background: var(--map-down-2); }
    .bin-down-3 { background: var(--map-down-3); }
    .bin-flat { background: var(--map-flat); }
    .bin-na { background: transparent; border: 1px dashed var(--border-soft); color: var(--muted); }
    .map-legend {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 10px;
    }
    .map-legend .chip { padding: 2px 8px; border-radius: 4px; color: var(--text); font-variant-numeric: tabular-nums; }
    .map-detail summary { cursor: pointer; color: var(--muted); font-size: 13px; margin-bottom: 8px; }
    .map-market-panel { display: none; }
    .map-market-panel.active { display: block; }
    .map-panel-title { display: none; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
    .map-breadth { display: flex; gap: 10px; font-size: 13px; color: var(--muted); margin-bottom: 8px; font-variant-numeric: tabular-nums; }
    @media (max-width: 760px) {
      .market-workspace { grid-template-columns: 1fr; padding: 10px; }
      .market-workspace-stats { grid-column: auto; }
      .map-group-trend { margin-left: 0; flex-basis: 100%; }
    }
    .position-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: 8px 0;
    }
    .position-chip {
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 6px 8px;
      background: var(--surface-alt);
      min-width: 0;
    }
    .position-chip .label { display: block; color: var(--muted); font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .position-chip .value { display: block; font-weight: 800; font-size: 13px; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .card-secondary {
      margin-top: 8px;
      border-top: 1px solid var(--border-soft);
    }
    .card-secondary > summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      padding: 7px 0 0;
    }
    .card-secondary > summary::-webkit-details-marker { display: none; }
    .card-secondary > summary::after {
      content: "顯示";
      color: var(--link);
      font-size: 11px;
      font-weight: 800;
    }
    .card-secondary[open] > summary::after { content: "隱藏"; }
    .mode-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      margin-bottom: 8px;
    }
    .mode-button[aria-pressed="true"] {
      color: var(--info);
      border-color: var(--info);
      background: var(--info-bg);
    }
    .mode-hint {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      margin-left: auto;
    }
    .change-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .change-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
      font-size: 13px;
    }
    .change-item:hover { text-decoration: none; background: var(--info-bg); }
    .change-item strong { display: block; margin-bottom: 2px; }

    .macro-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 10px;
    }
    .macro-card {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .macro-card.rates { border-color: var(--warning); background: var(--warning-bg); }
    .macro-card.jobs { border-color: var(--info); background: var(--info-bg); }
    .macro-card.inflation { border-color: var(--danger); background: var(--danger-bg); }
    .macro-card .name { display: block; font-weight: 800; }
    .macro-card .time { display: block; margin-top: 2px; font-size: 13px; }
    .macro-card .note { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
    .macro-card .note.long {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-height: 3em;
    }
    .sort-hint {
      color: var(--muted);
      font-size: 11px;
      margin: -8px 0 10px;
      letter-spacing: 0.02em;
    }
    .head-link {
      font-size: 11px;
      font-weight: 600;
      color: var(--danger);
      white-space: nowrap;
      margin-left: 4px;
    }
    .head-link:hover { text-decoration: underline; }

    /* Earnings pills */
    .earnings-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
    }
    .earnings-pill {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .earnings-pill.imminent {
      border-color: var(--danger);
      border-width: 2px;
      background: var(--danger-bg);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 20%, transparent), 0 4px 8px rgba(185, 28, 28, 0.15);
    }
    .earnings-pill.soon { border-color: var(--warning); background: var(--warning-bg); }
    .earnings-pill.week { border-color: var(--good); background: var(--good-bg); }
    .earnings-pill .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .earnings-pill .symbol { font-weight: 800; font-size: 16px; }
    .earnings-pill .when { font-size: 12px; font-weight: 600; }
    .earnings-pill.imminent .when { color: var(--danger); }
    .earnings-pill.soon .when { color: var(--warning); }
    .earnings-pill.week .when { color: var(--good); }
    .earnings-pill .name { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .earnings-pill .date { color: var(--muted); font-size: 11px; }

    /* Tables */
    .table-wrap {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: auto;
      max-height: 560px;
      max-width: 100%;
    }
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }
    thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--surface-alt);
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    th.num, td.num { text-align: right; }
    tbody td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: middle;
    }
    tbody tr:nth-child(even) td { background: var(--surface-alt); }
    tbody tr:hover td { background: var(--info-bg); }
    tbody tr:last-child td { border-bottom: none; }
    .symbol-cell a { color: var(--text); font-weight: 800; }
    .valuation-controls, .ticker-controls, .export-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }
    .market-workspace {
      display: grid;
      grid-template-columns: minmax(180px, 0.7fr) minmax(360px, 1.3fr) minmax(320px, 1fr);
      gap: 12px;
      align-items: center;
      margin: 0 0 12px;
      padding: 12px 14px;
      border-top: 3px solid var(--info);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    .market-workspace-copy { min-width: 0; }
    .market-workspace-title {
      display: block;
      color: var(--text);
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0;
    }
    .market-workspace-subtitle {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }
    .market-workspace-stats {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 6px;
    }
    .market-workspace-stat {
      min-width: 0;
      padding: 6px 8px;
      border-left: 1px solid var(--border-soft);
    }
    .market-workspace-stat strong {
      display: block;
      color: var(--text);
      font-size: 15px;
      font-variant-numeric: tabular-nums;
    }
    .market-workspace-stat span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }
    .taiwan-margin-context {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(180px, 0.7fr) auto minmax(260px, 1.3fr) auto;
      gap: 8px 16px;
      align-items: center;
      min-width: 0;
      padding-top: 10px;
      border-top: 1px solid var(--border-soft);
    }
    .taiwan-margin-context[hidden] { display: none; }
    .taiwan-margin-heading {
      display: grid;
      gap: 2px;
      min-width: 0;
    }
    .taiwan-margin-heading strong { color: var(--text); font-size: 12px; }
    .taiwan-margin-status { color: var(--muted); font-size: 11px; font-weight: 700; }
    .taiwan-margin-context.tone-good .taiwan-margin-status { color: var(--good); }
    .taiwan-margin-context.tone-warning .taiwan-margin-status { color: var(--warning); }
    .taiwan-margin-context.tone-danger .taiwan-margin-status { color: var(--danger); }
    .taiwan-margin-value {
      color: var(--text);
      font-size: 22px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    .taiwan-margin-detail {
      display: grid;
      gap: 2px;
      min-width: 0;
      color: var(--text);
      font-size: 11px;
      line-height: 1.4;
    }
    .taiwan-margin-metrics {
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      overflow-wrap: anywhere;
    }
    .taiwan-margin-source {
      color: var(--muted);
      font-size: 10px;
      text-align: right;
      white-space: nowrap;
    }
    @media (max-width: 760px) {
      .taiwan-margin-context { grid-template-columns: minmax(0, 1fr) auto; }
      .taiwan-margin-detail, .taiwan-margin-source { grid-column: 1 / -1; }
      .taiwan-margin-source { text-align: left; white-space: normal; }
    }
    @media (max-width: 480px) {
      .taiwan-margin-context { grid-template-columns: 1fr; }
      .taiwan-margin-value, .taiwan-margin-detail, .taiwan-margin-source { grid-column: 1; }
    }
    .is-market-hidden, .is-market-empty { display: none !important; }
    .market-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: min(100%, 520px);
      gap: 4px;
      margin: 0 0 12px;
      padding: 4px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface-alt);
    }
    .market-tab {
      min-width: 0;
      min-height: 38px;
      padding: 6px 10px;
      border: 1px solid transparent;
      border-radius: 6px;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0;
      cursor: pointer;
    }
    .market-tab:hover { color: var(--text); background: var(--surface-soft); }
    .market-tab.is-active {
      color: var(--text);
      background: var(--surface);
      border-color: var(--border);
      box-shadow: var(--shadow);
    }
    .market-workspace .market-tabs { width: 100%; margin: 0; }
    .market-tab-count {
      display: inline-flex;
      justify-content: center;
      min-width: 22px;
      margin-left: 4px;
      color: var(--muted);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    .valuation-view-note { color: var(--muted); font-size: 11px; }
    .valuation-table.is-compact .valuation-secondary { display: none; }
    .valuation-table:not(.is-compact) .valuation-primary-only { display: none; }
    .eps-outlook { min-width: 176px; white-space: nowrap; }
    .eps-outlook-values { color: var(--text); }
    .eps-outlook-signal { margin-left: 6px; font-size: 11px; font-weight: 700; }
    .analyst-consensus-cell { min-width: 168px; white-space: nowrap; }
    .analyst-consensus-upside { margin-left: 6px; font-size: 11px; font-weight: 700; }
    .analyst-consensus-stale {
      margin-left: 5px; color: var(--warning); font-size: 10px; font-weight: 700;
    }
    .market-map-context { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
    .market-summary-action { color: var(--link); font-weight: 700; }    .control-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }
    .control-label.checkbox { color: var(--text); }
    .is-hidden { display: none !important; }
    .dimmed { opacity: 0.48; }

    /* P/E heatmap hints */
    .pe-elevated { color: var(--warning); }
    .pe-high { color: var(--danger); font-weight: 600; }
    .pe-extreme { color: var(--danger); font-weight: 800; background: var(--danger-bg); padding: 1px 6px; border-radius: 4px; }
    .pe-neg { color: var(--muted); }
    .rsi-high, .rsi-extreme { color: var(--danger); font-weight: 700; }
    .rsi-low, .rsi-extreme-low { color: var(--info); font-weight: 700; }
    .rsi-extreme, .rsi-extreme-low { background: var(--info-bg); padding: 1px 6px; border-radius: 4px; }
    .rsi-extreme { background: var(--danger-bg); }
    .delta-up   { color: var(--good, #16a34a); font-size: 0.75rem; margin-left: 3px; }
    .delta-down { color: var(--danger, #dc2626); font-size: 0.75rem; margin-left: 3px; }

    .attn-breakdown {
      display: flex;
      width: 100%;
      height: 5px;
      margin-top: 4px;
      border-radius: 3px;
      overflow: hidden;
      background: var(--border-soft);
    }
    .attn-seg { display: block; height: 100%; }
    .attn-seg.attn-news    { background: var(--info); }
    .attn-seg.attn-burst   { background: var(--accent); }
    .attn-seg.attn-earnings{ background: var(--warning); }
    .attn-seg.attn-risk    { background: var(--danger); }
    .attn-seg.attn-holding { background: var(--good); }
    .attn-seg.attn-stale   { background: var(--muted); }

    .morning-actions { border: 1px solid var(--border); border-left: 4px solid var(--danger); }
    .morning-actions-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .morning-action a {
      display: grid; grid-template-columns: minmax(90px, auto) 1fr auto; gap: 10px;
      align-items: baseline; padding: 8px 12px; border-radius: 6px;
      text-decoration: none; color: var(--text); background: var(--surface-alt, var(--surface));
      border-left: 3px solid var(--border);
    }
    .morning-action a:hover { background: var(--info-bg); }
    .morning-action.tone-danger a { border-left-color: var(--danger); }
    .morning-action.tone-warn a   { border-left-color: #d97706; }
    .morning-action.tone-good a   { border-left-color: var(--good, #16a34a); }
    .morning-action.tone-info a   { border-left-color: var(--info, #2563eb); }
    .ma-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 700; }
    .ma-headline { font-weight: 600; }
    .ma-detail { font-size: 0.8rem; color: var(--muted); }
    .plan-trigger-chip { font-size: 0.72rem; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--border); margin-left: 4px; }
    .plan-trigger-chip.tone-danger { color: var(--danger); border-color: var(--danger); }
    .plan-trigger-chip.tone-good   { color: var(--good, #16a34a); border-color: var(--good, #16a34a); }
    .plan-trigger-chip.tone-info   { color: var(--info, #2563eb); border-color: var(--info, #2563eb); }
    .sparkline { vertical-align: middle; }
    @media (max-width: 640px) {
      .morning-action a { grid-template-columns: 1fr; gap: 2px; }
    }

    .sentiment-panel {
      display: grid;
      grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr);
      gap: 12px;
      align-items: stretch;
    }
    .sentiment-score {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      padding: 14px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .sentiment-score strong { font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums; }
    .sentiment-score span { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .sentiment-components {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
    }
    .sentiment-component {
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      font-size: 12px;
    }
    .sentiment-component strong { display: block; margin-bottom: 3px; }
    .sentiment-component .component-score { color: var(--muted); }

    /* Daily change & 52w distance signs */
    .change.change-pos { color: var(--good); font-weight: 600; }
    .change.change-neg { color: var(--danger); font-weight: 600; }
    .change.change-flat { color: var(--muted); }

    /* Sector tag under company name */
    .ticker-sector {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.02em;
      margin-top: 2px;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      background: var(--surface-soft);
      color: var(--muted);
      letter-spacing: 0.02em;
    }
    .badge.warn { color: var(--warning); background: var(--warning-bg); }
    .badge.danger { color: var(--danger); background: var(--danger-bg); }
    .badge.good { color: var(--good); background: var(--good-bg); }
    .badge.info { color: var(--info); background: var(--info-bg); }

    /* News */
    .news-list { margin: 0; padding: 0; list-style: none; }
    .news-item {
      display: grid;
      grid-template-columns: 60px 1fr;
      grid-template-rows: auto auto;
      gap: 4px 12px;
      padding: 12px 14px;
      border-left: 3px solid transparent;
      border-bottom: 1px solid var(--border-soft);
      margin: 0 -12px;
    }
    .news-item:last-child { border-bottom: none; }
    .news-item .symbol {
      grid-row: 1 / span 2;
      grid-column: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--surface-soft);
      color: var(--text);
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 0.02em;
      height: 22px;
      align-self: start;
      margin-top: 2px;
    }
    .news-item .title {
      grid-row: 1;
      grid-column: 2;
      font-size: 14px;
      line-height: 1.35;
    }
    .news-item .title a { color: var(--text); }
    .news-item .meta {
      grid-row: 2;
      grid-column: 2;
      display: flex;
      gap: 8px;
      align-items: center;
      font-size: 11px;
      color: var(--muted);
    }
    .news-item .news-why {
      grid-row: 2;
      grid-column: 2;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--text);
      font-style: normal;
      margin: 0;
      padding: 2px 8px;
      border-radius: 4px;
      background: color-mix(in srgb, var(--info-bg) 60%, transparent);
    }
    .news-item .news-why .why-label {
      font-weight: 700;
      color: var(--info);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 9px;
    }
    /* If we have a Why row, put meta after it. They share row 2 so keep them in a flex column. */
    .news-item.has-why .meta { grid-row: 3; }
    /* Top tier — strongest visual */
    .news-item.tier-top {
      border-left-color: var(--danger);
      border-left-width: 4px;
      background: color-mix(in srgb, var(--danger-bg) 45%, transparent);
    }
    .news-item.tier-top .title { font-weight: 700; font-size: 15px; }
    .news-item.tier-top .symbol { background: var(--danger-bg); color: var(--danger); }
    /* Primary — medium */
    .news-item.tier-primary { border-left-color: var(--warning); }
    .news-item.tier-primary .symbol { background: var(--warning-bg); color: var(--warning); }
    /* Editor pick — discreet badge after the title (top tier only) */
    .news-item.editor-pick .title::after {
      content: "Editor pick";
      display: inline-flex;
      margin-left: 8px;
      padding: 1px 6px;
      border-radius: 999px;
      color: var(--info);
      background: var(--info-bg);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      vertical-align: middle;
    }
    /* Minor — clearly downweight */
    .news-item.tier-minor {
      opacity: 0.55;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .news-item.tier-minor:hover { opacity: 1; }
    .news-item.tier-minor .title { font-size: 13px; }
    .news-item.tier-minor .title a { color: var(--muted); }
    .news-item.tier-minor .news-why { display: none; }
    .news-item .news-why .why-label {
      font-style: normal;
      font-weight: 700;
      color: var(--info);
      letter-spacing: 0.02em;
    }

    /* Watchlist-only mode */
    body.watchlist-mode #watchlist-mode-toggle {
      background: var(--info);
      color: var(--bg);
      border-color: var(--info);
    }
    body.watchlist-mode .ticker-card:not(.is-pinned) { display: none; }
    /* Hide everything that isn't the daily-driver core when in watchlist mode */
    body.watchlist-mode #overextended,
    body.watchlist-mode #market-sentiment,
    body.watchlist-mode #changes,
    body.watchlist-mode #valuation,
    body.watchlist-mode #news,
    body.watchlist-mode .legend,
    body.watchlist-mode .filter-row { display: none; }
    /* Bigger pinned cards */
    body.watchlist-mode .ticker-grid {
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 16px;
    }
    body.watchlist-mode .ticker-card {
      padding: 18px 20px;
    }
    body.watchlist-mode .ticker-card .ticker-symbol { font-size: 22px; }
    body.watchlist-mode .ticker-card .ticker-name { font-size: 14px; }
    /* Surface review status, revisit, and notes preview directly — no need to expand Manage */
    body.watchlist-mode .ticker-card .note-preview { display: block; }
    body.watchlist-mode .ticker-card .review-status { display: inline-flex; }
    body.watchlist-mode .ticker-card .insights {
      font-size: 13px;
    }

    /* Post-earnings review banner */
    .post-earnings {
      margin: 8px 0;
      padding: 8px 10px;
      background: var(--info-bg);
      border: 1px solid color-mix(in srgb, var(--info) 30%, var(--border));
      border-radius: 6px;
    }
    .post-earnings > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .post-earnings > summary::-webkit-details-marker { display: none; }
    .post-earnings > summary::before {
      content: "▸ ";
      font-size: 10px;
      color: var(--info);
    }
    .post-earnings[open] > summary::before { content: "▾ "; }
    .pre-earnings {
      margin: 8px 0;
      padding: 8px 10px;
      background: var(--warning-bg);
      border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));
      border-radius: 6px;
    }
    .pre-earnings > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .pre-earnings > summary::-webkit-details-marker { display: none; }
    .pre-earnings > summary::before { content: "▸ "; font-size: 10px; color: var(--warning); }
    .pre-earnings[open] > summary::before { content: "▾ "; }
    .pe-pill.pre { color: var(--warning); }
    .pe-status.extended { color: var(--danger); margin-left: auto; }
    .pre-earnings-body { margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
    .pre-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 6px;
    }
    .pre-metric {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 4px 6px;
      background: var(--surface);
      border-radius: 4px;
    }
    .pre-k { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .pre-v { font-size: 13px; font-weight: 700; }
    .pre-questions { display: flex; flex-direction: column; gap: 4px; }
    .pre-q-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .pre-q-input {
      width: 100%;
      padding: 5px 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      border-radius: 4px;
      resize: vertical;
    }
    .pe-pill {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--info);
      background: var(--surface);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .pe-meta { color: var(--muted); font-size: 11px; }
    .pe-status { color: var(--good); font-size: 11px; font-weight: 700; margin-left: auto; }
    .pe-status:empty::before { content: "尚未檢視"; color: var(--warning); font-weight: 600; }
    .post-earnings-form {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 8px;
    }
    .pe-row { display: flex; align-items: center; gap: 8px; }
    .pe-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      width: 64px;
    }
    .pe-buttons { display: flex; gap: 4px; }
    .pe-buttons button {
      padding: 4px 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 11px;
      border-radius: 4px;
      cursor: pointer;
    }
    .pe-buttons button:hover { background: var(--surface-soft); }
    .pe-buttons button[aria-pressed="true"] {
      background: var(--info-bg);
      border-color: var(--info);
      color: var(--info);
      font-weight: 700;
    }
    .pe-buttons button[data-pe-value="miss"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="down"][aria-pressed="true"] {
      background: var(--danger-bg);
      border-color: var(--danger);
      color: var(--danger);
    }
    .pe-buttons button[data-pe-value="beat"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="up"][aria-pressed="true"] {
      background: var(--good-bg);
      border-color: var(--good);
      color: var(--good);
    }
    .pe-text {
      width: 100%;
      min-height: 36px;
      resize: vertical;
      padding: 6px 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      border-radius: 4px;
    }
    .scoreboard-status {
      display: inline-flex;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--surface-soft);
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      min-width: 72px;
      justify-content: center;
    }
    .scoreboard-status.done { color: var(--good); background: var(--good-bg); }
    .scoreboard-status.partial { color: var(--warning); background: var(--warning-bg); }

    /* Macro overlay (rates + breadth) — sits next to market sentiment */
    .macro-overlay {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }
    @media (max-width: 760px) {
      .market-workspace { grid-template-columns: 1fr; padding: 10px; }
      .market-workspace-stats { grid-column: auto; } .macro-overlay { grid-template-columns: 1fr; } }
    .rates-list, .breadth-list { list-style: none; margin: 6px 0 8px; padding: 0; }
    .rate-row, .breadth-row {
      display: grid;
      gap: 12px;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-soft);

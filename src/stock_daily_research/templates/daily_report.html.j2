<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>每日股票研究 - {{ report.report_date.isoformat() }}</title>
  <script>
    // Apply persisted theme before paint to avoid a flash. Falls back to OS preference.
    (function () {
      try {
        var t = localStorage.getItem("stock-daily-theme");
        if (t === "dark" || t === "light") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f4f6f9;
      --surface: #ffffff;
      --surface-soft: #eaeef7;
      --surface-alt: #f5f8fc;
      --text: #0f172a;
      --muted: #5a6e81;
      --border: #cbd5e0;
      --border-soft: #e2e8f0;
      --accent: #0d9488;
      --link: #0369a1;
      --warning: #d97706;
      --warning-bg: #fef3c7;
      --danger: #dc2626;
      --danger-bg: #fee2e2;
      --good: #16a34a;
      --good-bg: #ecfdf5;
      --info: #2563eb;
      --info-bg: #eff6ff;
      --shadow: 0 2px 8px rgba(15, 23, 42, 0.12);
      /* Sector-map diverging tiles: 3 intensity steps per side + neutral. */
      --map-up-1: rgba(22, 163, 74, 0.14);
      --map-up-2: rgba(22, 163, 74, 0.30);
      --map-up-3: rgba(22, 163, 74, 0.50);
      --map-down-1: rgba(220, 38, 38, 0.12);
      --map-down-2: rgba(220, 38, 38, 0.26);
      --map-down-3: rgba(220, 38, 38, 0.45);
      --map-flat: rgba(148, 163, 184, 0.16);
    }

    /* Dark tokens applied two ways: when OS prefers dark and no manual override,
       OR when the user explicitly picks dark via the toggle. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #0d1117;
        --surface: #161b22;
        --surface-soft: #1d232d;
        --surface-alt: #0d1117;
        --text: #c9d1d9;
        --muted: #8b949e;
        --border: #30363d;
        --border-soft: #21262d;
        --link: #58a6ff;
        --warning: #fbbf24;
        --warning-bg: #3d2817;
        --danger: #ff7b72;
        --danger-bg: #3d1f1a;
        --good: #3fb950;
        --good-bg: #0d3a1f;
        --info: #79c0ff;
        --info-bg: #1f2d3d;
        --shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        --map-up-1: rgba(63, 185, 80, 0.16);
        --map-up-2: rgba(63, 185, 80, 0.30);
        --map-up-3: rgba(63, 185, 80, 0.45);
        --map-down-1: rgba(255, 123, 114, 0.14);
        --map-down-2: rgba(255, 123, 114, 0.27);
        --map-down-3: rgba(255, 123, 114, 0.40);
        --map-flat: rgba(139, 148, 158, 0.16);
      }
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #0d1117;
      --surface: #161b22;
      --surface-soft: #1d232d;
      --surface-alt: #0d1117;
      --text: #c9d1d9;
      --muted: #8b949e;
      --border: #30363d;
      --border-soft: #21262d;
      --link: #58a6ff;
      --warning: #fbbf24;
      --warning-bg: #3d2817;
      --danger: #ff7b72;
      --danger-bg: #3d1f1a;
      --good: #3fb950;
      --good-bg: #0d3a1f;
      --info: #79c0ff;
      --info-bg: #1f2d3d;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
      --map-up-1: rgba(63, 185, 80, 0.16);
      --map-up-2: rgba(63, 185, 80, 0.30);
      --map-up-3: rgba(63, 185, 80, 0.45);
      --map-down-1: rgba(255, 123, 114, 0.14);
      --map-down-2: rgba(255, 123, 114, 0.27);
      --map-down-3: rgba(255, 123, 114, 0.40);
      --map-flat: rgba(139, 148, 158, 0.16);
    }
    :root[data-theme="light"] {
      color-scheme: light;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.45;
      font-feature-settings: "tnum" 1, "cv11" 1;
      overflow-x: hidden;
    }
    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .page { max-width: 1480px; margin: 0 auto; padding: 24px; }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      margin-bottom: 18px;
    }
    .header-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    .top-tools {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
      width: min(100%, 720px);
      align-items: center;
    }
    .export-status {
      flex-basis: 100%;
      color: var(--muted);
      font-size: 11px;
      text-align: right;
      min-height: 16px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    #save-status {
      color: var(--info);
      min-height: 16px;
      font-size: 12px;
      font-weight: 500;
    }
    .search-box, .control-input, .control-select, .tag-select, .note-input, .revisit-input, .plan-input {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
    }
    .search-box {
      min-width: 240px;
      flex: 1 1 240px;
      padding: 8px 10px;
      box-shadow: var(--shadow);
    }
    .control-input, .control-select, .tag-select, .revisit-input { padding: 6px 8px; }
    .tool-button, .icon-button {
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .tool-button { padding: 7px 10px; }
    .tool-button-primary {
      background: var(--info);
      color: white;
      border-color: var(--info);
      font-weight: 800;
    }
    .tool-button-primary:hover { background: color-mix(in srgb, var(--info) 90%, black); border-color: var(--info); }
    .tool-button-secondary { opacity: 0.75; }
    .tool-button-secondary:hover { opacity: 1; }
    .tool-button-success {
      background: var(--good);
      color: white;
      border-color: var(--good);
      font-weight: 800;
    }
    .tool-button-success:hover { background: color-mix(in srgb, var(--good) 90%, black); border-color: var(--good); }
    .tool-button-success:disabled { opacity: 0.6; cursor: default; }
    .tools-menu {
      position: relative;
      margin: 0;
    }
    .tools-menu > summary {
      list-style: none;
      display: inline-flex;
      align-items: center;
      min-height: 32px;
    }
    .tools-menu > summary::-webkit-details-marker { display: none; }
    .tools-menu > summary::after {
      content: "▾";
      margin-left: 6px;
      color: var(--muted);
      font-size: 10px;
    }
    .tools-menu-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 6px);
      z-index: 10;
      display: grid;
      gap: 8px;
      min-width: 220px;
      padding: 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }
    .tools-menu-panel .tool-button {
      justify-content: center;
      width: 100%;
    }
    .tools-menu-panel .export-status {
      display: block;
      flex-basis: auto;
      text-align: left;
      white-space: normal;
      min-height: 0;
    }
    .save-status {
      flex-basis: 100%;
      text-align: right;
      font-size: 11px;
      min-height: 14px;
      color: var(--muted);
    }
    .save-status.is-saving { color: var(--info); }
    .save-status.is-ok { color: var(--good); }
    .save-status.is-error { color: var(--danger); }
    .icon-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      padding: 0;
      font-size: 15px;
    }
    .tool-button:hover, .icon-button:hover { background: var(--surface-soft); text-decoration: none; }
    .tool-button:focus-visible, .icon-button:focus-visible, .search-box:focus-visible,
    .control-select:focus-visible, .tag-select:focus-visible, .note-input:focus-visible,
    .revisit-input:focus-visible, .plan-input:focus-visible {
      outline: 2px solid var(--info);
      outline-offset: 2px;
    }
    .theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .theme-toggle:hover { background: var(--surface-soft); }
    .theme-toggle:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
    .theme-toggle .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
    }
    :root[data-theme="dark"] .theme-toggle .dot { background: var(--info); }
    :root[data-theme="light"] .theme-toggle .dot { background: var(--warning); }
    .language-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: var(--shadow);
    }
    .language-toggle:hover { background: var(--surface-soft); }
    .language-toggle:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }
    h1 { margin: 0; font-size: 28px; }
    h2 { margin: 0 0 12px; font-size: 17px; display: flex; align-items: center; gap: 10px; }
    h2 .count { color: var(--muted); font-size: 13px; font-weight: 500; }
    h3 { margin: 0; font-size: 15px; }
    .muted { color: var(--muted); font-size: 13px; }

    .toc {
      display: flex;
      flex-wrap: nowrap;
      gap: 14px;
      padding: 8px 0;
      margin: 0 0 18px;
      background: color-mix(in srgb, var(--bg) 82%, transparent);
      border-bottom: 1px solid var(--border-soft);
      overflow-x: auto;
      overflow-y: hidden;
      position: sticky;
      top: 0;
      z-index: 5;
      backdrop-filter: blur(8px);
      scrollbar-width: thin;
    }
    .toc::-webkit-scrollbar { height: 6px; }
    .toc::-webkit-scrollbar-thumb { background: var(--border); border-radius: 999px; }
    .toc a {
      padding: 2px 0;
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
      letter-spacing: 0;
    }
    .toc a:hover { color: var(--text); text-decoration: none; }
    .toc .toc-pill {
      padding: 1px 8px;
      border-radius: 999px;
      background: var(--danger-bg);
      color: var(--danger);
      font-weight: 700;
    }

    /* Command center: hero left, summary + top alerts right */
    .command-center {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.85fr);
      gap: 10px;
      margin-bottom: 14px;
      align-items: stretch;
    }
    .command-hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 8px;
    }
    .command-side {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 0;
    }
    .command-side .summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin-bottom: 0;
    }
    .command-side .stat { padding: 10px 12px; }
    .command-side .stat-value { font-size: 20px; }
    .command-alerts {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      box-shadow: var(--shadow);
      padding: 10px 12px;
    }
    .command-alerts-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 6px;
    }
    .cc-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .cc-more { font-size: 11px; color: var(--link); }
    .command-alert-list { list-style: none; margin: 0; padding: 0; }
    .command-alert {
      border-left: 3px solid var(--border);
      padding: 5px 8px;
      margin: 4px 0;
      border-radius: 0 4px 4px 0;
      background: var(--surface-alt);
    }
    .command-alert.danger { border-left-color: var(--danger); background: color-mix(in srgb, var(--danger-bg) 60%, var(--surface-alt)); }
    .command-alert.warning, .command-alert.warn { border-left-color: var(--warning); background: color-mix(in srgb, var(--warning-bg) 60%, var(--surface-alt)); }
    .command-alert.info { border-left-color: var(--info); }
    .command-alert a { display: flex; gap: 8px; align-items: baseline; color: var(--text); }
    .command-alert .ca-label { font-weight: 800; font-size: 12px; min-width: 48px; }
    .command-alert .ca-title { font-size: 12px; color: var(--text); line-height: 1.3; }

    .daily-summary {
      border-color: color-mix(in srgb, var(--info) 28%, var(--border));
      background: color-mix(in srgb, var(--surface) 90%, var(--info-bg));
      margin-bottom: 14px;
    }
    .daily-summary::before { background: var(--info); }
    .daily-summary.danger {
      border-color: color-mix(in srgb, var(--danger) 36%, var(--border));
      background: color-mix(in srgb, var(--surface) 84%, var(--danger-bg));
    }
    .daily-summary.danger::before { background: var(--danger); }
    .daily-summary.warn {
      border-color: color-mix(in srgb, var(--warning) 36%, var(--border));
      background: color-mix(in srgb, var(--surface) 84%, var(--warning-bg));
    }
    .daily-summary.warn::before { background: var(--warning); }
    .daily-summary-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .daily-summary-head h2 { margin: 0; }
    .daily-summary-detail {
      color: var(--muted);
      font-size: 12px;
      text-align: right;
    }
    .daily-summary-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr);
      gap: 12px;
      align-items: start;
    }
    .daily-summary-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 8px;
    }
    .daily-summary-item a {
      display: grid;
      grid-template-columns: minmax(64px, max-content) minmax(0, 1fr);
      gap: 6px 10px;
      align-items: baseline;
      padding: 8px 10px;
      border: 1px solid var(--border-soft);
      border-left: 3px solid var(--info);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      min-height: 52px;
    }
    .daily-summary-item a:hover {
      border-color: var(--border);
      text-decoration: none;
    }
    .daily-summary-item.danger a { border-left-color: var(--danger); }
    .daily-summary-item.warn a,
    .daily-summary-item.warning a { border-left-color: var(--warning); }
    .daily-summary-item.good a { border-left-color: var(--good); }
    .daily-summary-label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }
    .daily-summary-title {
      font-size: 14px;
      font-weight: 800;
      line-height: 1.3;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .daily-summary-text {
      grid-column: 2;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .brief-metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      padding: 8px;
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      background: color-mix(in srgb, var(--surface) 86%, var(--surface-alt));
    }
    .brief-metric {
      min-width: 0;
      padding: 6px 8px;
      border-radius: 5px;
      background: var(--surface);
      border: 1px solid var(--border-soft);
    }
    .brief-metric-value {
      display: block;
      color: var(--text);
      font-size: 18px;
      line-height: 1.1;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    .brief-metric-label {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }
    .brief-metric.alert .brief-metric-value { color: var(--warning); }
    .brief-metric.alert.danger .brief-metric-value { color: var(--danger); }

    /* Hero card itself (used inside .command-hero) */
    .hero {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }
    .hero-card {
      display: grid;
      grid-template-columns: 30px 1fr;
      gap: 10px;
      align-items: start;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      box-shadow: var(--shadow);
      color: var(--text);
      position: relative;
      transition: transform 80ms ease, box-shadow 80ms ease;
    }
    .hero-card:hover { transform: translateY(-1px); text-decoration: none; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.10); }
    .hero-card.imminent { border-color: var(--danger); background: var(--danger-bg); }
    .hero-card.soon { border-color: var(--warning); background: var(--warning-bg); }
    .hero-card.info { border-color: var(--info); background: var(--info-bg); }
    .hero-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 6px;
      background: color-mix(in srgb, currentColor 12%, transparent);
      color: var(--muted);
    }
    .hero-card.imminent .hero-icon { color: var(--danger); }
    .hero-card.soon .hero-icon { color: var(--warning); }
    .hero-card.info .hero-icon { color: var(--info); }
    .hero-body { display: flex; flex-direction: column; min-width: 0; }
    .hero-card .hero-label { display: block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 4px; }
    .hero-card.imminent .hero-label { color: var(--danger); }
    .hero-card.soon .hero-label { color: var(--warning); }
    .hero-card.info .hero-label { color: var(--info); }
    .hero-card .hero-headline {
      display: block;
      font-size: 16px;
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: 0;
      margin-bottom: 3px;
      color: var(--text);
    }
    .hero-card .hero-sub { display: block; color: var(--muted); font-size: 12px; }

    /* Header focus line */
    .focus-line { font-size: 12px; font-weight: 600; color: var(--text); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .focus-line .sep { color: var(--border); }
    .focus-line .focus-num { font-variant-numeric: tabular-nums; }
    .disclaimer { font-size: 11px; opacity: 0.75; }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(140px, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }
    .stat, .section, .ticker-card {
      background: var(--surface);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      border-radius: 8px;
    }
    .stat { padding: 12px 14px; }
    .stat-value { display: block; font-size: 24px; font-weight: 700; line-height: 1.1; }
    .stat-label { display: block; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
    .stat.alert .stat-value { color: var(--warning); }
    .stat.alert.danger .stat-value { color: var(--danger); }

    .section { padding: 16px; margin-bottom: 16px; position: relative; min-width: 0; }
    .section::before {
      content: "";
      position: absolute;
      top: 12px;
      bottom: 12px;
      left: 0;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: transparent;
    }
    .section-primary {
      background: color-mix(in srgb, var(--surface) 88%, var(--info-bg));
      border-color: color-mix(in srgb, var(--info) 28%, var(--border));
    }
    .section-primary::before { background: var(--info); }
    .section-secondary {
      background: color-mix(in srgb, var(--surface) 94%, var(--surface-soft));
    }
    .section-secondary::before { background: color-mix(in srgb, var(--muted) 45%, transparent); }
    .section-tertiary {
      box-shadow: none;
      background: var(--surface);
      border-color: var(--border-soft);
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .section-header h2 { margin-bottom: 0; }
    .section-empty { color: var(--muted); font-size: 13px; padding: 6px 0; }
    .priority-list, .alert-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 10px;
    }
    .priority-item, .alert-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
    }
    .priority-item:hover, .alert-item:hover { text-decoration: none; background: var(--info-bg); }
    .priority-label, .alert-label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 3px;
    }
    .priority-headline, .alert-title { display: block; font-weight: 800; line-height: 1.3; }
    .priority-subtitle, .alert-detail { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .alert-item.danger { border-color: var(--danger); background: var(--danger-bg); }
    .alert-item.warn { border-color: var(--warning); background: var(--warning-bg); }
    .morning-grid, .catalyst-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
    }
    .morning-tile, .catalyst-card {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
      min-width: 0;
    }
    .morning-tile .label, .catalyst-card .label {
      display: block;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .morning-tile .value {
      display: block;
      font-size: 20px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
    }
    .morning-tile .value.change-info { color: var(--info); }
    .morning-tile .value.change-warn { color: var(--warning); }
    .morning-tile .sub, .catalyst-card .sub {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .mover-list, .catalyst-list { list-style: none; margin: 0; padding: 0; }
    .mover-list li, .catalyst-list li {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 5px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .mover-list li:last-child, .catalyst-list li:last-child { border-bottom: none; }
    .macro-risk {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 8px;
      margin-top: 10px;
    }
    .risk-meter {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      padding: 9px 10px;
      background: var(--surface-alt);
    }
    .risk-meter .risk-name { display: block; font-size: 12px; font-weight: 800; }
    .risk-meter .risk-level {
      display: inline-flex;
      margin-top: 4px;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .risk-meter.low .risk-level { color: var(--good); background: var(--good-bg); }
    .risk-meter.medium .risk-level { color: var(--warning); background: var(--warning-bg); }
    .risk-meter.high .risk-level { color: var(--danger); background: var(--danger-bg); }
    .risk-meter .risk-detail { display: block; color: var(--muted); font-size: 11px; margin-top: 4px; }
    .focus-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .focus-column {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px 12px;
      position: relative;
      overflow: hidden;
    }
    .focus-column.review { border-color: color-mix(in srgb, var(--info) 30%, var(--border)); }
    .focus-column.chase { border-color: color-mix(in srgb, var(--danger) 30%, var(--border)); }
    .focus-column.pullback { border-color: color-mix(in srgb, var(--good) 30%, var(--border)); }
    .focus-column::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      background: var(--border);
    }
    .focus-column.review::before { background: var(--info); }
    .focus-column.chase::before { background: var(--danger); }
    .focus-column.pullback::before { background: var(--good); }
    .focus-column h3 {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .focus-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      color: var(--surface);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0;
    }
    .focus-column.review .focus-icon { background: var(--info); }
    .focus-column.chase .focus-icon { background: var(--danger); }
    .focus-column.pullback .focus-icon { background: var(--good); }
    .focus-list { list-style: none; margin: 0; padding: 0; }
    .focus-list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      column-gap: 8px;
      padding: 8px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .focus-list li:last-child { border-bottom: none; }
    .focus-rank {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: var(--surface);
      border: 1px solid var(--border-soft);
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      grid-row: span 2;
    }
    .focus-list a { font-weight: 800; color: var(--text); }
    .focus-reason { display: block; color: var(--muted); font-size: 12px; margin-top: 2px; }
    .heatmap-table { min-width: 560px; }
    .heatmap-table .symbols { color: var(--muted); font-size: 12px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sector-map {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 12px;
      margin-bottom: 10px;
    }
    .map-group {
      border: 1px solid var(--border-soft);
      border-radius: 8px;
      background: var(--surface-alt);
      padding: 10px;
      min-width: 0;
    }
    .map-group-head {
      display: flex;
      align-items: baseline;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .map-group-name { font-weight: 600; font-size: 14px; }
    .map-group-avg { font-weight: 700; font-size: 15px; font-variant-numeric: tabular-nums; }
    .map-group-trend { color: var(--muted); font-size: 12px; margin-left: auto; white-space: nowrap; }
    .map-tiles { display: flex; flex-wrap: wrap; gap: 3px; }
    .map-tile {
      flex: 1 1 84px;
      min-width: 72px;
      max-width: 170px;
      border-radius: 6px;
      padding: 8px 6px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      color: var(--text);
      border: 1px solid transparent;
    }
    .map-tile:hover { text-decoration: none; border-color: var(--border); }
    .map-tile-symbol { font-weight: 700; font-size: 13px; letter-spacing: 0.02em; }
    .map-tile-change { font-size: 12px; font-variant-numeric: tabular-nums; }
    .bin-up-1 { background: var(--map-up-1); }
    .bin-up-2 { background: var(--map-up-2); }
    .bin-up-3 { background: var(--map-up-3); }
    .bin-down-1 { background: var(--map-down-1); }
    .bin-down-2 { background: var(--map-down-2); }
    .bin-down-3 { background: var(--map-down-3); }
    .bin-flat { background: var(--map-flat); }
    .bin-na { background: transparent; border: 1px dashed var(--border-soft); color: var(--muted); }
    .map-legend {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 10px;
    }
    .map-legend .chip { padding: 2px 8px; border-radius: 4px; color: var(--text); font-variant-numeric: tabular-nums; }
    .map-detail summary { cursor: pointer; color: var(--muted); font-size: 13px; margin-bottom: 8px; }
    .map-market-panel { display: none; }
    .map-market-panel.active { display: block; }
    .map-panel-title { display: none; font-weight: 600; font-size: 14px; margin-bottom: 6px; }
    .map-breadth { display: flex; gap: 10px; font-size: 13px; color: var(--muted); margin-bottom: 8px; font-variant-numeric: tabular-nums; }
    @media (max-width: 760px) {
      .market-workspace { grid-template-columns: 1fr; padding: 10px; }
      .market-workspace-stats { grid-column: auto; }
      .map-group-trend { margin-left: 0; flex-basis: 100%; }
    }
    .position-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: 8px 0;
    }
    .position-chip {
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 6px 8px;
      background: var(--surface-alt);
      min-width: 0;
    }
    .position-chip .label { display: block; color: var(--muted); font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
    .position-chip .value { display: block; font-weight: 800; font-size: 13px; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .card-secondary {
      margin-top: 8px;
      border-top: 1px solid var(--border-soft);
    }
    .card-secondary > summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      padding: 7px 0 0;
    }
    .card-secondary > summary::-webkit-details-marker { display: none; }
    .card-secondary > summary::after {
      content: "顯示";
      color: var(--link);
      font-size: 11px;
      font-weight: 800;
    }
    .card-secondary[open] > summary::after { content: "隱藏"; }
    .mode-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      margin-bottom: 8px;
    }
    .mode-button[aria-pressed="true"] {
      color: var(--info);
      border-color: var(--info);
      background: var(--info-bg);
    }
    .mode-hint {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      margin-left: auto;
    }
    .change-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 10px;
    }
    .change-item {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      color: var(--text);
      font-size: 13px;
    }
    .change-item:hover { text-decoration: none; background: var(--info-bg); }
    .change-item strong { display: block; margin-bottom: 2px; }

    .macro-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 10px;
    }
    .macro-card {
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .macro-card.rates { border-color: var(--warning); background: var(--warning-bg); }
    .macro-card.jobs { border-color: var(--info); background: var(--info-bg); }
    .macro-card .name { display: block; font-weight: 800; }
    .macro-card .time { display: block; margin-top: 2px; font-size: 13px; }
    .macro-card .note { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
    .macro-card .note.long {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-height: 3em;
    }
    .sort-hint {
      color: var(--muted);
      font-size: 11px;
      margin: -8px 0 10px;
      letter-spacing: 0.02em;
    }
    .head-link {
      font-size: 11px;
      font-weight: 600;
      color: var(--danger);
      white-space: nowrap;
      margin-left: 4px;
    }
    .head-link:hover { text-decoration: underline; }

    /* Earnings pills */
    .earnings-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 10px;
    }
    .earnings-pill {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .earnings-pill.imminent {
      border-color: var(--danger);
      border-width: 2px;
      background: var(--danger-bg);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 20%, transparent), 0 4px 8px rgba(185, 28, 28, 0.15);
    }
    .earnings-pill.soon { border-color: var(--warning); background: var(--warning-bg); }
    .earnings-pill.week { border-color: var(--good); background: var(--good-bg); }
    .earnings-pill .top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
    .earnings-pill .symbol { font-weight: 800; font-size: 16px; }
    .earnings-pill .when { font-size: 12px; font-weight: 600; }
    .earnings-pill.imminent .when { color: var(--danger); }
    .earnings-pill.soon .when { color: var(--warning); }
    .earnings-pill.week .when { color: var(--good); }
    .earnings-pill .name { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .earnings-pill .date { color: var(--muted); font-size: 11px; }

    /* Tables */
    .table-wrap {
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: auto;
      max-height: 560px;
      max-width: 100%;
    }
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }
    thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: var(--surface-alt);
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    th.num, td.num { text-align: right; }
    tbody td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: middle;
    }
    tbody tr:nth-child(even) td { background: var(--surface-alt); }
    tbody tr:hover td { background: var(--info-bg); }
    tbody tr:last-child td { border-bottom: none; }
    .symbol-cell a { color: var(--text); font-weight: 800; }
    .valuation-controls, .ticker-controls, .export-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
      margin-bottom: 12px;
    }
    .market-workspace {
      display: grid;
      grid-template-columns: minmax(180px, 0.7fr) minmax(360px, 1.3fr) minmax(320px, 1fr);
      gap: 12px;
      align-items: center;
      margin: 0 0 12px;
      padding: 12px 14px;
      border-top: 3px solid var(--info);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    .market-workspace-copy { min-width: 0; }
    .market-workspace-title {
      display: block;
      color: var(--text);
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0;
    }
    .market-workspace-subtitle {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 11px;
    }
    .market-workspace-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .market-workspace-stat {
      min-width: 0;
      padding: 6px 8px;
      border-left: 1px solid var(--border-soft);
    }
    .market-workspace-stat strong {
      display: block;
      color: var(--text);
      font-size: 15px;
      font-variant-numeric: tabular-nums;
    }
    .market-workspace-stat span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }
    .is-market-hidden, .is-market-empty { display: none !important; }
    .market-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: min(100%, 520px);
      gap: 4px;
      margin: 0 0 12px;
      padding: 4px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface-alt);
    }
    .market-tab {
      min-width: 0;
      min-height: 38px;
      padding: 6px 10px;
      border: 1px solid transparent;
      border-radius: 6px;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0;
      cursor: pointer;
    }
    .market-tab:hover { color: var(--text); background: var(--surface-soft); }
    .market-tab.is-active {
      color: var(--text);
      background: var(--surface);
      border-color: var(--border);
      box-shadow: var(--shadow);
    }
    .market-workspace .market-tabs { width: 100%; margin: 0; }
    .market-tab-count {
      display: inline-flex;
      justify-content: center;
      min-width: 22px;
      margin-left: 4px;
      color: var(--muted);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
    }
    .valuation-view-note { color: var(--muted); font-size: 11px; }
    .valuation-table.is-compact .valuation-secondary { display: none; }
    .market-map-context { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
    .market-summary-action { color: var(--link); font-weight: 700; }    .control-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
    }
    .control-label.checkbox { color: var(--text); }
    .is-hidden { display: none !important; }
    .dimmed { opacity: 0.48; }

    /* P/E heatmap hints */
    .pe-elevated { color: var(--warning); }
    .pe-high { color: var(--danger); font-weight: 600; }
    .pe-extreme { color: var(--danger); font-weight: 800; background: var(--danger-bg); padding: 1px 6px; border-radius: 4px; }
    .pe-neg { color: var(--muted); }
    .rsi-high, .rsi-extreme { color: var(--danger); font-weight: 700; }
    .rsi-low, .rsi-extreme-low { color: var(--info); font-weight: 700; }
    .rsi-extreme, .rsi-extreme-low { background: var(--info-bg); padding: 1px 6px; border-radius: 4px; }
    .rsi-extreme { background: var(--danger-bg); }
    .delta-up   { color: var(--good, #16a34a); font-size: 0.75rem; margin-left: 3px; }
    .delta-down { color: var(--danger, #dc2626); font-size: 0.75rem; margin-left: 3px; }

    .morning-actions { border: 1px solid var(--border); border-left: 4px solid var(--danger); }
    .morning-actions-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .morning-action a {
      display: grid; grid-template-columns: minmax(90px, auto) 1fr auto; gap: 10px;
      align-items: baseline; padding: 8px 12px; border-radius: 6px;
      text-decoration: none; color: var(--text); background: var(--surface-alt, var(--surface));
      border-left: 3px solid var(--border);
    }
    .morning-action a:hover { background: var(--info-bg); }
    .morning-action.tone-danger a { border-left-color: var(--danger); }
    .morning-action.tone-warn a   { border-left-color: #d97706; }
    .morning-action.tone-good a   { border-left-color: var(--good, #16a34a); }
    .morning-action.tone-info a   { border-left-color: var(--info, #2563eb); }
    .ma-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 700; }
    .ma-headline { font-weight: 600; }
    .ma-detail { font-size: 0.8rem; color: var(--muted); }
    .plan-trigger-chip { font-size: 0.72rem; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--border); margin-left: 4px; }
    .plan-trigger-chip.tone-danger { color: var(--danger); border-color: var(--danger); }
    .plan-trigger-chip.tone-good   { color: var(--good, #16a34a); border-color: var(--good, #16a34a); }
    .plan-trigger-chip.tone-info   { color: var(--info, #2563eb); border-color: var(--info, #2563eb); }
    .sparkline { vertical-align: middle; }
    @media (max-width: 640px) {
      .morning-action a { grid-template-columns: 1fr; gap: 2px; }
    }

    .sentiment-panel {
      display: grid;
      grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr);
      gap: 12px;
      align-items: stretch;
    }
    .sentiment-score {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      padding: 14px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
    }
    .sentiment-score strong { font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums; }
    .sentiment-score span { color: var(--muted); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .sentiment-components {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
    }
    .sentiment-component {
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--border-soft);
      background: var(--surface-alt);
      font-size: 12px;
    }
    .sentiment-component strong { display: block; margin-bottom: 3px; }
    .sentiment-component .component-score { color: var(--muted); }

    /* Daily change & 52w distance signs */
    .change.change-pos { color: var(--good); font-weight: 600; }
    .change.change-neg { color: var(--danger); font-weight: 600; }
    .change.change-flat { color: var(--muted); }

    /* Sector tag under company name */
    .ticker-sector {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.02em;
      margin-top: 2px;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      background: var(--surface-soft);
      color: var(--muted);
      letter-spacing: 0.02em;
    }
    .badge.warn { color: var(--warning); background: var(--warning-bg); }
    .badge.danger { color: var(--danger); background: var(--danger-bg); }
    .badge.good { color: var(--good); background: var(--good-bg); }
    .badge.info { color: var(--info); background: var(--info-bg); }

    /* News */
    .news-list { margin: 0; padding: 0; list-style: none; }
    .news-item {
      display: grid;
      grid-template-columns: 60px 1fr;
      grid-template-rows: auto auto;
      gap: 4px 12px;
      padding: 12px 14px;
      border-left: 3px solid transparent;
      border-bottom: 1px solid var(--border-soft);
      margin: 0 -12px;
    }
    .news-item:last-child { border-bottom: none; }
    .news-item .symbol {
      grid-row: 1 / span 2;
      grid-column: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--surface-soft);
      color: var(--text);
      font-weight: 800;
      font-size: 11px;
      letter-spacing: 0.02em;
      height: 22px;
      align-self: start;
      margin-top: 2px;
    }
    .news-item .title {
      grid-row: 1;
      grid-column: 2;
      font-size: 14px;
      line-height: 1.35;
    }
    .news-item .title a { color: var(--text); }
    .news-item .meta {
      grid-row: 2;
      grid-column: 2;
      display: flex;
      gap: 8px;
      align-items: center;
      font-size: 11px;
      color: var(--muted);
    }
    .news-item .news-why {
      grid-row: 2;
      grid-column: 2;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--text);
      font-style: normal;
      margin: 0;
      padding: 2px 8px;
      border-radius: 4px;
      background: color-mix(in srgb, var(--info-bg) 60%, transparent);
    }
    .news-item .news-why .why-label {
      font-weight: 700;
      color: var(--info);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-size: 9px;
    }
    /* If we have a Why row, put meta after it. They share row 2 so keep them in a flex column. */
    .news-item.has-why .meta { grid-row: 3; }
    /* Top tier — strongest visual */
    .news-item.tier-top {
      border-left-color: var(--danger);
      border-left-width: 4px;
      background: color-mix(in srgb, var(--danger-bg) 45%, transparent);
    }
    .news-item.tier-top .title { font-weight: 700; font-size: 15px; }
    .news-item.tier-top .symbol { background: var(--danger-bg); color: var(--danger); }
    /* Primary — medium */
    .news-item.tier-primary { border-left-color: var(--warning); }
    .news-item.tier-primary .symbol { background: var(--warning-bg); color: var(--warning); }
    /* Editor pick — discreet badge after the title (top tier only) */
    .news-item.editor-pick .title::after {
      content: "Editor pick";
      display: inline-flex;
      margin-left: 8px;
      padding: 1px 6px;
      border-radius: 999px;
      color: var(--info);
      background: var(--info-bg);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      vertical-align: middle;
    }
    /* Minor — clearly downweight */
    .news-item.tier-minor {
      opacity: 0.55;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .news-item.tier-minor:hover { opacity: 1; }
    .news-item.tier-minor .title { font-size: 13px; }
    .news-item.tier-minor .title a { color: var(--muted); }
    .news-item.tier-minor .news-why { display: none; }
    .news-item .news-why .why-label {
      font-style: normal;
      font-weight: 700;
      color: var(--info);
      letter-spacing: 0.02em;
    }

    /* Watchlist-only mode */
    body.watchlist-mode #watchlist-mode-toggle {
      background: var(--info);
      color: var(--bg);
      border-color: var(--info);
    }
    body.watchlist-mode .ticker-card:not(.is-pinned) { display: none; }
    /* Hide everything that isn't the daily-driver core when in watchlist mode */
    body.watchlist-mode #overextended,
    body.watchlist-mode #market-sentiment,
    body.watchlist-mode #changes,
    body.watchlist-mode #valuation,
    body.watchlist-mode #news,
    body.watchlist-mode .legend,
    body.watchlist-mode .filter-row { display: none; }
    /* Bigger pinned cards */
    body.watchlist-mode .ticker-grid {
      grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
      gap: 16px;
    }
    body.watchlist-mode .ticker-card {
      padding: 18px 20px;
    }
    body.watchlist-mode .ticker-card .ticker-symbol { font-size: 22px; }
    body.watchlist-mode .ticker-card .ticker-name { font-size: 14px; }
    /* Surface review status, revisit, and notes preview directly — no need to expand Manage */
    body.watchlist-mode .ticker-card .note-preview { display: block; }
    body.watchlist-mode .ticker-card .review-status { display: inline-flex; }
    body.watchlist-mode .ticker-card .insights {
      font-size: 13px;
    }

    /* Post-earnings review banner */
    .post-earnings {
      margin: 8px 0;
      padding: 8px 10px;
      background: var(--info-bg);
      border: 1px solid color-mix(in srgb, var(--info) 30%, var(--border));
      border-radius: 6px;
    }
    .post-earnings > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .post-earnings > summary::-webkit-details-marker { display: none; }
    .post-earnings > summary::before {
      content: "▸ ";
      font-size: 10px;
      color: var(--info);
    }
    .post-earnings[open] > summary::before { content: "▾ "; }
    .pre-earnings {
      margin: 8px 0;
      padding: 8px 10px;
      background: var(--warning-bg);
      border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));
      border-radius: 6px;
    }
    .pre-earnings > summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .pre-earnings > summary::-webkit-details-marker { display: none; }
    .pre-earnings > summary::before { content: "▸ "; font-size: 10px; color: var(--warning); }
    .pre-earnings[open] > summary::before { content: "▾ "; }
    .pe-pill.pre { color: var(--warning); }
    .pe-status.extended { color: var(--danger); margin-left: auto; }
    .pre-earnings-body { margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
    .pre-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 6px;
    }
    .pre-metric {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 4px 6px;
      background: var(--surface);
      border-radius: 4px;
    }
    .pre-k { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .pre-v { font-size: 13px; font-weight: 700; }
    .pre-questions { display: flex; flex-direction: column; gap: 4px; }
    .pre-q-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
    .pre-q-input {
      width: 100%;
      padding: 5px 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      border-radius: 4px;
      resize: vertical;
    }
    .pe-pill {
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--info);
      background: var(--surface);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .pe-meta { color: var(--muted); font-size: 11px; }
    .pe-status { color: var(--good); font-size: 11px; font-weight: 700; margin-left: auto; }
    .pe-status:empty::before { content: "尚未檢視"; color: var(--warning); font-weight: 600; }
    .post-earnings-form {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 8px;
    }
    .pe-row { display: flex; align-items: center; gap: 8px; }
    .pe-label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      width: 64px;
    }
    .pe-buttons { display: flex; gap: 4px; }
    .pe-buttons button {
      padding: 4px 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 11px;
      border-radius: 4px;
      cursor: pointer;
    }
    .pe-buttons button:hover { background: var(--surface-soft); }
    .pe-buttons button[aria-pressed="true"] {
      background: var(--info-bg);
      border-color: var(--info);
      color: var(--info);
      font-weight: 700;
    }
    .pe-buttons button[data-pe-value="miss"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="down"][aria-pressed="true"] {
      background: var(--danger-bg);
      border-color: var(--danger);
      color: var(--danger);
    }
    .pe-buttons button[data-pe-value="beat"][aria-pressed="true"],
    .pe-buttons button[data-pe-value="up"][aria-pressed="true"] {
      background: var(--good-bg);
      border-color: var(--good);
      color: var(--good);
    }
    .pe-text {
      width: 100%;
      min-height: 36px;
      resize: vertical;
      padding: 6px 8px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      border-radius: 4px;
    }
    .scoreboard-status {
      display: inline-flex;
      padding: 2px 8px;
      border-radius: 999px;
      background: var(--surface-soft);
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      min-width: 72px;
      justify-content: center;
    }
    .scoreboard-status.done { color: var(--good); background: var(--good-bg); }
    .scoreboard-status.partial { color: var(--warning); background: var(--warning-bg); }

    /* Macro overlay (rates + breadth) — sits next to market sentiment */
    .macro-overlay {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 18px;
    }
    @media (max-width: 760px) {
      .market-workspace { grid-template-columns: 1fr; padding: 10px; }
      .market-workspace-stats { grid-column: auto; } .macro-overlay { grid-template-columns: 1fr; } }
    .rates-list, .breadth-list { list-style: none; margin: 6px 0 8px; padding: 0; }
    .rate-row, .breadth-row {
      display: grid;
      gap: 12px;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-soft);
      font-size: 13px;
    }
    .rate-row { grid-template-columns: 56px 1fr auto; }
    .breadth-row { grid-template-columns: 1fr auto; }
    .rate-row:last-child, .breadth-row:last-child { border-bottom: none; }
    .rate-name { font-weight: 800; color: var(--muted); letter-spacing: 0.04em; }
    .rate-last { font-variant-numeric: tabular-nums; }
    .rate-change { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
    .change-pos { color: var(--good); }
    .change-neg { color: var(--danger); }
    .change-flat { color: var(--muted); }
    .breadth-label { font-weight: 700; }
    .breadth-spread { font-weight: 800; font-variant-numeric: tabular-nums; }
    .rates-interp, .breadth-hint {
      font-size: 11px;
      color: var(--muted);
      margin-top: 6px;
      font-style: italic;
    }
    .regime-pill {
      display: inline-flex;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--info-bg);
      color: var(--info);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-left: auto;
      cursor: help;
    }

    /* My Book Today — portfolio impact summary */
    .my-book-section {
      border: 1px solid color-mix(in srgb, var(--info) 40%, var(--border));
      background: color-mix(in srgb, var(--info-bg) 20%, var(--surface));
    }
    .my-book-section h2 { color: var(--info); }
    .my-book-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 10px;
      margin-top: 8px;
    }
    .my-book-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 8px 10px;
    }
    .my-book-card.winners { border-left: 3px solid var(--good); }
    .my-book-card.losers { border-left: 3px solid var(--danger); }
    .my-book-card.events { border-left: 3px solid var(--warning); }
    .my-book-card.risks { border-left: 3px solid var(--info); }
    .mb-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .mb-list { list-style: none; margin: 0; padding: 0; }
    .mb-list li {
      display: grid;
      grid-template-columns: 56px auto 1fr;
      gap: 8px;
      align-items: baseline;
      padding: 3px 0;
      font-size: 12px;
    }
    .mb-list li a { font-weight: 800; color: var(--text); }
    .mb-pct { font-weight: 700; font-variant-numeric: tabular-nums; }
    .mb-detail { color: var(--muted); font-size: 11px; }
    .mb-empty { color: var(--muted); font-size: 11px; font-style: italic; }
    .my-book-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 4px 0 10px;
      font-size: 12px;
    }
    .my-book-stats .stat {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 4px 10px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 110px;
    }
    .my-book-stats .stat .label {
      font-size: 10px;
      text-transform: uppercase;
      color: var(--muted);
      letter-spacing: 0.05em;
    }
    .my-book-stats .stat .value {
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .my-book-card.sectors { border-left: 3px solid var(--info); }
    .my-book-card.stops { border-left: 3px solid var(--danger); }
    .sector-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
      font-size: 12px;
      padding: 2px 0;
    }
    .sector-row.over-cap { color: var(--danger); font-weight: 700; }
    .sector-row .tickers { color: var(--muted); font-size: 11px; font-weight: 400; }
    .concentration-warning {
      margin: 10px 0; padding: 10px 14px; border-radius: 8px;
      background: var(--warning-bg); border: 1px solid var(--warning, #d97706);
      border-left: 4px solid var(--warning, #d97706); font-size: 0.88rem; line-height: 1.5;
    }
    .concentration-warning strong { color: var(--warning, #d97706); }
    .concentration-warning a { font-weight: 600; }
    .stop-row {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 8px;
      font-size: 12px;
      padding: 2px 0;
    }
    .stop-row.tone-danger { color: var(--danger); font-weight: 700; }
    .stop-row.tone-warn { color: var(--warning); }
    .stop-row .detail { font-size: 11px; color: var(--muted); }
    .position-chip.tone-danger .value { color: var(--danger); font-weight: 700; }
    .position-chip.tone-warn .value { color: var(--warning); }
    .position-chip.tone-ok .value { color: var(--good); }

    /* Overextended list (top-of-dashboard danger panel) */
    .overextended-section {
      border: 1px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 25%, var(--surface));
    }
    .overextended-section h2 { color: var(--danger); }
    .overextended-list { list-style: none; margin: 6px 0 0; padding: 0; }
    .overextended-item {
      display: grid;
      grid-template-columns: 56px 1fr auto;
      gap: 12px;
      align-items: baseline;
      padding: 8px 12px;
      margin: 4px -12px;
      border-left: 3px solid var(--danger);
      background: color-mix(in srgb, var(--danger-bg) 30%, transparent);
      border-radius: 0 4px 4px 0;
    }
    .overextended-item:nth-child(odd) { background: color-mix(in srgb, var(--danger-bg) 45%, transparent); }
    .overextended-item .symbol { font-weight: 800; font-size: 14px; color: var(--text); }
    .overextended-item .ext-reasons { font-size: 12px; color: var(--text); }
    .overextended-item .ext-score {
      font-weight: 800;
      font-size: 13px;
      color: var(--danger);
      font-variant-numeric: tabular-nums;
    }
    .news-item .meta { color: var(--muted); font-size: 12px; white-space: nowrap; display: flex; gap: 8px; align-items: center; }

    /* Event-typed badges */
    .event-badge { font-size: 10px; }
    .event-badge.event-earnings { color: var(--danger); background: var(--danger-bg); }
    .event-badge.event-guidance, .event-badge.event-supply { color: var(--warning); background: var(--warning-bg); }
    .event-badge.event-ma, .event-badge.event-antitrust, .event-badge.event-lawsuit, .event-badge.event-regulation { color: var(--info); background: var(--info-bg); }
    .event-badge.event-ai, .event-badge.event-product { color: var(--good); background: var(--good-bg); }
    .event-badge.event-analyst_call, .event-badge.event-management, .event-badge.event-macro, .event-badge.event-other { color: var(--muted); background: var(--surface-soft); }

    /* Event clusters — cross-source story grouping */
    .cluster-list { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .cluster-item {
      border: 1px solid var(--border-soft);
      border-left: 3px solid var(--muted);
      border-radius: 6px;
      padding: 8px 12px;
      background: var(--surface);
    }
    .cluster-item.confidence-high { border-left-color: var(--good); }
    .cluster-item.confidence-medium { border-left-color: var(--warning); }
    .cluster-item.confidence-low { border-left-color: var(--muted); }
    .cluster-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
    }
    .cluster-headline { font-weight: 700; font-size: 13px; color: var(--text); }
    .cluster-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 6px;
      font-size: 12px;
      color: var(--text);
    }
    .cluster-field .cf-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--muted);
      margin-right: 4px;
    }
    .cluster-field a { color: var(--text); font-weight: 700; }
    .conf-tag {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 1px 6px;
      border-radius: 4px;
    }
    .conf-tag.conf-high { color: var(--good); background: var(--good-bg); }
    .conf-tag.conf-medium { color: var(--warning); background: var(--warning-bg); }
    .conf-tag.conf-low { color: var(--muted); background: var(--surface-soft); }
    .cluster-action { margin-top: 6px; font-size: 11px; color: var(--muted); font-style: italic; }

    /* Ticker grid */
    .ticker-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 12px;
    }
    .ticker-card { padding: 14px; min-width: 0; scroll-margin-top: 80px; position: relative; overflow: hidden; }
    .ticker-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: transparent;
    }
    .ticker-card.hot { border-color: color-mix(in srgb, var(--danger) 40%, var(--border)); }
    .ticker-card.hot::before { background: var(--danger); }
    .ticker-card.warn { border-color: color-mix(in srgb, var(--warning) 40%, var(--border)); }
    .ticker-card.warn::before { background: var(--warning); }
    .ticker-card.warm::before { background: var(--good); opacity: 0.4; }
    .ticker-card.warm { border-color: var(--border); }
    .ticker-card.quiet { opacity: 0.55; border-color: var(--border-soft); }
    .ticker-card.quiet:hover { opacity: 1; }
    .ticker-card.quiet .ticker-name { color: var(--muted); }

    /* Insight rows: Setup / Risk / Watch */
    /* Legend below the tickers heading */
    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      padding: 8px 10px;
      margin-bottom: 12px;
      background: var(--surface-alt);
      border-radius: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .legend .badge { font-size: 10px; }
    .legend-sep { color: var(--border); }

    .insights {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 10px 0;
      padding: 8px 10px;
      background: var(--surface-alt);
      border-radius: 6px;
    }
    .insight-row {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 8px;
      font-size: 12px;
      line-height: 1.4;
      align-items: baseline;
    }
    .insight-label {
      text-transform: uppercase;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-weight: 700;
    }
    .insight-row.action .insight-label { color: var(--info); }
    .insight-row.action .insight-text { color: var(--info); font-weight: 700; }
    .insight-row.rs .insight-label { color: var(--muted); }
    .insight-row.rs.trend-up .insight-label { color: var(--good); }
    .insight-row.rs.trend-down .insight-label { color: var(--danger); }
    .insight-row.rs.trend-down .insight-text { color: var(--danger); }
    .insight-row.rs.trend-mixed .insight-label { color: var(--warning); }
    /* Right-side trading score */
    details.insight-row.score { display: block; cursor: pointer; padding: 4px 0; }
    details.insight-row.score > summary {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 8px;
      align-items: baseline;
      list-style: none;
      cursor: pointer;
    }
    details.insight-row.score > summary::-webkit-details-marker { display: none; }
    details.insight-row.score > summary::after {
      content: "▸";
      font-size: 9px;
      color: var(--muted);
      margin-left: 6px;
    }
    details.insight-row.score[open] > summary::after { content: "▾"; }
    .score-breakdown {
      list-style: none;
      margin: 6px 0 0 56px;
      padding: 6px 10px;
      background: var(--surface-alt);
      border-left: 2px solid var(--border);
      border-radius: 4px;
    }
    .score-reason {
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      padding: 1px 0;
      color: var(--text);
    }
    .score-reason.positive { color: var(--good); }
    .score-reason.negative { color: var(--danger); }
    .score-empty { font-size: 11px; color: var(--muted); margin-left: 56px; font-style: italic; }
    .insight-row.score .insight-label { color: var(--info); font-weight: 800; }
    .insight-row.score .insight-text { font-weight: 700; font-variant-numeric: tabular-nums; }
    .insight-row.score.score-up .insight-label { color: var(--good); }
    .insight-row.score.score-up .insight-text { color: var(--good); }
    .insight-row.score.score-down .insight-label { color: var(--danger); }
    .insight-row.score.score-down .insight-text { color: var(--danger); }
    .insight-row.score.score-mixed .insight-label { color: var(--warning); }
    .insight-row.score.score-extended .insight-label { color: var(--warning); }
    .insight-row.score.score-extended .insight-text { color: var(--warning); }
    .badge.score-badge { font-weight: 700; }
    .badge.score-badge.score-up { background: var(--good-bg); color: var(--good); }
    .badge.score-badge.score-down { background: var(--danger-bg); color: var(--danger); }
    .badge.score-badge.score-mixed { background: var(--warning-bg); color: var(--warning); opacity: 0.75; }
    .badge.score-badge.score-extended { background: var(--warning-bg); color: var(--warning); }
    .badge.dq-medium { background: var(--warning-bg); color: var(--warning); font-weight: 700; }
    .badge.dq-low { background: var(--danger-bg); color: var(--danger); font-weight: 700; }
    .dq-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .dq-table th, .dq-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border-soft); vertical-align: top; }
    .dq-table th.num, .dq-table td.num { text-align: right; }
    .dq-flags { margin: 0; padding-left: 16px; color: var(--muted); }
    .dq-flags li { margin: 1px 0; }
    .compare-table-wrap td.score-up { color: var(--good); font-weight: 700; }
    .compare-table-wrap td.score-down { color: var(--danger); font-weight: 700; }
    .compare-table-wrap td.score-mixed { color: var(--warning); }
    .compare-table-wrap td.score-extended { color: var(--warning); font-weight: 700; }
    .insight-row.setup .insight-label { color: var(--good); }
    .insight-row.trend .insight-label { color: var(--muted); }
    .insight-row.trend.trend-up .insight-label { color: var(--good); }
    .insight-row.trend.trend-down .insight-label { color: var(--danger); }
    .insight-row.trend.trend-mixed .insight-label { color: var(--warning); }
    .insight-row.trend.trend-down .insight-text { color: var(--danger); }
    .insight-row.trend[title] { cursor: help; }
    .insight-row.risk .insight-label { color: var(--danger); }
    .insight-row.watch .insight-label { color: var(--info); }
    .insight-row .insight-text { color: var(--text); }
    .insight-row.risk .insight-text { color: var(--danger); }
    .ticker-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 10px;
      align-items: flex-start;
    }
    .ticker-head > div:first-child {
      min-width: 0;
    }
    .ticker-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: flex-end;
      gap: 5px;
      max-width: min(220px, 52%);
      min-width: 0;
    }
    .quick-actions,
    .status-badges {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 5px;
      max-width: 100%;
    }
    .ticker-actions .icon-button {
      width: auto;
      min-width: 30px;
      max-width: 64px;
      height: 28px;
      padding: 0 6px;
      white-space: nowrap;
      font-size: 12px;
      line-height: 1;
    }
    .status-badges .badge,
    .status-badges .plan-trigger-chip {
      max-width: 106px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .review-status.reviewed { color: var(--good); background: var(--good-bg); }
    .review-status.in-progress { color: var(--info); background: var(--info-bg); }
    .review-status.not-reviewed { color: var(--muted); background: var(--surface-soft); }
    .user-tools-details {
      margin-top: 10px;
    }
    .user-tools-details > summary {
      cursor: pointer;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      padding: 4px 0;
      list-style: none;
    }
    .user-tools-details > summary::-webkit-details-marker { display: none; }
    .user-tools-details > summary::before {
      content: "> ";
      font-size: 10px;
      margin-right: 4px;
    }
    .user-tools-details[open] > summary::before { content: "v "; }
    .user-tools-details > summary:hover { color: var(--text); }
    .pin-button { width: auto; padding: 0 8px; }
    .pin-button[aria-pressed="true"] {
      color: var(--warning);
      border-color: var(--warning);
      background: var(--warning-bg);
    }
    .compare-label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }
    .user-tools {
      display: grid;
      gap: 7px;
      margin-top: 10px;
      padding: 7px 9px;
      border-radius: 6px;
      background: var(--surface-alt);
      border: 1px solid var(--border-soft);
    }
    .tag-row, .revisit-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    .tag-badge { display: none; }
    .tag-badge.has-tag { display: inline-flex; }
    .note-preview {
      display: block;
      margin-top: 8px;
      padding: 6px 8px;
      border-radius: 6px;
      background: var(--info-bg);
      color: var(--info);
      font-size: 12px;
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    body[data-work-mode="prep"] .note-preview,
    body[data-work-mode="prep"] .user-tools-details > summary,
    body[data-work-mode="prep"] .compare-label,
    body[data-work-mode="review"] .review-status {
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--info) 18%, transparent);
    }
    body[data-work-mode="prep"] .user-tools {
      border-color: var(--info);
      background: color-mix(in srgb, var(--info-bg) 70%, var(--surface-alt));
    }
    .note-input {
      width: 100%;
      min-height: 42px;
      resize: vertical;
      padding: 8px;
      line-height: 1.4;
    }
    .plan-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 6px;
    }
    .plan-field {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .plan-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .plan-label.up { color: var(--good); }
    .plan-label.down { color: var(--danger); }
    .plan-input {
      width: 100%;
      min-height: 40px;
      resize: vertical;
      padding: 6px 8px;
      line-height: 1.4;
    }
    @media (max-width: 480px) {
      .plan-grid { grid-template-columns: minmax(0, 1fr); }
    }
    .manage-panel {
      margin-top: 0;
      padding-top: 2px;
    }
    .manage-panel summary {
      font-size: 12px;
      color: var(--muted);
    }
    .manage-panel[open] {
      padding-top: 6px;
      border-top: 1px solid var(--border-soft);
    }
    .advanced-tools {
      display: grid;
      gap: 8px;
      margin-top: 8px;
    }
    .position-editor {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 8px;
      padding: 8px;
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      background: var(--surface-alt);
    }
    .position-editor label {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .position-editor input,
    .position-editor select {
      width: 100%;
      min-width: 0;
      padding: 5px 7px;
      border: 1px solid var(--border);
      border-radius: 4px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      text-transform: none;
      letter-spacing: 0;
    }
    .position-editor .position-wide { grid-column: span 2; }
    .position-live {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 6px;
      margin-top: 8px;
      padding: 8px;
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      background: var(--surface-alt);
      font-size: 12px;
    }
    .position-live span {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
    .position-live .label {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .position-live .value {
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    .draft-row {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .draft-row .tag-select { flex: 1 1 150px; }
    .draft-row .tool-button { white-space: nowrap; }
    .checklist {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 6px;
      margin: 0;
    }
    .checklist label {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
    }
    .countdown { margin-top: 2px; color: var(--muted); font-size: 11px; }
    .compare-panel {
      margin: 0 0 12px;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface-alt);
    }
    .compare-panel h3 {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .compare-table-wrap { overflow: auto; }
    .compare-table-wrap td.trend-up { color: var(--good); }
    .compare-table-wrap td.trend-down { color: var(--danger); }
    .compare-table-wrap td.trend-mixed { color: var(--warning); }
    .compare-table-wrap td.change-pos { color: var(--good); font-weight: 600; }
    .compare-table-wrap td.change-neg { color: var(--danger); font-weight: 600; }
    .ticker-symbol { font-weight: 800; font-size: 18px; line-height: 1.1; }
    .ticker-name { color: var(--muted); font-size: 12px; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .market-badge, .currency-code {
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0;
    }
    .market-badge {
      margin-left: 6px;
      padding: 2px 5px;
      border: 1px solid var(--border-soft);
      border-radius: 4px;
      color: var(--info);
      background: var(--info-bg);
    }
    .currency-code { margin-left: 4px; color: var(--muted); }
    .metrics {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      margin: 10px 0;
    }
    .metric {
      background: var(--surface-alt);
      border: 1px solid var(--border-soft);
      border-radius: 6px;
      padding: 6px 8px;
    }
    .metric-label { display: block; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.03em; }
    .metric-value { display: block; font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; }

    .warning-list { margin: 8px 0 0; padding-left: 18px; color: var(--warning); font-size: 12px; }
    .warning-list li { margin: 2px 0; }
    details { margin-top: 10px; }
    summary { cursor: pointer; color: var(--link); font-weight: 600; font-size: 13px; }
    details ul { margin: 8px 0 0; padding-left: 18px; }
    details ul li { margin: 4px 0; font-size: 13px; }

    .footer {
      margin-top: 24px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 1100px) {
      .market-workspace { grid-template-columns: minmax(160px, 0.55fr) minmax(360px, 1.45fr); }
      .market-workspace-stats { grid-column: 1 / -1; }
      .command-center { grid-template-columns: 1fr; }
      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 760px) {
      .market-workspace { grid-template-columns: 1fr; padding: 10px; }
      .market-workspace-stats { grid-column: auto; }
      .page { padding: 14px; }
      .header { flex-direction: column; align-items: flex-start; }
      .header-right { align-items: stretch; width: 100%; }
      .top-tools { justify-content: flex-start; width: 100%; }
      .search-box { min-width: 0; flex-basis: 100%; }
      .export-status { text-align: left; }
      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .sentiment-panel { grid-template-columns: 1fr; }
      .toc { position: static; }
      .daily-summary-head { flex-direction: column; align-items: flex-start; gap: 4px; }
      .daily-summary-detail { text-align: left; }
      .daily-summary-body { grid-template-columns: 1fr; }
      .news-item { grid-template-columns: 1fr; }
      .news-item .meta { white-space: normal; }
    }
    @media (max-width: 480px) {
      .summary-grid { grid-template-columns: 1fr 1fr; }
      .daily-summary-list { grid-template-columns: 1fr; }
      .daily-summary-item a { grid-template-columns: 1fr; }
      .daily-summary-text { grid-column: 1; }
      .metrics { grid-template-columns: 1fr; }
      .ticker-actions { max-width: 100%; }
    }

    .news-read-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: 1.5px solid var(--border);
      background: transparent;
      color: var(--muted);
      font-size: 11px;
      cursor: pointer;
      flex-shrink: 0;
      vertical-align: middle;
      margin-right: 6px;
      opacity: 0.5;
      transition: opacity 0.15s, background 0.15s, color 0.15s;
    }
    .news-read-btn:hover {
      opacity: 1;
    }
    .news-item.is-read .news-read-btn {
      background: var(--good-bg, #d4edda);
      border-color: var(--good, #28a745);
      color: var(--good, #28a745);
      opacity: 1;
    }
    .news-item.is-read {
      opacity: 0.35;
    }
    .news-item.is-read .title a {
      text-decoration: line-through;
      color: var(--muted);
    }

    .thesis-preview {
      display: block;
      margin-top: 4px;
      padding: 4px 8px;
      border-radius: 4px;
      background: color-mix(in srgb, var(--accent, #0d6efd) 8%, transparent);
      color: var(--muted);
      font-size: 11px;
      font-style: italic;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    @media print {
      :root { color-scheme: light; }
      body { background: white; }
      .toc, details, .theme-toggle { display: none; }
      .section, .ticker-card, .stat { break-inside: avoid; box-shadow: none; }
      .table-wrap { max-height: none; overflow: visible; }
      /* Sector map: print every market stacked, with its title. */
      .map-market-panel { display: block; }
      .map-panel-title { display: block; }
    }
  </style>
</head>
<body>
  <main class="page">
    <header class="header">
      <div>
        <h1>每日股票研究</h1>
        <div class="muted">{{ report.report_date.isoformat() }} | Generated: {{ report.generated_at|twn_datetime }}</div>
      </div>
      <div class="header-right">
        <div class="top-tools" aria-label="Dashboard tools">
          <input id="quick-search" class="search-box" type="search" placeholder="搜尋代碼或公司名稱" autocomplete="off" data-i18n="label_search">
          <button id="watchlist-mode-toggle" type="button" class="tool-button" aria-pressed="false" title="只顯示釘選的股票">只看釘選</button>
          <button id="save-to-db" type="button" class="tool-button tool-button-success" title="儲存所有變更到資料庫">💾 保存</button>
          <details class="tools-menu">
            <summary class="tool-button">匯出</summary>
            <div class="tools-menu-panel">
              <button id="export-watchlist" type="button" class="tool-button tool-button-secondary" title="TXT: ticker, state, earnings timing, tag">觀察清單 TXT</button>
              <button id="export-research" type="button" class="tool-button tool-button-primary" title="JSON: current research state for CLI import back into SQLite">研究狀態 JSON</button>
              <button id="export-earnings" type="button" class="tool-button tool-button-secondary" title="JSON: ticker, company, earnings timing">財報數據 JSON</button>
              <div id="export-status" class="export-status" aria-live="polite">可匯出觀察清單、研究狀態、財報數據</div>
            </div>
          </details>
          <div id="save-status" class="save-status" aria-live="polite"></div>
        </div>
        <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Cycle theme: Auto, Light, Dark">
          <span class="dot" aria-hidden="true"></span>
          <span class="theme-label">自動</span>
        </button>
        <button id="language-toggle" type="button" class="language-toggle" aria-label="Toggle language: 中文 / English" title="切換語言 / Toggle language">
          <span class="lang-label">中文</span>
        </button>
        <div class="focus-line">
          <span><span id="market-header-ticker-count" class="focus-num">{{ summary.ticker_count }}</span> 檔股票</span>
          <span class="sep">|</span>
          <span><span id="market-header-earnings-count" class="focus-num">{{ summary.earnings_soon_count }}</span> 財報 7 天內</span>
          <span id="market-header-macro-separator" class="sep">|</span>
          <span id="market-header-macro"><span class="focus-num">{{ summary.economic_event_count }}</span> 總經事件</span>
        </div>
      </div>
    </header>
    <section id="market-workspace" class="market-workspace" aria-label="&#x5E02;&#x5834;&#x5DE5;&#x4F5C;&#x5340;">
      <div class="market-workspace-copy">
        <span id="market-workspace-title" class="market-workspace-title">&#x7F8E;&#x80A1;&#x5DE5;&#x4F5C;&#x5340;</span>
        <span id="market-workspace-subtitle" class="market-workspace-subtitle">&#x6458;&#x8981;&#x3001;&#x65B0;&#x805E;&#x3001;&#x4F30;&#x503C;&#x8207;&#x500B;&#x80A1;&#x5C07;&#x540C;&#x6B65;&#x5207;&#x63DB;</span>
      </div>
      <div class="market-tabs" role="tablist" aria-label="&#x5E02;&#x5834;&#x5207;&#x63DB;">
        <button type="button" class="market-tab" role="tab" data-market-tab="us">&#x7F8E;&#x80A1;<span class="market-tab-count">{{ summary.market_counts.get("us", 0) }}</span></button>
        <button type="button" class="market-tab" role="tab" data-market-tab="taiwan">&#x53F0;&#x80A1;<span class="market-tab-count">{{ summary.market_counts.get("twse", 0) + summary.market_counts.get("tpex", 0) }}</span></button>
        <button type="button" class="market-tab" role="tab" data-market-tab="crypto">&#x52A0;&#x5BC6;&#x8CA8;&#x5E63;<span class="market-tab-count">{{ summary.market_counts.get("crypto", 0) }}</span></button>
      </div>
      <div class="market-workspace-stats" aria-live="polite">
        <div class="market-workspace-stat"><strong id="market-stat-tickers">0</strong><span>&#x8FFD;&#x8E64;&#x6A19;&#x7684;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-holdings">0</strong><span>&#x6301;&#x6709;&#x90E8;&#x4F4D;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-attention">0</strong><span>&#x9700;&#x7559;&#x610F;</span></div>
        <div class="market-workspace-stat"><strong id="market-stat-news">0</strong><span>&#x4ECA;&#x65E5;&#x65B0;&#x805E;</span></div>
      </div>
    </section>

    <nav class="toc" aria-label="Sections">
      {% if morning_actions %}<a href="#morning-actions" class="toc-pill" style="background:var(--danger-bg);color:var(--danger)">行動 {{ morning_actions|length }}</a>{% endif %}
      <a href="#daily-summary">摘要</a>
      <a href="#hero">盤前快照</a>
      <a href="#todays-focus">焦點</a>
      {% if portfolio and portfolio.holdings %}<a href="#my-book" class="toc-pill" style="background:var(--info-bg);color:var(--info)">持股 {{ portfolio.holdings|length }}</a>{% elif book_today %}<a href="#book-today">持股</a>{% endif %}
      {% if overextended %}<a href="#overextended" class="toc-pill">過熱 {{ overextended|length }}</a>{% endif %}
      {% if rule_alerts %}<a href="#rule-alerts" class="toc-pill">警示 {{ rule_alerts|length }}</a>{% endif %}
      {% if report.warnings %}<a href="#global-warnings" class="toc-pill">警告 {{ report.warnings|length }}</a>{% endif %}
      {% if data_quality.flagged %}<a href="#data-quality" class="toc-pill">資料 {{ data_quality.flagged|length }}</a>{% endif %}
      <a href="#macro">總經</a>
      <a href="#earnings">財報</a>
      <a href="#news">新聞 ({{ important_news|length }})</a>
      <a href="#valuation">估值</a>
      <a href="#tickers">個股 ({{ report.ticker_reports|length }})</a>
    </nav>

    {% if morning_actions %}
    <section id="morning-actions" class="section morning-actions" aria-label="Morning actions">
      <div class="section-header">
        <h2>早盤行動 <span class="muted">— 先決定這些</span></h2>
      </div>
      <ul class="morning-actions-list">
        {% for action in morning_actions %}
        <li class="morning-action tone-{{ action.tone }}">
          <a href="{{ action.anchor }}">
            <span class="ma-label">{{ action.label }}</span>
            <span class="ma-headline">{{ action.headline }}</span>
            <span class="ma-detail">{{ action.detail }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section id="daily-summary" class="section daily-summary {{ daily_summary.tone }}" aria-label="Daily summary">
      <div class="daily-summary-head">
        <h2>今日摘要</h2>
        <span id="market-summary-detail" class="daily-summary-detail">{{ daily_summary.headline }} · {{ daily_summary.detail }}</span>
      </div>
      <div class="daily-summary-body">
        <ul id="market-summary-list" class="daily-summary-list">
          {% for item in daily_summary["items"] %}
          <li class="daily-summary-item {{ item.tone }}">
            <a href="{{ item.anchor }}">
              <span class="daily-summary-label">{{ item.label }}</span>
              <span class="daily-summary-title">{{ item.headline }}</span>
              <span class="daily-summary-text">{{ item.detail }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
        <div class="brief-metrics" aria-label="Key metrics">
          <div class="brief-metric {% if summary.hot_count %}alert danger{% endif %}"><span class="brief-metric-value">{{ summary.hot_count }}</span><span class="brief-metric-label">熱點</span></div>
          <div class="brief-metric {% if summary.premarket_gap_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.premarket_gap_count }}</span><span class="brief-metric-label">盤前缺口</span></div>
          <div class="brief-metric {% if summary.earnings_soon_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.earnings_soon_count }}</span><span class="brief-metric-label">財報 7 天內</span></div>
          <div id="market-summary-macro" class="brief-metric {% if summary.economic_event_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.economic_event_count }}</span><span class="brief-metric-label">總經事件</span></div>
          <div class="brief-metric"><span class="brief-metric-value" id="reviewed-count">{{ summary.reviewed_count }} / {{ summary.ticker_count }}</span><span class="brief-metric-label">已檢視</span></div>
          <div class="brief-metric {% if summary.rsi_overbought_count or summary.rsi_oversold_count %}alert{% endif %}"><span class="brief-metric-value">{{ summary.rsi_overbought_count }} / {{ summary.rsi_oversold_count }}</span><span class="brief-metric-label">RSI 高/低</span></div>
        </div>
      </div>
    </section>

    <section class="command-center" aria-label="Today">
      <div id="hero" class="command-hero">
        {% for item in hero %}
        <a class="hero-card {{ item.tone }} hero-kind-{{ item.kind }}" href="{{ item.anchor }}">
          <span class="hero-icon" aria-hidden="true">
            {% if item.kind == "earnings" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
            {% elif item.kind == "macro" or item.kind == "regime" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
            {% elif item.kind == "premarket" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8 12 12 8 16 12"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
            {% elif item.kind == "risk" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            {% elif item.kind == "focus" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            {% elif item.kind == "valuation" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M5 9l7-7 7 7M5 15l7 7 7-7"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="16" x2="12" y2="17"/></svg>
            {% endif %}
          </span>
          <div class="hero-body">
            <span class="hero-label">{{ item.label }}</span>
            <span class="hero-headline">{{ item.headline }}</span>
            <span class="hero-sub">{{ item.subtitle }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
      <aside class="command-side" id="summary">
        <div class="mode-bar" role="group" aria-label="Today work mode">
          <button type="button" class="tool-button mode-button" data-mode="overview" aria-pressed="true">概覽</button>
          <button type="button" class="tool-button mode-button" data-mode="review" aria-pressed="false">檢視模式</button>
          <button type="button" class="tool-button mode-button" data-mode="prep" aria-pressed="false">準備模式</button>
          <span id="mode-hint" class="mode-hint">完整儀表板</span>
        </div>
        {% if rule_alerts %}
        <div class="command-alerts">
          <div class="command-alerts-head">
            <span class="cc-label">警示</span>
            {% if rule_alerts|length > 3 %}<a href="#rule-alerts" class="cc-more">+{{ rule_alerts|length - 3 }} more</a>{% endif %}
          </div>
          <ul class="command-alert-list">
            {% for alert in rule_alerts[:3] %}
            <li class="command-alert {{ alert.tone }}">
              <a href="{{ alert.anchor }}">
                <span class="ca-label">{{ alert.symbol }}</span>
                <span class="ca-title">{{ alert.title }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </aside>
    </section>

    <section id="todays-focus" class="section section-primary">
      <div class="section-header">
        <h2>決策清單</h2>
      </div>
      <div class="focus-grid">
        <div class="focus-column review">
          <h3><span class="focus-icon">1</span>先處理</h3>
          {% if todays_focus.review_first %}
          <ul class="focus-list">
            {% for row in todays_focus.review_first %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ')|zh_text }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有需要立刻處理的個股。</div>{% endif %}
        </div>
        <div class="focus-column chase">
          <h3><span class="focus-icon">2</span>事件前暫停</h3>
          {% if todays_focus.no_action_before_event %}
          <ul class="focus-list">
            {% for row in todays_focus.no_action_before_event %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ')|zh_text }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">沒有因事件窗口需要暫停操作的個股。</div>{% endif %}
        </div>
        <div class="focus-column pullback">
          <h3><span class="focus-icon">3</span>回檔機會</h3>
          {% if todays_focus.pullback_setup %}
          <ul class="focus-list">
            {% for row in todays_focus.pullback_setup %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ')|zh_text }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有乾淨的回檔機會。</div>{% endif %}
        </div>
        <div class="focus-column chase">
          <h3><span class="focus-icon">!</span>避免追高</h3>
          {% if todays_focus.avoid_chase %}
          <ul class="focus-list">
            {% for row in todays_focus.avoid_chase %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ')|zh_text }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有明顯追高風險。</div>{% endif %}
        </div>
      </div>
    </section>

    <section id="capital-allocation" class="section section-primary">
      <div class="section-header">
        <h2>資金配置清單</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th data-i18n="table_grade">評分</th>
              <th data-i18n="table_ticker">代碼</th>
              <th data-i18n="table_action">操作</th>
              <th class="num" data-i18n="table_score">分數</th>
              <th data-i18n="table_status">狀態</th>
              <th data-i18n="table_reasons">原因</th>
            </tr>
          </thead>
          <tbody>
            {% for grade, rows in capital_allocation.items() %}
              {% for row in rows[:5] %}
              <tr>
                <td><span class="badge">{{ grade }}</span></td>
                <td class="symbol-cell"><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a></td>
                <td>{{ row.action|zh_text }}</td>
                <td class="num">{{ row.score }}</td>
                <td>{{ row.status|zh_text }}</td>
                <td>{{ row.reasons|join(' | ')|zh_text }}</td>
              </tr>
              {% endfor %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <section id="research-queue" class="section section-primary">
      <div class="section-header">
        <h2>研究待辦</h2>
      </div>
      <div class="focus-grid">
        <div class="focus-column review">
          <h3><span class="focus-icon">Q</span>優先檢視</h3>
          {% if history.review_queue %}
          <ul class="focus-list">
            {% for row in history.review_queue %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="{{ row.anchor }}">{{ row.symbol }}</a><span class="focus-reason">{{ row.reasons|join(' | ') }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有待檢視項目。</div>{% endif %}
        </div>
        <div class="focus-column chase">
          <h3><span class="focus-icon">T</span>論點變動</h3>
          {% if history.recent_thesis_changes %}
          <ul class="focus-list">
            {% for row in history.recent_thesis_changes %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="{{ row.anchor }}">{{ row.symbol }}</a><span class="focus-reason">{{ row.detail }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">近期沒有投資論點狀態變化。</div>{% endif %}
        </div>
        <div class="focus-column pullback">
          <h3><span class="focus-icon">E</span>財報後待追蹤</h3>
          {% if history.post_earnings_due %}
          <ul class="focus-list">
            {% for row in history.post_earnings_due %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="{{ row.anchor }}">{{ row.symbol }}</a><span class="focus-reason">{{ row.detail }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有待完成的財報後檢視。</div>{% endif %}
        </div>
      </div>
      <div class="focus-grid" style="margin-top: 10px;">
        <div class="focus-column review">
          <h3><span class="focus-icon">D</span>研究狀態漂移</h3>
          {% if history.research_drift %}
          <ul class="focus-list">
            {% for row in history.research_drift %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><a href="{{ row.anchor }}">{{ row.symbol }}</a><span class="focus-reason">{{ row.detail }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有過久未更新的有效投資論點。</div>{% endif %}
        </div>
        <div class="focus-column chase">
          <h3><span class="focus-icon">H</span>歷史報告</h3>
          {% if history.archive_dates %}
          <ul class="focus-list">
            {% for report_date in history.archive_dates[:6] %}
            <li><span class="focus-rank">{{ loop.index }}</span><span><span class="focus-reason">{{ report_date }}</span></span></li>
            {% endfor %}
          </ul>
          {% else %}<div class="section-empty">目前沒有已儲存的歷史報告。</div>{% endif %}
        </div>
        <div class="focus-column pullback">
          <h3><span class="focus-icon">R</span>研究記憶</h3>
          <div class="section-empty">{{ history.history_days }} 天歷史資料已從 SQLite 載入。</div>
        </div>
      </div>
    </section>

    {% if book_today %}
    <section id="book-today" class="section section-primary">
      <div class="section-header">
        <h2>今日持股</h2>
      </div>
      <div class="morning-grid">
        {% for row in book_today %}
        <a class="morning-tile" href="#{{ row.item.ticker.symbol|ticker_anchor }}">
          <span class="label">{{ row.label }}</span>
          <span class="value change-{{ row.tone }}">{{ row.value }}</span>
          <span class="sub">{{ row.item.ticker.symbol }} | {{ row.detail }}</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if book_impact %}
    <section id="book-impact" class="section section-secondary">
      <div class="section-header">
        <h2>持股貢獻明細 <span class="count">({{ book_impact|length }})</span></h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th data-i18n="table_ticker">代碼</th>
              <th class="num" data-i18n="table_move">漲跌幅</th>
              <th class="num" data-i18n="table_weight">持股比重</th>
              <th class="num" data-i18n="table_book_impact">帳面影響</th>
              <th data-i18n="table_action">操作</th>
            </tr>
          </thead>
          <tbody>
            {% for row in book_impact %}
            <tr>
              <td class="symbol-cell"><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a></td>
              <td class="num change change-{{ row.move|change_class }}" title="{{ row.move_source }}">{{ row.move|format_pct }}</td>
              <td class="num">{{ row.weight|format_pct(sign=False) }}</td>
              <td class="num change change-{{ row.impact|change_class }}">{{ row.impact|format_pct }}</td>
              <td>{{ row.action|zh_text }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if report.premarket %}
    <section id="premarket" class="section section-primary">
      <div class="section-header">
        <h2>隔夜 / 盤前 <span class="count">行情時間：{{ report.premarket.retrieved_at|utc_timestamp }}</span></h2>
      </div>
      {% if report.premarket.benchmarks %}
      <div class="morning-grid" aria-label="Premarket benchmarks">
        {% for move in report.premarket.benchmarks %}
        <div class="morning-tile">
          <span class="label">{{ move.name }}</span>
          <span class="value change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span>
          <span class="sub">{{ move.symbol }} at {{ move.last|metric_value }} | {{ move.source }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if report.premarket.watchlist_movers %}
      <div class="catalyst-grid" style="margin-top: 10px;">
        <div class="catalyst-card">
          <span class="label">Watchlist top movers</span>
          <ul class="mover-list">
            {% for move in report.premarket.watchlist_movers[:6] %}
            <li><a href="#ticker-{{ move.symbol|lower }}">{{ move.symbol }}</a><span class="change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span></li>
            {% endfor %}
          </ul>
        </div>
        <div class="catalyst-card">
          <span class="label">Gap &gt; +/-2%</span>
          {% if report.premarket.gap_movers %}
          <ul class="mover-list">
            {% for move in report.premarket.gap_movers[:8] %}
            <li><a href="#ticker-{{ move.symbol|lower }}">{{ move.symbol }}</a><span class="change change-{{ move.change_pct|change_class }}">{{ move.change_pct|format_pct }}</span></li>
            {% endfor %}
          </ul>
          {% else %}
          <span class="sub">No watchlist gaps above threshold.</span>
          {% endif %}
        </div>
      </div>
      {% endif %}
      {% if premarket_triage.catalyst_backed or premarket_triage.unclear %}
      <div class="catalyst-grid" style="margin-top: 10px;">
        <div class="catalyst-card">
          <span class="label">Catalyst-backed</span>
          {% if premarket_triage.catalyst_backed %}
          <ul class="mover-list">
            {% for row in premarket_triage.catalyst_backed %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="change change-{{ row.move.change_pct|change_class }}">{{ row.move.change_pct|format_pct }} | {{ row.confidence }} | {{ row.reasons|join(', ') }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">No mover with clear catalyst support.</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">Unclear / noisy</span>
          {% if premarket_triage.unclear %}
          <ul class="mover-list">
            {% for row in premarket_triage.unclear %}
            <li><a href="#{{ row.item.ticker.symbol|ticker_anchor }}">{{ row.item.ticker.symbol }}</a><span class="change change-{{ row.move.change_pct|change_class }}">{{ row.move.change_pct|format_pct }} | {{ row.confidence }} | {{ row.source_tier }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">No unexplained high-priority movers.</span>{% endif %}
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    <section id="today-catalysts" class="section section-primary">
      <div class="section-header">
        <h2>今日催化</h2>
      </div>
      <div class="catalyst-grid">
        <div class="catalyst-card">
          <span class="label">盤前公布財報</span>
          {% if todays_catalysts.before_open %}
          <ul class="catalyst-list">
            {% for item in todays_catalysts.before_open %}
            <li><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a><span>{{ item.ticker.company_name }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">觀察清單目前沒有項目。</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">盤後公布財報</span>
          {% if todays_catalysts.after_close %}
          <ul class="catalyst-list">
            {% for item in todays_catalysts.after_close %}
            <li><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a><span>{{ item.ticker.company_name }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">觀察清單目前沒有項目。</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">今日總經事件</span>
          {% if todays_catalysts.macro %}
          <ul class="catalyst-list">
            {% for event in todays_catalysts.macro %}
            <li><a href="{{ event.source_url }}" target="_blank" rel="noopener">{{ event.name }}</a><span>{{ event.event_datetime|twn_timestamp }} / {{ event.event_datetime|et_timestamp }}</span></li>
            {% endfor %}
          </ul>
          {% else %}<span class="sub">今日沒有追蹤中的總經事件。</span>{% endif %}
        </div>
        <div class="catalyst-card">
          <span class="label">今日到期回看</span>
          <ul id="revisit-due-list" class="catalyst-list">
            <li><span class="muted">正在載入回看日期</span><span></span></li>
          </ul>
        </div>
      </div>
    </section>

    {% if post_earnings_items %}
    <section id="post-earnings-scoreboard" class="section section-secondary">
      <div class="section-header">
        <h2>財報後計分板 <span class="count">({{ post_earnings_items|length }})</span></h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Ticker</th>
              <th class="num">Reported</th>
              <th>EPS</th>
              <th class="num">EPS surprise</th>
              <th>Revenue</th>
              <th class="num">Revenue surprise</th>
              <th>Guidance</th>
              <th class="num">FY1 EPS rev</th>
              <th class="num">FY1 revenue rev</th>
              <th class="num">Price reaction</th>
              <th>檢視</th>
            </tr>
          </thead>
          <tbody>
            {% for row in post_earnings_items %}
            {% set item = row.item %}
            {% set pe_default = item|post_earnings_defaults %}
            <tr data-pe-score-row="{{ item.ticker.symbol }}">
              <td class="symbol-cell"><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a></td>
              <td class="num">{{ row.days_ago }}d ago</td>
              <td data-pe-score-field="eps" data-default="{{ pe_default.eps or '' }}">{{ pe_default.eps or 'N/A' }}</td>
              <td class="num change change-{{ pe_default.eps_surprise|change_class }}" data-pe-score-field="eps_surprise" data-default="{% if pe_default.eps_surprise is not none %}{{ pe_default.eps_surprise }}{% endif %}">{{ pe_default.eps_surprise|format_pct }}</td>
              <td data-pe-score-field="rev" data-default="{{ pe_default.rev or '' }}">{{ pe_default.rev or 'N/A' }}</td>
              <td class="num change change-{{ pe_default.rev_surprise|change_class }}" data-pe-score-field="rev_surprise" data-default="{% if pe_default.rev_surprise is not none %}{{ pe_default.rev_surprise }}{% endif %}">{{ pe_default.rev_surprise|format_pct }}</td>
              <td data-pe-score-field="guide" data-default="{{ pe_default.guide or '' }}">{{ pe_default.guide or 'N/A' }}</td>
              <td class="num change change-{{ pe_default.fy1_eps_revision_after|change_class }}" data-pe-score-field="fy1_eps_revision_after" data-default="{% if pe_default.fy1_eps_revision_after is not none %}{{ pe_default.fy1_eps_revision_after }}{% endif %}">{{ pe_default.fy1_eps_revision_after|format_pct }}</td>
              <td class="num change change-{{ pe_default.fy1_revenue_revision_after|change_class }}" data-pe-score-field="fy1_revenue_revision_after" data-default="{% if pe_default.fy1_revenue_revision_after is not none %}{{ pe_default.fy1_revenue_revision_after }}{% endif %}">{{ pe_default.fy1_revenue_revision_after|format_pct }}</td>
              <td class="num change change-{{ row.reaction|change_class }}">{{ row.reaction|format_pct }}</td>
              <td><span class="scoreboard-status{% if pe_default.conclusion or pe_default.next_step %} partial{% endif %}" data-pe-score-field="review">{% if pe_default.conclusion or pe_default.next_step %}已檢視{% else %}未檢視{% endif %}</span></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if portfolio and portfolio.holdings %}
    <section id="my-book" class="section my-book-section">
      <div class="section-header">
        <h2>持股總覽 <span class="count">({{ portfolio.holdings|length }} holdings)</span></h2>
        <span class="regime-pill" style="background:var(--info-bg);color:var(--info);" title="Sum of (daily % × weight) across holdings">
          Net impact {{ portfolio.total_impact_pct|format_pct }}
        </span>
      </div>

      <div class="my-book-stats">
        <div class="stat" title="Sum of position weights across holdings">
          <span class="label">Invested weight</span>
          <span class="value">{{ portfolio.total_weight_pct|format_pct(sign=False) }}</span>
        </div>
        {% if portfolio.total_pl_dollar is not none %}
        <div class="stat" title="Total unrealized P&amp;L across holdings (current price vs avg cost)">
          <span class="label">Unrealized P&amp;L</span>
          <span class="value change change-{{ 'pos' if portfolio.total_pl_dollar >= 0 else 'neg' }}">${{ "{:+,.0f}".format(portfolio.total_pl_dollar) }}{% if portfolio.total_pl_pct is not none %} ({{ portfolio.total_pl_pct|format_pct }}){% endif %}</span>
        </div>
        {% endif %}
        {% if portfolio.addable_cash is not none %}
        <div class="stat" title="Cash available to deploy (from settings.portfolio.addable_cash)">
          <span class="label">Addable cash</span>
          <span class="value">${{ "{:,.0f}".format(portfolio.addable_cash) }}</span>
        </div>
        {% endif %}
        {% if portfolio.total_value is not none %}
        <div class="stat" title="Total portfolio value (from settings.portfolio.total_value)">
          <span class="label">Book value</span>
          <span class="value">${{ "{:,.0f}".format(portfolio.total_value) }}</span>
        </div>
        {% endif %}
        {% if portfolio.max_single_weight is not none %}
        <div class="stat" title="Max single-name weight cap">
          <span class="label">Single cap</span>
          <span class="value">{{ portfolio.max_single_weight|format_pct(sign=False) }}</span>
        </div>
        {% endif %}
      </div>

      {% if portfolio.over_concentrated %}
      <div class="concentration-warning" role="alert">
        <strong>集中風險</strong> — {{ portfolio.over_concentrated|length }} holding{{ 's' if portfolio.over_concentrated|length > 1 else '' }} above {{ portfolio.concentration_threshold|format_pct(sign=False) }}:
        {% for r in portfolio.over_concentrated %}<a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }} {{ r.weight|format_pct(sign=False) }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
        Review before adding.
      </div>
      {% endif %}

      <div class="my-book-grid">
        <div class="my-book-card winners">
          <div class="mb-label">最大正面影響</div>
          {% if portfolio.winners %}
          <ul class="mb-list">
            {% for r in portfolio.winners %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-pct change-pos">+{{ "%.2f"|format(r.book_impact) }}%</span>
              <span class="mb-detail">{{ "%.2f"|format(r.change_pct) }}% × {{ r.weight }}%w</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No positive contributors today.</div>{% endif %}
        </div>

        <div class="my-book-card losers">
          <div class="mb-label">最大負面影響</div>
          {% if portfolio.losers %}
          <ul class="mb-list">
            {% for r in portfolio.losers %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-pct change-neg">{{ "%.2f"|format(r.book_impact) }}%</span>
              <span class="mb-detail">{{ "%.2f"|format(r.change_pct) }}% × {{ r.weight }}%w</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No negative contributors today.</div>{% endif %}
        </div>

        <div class="my-book-card winners">
          <div class="mb-label">Total return leaders</div>
          {% if portfolio.pl_leaders %}
          <ul class="mb-list">
            {% for r in portfolio.pl_leaders %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-pct change-pos">+{{ "%.1f"|format(r.pl_pct) }}%</span>
              <span class="mb-detail">{% if r.pl_dollar is not none %}${{ "{:+,.0f}".format(r.pl_dollar) }}{% endif %}</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No gainers yet.</div>{% endif %}
        </div>

        <div class="my-book-card losers">
          <div class="mb-label">Total return laggards</div>
          {% if portfolio.pl_laggards %}
          <ul class="mb-list">
            {% for r in portfolio.pl_laggards %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-pct change-neg">{{ "%.1f"|format(r.pl_pct) }}%</span>
              <span class="mb-detail">{% if r.pl_dollar is not none %}${{ "{:+,.0f}".format(r.pl_dollar) }}{% endif %}</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No laggards.</div>{% endif %}
        </div>

        <div class="my-book-card events">
          <div class="mb-label">Event ≤ 3d</div>
          {% if portfolio.event_soon %}
          <ul class="mb-list">
            {% for r in portfolio.event_soon %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-detail">earnings {% if r.earnings_days == 0 %}today{% elif r.earnings_days == 1 %}tomorrow{% else %}in {{ r.earnings_days }}d{% endif %} · {{ r.weight }}%w</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No imminent events.</div>{% endif %}
        </div>

        <div class="my-book-card risks">
          <div class="mb-label">Thesis risk</div>
          {% if portfolio.thesis_risk %}
          <ul class="mb-list">
            {% for r in portfolio.thesis_risk %}
            <li><a href="#{{ r.symbol|ticker_anchor }}">{{ r.symbol }}</a>
              <span class="mb-detail">{{ r.weight }}%w {% if r.thesis_risk %}· flagged{% endif %}</span>
            </li>
            {% endfor %}
          </ul>
          {% else %}<div class="mb-empty">No thesis flags.</div>{% endif %}
        </div>

        <div class="my-book-card sectors">
          <div class="mb-label">Sector concentration</div>
          {% if portfolio.sectors %}
          {% for bucket in portfolio.sectors %}
          <div class="sector-row{% if bucket.get('over_cap') %} over-cap{% endif %}" {% if bucket.get('over_cap') %}title="Above {{ bucket.cap }}% cap"{% endif %}>
            <span>{{ bucket.sector }} <span class="tickers">({{ bucket.tickers|join(', ') }})</span></span>
            <span>{{ bucket.weight|format_pct(sign=False) }}</span>
          </div>
          {% endfor %}
          {% else %}<div class="mb-empty">No sector data yet.</div>{% endif %}
        </div>

        <div class="my-book-card stops">
          <div class="mb-label">Stop distance ≤ 5%</div>
          {% if portfolio.stop_warnings %}
          {% for w in portfolio.stop_warnings %}
          <div class="stop-row tone-{{ w.tone }}">
            <a href="#{{ w.symbol|ticker_anchor }}">{{ w.symbol }}</a>
            <span class="detail">last ${{ "%.2f"|format(w.last) }} vs stop ${{ "%.2f"|format(w.stop_loss) }}</span>
            <span>{{ w.distance_pct|format_pct }}</span>
          </div>
          {% endfor %}
          {% else %}<div class="mb-empty">All holdings comfortably above stops.</div>{% endif %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if overextended %}
    <section id="overextended" class="section section-secondary overextended-section">
      <div class="section-header">
        <h2>Overextended <span class="count">({{ overextended|length }})</span></h2>
      </div>
      <div class="sort-hint">Two or more of: RSI ≥ 70 · near 52w high · P/E ≥ 100 — caution on entry.</div>
      <ul class="overextended-list">
        {% for entry in overextended %}
        <li class="overextended-item">
          <a class="symbol" href="#{{ entry.item.ticker.symbol|ticker_anchor }}">{{ entry.item.ticker.symbol }}</a>
          <span class="ext-reasons">{{ entry.reasons|join(' · ') }}</span>
          <span class="ext-score" title="Number of danger flags (max 3)">{{ entry.score }}/3</span>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if report.market_sentiment %}
    <section id="market-sentiment" class="section section-secondary">
      <div class="section-header">
        <h2>市場情緒 <span class="count">({{ report.market_sentiment.source }})</span></h2>
      </div>
      <div class="sentiment-panel">
        <div class="sentiment-score">
          <strong>{{ report.market_sentiment.score }}</strong>
          <span>{{ report.market_sentiment.label }}</span>
          <div class="muted">Fear &amp; Greed style proxy from public market data.</div>
        </div>
        <div class="sentiment-components">
          {% for component in report.market_sentiment.components %}
          <div class="sentiment-component">
            <strong>{{ component.name }}</strong>
            <div>{{ component.detail }}</div>
            <div class="component-score">{{ "%.0f"|format(component.score) }} / 100 - {{ component.label }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% if report.market_context and (report.market_context.rates or report.market_context.breadth) %}
    <section id="market-context" class="macro-overlay">
      {% if report.market_context.rates %}
      <div id="rates" class="section section-primary">
        <div class="section-header">
          <h2>利率、美元與能源</h2>
          {% set regime = report|market_regime %}
          {% if regime %}<span class="regime-pill" title="Combined yields + dollar + oil + sentiment framing">{{ regime }}</span>{% endif %}
        </div>
        <ul class="rates-list">
          {% for r in report.market_context.rates %}
          <li class="rate-row">
            <span class="rate-name">{{ r.name }}</span>
            <span class="rate-last">{% if r.name == "WTI" %}${% endif %}{{ "%.2f"|format(r.last) }}{% if r.unit == "bp" %}%{% endif %}</span>
            <span class="rate-change change-{{ 'pos' if r.change > 0 else 'neg' if r.change < 0 else 'flat' }}">
              {{ "+%.1f"|format(r.change) if r.change > 0 else "%.1f"|format(r.change) }}{{ r.unit }}
            </span>
          </li>
          {% endfor %}
        </ul>
        {% set tip = report.market_context.rates|rates_interpretation %}
        {% if tip %}<div class="rates-interp">{{ tip }}</div>{% endif %}
        {% if macro_risk %}
        <h3>總經風險儀表</h3>
        <div class="macro-risk" aria-label="Macro risk meter">
          {% for risk in macro_risk %}
          <div class="risk-meter {{ risk.level }}">
            <span class="risk-name">{{ risk.name }}</span>
            <span class="risk-level">{{ risk.level }}</span>
            <span class="risk-detail">{{ risk.detail }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if report.market_context.breadth %}
      <div id="breadth" class="section section-primary">
        <div class="section-header">
          <h2>市場廣度（20D）</h2>
        </div>
        <ul class="breadth-list">
          {% for b in report.market_context.breadth %}
          <li class="breadth-row">
            <span class="breadth-label">{{ b.label }}</span>
            <span class="breadth-spread change-{{ 'pos' if b.spread > 0.5 else 'neg' if b.spread < -0.5 else 'flat' }}" title="{{ b.a_symbol }} {{ '%+.2f'|format(b.a_return) }}% vs {{ b.b_symbol }} {{ '%+.2f'|format(b.b_return) }}%">
              {{ "%+.2f"|format(b.spread) }}%
            </span>
          </li>
          {% endfor %}
        </ul>
        <div class="breadth-hint">Positive = first leg outperformed. Negative cap-weight (e.g. QQQ−QQQE &lt; 0) hints at narrow leadership.</div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if sector_map_markets %}
    <section id="sector-leadership" class="section section-secondary">
      <div class="section-header">
        <h2>產業地圖</h2>
      </div>
      <div id="market-map-context" class="market-map-context">內容會跟隨頁首市場切換</div>

      {% for panel in sector_map_markets %}
      <div class="map-market-panel{% if loop.first %} active{% endif %}" data-market-panel="{{ panel.key }}">
        <div class="map-panel-title">{{ panel.label }}</div>
        <div class="map-breadth"><span>上漲 {{ panel.advancers }}</span><span>持平 {{ panel.flat }}</span><span>下跌 {{ panel.decliners }}</span></div>
        <div class="sector-map">
          {% for row in panel.rows %}
          <div class="map-group">
            <div class="map-group-head">
              <span class="map-group-name">{{ row.label_zh }}</span>
              <span class="map-group-avg change change-{{ row.one_day|change_class }}">{{ row.one_day|format_pct }}</span>
              <span class="map-group-trend">5D {{ row.ret_5d|format_pct }} · 20D {{ row.ret_20d|format_pct }}</span>
            </div>
            <div class="map-tiles">
              {% for tile in row.tiles %}
              <a class="map-tile bin-{{ tile.bin }}" href="#{{ tile.anchor }}" title="{{ tile.company }} — 1D {{ tile.change|format_pct }}｜5D {{ tile.ret_5d|format_pct }}｜20D {{ tile.ret_20d|format_pct }}">
                <span class="map-tile-symbol">{{ tile.symbol }}</span>
                <span class="map-tile-change">{{ tile.change|format_pct }}</span>
              </a>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <details class="map-detail">
        <summary>查看產業明細</summary>
        <div class="table-wrap">
          <table class="heatmap-table">
            <thead><tr><th>市場</th><th>產業</th><th>標的</th><th class="num">1D</th><th class="num">5D</th><th class="num">20D</th></tr></thead>
            <tbody>
              {% for panel in sector_map_markets %}{% for row in panel.rows %}
              <tr data-market="{{ row.market }}"><td>{{ row.market_label }}</td><td>{{ row.label_zh }}</td><td class="symbols">{{ row.symbols }}</td><td class="num change change-{{ row.one_day|change_class }}">{{ row.one_day|format_pct }}</td><td class="num change change-{{ row.ret_5d|change_class }}">{{ row.ret_5d|format_pct }}</td><td class="num change change-{{ row.ret_20d|change_class }}">{{ row.ret_20d|format_pct }}</td></tr>
              {% endfor %}{% endfor %}
            </tbody>
          </table>
        </div>
      </details>
    </section>
    {% endif %}
    <section id="changes" class="section section-tertiary">
      <div class="section-header">
        <h2>上次報告後的變化 <span class="count">{{ report.generated_at|twn_timestamp }}</span></h2>
      </div>
      <div id="changes-body" class="change-list">
        {% if history.changes_since_last_run %}
          {% for row in history.changes_since_last_run %}
          <a class="change-item" data-symbol="{{ row.symbol }}" href="{{ row.anchor }}"><strong>{{ row.symbol }}: {{ row.title|zh_text }}</strong><span>{{ row.detail|zh_text }}</span></a>
          {% endfor %}
        {% else %}
        <div class="section-empty">No material changes versus the previous saved run.</div>
        {% endif %}
      </div>
    </section>

    <section id="changes-30d" class="section section-tertiary">
      <div class="section-header">
        <h2>30 天變化</h2>
      </div>
      <div class="change-list">
        {% if history.changes_30d %}
          {% for row in history.changes_30d %}
          <a class="change-item" data-symbol="{{ row.symbol }}" href="{{ row.anchor }}"><strong>{{ row.symbol }}: {{ row.title|zh_text }}</strong><span>{{ row.detail|zh_text }}</span></a>
          {% endfor %}
        {% else %}
        <div class="section-empty">目前累積的歷史資料不足，尚無法進行 30 天比較。</div>
        {% endif %}
      </div>
    </section>

    {% if rule_alerts %}
    <section id="rule-alerts" class="section section-primary">
      <div class="section-header">
        <h2>Rule Alerts <span class="count">({{ rule_alerts|length }} tickers)</span></h2>
        {% if rule_alerts|length > 6 %}<button id="toggle-alerts" type="button" class="tool-button">顯示全部</button>{% endif %}
      </div>
      <div class="alert-list">
        {% for alert in rule_alerts %}
        <a class="alert-item {{ alert.tone }}{% if loop.index0 >= 6 %} alert-extra is-hidden{% endif %}" data-symbol="{{ alert.symbol }}" href="{{ alert.anchor }}">
          <span class="alert-label">{{ alert.symbol }}</span>
          <span class="alert-title">{{ alert.title }}</span>
          <span class="alert-detail">{{ alert.detail }}</span>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if report.warnings %}
    <section id="global-warnings" class="section section-secondary">
      <h2>全域警示 <span class="count">({{ report.warnings|length }})</span></h2>
      <ul class="warning-list">
        {% for warning in report.warnings %}<li>{{ warning|zh_text }}</li>{% endfor %}
      </ul>
    </section>
    {% endif %}

    <section id="data-quality" class="section section-secondary">
      <h2>資料品質
        <span class="count">(平均可信度 {{ data_quality.average }}/100 · {{ data_quality.checked }} 檔)</span>
      </h2>
      {% if data_quality.flagged %}
      <table class="dq-table">
        <thead>
          <tr><th>代碼</th><th class="num">可信度</th><th>等級</th><th>問題</th></tr>
        </thead>
        <tbody>
          {% for row in data_quality.flagged %}
          <tr data-symbol="{{ row.symbol }}">
            <td><a href="#{{ row.symbol|ticker_anchor }}">{{ row.symbol }}</a></td>
            <td class="num">{{ row.score }}</td>
            <td><span class="badge dq-{{ row.tag }}">{{ row.tag }}</span></td>
            <td>
              <ul class="dq-flags">
                {% if row.fallback %}<li>Valuation fallback used</li>{% endif %}
                {% if row.missing_fields %}<li>Missing: {{ row.missing_fields|join(", ") }}</li>{% endif %}
                {% for flag in row.flags %}<li>{{ flag }}</li>{% endfor %}
              </ul>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <div class="section-empty">所有標的可信度皆達 80 分以上，本次沒有資料品質警示。</div>
      {% endif %}
    </section>

    <section id="macro" class="section section-secondary">
      <h2>總經日曆 <span class="count">(近期事件)</span></h2>
      {% if report.economic_events %}
      <div class="macro-row">
        {% for event in report.economic_events %}
        <a class="macro-card {{ event.category }}" href="{{ event.source_url }}" target="_blank" rel="noopener">
          <span class="name">{{ event.name }}</span>
          <span class="time">{{ event.event_datetime|twn_timestamp }}</span>
          <span class="note">{{ event.source }}{% if event.source_time_label %} / {{ event.source_time_label }}{% endif %}</span>
          {% if event.notes %}<span class="note long" title="{{ event.notes }}">{{ event.notes }}</span>{% endif %}
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="section-empty">本次沒有找到近期總經事件。</div>
      {% endif %}
    </section>

    <section id="earnings" class="section section-tertiary">
      <h2>近期財報 <span class="count">(未來 7 天)</span></h2>
      {% if earnings_soon %}
      <div class="earnings-row">
        {% for item in earnings_soon %}
        {% set urgency = item.earnings.earnings_date|earnings_urgency %}
        <a class="earnings-pill {{ urgency }}" href="#{{ item.ticker.symbol|ticker_anchor }}">
          <div class="top">
            <span class="symbol">{{ item.ticker.symbol }}</span>
            <span class="when">{{ item.earnings.earnings_date|days_until }}{% set urgency_label = item.earnings.earnings_date|earnings_urgency_label %}{% if urgency_label %} · {{ urgency_label }}{% endif %}</span>
          </div>
          <span class="name">{{ item.ticker.company_name }}</span>
          <span class="date">{{ item.earnings.earnings_date|date_or_na }} | {{ item.earnings.source }}</span>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="section-empty">未來 7 天沒有已知財報日期。</div>
      {% endif %}
    </section>

    {% if news_clusters %}
    <section id="news-clusters" class="section section-tertiary news-clusters-section">
      <div class="section-header">
        <h2>事件群組 <span class="count">({{ news_clusters|length }})</span></h2>
      </div>
      <div class="sort-hint">相同事件由多家媒體報導時會合併顯示，減少重複資訊。</div>
      <ul class="cluster-list">
        {% for c in news_clusters %}
        <li class="cluster-item confidence-{{ c.confidence }}">
          <div class="cluster-head">
            <span class="cluster-headline">{{ c.headline }}</span>
            <span class="badge event-badge event-{{ c.event_type }}">{{ c.event_type|event_label }}</span>
          </div>
          <div class="cluster-meta">
            <span class="cluster-field"><span class="cf-label">標的</span>
              {% for sym in c.tickers %}<a href="#{{ sym|ticker_anchor }}">{{ sym }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
            </span>
            <span class="cluster-field"><span class="cf-label">來源</span>{{ c.sources }} ({{ c.article_count }} articles)</span>
            <span class="cluster-field"><span class="cf-label">影響</span>{{ c.impact }}</span>
            <span class="cluster-field"><span class="cf-label">可信度</span><span class="conf-tag conf-{{ c.confidence }}">{{ c.confidence }}</span></span>
          </div>
          <div class="cluster-action">{{ c.action }}</div>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section id="news" class="section section-tertiary">
      <div class="section-header">
        <h2>重點新聞 <span class="count">({{ important_news[:5]|length }} picks / {{ important_news|length }} total)</span></h2>
        {% if important_news|length > 5 %}<button id="toggle-news" type="button" class="tool-button">顯示積壓</button>{% endif %}
      </div>
      {% if important_news %}
      <ul class="news-list">
        {% for item, article, tier in important_news %}
        {% set rationale = article|news_rationale %}
        <li class="news-item tier-{{ tier }}{% if rationale %} has-why{% endif %} {% if loop.index <= 5 %}editor-pick{% else %}news-extra is-hidden{% endif %}" data-article-url="{{ article.url }}">
          <button type="button" class="news-read-btn" title="Mark as read" aria-label="Mark as read">&#10003;</button>
          <a class="symbol" href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a>
          <div class="title">
            <a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a>
          </div>
          {% if rationale %}<div class="news-why"><span class="why-label">Why</span>{{ rationale }}</div>{% endif %}
          <div class="meta">
            <span class="badge info">{{ news_triage_label(item, article) }}</span>
            {% set reliability = article|source_reliability %}
            <span class="badge">{{ reliability.label }}</span>
            <span class="badge event-badge event-{{ article.event_type }}">{{ article.event_type|event_label }}</span>
            <span>{{ article.source }}</span>
          </div>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <div class="section-empty">本次沒有達到重要性門檻的重點新聞。</div>
      {% endif %}
    </section>

    <section id="valuation" class="section section-tertiary">
      <div class="section-header">
        <h2>估值快照 <span class="count">({{ report.ticker_reports|length }} 檔)</span></h2>
        <button id="toggle-valuation" type="button" class="tool-button" aria-expanded="true">收合</button>
      </div>
      <div id="valuation-body">
      <div class="valuation-controls">
        <label class="control-label" for="valuation-sort">排序</label>
        <select id="valuation-sort" class="control-select">
          <option value="symbol">代碼 A-Z</option>
          <option value="market_cap_desc">市值由高至低</option>
          <option value="forward_pe_asc">預估 P/E 由低至高</option>
          <option value="forward_pe_desc">預估 P/E 由高至低</option>
          <option value="rsi_asc">RSI 由低至高</option>
          <option value="rsi_desc">RSI 由高至低</option>
          <option value="earnings_soon">財報日期由近至遠</option>
        </select>
        <button id="toggle-valuation-columns" type="button" class="tool-button" aria-pressed="false">完整欄位</button>
        <span class="valuation-view-note">預設顯示決策常用欄位</span>
      </div>
      <div class="table-wrap">
        <table id="valuation-table" class="valuation-table is-compact">
          <thead>
            <tr>
              <th>代碼</th>
              {% for key in valuation_keys %}
              <th class="num{% if key not in ('last_close', 'rsi_14', 'market_cap', 'forward_pe', 'fy1_eps_revision_30d') %} valuation-secondary{% endif %}">{{ key|html_metric_label }}</th>
              {% if key == "last_close" %}<th class="num">日漲跌</th>{% endif %}
              {% if key == "market_cap" %}<th class="num valuation-secondary">距高點</th>{% endif %}
              {% endfor %}
              <th class="num">財報</th>
            </tr>
          </thead>
          <tbody id="valuation-rows">
            {% for item in valuation_rows %}
            {% set delta = item|earnings_delta %}
            {% set chg = item|daily_change %}
            {% set fh = item|from_52w_high %}
            <tr data-symbol="{{ item.ticker.symbol }}" data-company="{{ item.ticker.company_name|lower }}" data-market="{{ item.ticker.market }}" data-market-cap="{{ item|metric_raw('market_cap') }}" data-forward-pe="{{ item|metric_raw('forward_pe') }}" data-rsi="{{ item|metric_raw('rsi_14') }}" data-earnings-days="{% if delta is not none %}{{ delta }}{% endif %}">
              <td class="symbol-cell"><a href="#{{ item.ticker.symbol|ticker_anchor }}">{{ item.ticker.symbol }}</a></td>
              {% for key in valuation_keys %}
              {% set raw = item.valuation.metrics.get(key) if item.valuation else None %}
              <td class="num{% if key not in ('last_close', 'rsi_14', 'market_cap', 'forward_pe', 'fy1_eps_revision_30d') %} valuation-secondary{% endif %} {% if key in ('trailing_pe', 'forward_pe', 'ev_to_ebitda') %}pe-{{ raw|pe_class }}{% endif %}{% if key == 'rsi_14' %} rsi-{{ raw|rsi_class }}{% endif %}{% if key == 'gap_percent' %} change change-{{ raw|change_class }}{% endif %}{% if key in ('fy1_eps_revision_30d', 'fy1_revenue_revision_30d', 'next_q_revenue_revision_30d') %} change change-{{ raw|eps_revision_class }}{% endif %}{% if key in ('eps_growth_pct', 'revenue_growth_pct') %} change change-{{ raw|change_class }}{% endif %}"{% if key == 'rsi_14' %} title="{{ raw|rsi_label }}"{% endif %}>{% if not item.valuation %}N/A{% elif key == 'volume_vs_20d' %}{{ raw|format_ratio }}{% elif key in ('gap_percent', 'fy1_eps_revision_30d', 'fy1_revenue_revision_30d', 'next_q_revenue_revision_30d') %}{{ raw|format_pct }}{% elif key in ('atr_20_percent', 'eps_growth_pct', 'revenue_growth_pct') %}{{ raw|format_pct(sign=False) }}{% else %}{{ raw|metric_value }}{% endif %}</td>
              {% if key == "last_close" %}
              <td class="num change change-{{ chg|change_class }}">{{ chg|format_pct }}</td>
              {% endif %}
              {% if key == "market_cap" %}
              <td class="num valuation-secondary change change-{{ fh|change_class }}">{{ fh|format_pct }}</td>
              {% endif %}
              {% endfor %}
              <td class="num">
                {% if item.earnings and item.earnings.earnings_date %}
                <span title="{{ item.earnings.earnings_date|date_or_na }}">{{ item.earnings.earnings_date|days_until }}</span>
                {% else %}<span class="muted">N/A</span>{% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </div>
    </section>

    <section id="tickers" class="section section-primary">
      <div class="section-header">
        <h2>個股卡片 <span class="count" id="ticker-count">({{ report.ticker_reports|length }})</span></h2>
        <button id="toggle-quiet" type="button" class="tool-button">顯示平穩股</button>
      </div>
      <div class="sort-hint">依市值排序（由大到小）</div>
      <div class="legend" aria-label="Card state legend">
        <span class="badge danger">熱點</span> 今日財報或 2 則以上重點新聞
        <span class="legend-sep">|</span>
        <span class="badge good">留意</span> 有新聞或 7 天內財報
        <span class="legend-sep">|</span>
        <span class="badge warn">警示</span> 資料警示
        <span class="legend-sep">|</span>
        <span class="badge">平穩</span> 無明顯催化
      </div>
      <div class="ticker-controls">
        <label class="control-label" for="focus-filter" data-i18n="label_focus">焦點</label>
        <select id="focus-filter" class="control-select">
          <option value="all" data-i18n="option_all">全部</option>
          <option value="watchlist" data-i18n="option_watchlist">釘選項目</option>
          <option value="reviewed" data-i18n="option_reviewed">已檢視</option>
          <option value="unreviewed" data-i18n="option_unreviewed">未檢視</option>
        </select>
        <label class="control-label" for="state-filter" data-i18n="label_state">狀態</label>
        <select id="state-filter" class="control-select">
          <option value="all" data-i18n="option_all_active">全部狀態</option>
          <option value="hot" data-i18n="option_hot">熱點</option>
          <option value="warm" data-i18n="option_warm">留意</option>
          <option value="warn" data-i18n="option_warn">警示</option>
          <option value="quiet" data-i18n="option_quiet">平穩</option>
        </select>
        <label class="control-label" for="score-filter">分數</label>
        <select id="score-filter" class="control-select">
          <option value="all">不限分數</option>
          <option value="breakout-confirmed">突破確認</option>
          <option value="pullback-buy-zone">回檔買點區</option>
          <option value="extended-do-not-chase">已延伸，避免追高</option>
          <option value="mixed-neutral">中性</option>
          <option value="thesis-weakening">投資論點轉弱</option>
          <option value="avoid">暫避</option>
        </select>
        <label class="control-label" for="earnings-filter">財報</label>
        <select id="earnings-filter" class="control-select">
          <option value="all">不限日期</option>
          <option value="today">今日</option>
          <option value="tomorrow">明日</option>
          <option value="7d">7 天內</option>
        </select>
        <label class="control-label" for="rsi-filter">RSI</label>
        <select id="rsi-filter" class="control-select">
          <option value="all">不限 RSI</option>
          <option value="oversold">超賣 &lt;=30</option>
          <option value="neutral">中性 30-70</option>
          <option value="overbought">過熱 &gt;=70</option>
        </select>
        <label class="control-label" for="topic-filter">主題</label>
        <select id="topic-filter" class="control-select">
          <option value="all">全部主題</option>
          <option value="ai">AI</option>
          <option value="cloud">Cloud</option>
          <option value="memory">Memory</option>
          <option value="ev">EV</option>
        </select>
        {% if sectors %}
        <label class="control-label" for="sector-filter">產業</label>
        <select id="sector-filter" class="control-select">
          <option value="all">全部產業</option>
          {% for sec in sectors %}<option value="{{ sec|lower }}">{{ sec }}</option>{% endfor %}
        </select>
        {% endif %}
        {% if clusters %}
        <label class="control-label" for="cluster-filter">群組</label>
        <select id="cluster-filter" class="control-select">
          <option value="all">全部群組</option>
          {% for cluster in clusters %}<option value="{{ cluster|lower }}">{{ cluster }}</option>{% endfor %}
        </select>
        {% endif %}
        <label class="control-label checkbox"><input id="risk-filter" type="checkbox"> 只看風險股</label>
      </div>
      <div id="compare-panel" class="compare-panel is-hidden" aria-live="polite"></div>
      <div class="ticker-grid" id="ticker-grid">
        {% for item in ticker_cards %}
        {% set state = item|card_state %}
        {% set insights = item|ticker_insights %}
        {% set research = item|research_state %}
        {% set history_points = item|history_points %}
        {% set history_current = history_points[0] if history_points else None %}
        {% set tdelta = ticker_delta(item.ticker.symbol) %}
        {% set delta = item|earnings_delta %}
        {% set sector = item.valuation.metrics.get("sector") if item.valuation else None %}
        {% set dchg = item|daily_change %}
        {% set fhigh = item|from_52w_high %}
        {% set pmchg = item|premarket_change %}
        {% set pos = item|position_view %}
        {% set dq = item|data_quality %}
        {% set cluster = item|ticker_cluster %}
        <article class="ticker-card {{ state }}" id="{{ item.ticker.symbol|ticker_anchor }}" data-symbol="{{ item.ticker.symbol }}" data-company="{{ item.ticker.company_name|lower }}" data-market="{{ item.ticker.market }}" data-state="{{ state }}" data-has-risk="{{ '1' if item|has_risk_signal else '0' }}" data-earnings-days="{% if delta is not none %}{{ delta }}{% endif %}" data-topics="{{ item|topic_tags|join(' ') }}" data-last-close="{{ item|metric_raw('last_close') }}" data-previous-close="{{ item|metric_raw('previous_close') }}" data-market-cap="{{ item|metric_raw('market_cap') }}" data-trailing-pe="{{ item|metric_raw('trailing_pe') }}" data-forward-pe="{{ item|metric_raw('forward_pe') }}" data-eps-growth="{{ item|metric_raw('eps_growth_pct') }}" data-eps-rev-30d="{{ item|metric_raw('fy1_eps_revision_30d') }}" data-revenue-rev-30d="{{ item|metric_raw('fy1_revenue_revision_30d') }}" data-next-q-revenue-rev-30d="{{ item|metric_raw('next_q_revenue_revision_30d') }}" data-rsi="{{ item|metric_raw('rsi_14') }}" data-volume-x="{{ item|metric_raw('volume_vs_20d') }}" data-gap-pct="{{ item|metric_raw('gap_percent') }}" data-atr-pct="{{ item|metric_raw('atr_20_percent') }}" data-premarket-change="{% if pmchg is not none %}{{ pmchg }}{% endif %}" data-position-status="{{ pos.status }}" data-position-shares="{% if pos.shares is not none %}{{ pos.shares }}{% endif %}" data-position-avg-cost="{% if pos.avg_cost is not none %}{{ pos.avg_cost }}{% endif %}" data-position-size="{% if pos.position_size is not none %}{{ pos.position_size }}{% endif %}" data-position-stop-loss="{% if pos.stop_loss is not none %}{{ pos.stop_loss }}{% endif %}" data-position-weight="{% if pos.portfolio_weight is not none %}{{ pos.portfolio_weight }}{% endif %}" data-pl-pct="{% if pos.pl_pct is not none %}{{ pos.pl_pct }}{% endif %}" data-book-impact="{% if pos.book_impact is not none %}{{ pos.book_impact }}{% endif %}" data-watch="{{ item.ticker.keywords[:3]|join(', ') }}" data-news-count="{{ item.articles|length }}" data-top-news-count="{{ item|top_news_count }}" data-top-news-signatures="{{ item|top_news_signatures }}" data-valuation-risk="{{ item|valuation_risk }}" data-sector="{{ (sector or '')|lower }}" data-cluster="{{ cluster or '' }}" data-daily-change="{% if dchg is not none %}{{ dchg }}{% endif %}" data-from-high="{% if fhigh is not none %}{{ fhigh }}{% endif %}" data-trend="{{ insights.trend|join(' / ') if insights.trend else '' }}" data-trend-tone="{{ insights.trend_tone }}" data-right-side-score="{{ insights.score.score if insights.score else '' }}" data-right-side-status="{{ insights.score.slug if insights.score else '' }}" data-right-side-tone="{{ insights.score.tone if insights.score else '' }}" data-thesis-state="{{ research.thesis_state }}" data-thesis-trigger="{{ research.thesis_trigger }}" data-review-status="{{ research.review_status }}" data-last-reviewed-at="{{ research.last_reviewed_at.isoformat() if research.last_reviewed_at else '' }}" data-news-burst="{% if history_current %}{{ history_current.news_burst_score }}{% endif %}" data-attention-score="{% if history_current %}{{ history_current.attention_score }}{% endif %}" data-confidence-score="{{ dq.score }}" data-confidence-tag="{{ dq.tag }}">
          <div class="ticker-head">
            <div>
              <div class="ticker-symbol">{{ item.ticker.display_symbol }}<span class="market-badge">{{ item.ticker.market|market_label }}</span></div>
              <div class="ticker-name">{{ item.ticker.company_name }}<span class="currency-code">{{ item.ticker.currency }}</span></div>
              {% if sector %}<div class="ticker-sector">{{ sector }}</div>{% endif %}
              {% if research.thesis_state or research.last_reviewed_at %}
              <div class="ticker-sector">
                {% if research.thesis_state %}投資論點：{{ research.thesis_state|zh_text }}{% endif %}
                {% if research.last_reviewed_at %}{% if research.thesis_state %} | {% endif %}上次檢視 {{ research.last_reviewed_at.date().isoformat() }}{% endif %}
              </div>
              {% endif %}
              {% if item.earnings and item.earnings.earnings_date %}<div class="countdown" data-countdown="{{ item.earnings.earnings_date.isoformat() }}" data-time-of-day="{{ item.earnings.time_of_day }}"></div>{% endif %}
            </div>
            <div class="ticker-actions">
              <div class="quick-actions">
                <button type="button" class="icon-button pin-button" aria-label="加入焦點 {{ item.ticker.symbol }}" aria-pressed="false" data-pin="{{ item.ticker.symbol }}" title="加入焦點">焦點</button>
                <button type="button" class="icon-button quick-done" aria-label="標記 {{ item.ticker.symbol }} 已看過" data-quick-done="{{ item.ticker.symbol }}" title="標記財報、指引、估值、新聞、投資論點都已檢視">已看</button>
                <button type="button" class="icon-button quick-revisit" aria-label="明天再看 {{ item.ticker.symbol }}" data-quick-revisit="{{ item.ticker.symbol }}" title="把檢視日期設為今天 +1 天，或將既有日期往後推一天">明天</button>
              </div>
              <div class="status-badges">
                {% if state == "hot" %}<span class="badge danger">{{ state|card_state_label }}</span>
                {% elif state == "warn" %}<span class="badge warn">{{ state|card_state_label }}</span>
                {% elif state == "warm" %}<span class="badge good">{{ state|card_state_label }}</span>
                {% else %}<span class="badge">{{ state|card_state_label }}</span>{% endif %}
                {% if fhigh is not none %}<span class="badge from-high-chip change change-{{ fhigh|change_class }}" title="距離 52 週高點">距高點 {{ fhigh|format_pct }}</span>{% endif %}
                {% if insights.score and state != "quiet" %}<span class="badge score-badge score-{{ insights.score.tone }}" title="右側分數 {{ insights.score.score }}/100">{{ insights.score.status|zh_text }}</span>{% endif %}
                {% if dq.tag != "high" %}<span class="badge dq-{{ dq.tag }}" title="資料可信度 {{ dq.score }}/100{% if dq.flags %} — {{ dq.flags|join('; ')|zh_text }}{% endif %}">資料 {{ dq.tag|level_label }}</span>{% endif %}
                <span class="badge review-status {{ research.review_status }}" data-review-status="{{ item.ticker.symbol }}">{{ research.review_status|review_status_label }}</span>
                {% for trig in plan_triggers_for(item.ticker.symbol) %}<span class="plan-trigger-chip tone-{{ trig.tone }}" title="{{ trig.headline|zh_text }} — {{ trig.detail|zh_text }}">{{ trig.label|zh_text }}</span>{% endfor %}
              </div>
            </div>
          </div>

          <div class="metrics metrics-compact">
            <div class="metric">
              <span class="metric-label">財報</span>
              <span class="metric-value">
                {% if item.earnings and item.earnings.earnings_date %}
                  {{ item.earnings.earnings_date|days_until }}
                {% else %}N/A{% endif %}
              </span>
            </div>
            <div class="metric">
              <span class="metric-label">市值</span>
              <span class="metric-value">{{ item.valuation.metrics.get("market_cap")|metric_value if item.valuation else "N/A" }}</span>
            </div>
            <div class="metric">
              {% set rsi = item.valuation.metrics.get("rsi_14") if item.valuation else None %}
              <span class="metric-label">RSI 14</span>
              <span class="metric-value rsi-{{ rsi|rsi_class }}" title="{{ rsi|rsi_label }}">{{ rsi|metric_value if item.valuation else "N/A" }}{% if tdelta and tdelta.rsi_delta and tdelta.rsi_delta != 0 %}<span class="{{ 'delta-up' if tdelta.rsi_delta > 0 else 'delta-down' }}">{{ '+' if tdelta.rsi_delta > 0 else '' }}{{ tdelta.rsi_delta }}</span>{% endif %}</span>
            </div>
            {% if tdelta %}
            <div class="metric">
              <span class="metric-label">新聞</span>
              <span class="metric-value">{{ item.articles|length }}{% if tdelta.news_count_delta is not none and tdelta.news_count_delta != 0 %}<span class="{{ 'delta-up' if tdelta.news_count_delta > 0 else 'delta-down' }}">{{ '+' if tdelta.news_count_delta > 0 else '' }}{{ tdelta.news_count_delta }}</span>{% endif %}</span>
            </div>
            <div class="metric">
              <span class="metric-label">關注分數</span>
              <span class="metric-value">{% if history_current %}{{ history_current.attention_score }}{% else %}N/A{% endif %}{% if tdelta.attention_score_delta is not none and tdelta.attention_score_delta != 0 %}<span class="{{ 'delta-up' if tdelta.attention_score_delta > 0 else 'delta-down' }}">{{ '+' if tdelta.attention_score_delta > 0 else '' }}{{ tdelta.attention_score_delta }}</span>{% endif %}{{ ticker_sparkline(item.ticker.symbol)|safe }}</span>
            </div>
            {% if tdelta.valuation_risk_direction != 'same' %}
            <div class="metric">
              <span class="metric-label">估值風險</span>
              <span class="metric-value"><span class="{{ 'delta-down' if tdelta.valuation_risk_direction == 'up' else 'delta-up' }}">{{ '↑' if tdelta.valuation_risk_direction == 'up' else '↓' }}</span> {{ item|valuation_risk|zh_text }}</span>
            </div>
            {% endif %}
            {% endif %}
          </div>

          <details class="card-secondary position-details">
            <summary>持股與損益</summary>
            <div class="position-row">
              <div class="position-chip">
                <span class="label">狀態</span>
                <span class="value">{{ pos.status|position_status_label }}{% if pos.sector %} · {{ pos.sector }}{% endif %}</span>
              </div>
              <div class="position-chip">
                <span class="label">持股比重 / 影響</span>
                <span class="value">{% if pos.portfolio_weight is not none %}{{ pos.portfolio_weight|format_pct(sign=False) }}{% else %}N/A{% endif %}{% if pos.book_impact is not none %} / {{ pos.book_impact|format_pct }}{% endif %}</span>
              </div>
              <div class="position-chip">
                <span class="label">均價</span>
                <span class="value">{{ pos.avg_cost|metric_value }}</span>
              </div>
              <div class="position-chip">
                <span class="label">P/L</span>
                <span class="value change change-{{ pos.pl_pct|change_class }}">{{ pos.pl_pct|format_pct }}{% if pos.pl_dollar is not none %} ({{ item.ticker.currency }} {{ "{:+,.0f}".format(pos.pl_dollar) }}){% endif %}</span>
              </div>
              {% if pos.stop_loss is not none %}
              <div class="position-chip tone-{{ pos.stop_distance_tone }}" title="Distance from stop-loss">
                <span class="label">停損</span>
                <span class="value">${{ "%.2f"|format(pos.stop_loss) }}{% if pos.stop_distance_pct is not none %} · 距離 {{ pos.stop_distance_pct|format_pct }}{% endif %}</span>
              </div>
              {% endif %}
              {% if pos.position_size is not none %}
              <div class="position-chip">
                <span class="label">持股金額</span>
                <span class="value">${{ "{:,.0f}".format(pos.position_size) }}</span>
              </div>
              {% endif %}
            </div>
          </details>

          <div class="position-live" data-position-live="{{ item.ticker.symbol }}">
            <span><span class="label">持股狀態</span><span class="value" data-position-live-status="{{ item.ticker.symbol }}">{{ pos.status|position_status_label }}</span></span>
            <span><span class="label">持股比重</span><span class="value" data-position-live-weight="{{ item.ticker.symbol }}">N/A</span></span>
            <span><span class="label">P/L</span><span class="value change" data-position-live-pl="{{ item.ticker.symbol }}">N/A</span></span>
            <span><span class="label">影響</span><span class="value change" data-position-live-impact="{{ item.ticker.symbol }}">N/A</span></span>
          </div>

          {% if insights.action or insights.setup or insights.trend or insights.risk or insights.score %}
          <div class="insights">
            {% if insights.action %}<div class="insight-row action"><span class="insight-label">操作</span><span class="insight-text">{{ insights.action|zh_text }}</span></div>{% endif %}
            {% if insights.score %}
            <details class="insight-row score score-{{ insights.score.tone }}">
              <summary>
                <span class="insight-label">分數</span>
                <span class="insight-text">{{ insights.score.score }}/100 — {{ insights.score.status|zh_text }}</span>
              </summary>
              {% if insights.score.reasons %}
              <ul class="score-breakdown">
                {% for reason in insights.score.reasons %}
                <li class="score-reason {% if reason.startswith('+') %}positive{% elif reason.startswith('-') %}negative{% endif %}">{{ reason|zh_text }}</li>
                {% endfor %}
              </ul>
              {% else %}
              <div class="score-empty">目前沒有可拆解的加減分因素。</div>
              {% endif %}
            </details>
            {% endif %}
            {% if insights.setup %}<div class="insight-row setup"><span class="insight-label">重點</span><span class="insight-text">{{ insights.setup|join(' | ')|zh_text }}</span></div>{% endif %}
            {% if insights.trend %}<div class="insight-row trend trend-{{ insights.trend_tone }}"{% if insights.trend_title %} title="{{ insights.trend_title|zh_text }}"{% endif %}><span class="insight-label">趨勢</span><span class="insight-text">{{ insights.trend|join(' | ')|zh_text }}</span></div>{% endif %}
            {% if insights.rs %}<div class="insight-row rs trend-{{ insights.rs_tone }}"><span class="insight-label">相對強度</span><span class="insight-text">{{ insights.rs|join(' · ')|zh_text }}</span></div>{% endif %}
            {% if insights.risk %}<div class="insight-row risk"><span class="insight-label">風險</span><span class="insight-text">{{ insights.risk|join(' | ')|zh_text }}</span></div>{% endif %}
          </div>
          {% endif %}

          {% if insights.quality or insights.watch %}
          <details class="card-secondary card-extras">
            <summary>品質與觀察</summary>
            <div class="insights">
              {% if insights.quality %}<div class="insight-row"><span class="insight-label">品質</span><span class="insight-text">{{ insights.quality|join(' | ')|zh_text }}</span></div>{% endif %}
              {% if insights.watch %}<div class="insight-row watch"><span class="insight-label">觀察</span><span class="insight-text">{{ insights.watch|join(' | ')|zh_text }}</span></div>{% endif %}
            </div>
          </details>
          {% endif %}

          {% if history_points %}
          <details class="card-secondary">
            <summary>研究紀錄</summary>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>日期</th>
                    <th>投資論點</th>
                    <th>檢視</th>
                    <th class="num">重點新聞</th>
                    <th>估值</th>
                    <th class="num">財報</th>
                    <th class="num">警示</th>
                  </tr>
                </thead>
                <tbody>
                  {% for point in history_points[:6] %}
                  <tr>
                    <td>{{ point.report_date.isoformat() }}</td>
                    <td>{{ point.thesis_state|zh_text if point.thesis_state else '未標記' }}</td>
                    <td>{{ point.review_status|review_status_label }}</td>
                    <td class="num">{{ point.top_news_count }}</td>
                    <td>{{ point.valuation_risk|zh_text }}</td>
                    <td class="num">{% if point.earnings_days is not none %}{{ point.earnings_days }}d{% else %}N/A{% endif %}</td>
                    <td class="num">{{ point.warning_count }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </details>
          {% endif %}

          {% if item.warnings %}
          <ul class="warning-list">
            {% for warning in item.warnings %}<li>{{ warning }}</li>{% endfor %}
          </ul>
          {% endif %}

          {% set pre_er = item|pre_earnings_card %}
          {% if pre_er %}
          <details class="pre-earnings" data-pre-earnings="{{ item.ticker.symbol }}" open>
            <summary>
              <span class="pe-pill pre">財報前準備</span>
              <span class="pe-meta">{{ pre_er.days_until }} 天後公布{% if pre_er.action %} · {{ pre_er.action|zh_text }}{% endif %}</span>
              {% if pre_er.overextended %}<span class="pe-status extended">已延伸</span>{% endif %}
            </summary>
            <div class="pre-earnings-body">
              <div class="pre-metrics">
                <div class="pre-metric">
                  <span class="pre-k">市場預估 EPS</span>
                  <span class="pre-v">{{ "%.2f"|format(pre_er.eps_estimate) if pre_er.eps_estimate is not none else "—" }}</span>
                </div>
                <div class="pre-metric">
                  <span class="pre-k">市場預估營收</span>
                  <span class="pre-v">{{ "{:,.0f}".format(pre_er.revenue_estimate) if pre_er.revenue_estimate is not none else "—" }}</span>
                </div>
                <div class="pre-metric">
                  <span class="pre-k">FY1 EPS 修正 30D</span>
                  <span class="pre-v {{ pre_er.eps_revision_30d|change_class }}">{{ pre_er.eps_revision_30d|format_pct }}</span>
                </div>
                <div class="pre-metric">
                  <span class="pre-k">20D 漲跌</span>
                  <span class="pre-v {{ pre_er.move_30d|change_class }}">{{ pre_er.move_30d|format_pct }}</span>
                </div>
                <div class="pre-metric">
                  <span class="pre-k">RSI 14</span>
                  <span class="pre-v {{ pre_er.rsi|rsi_class }}">{{ "%.0f"|format(pre_er.rsi) if pre_er.rsi is not none else "—" }}</span>
                </div>
                <div class="pre-metric">
                  <span class="pre-k">距 52 週高</span>
                  <span class="pre-v {{ pre_er.from_52w_high|change_class }}">{{ pre_er.from_52w_high|format_pct }}</span>
                </div>
              </div>
              <div class="pre-questions">
                <span class="pre-q-label">財報公布時要確認的問題</span>
                {% for q in pre_er.questions %}
                <textarea class="pre-q-input" data-eq-field="{{ loop.index0 }}" data-eq-symbol="{{ item.ticker.symbol }}" rows="1" placeholder="問題 {{ loop.index }}">{{ q }}</textarea>
                {% endfor %}
              </div>
            </div>
          </details>
          {% endif %}

          {% set post_er = item|post_earnings %}
          {% if post_er %}
          <details class="post-earnings" data-post-earnings="{{ item.ticker.symbol }}" data-earnings-date="{{ post_er.earnings_date.isoformat() }}">
            <summary>
              <span class="pe-pill">財報後檢視</span>
              <span class="pe-meta">{{ post_er.days_ago }} 天前公布 · {{ post_er.earnings_date.isoformat() }}</span>
              <span class="pe-status" data-pe-status="{{ item.ticker.symbol }}"></span>
            </summary>
            <div class="post-earnings-form">
              <div class="pe-row">
                <label class="pe-label">EPS</label>
                <div class="pe-buttons" data-pe-field="eps" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="beat">優於</button>
                  <button type="button" data-pe-value="inline">符合</button>
                  <button type="button" data-pe-value="miss">低於</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label">營收</label>
                <div class="pe-buttons" data-pe-field="rev" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="beat">優於</button>
                  <button type="button" data-pe-value="inline">符合</button>
                  <button type="button" data-pe-value="miss">低於</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label">展望</label>
                <div class="pe-buttons" data-pe-field="guide" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="up">上修</button>
                  <button type="button" data-pe-value="flat">持平</button>
                  <button type="button" data-pe-value="down">下修</button>
                </div>
              </div>
              <div class="pe-row">
                <label class="pe-label" for="eps-surprise-{{ item.ticker.symbol }}">EPS 驚喜 %</label>
                <input id="eps-surprise-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="eps_surprise" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="+8.5">
              </div>
              <div class="pe-row">
                <label class="pe-label" for="rev-surprise-{{ item.ticker.symbol }}">營收驚喜 %</label>
                <input id="rev-surprise-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="rev_surprise" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="+2.1">
              </div>
              <div class="pe-row">
                <label class="pe-label" for="fy1-eps-rev-after-{{ item.ticker.symbol }}">財報後 FY1 EPS 修正 %</label>
                <input id="fy1-eps-rev-after-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="fy1_eps_revision_after" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="+3.0">
              </div>
              <div class="pe-row">
                <label class="pe-label" for="fy1-rev-rev-after-{{ item.ticker.symbol }}">財報後 FY1 營收修正 %</label>
                <input id="fy1-rev-rev-after-{{ item.ticker.symbol }}" class="control-input" type="number" step="0.1" data-pe-field="fy1_revenue_revision_after" data-pe-symbol="{{ item.ticker.symbol }}" placeholder="-1.0">
              </div>
              <textarea class="pe-text" data-pe-field="gross_margin_change" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="毛利率：相較前季或指引的方向"></textarea>
              <textarea class="pe-text" data-pe-field="management_keywords" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="管理層關鍵字：需求、訂單、定價、保守語氣..."></textarea>
              <div class="pe-row">
                <label class="pe-label">論點是否改變？</label>
                <div class="pe-buttons" data-pe-field="thesis_changed" data-pe-symbol="{{ item.ticker.symbol }}">
                  <button type="button" data-pe-value="no">否</button>
                  <button type="button" data-pe-value="yes">是</button>
                </div>
              </div>
              <textarea class="pe-text" data-pe-field="conclusion" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="結論：論點維持 / 出現裂縫 / 需要轉向"></textarea>
              <textarea class="pe-text" data-pe-field="next_step" data-pe-symbol="{{ item.ticker.symbol }}" rows="2" placeholder="下一步：續抱 / 加碼 / 減碼 / 到 $X 再評估"></textarea>
            </div>
          </details>
          {% endif %}

          <div class="note-preview is-hidden" data-note-preview="{{ item.ticker.symbol }}"></div>
          <div class="thesis-preview is-hidden" data-thesis-preview="{{ item.ticker.symbol }}"></div>

          <details class="user-tools-details">
            <summary>管理</summary>
            <div class="user-tools">
              <label class="compare-label"><input type="checkbox" class="compare-check" value="{{ item.ticker.symbol }}"> 加入比較</label>
              <div class="position-editor" data-position-editor="{{ item.ticker.symbol }}">
                <label>狀態
                  <select data-position-field="status" data-position-symbol="{{ item.ticker.symbol }}">
                    <option value="watchlist">觀察中</option>
                    <option value="holding">已持有</option>
                    <option value="tracking">追蹤中</option>
                    <option value="avoid">暫不考慮</option>
                  </select>
                </label>
                <label>股數
                  <input type="number" step="0.0001" min="0" data-position-field="shares" data-position-symbol="{{ item.ticker.symbol }}" placeholder="10">
                </label>
                <label>均價
                  <input type="number" step="0.01" min="0" data-position-field="avg_cost" data-position-symbol="{{ item.ticker.symbol }}" placeholder="120.00">
                </label>
                <label>持股比重 %
                  <input type="number" step="0.01" min="0" data-position-field="portfolio_weight" data-position-symbol="{{ item.ticker.symbol }}" placeholder="5">
                </label>
                <label>金額 $
                  <input type="number" step="1" min="0" data-position-field="position_size" data-position-symbol="{{ item.ticker.symbol }}" placeholder="auto">
                </label>
                <label>停損
                  <input type="number" step="0.01" min="0" data-position-field="stop_loss" data-position-symbol="{{ item.ticker.symbol }}" placeholder="optional">
                </label>
              </div>
              <div class="tag-row">
                <label class="control-label" for="tag-{{ item.ticker.symbol }}">標籤</label>
                <select id="tag-{{ item.ticker.symbol }}" class="tag-select" data-tag="{{ item.ticker.symbol }}">
                  <option value="">無</option>
                  <option value="High conviction">高度確信</option>
                  <option value="Watch closely">密切關注</option>
                  <option value="Overvalued">高估</option>
                  <option value="Post-earnings review">財報後檢視</option>
                  <option value="Do not chase">勿追</option>
                </select>
                <span class="badge info tag-badge" data-tag-badge="{{ item.ticker.symbol }}"></span>
              </div>
              <div class="tag-row">
                <label class="control-label" for="thesis-{{ item.ticker.symbol }}">投資論點</label>
                <div class="draft-row">
                  <select id="thesis-{{ item.ticker.symbol }}" class="tag-select" data-thesis="{{ item.ticker.symbol }}">
                    <option value="">未標記</option>
                    <option value="watching">觀察中</option>
                    <option value="building">建立中</option>
                    <option value="active">有效</option>
                    <option value="weakening">轉弱</option>
                    <option value="broken">失效</option>
                  </select>
                  <button type="button" class="tool-button" data-thesis-draft="{{ item.ticker.symbol }}">草稿</button>
                </div>
              </div>
              <div class="tag-row">
                <label class="control-label" for="thesis-trigger-{{ item.ticker.symbol }}">觸發因素</label>
                <select id="thesis-trigger-{{ item.ticker.symbol }}" class="tag-select" data-thesis-trigger="{{ item.ticker.symbol }}">
                  <option value="">無</option>
                  <option value="valuation">估值</option>
                  <option value="guidance">前景指引</option>
                  <option value="regulation">監管</option>
                  <option value="competitive pressure">競爭壓力</option>
                  <option value="macro">宏觀</option>
                  <option value="execution">執行</option>
                </select>
              </div>
              <div class="tag-row">
                <label class="control-label" for="thesis-text-{{ item.ticker.symbol }}">投資論點</label>
                <input type="text" id="thesis-text-{{ item.ticker.symbol }}" class="control-input thesis-text-input"
                  data-thesis-text="{{ item.ticker.symbol }}"
                  placeholder="單句投資論點（例如：AI資本支出→NVDA營收超預期）"
                  maxlength="120">
              </div>
              <textarea class="note-input" rows="2" data-note="{{ item.ticker.symbol }}" placeholder="Notes: thesis, risk, what to watch"></textarea>
              <div class="revisit-row">
                <label class="control-label" for="revisit-{{ item.ticker.symbol }}">下次檢視</label>
                <input id="revisit-{{ item.ticker.symbol }}" class="revisit-input" type="date" data-revisit="{{ item.ticker.symbol }}">
              </div>
              <div class="checklist" data-checklist="{{ item.ticker.symbol }}">
                <label><input type="checkbox" value="earnings"> earnings reviewed</label>
                <label><input type="checkbox" value="guidance"> guidance reviewed</label>
                <label><input type="checkbox" value="valuation"> valuation reviewed</label>
                <label><input type="checkbox" value="news"> news reviewed</label>
                <label><input type="checkbox" value="thesis"> thesis updated</label>
              </div>
            </div>
          </details>

          <details class="card-secondary investment-plan" data-plan-card="{{ item.ticker.symbol }}">
            <summary>投資計畫</summary>
            <div class="plan-grid">
              <label class="plan-field">
                <span class="plan-label up">多方情境</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="bull_case" placeholder="Why this works"></textarea>
              </label>
              <label class="plan-field">
                <span class="plan-label down">空方情境</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="bear_case" placeholder="What breaks the thesis"></textarea>
              </label>
              <label class="plan-field">
                <span class="plan-label">進場計畫</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="entry_plan" placeholder="When / how to start"></textarea>
              </label>
              <label class="plan-field">
                <span class="plan-label">加碼區</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="add_zone" placeholder="Where to scale up"></textarea>
              </label>
              <label class="plan-field">
                <span class="plan-label">減碼區</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="reduce_zone" placeholder="Where to trim"></textarea>
              </label>
              <label class="plan-field">
                <span class="plan-label down">停損</span>
                <textarea class="plan-input" rows="2" data-plan="{{ item.ticker.symbol }}" data-plan-field="stop_loss" placeholder="Hard exit rule"></textarea>
              </label>
            </div>
          </details>

          <details>
            <summary>新聞與 X 訊號</summary>
            {% if item.articles %}
            <ul>
              {% for article in item.articles %}
              <li><a href="{{ article.url }}" target="_blank" rel="noopener">{{ article.title }}</a> <span class="muted">- {{ article.source }}</span></li>
              {% endfor %}
            </ul>
            {% else %}
            <p class="muted" style="margin: 8px 0 0;">沒有找到可信新聞。</p>
            {% endif %}
            {% if item.x_signals %}
            <ul>
              {% for signal in item.x_signals %}
              <li>@{{ signal.author_handle }}: {{ signal.text }}{% if signal.url %} <a href="{{ signal.url }}" target="_blank" rel="noopener">source</a>{% endif %}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </details>
        </article>
        {% endfor %}
      </div>
    </section>

    <footer class="footer">
      stock-daily-research | {{ report.report_date.isoformat() }} | <a href="#summary">回到頂部</a>
      <div class="disclaimer" style="margin-top: 6px;">Personal research | Not investment advice</div>
    </footer>
  </main>
  <script>
    (function () {
      var STORAGE_KEY = "stock-daily-theme";
      var ORDER = ["auto", "light", "dark"];
      var LABEL = { auto: "自動", light: "淺色", dark: "深色" };
      var btn = document.getElementById("theme-toggle");
      if (!btn) return;
      var label = btn.querySelector(".theme-label");

      function read() {
        try {
          var t = localStorage.getItem(STORAGE_KEY);
          return ORDER.indexOf(t) >= 0 ? t : "auto";
        } catch (e) { return "auto"; }
      }

      function apply(t) {
        if (t === "auto") {
          document.documentElement.removeAttribute("data-theme");
        } else {
          document.documentElement.setAttribute("data-theme", t);
        }
        if (label) label.textContent = LABEL[t];
      }

      apply(read());

      btn.addEventListener("click", function () {
        var current = read();
        var next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
        try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
        apply(next);
      });
    })();

    (function () {
      var grid = document.getElementById("ticker-grid");
      if (!grid) return;

      var initialResearch = {{ research_payload|tojson }};
      var cards = Array.prototype.slice.call(grid.querySelectorAll(".ticker-card"));
      var search = document.getElementById("quick-search");
      var focusFilter = document.getElementById("focus-filter");
      var stateFilter = document.getElementById("state-filter");
      var marketTabs = Array.prototype.slice.call(document.querySelectorAll(".market-tab[data-market-tab]"));
      var scoreFilter = document.getElementById("score-filter");
      var earningsFilter = document.getElementById("earnings-filter");
      var rsiFilter = document.getElementById("rsi-filter");
      var topicFilter = document.getElementById("topic-filter");
      var sectorFilter = document.getElementById("sector-filter");
      var clusterFilter = document.getElementById("cluster-filter");
      var riskFilter = document.getElementById("risk-filter");
      var tickerCount = document.getElementById("ticker-count");
      var reviewedCount = document.getElementById("reviewed-count");
      var toggleQuiet = document.getElementById("toggle-quiet");
      var modeButtons = Array.prototype.slice.call(document.querySelectorAll("[data-mode]"));
      var modeHint = document.getElementById("mode-hint");
      var currentMode = "overview";
      var reportDate = "{{ report.report_date.isoformat() }}";
      var showQuiet = true;
      var MARKET_STORAGE_KEY = "stock-daily-market-tab";
      var activeMarket = "us";
      try {
        var storedMarket = localStorage.getItem(MARKET_STORAGE_KEY);
        if (["us", "taiwan", "crypto"].indexOf(storedMarket) >= 0) activeMarket = storedMarket;
      } catch (e) {}
      var tickerState = initialResearch.tickers || {};
      // Expose the server-rendered research state so the "Save to DB" block can
      // fall back to it for tickers/fields not edited in this session.
      window.__serverResearch = tickerState;
      var pinned = readJson("stock-daily-draft-pins", Object.keys(tickerState).filter(function (sym) { return !!tickerState[sym].pinned; }));
      var tags = readJson("stock-daily-draft-tags", mapState("tag"));
      var thesis = readJson("stock-daily-draft-thesis", mapState("thesis_state"));
      var thesisTriggers = readJson("stock-daily-draft-thesis-triggers", mapState("thesis_trigger"));
      var notes = readJson("stock-daily-draft-notes", mapNotes());
      var checklist = readJson("stock-daily-draft-checklist", mapState("checklist"));
      var plans = readJson("stock-daily-draft-plans", mapPlans());
      var earningsQuestions = readJson("stock-daily-draft-earnings-questions", mapEarningsQuestions());

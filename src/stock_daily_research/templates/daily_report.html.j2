      line-height: 1.4;
      align-items: baseline;
    }
    .insight-label {
      text-transform: uppercase;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-weight: 700;
    }
    .insight-meta { display: block; color: var(--muted); font-size: 11px; margin-top: 2px; }
    .analyst-target-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .analyst-target-list li { margin: 0; }
    .analyst-target-list a { font-weight: 700; }
    .analyst-target-source {
      display: inline; margin-left: 5px; color: var(--muted); font-size: 11px;
    }
    .insight-row.action .insight-label { color: var(--info); }
    .insight-row.action .insight-text { color: var(--info); font-weight: 700; }
    .insight-row.rs .insight-label { color: var(--muted); }
    .insight-row.rs.trend-up .insight-label { color: var(--good); }
    .insight-row.rs.trend-down .insight-label { color: var(--danger); }
    .insight-row.rs.trend-down .insight-text { color: var(--danger); }
    .insight-row.rs.trend-mixed .insight-label { color: var(--warning); }
    /* Right-side trading score */
    details.insight-row.score { display: block; cursor: pointer; padding: 4px 0; }
    details.insight-row.score > summary {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 8px;
      align-items: baseline;
      list-style: none;
      cursor: pointer;
    }
    details.insight-row.score > summary::-webkit-details-marker { display: none; }
    details.insight-row.score > summary::after {
      content: "▸";
      font-size: 9px;
      color: var(--muted);
      margin-left: 6px;
    }
    details.insight-row.score[open] > summary::after { content: "▾"; }
    .score-breakdown {
      list-style: none;
      margin: 6px 0 0 56px;
      padding: 6px 10px;
      background: var(--surface-alt);
      border-left: 2px solid var(--border);
      border-radius: 4px;
    }
    .score-reason {
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      padding: 1px 0;
      color: var(--text);
    }
    .score-reason.positive { color: var(--good); }
    .score-reason.negative { color: var(--danger); }
    .score-empty { font-size: 11px; color: var(--muted); margin-left: 56px; font-style: italic; }
    .insight-row.score .insight-label { color: var(--info); font-weight: 800; }
    .insight-row.score .insight-text { font-weight: 700; font-variant-numeric: tabular-nums; }
    .insight-row.score.score-up .insight-label { color: var(--good); }
    .insight-row.score.score-up .insight-text { color: var(--good); }
    .insight-row.score.score-down .insight-label { color: var(--danger); }
    .insight-row.score.score-down .insight-text { color: var(--danger); }
    .insight-row.score.score-mixed .insight-label { color: var(--warning); }
    .insight-row.score.score-extended .insight-label { color: var(--warning); }
    .insight-row.score.score-extended .insight-text { color: var(--warning); }
    details.insight-row.technical { display: block; cursor: pointer; padding: 4px 0; }
    details.insight-row.technical > summary {
      display: grid;
      grid-template-columns: 56px 1fr 12px;
      gap: 8px;
      align-items: baseline;
      list-style: none;
      cursor: pointer;
    }
    details.insight-row.technical > summary::-webkit-details-marker { display: none; }
    details.insight-row.technical > summary::after { content: "+"; color: var(--muted); font-size: 11px; text-align: right; }
    details.insight-row.technical[open] > summary::after { content: "-"; }
    .technical-breakdown {
      list-style: none;
      margin: 6px 0 0 56px;
      padding: 6px 10px;
      background: var(--surface-alt);
      border-left: 2px solid var(--border);
      border-radius: 4px;
    }
    .technical-breakdown li { padding: 1px 0; color: var(--text); font-size: 11px; font-variant-numeric: tabular-nums; }
    .insight-row.technical .insight-label { color: var(--info); font-weight: 800; }
    .insight-row.technical .insight-text { font-weight: 700; }
    .insight-row.technical.tech-up .insight-label, .insight-row.technical.tech-up .insight-text { color: var(--good); }
    .insight-row.technical.tech-down .insight-label, .insight-row.technical.tech-down .insight-text { color: var(--danger); }
    .insight-row.technical.tech-extended .insight-label, .insight-row.technical.tech-extended .insight-text,
    .insight-row.technical.tech-mixed .insight-label { color: var(--warning); }
    details.moving-average-panel { display: block; padding: 4px 0; }
    details.moving-average-panel > summary {
      display: grid;
      grid-template-columns: 56px minmax(0, 1fr) 12px;
      gap: 8px;
      align-items: baseline;
      list-style: none;
      cursor: pointer;
    }
    details.moving-average-panel > summary::-webkit-details-marker { display: none; }
    details.moving-average-panel > summary::after {
      content: "+";
      color: var(--muted);
      font-size: 11px;
      text-align: right;
    }
    details.moving-average-panel[open] > summary::after { content: "-"; }
    .moving-average-panel .insight-label { color: var(--info); font-weight: 800; }
    .moving-average-panel .insight-text { color: var(--text); font-weight: 700; }
    .moving-average-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 14px;
      margin: 7px 0 0;
      border-top: 1px solid var(--border-soft);
    }
    .moving-average-cell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) max-content;
      gap: 2px 8px;
      min-width: 0;
      padding: 6px 0;
      border-bottom: 1px solid var(--border-soft);
      font-variant-numeric: tabular-nums;
    }
    .moving-average-label {
      min-width: 0;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .moving-average-value {
      color: var(--text);
      font-size: 12px;
      text-align: right;
      white-space: nowrap;
      overflow-wrap: normal;
      word-break: normal;
    }
    .moving-average-distance {
      grid-column: 1 / -1;
      color: var(--muted);
      font-size: 10px;
      white-space: nowrap;
    }
    .moving-average-cell.tone-up .moving-average-distance { color: var(--good); }
    .moving-average-cell.tone-down .moving-average-distance { color: var(--danger); }
    .moving-average-cell.tone-near .moving-average-distance { color: var(--warning); }
    .moving-average-source {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 10px;
      overflow-wrap: anywhere;
    }
    details.insight-row.right-side-check { display: block; cursor: pointer; padding: 4px 0; }
    details.insight-row.right-side-check > summary {
      display: grid;
      grid-template-columns: 56px 1fr 12px;
      gap: 8px;
      align-items: baseline;
      list-style: none;
      cursor: pointer;
    }
    details.insight-row.right-side-check > summary::-webkit-details-marker { display: none; }
    details.insight-row.right-side-check > summary::after { content: "+"; color: var(--muted); font-size: 11px; text-align: right; }
    details.insight-row.right-side-check[open] > summary::after { content: "-"; }
    .right-side-breakdown {
      list-style: none;
      margin: 6px 0 0 56px;
      padding: 6px 10px;
      background: var(--surface-alt);
      border-left: 2px solid var(--border);
      border-radius: 4px;
    }
    .right-side-check-row {
      display: grid;
      grid-template-columns: 84px max-content minmax(0, 1fr);
      gap: 6px;
      align-items: baseline;
      padding: 3px 0;
      font-size: 11px;
      line-height: 1.4;
    }
    .right-side-check-label { color: var(--muted); }
    .right-side-check-status { color: var(--text); font-weight: 700; }
    .right-side-check-detail { color: var(--muted); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .right-side-check-row.tone-up .right-side-check-status { color: var(--good); }
    .right-side-check-row.tone-down .right-side-check-status { color: var(--danger); }
    .right-side-check-row.tone-mixed .right-side-check-status { color: var(--warning); }
    .insight-row.right-side-check .insight-label { color: var(--info); font-weight: 800; }
    .insight-row.right-side-check .insight-text { font-weight: 700; }
    .insight-row.right-side-check.check-up .insight-label, .insight-row.right-side-check.check-up .insight-text { color: var(--good); }
    .insight-row.right-side-check.check-down .insight-label, .insight-row.right-side-check.check-down .insight-text { color: var(--danger); }
    .insight-row.right-side-check.check-mixed .insight-label { color: var(--warning); }
    @media (max-width: 480px) {
      .right-side-check-row { grid-template-columns: 1fr; gap: 1px; padding: 5px 0; }
      details.moving-average-panel > summary { grid-template-columns: 48px minmax(0, 1fr) 12px; }
    }
    @media (max-width: 360px) {
      .moving-average-grid { grid-template-columns: 1fr; }
    }
    .badge.score-badge { font-weight: 700; }
    .badge.score-badge.score-up { background: var(--good-bg); color: var(--good); }
    .badge.score-badge.score-down { background: var(--danger-bg); color: var(--danger); }
    .badge.score-badge.score-mixed { background: var(--warning-bg); color: var(--warning); opacity: 0.75; }
    .badge.score-badge.score-extended { background: var(--warning-bg); color: var(--warning); }
    .badge.dq-medium { background: var(--warning-bg); color: var(--warning); font-weight: 700; }
    .badge.dq-low { background: var(--danger-bg); color: var(--danger); font-weight: 700; }
    .dq-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .dq-table th, .dq-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--border-soft); vertical-align: top; }
    .dq-table th.num, .dq-table td.num { text-align: right; }
    .dq-flags { margin: 0; padding-left: 16px; color: var(--muted); }
    .dq-flags li { margin: 1px 0; }
    .compare-table-wrap td.score-up { color: var(--good); font-weight: 700; }
    .compare-table-wrap td.score-down { color: var(--danger); font-weight: 700; }
    .compare-table-wrap td.score-mixed { color: var(--warning); }
    .compare-table-wrap td.score-extended { color: var(--warning); font-weight: 700; }
    .insight-row.setup .insight-label { color: var(--good); }
    .insight-row.trend .insight-label { color: var(--muted); }
    .insight-row.trend.trend-up .insight-label { color: var(--good); }
    .insight-row.trend.trend-down .insight-label { color: var(--danger); }
    .insight-row.trend.trend-mixed .insight-label { color: var(--warning); }
    .insight-row.trend.trend-down .insight-text { color: var(--danger); }
    .insight-row.trend[title] { cursor: help; }
    .insight-row.risk .insight-label { color: var(--danger); }
    .insight-row.watch .insight-label { color: var(--info); }
    .insight-row .insight-text { color: var(--text); }
    .insight-row.risk .insight-text { color: var(--danger); }
    .ticker-head {
      display: flex;
      justify-content: space-between;

      }
      function thesisTextFor(sym) {
        return thesisText[sym] || "";
      }
      function buildThesisDraft(card) {
        var s = symbol(card);
        var plan = plans[s] || {};
        var status = (card.dataset.positionStatus || "").toLowerCase();
        var days = numberOrNull(card.dataset.earningsDays);
        var risk = valuationRisk(card);
        var top = topWatch(card);
        var score = card.dataset.rightSideStatus || "";
        var trend = card.dataset.trend || "";
        var state = status === "holding" ? "active" : "watching";
        if (risk === "High" || risk === "Extreme") state = status === "holding" ? "weakening" : "watching";
        else if (days != null && days >= 0 && days <= 7) state = status === "holding" ? "active" : "building";

        var trigger = "execution";
        if (risk === "High" || risk === "Extreme") trigger = "valuation";
        else if (days != null && days >= 0 && days <= 7) trigger = "guidance";
        else if ((card.dataset.topics || "").indexOf("cloud") >= 0 || (card.dataset.topics || "").indexOf("ai") >= 0) trigger = "execution";

        var bull = (plan.bull_case || "").trim();
        var bear = (plan.bear_case || "").trim();
        var setup = bull || [top, trend, score].filter(Boolean).join(" / ");
        var caution = bear || (risk !== "None" ? risk + " valuation risk" : "watch revisions and news quality");
        var note = s + " thesis: " + (setup || "watch current setup") + "; key risk: " + caution + ".";
        return { state: state, trigger: trigger, note: note };
      }
      function thesisDraftPrompt(card, fallback) {
        var s = symbol(card);
        var plan = plans[s] || {};
        var headlines = Array.prototype.slice.call(card.querySelectorAll("details ul li a"))
          .map(function (el) { return el.textContent.trim(); })
          .filter(Boolean)
          .slice(0, 5);
        var context = {
          symbol: s,
          company: card.dataset.company || "",
          position_status: card.dataset.positionStatus || "watchlist",
          valuation_risk: valuationRisk(card),
          top_watch: topWatch(card),
          trend: card.dataset.trend || "",
          right_side_status: card.dataset.rightSideStatus || "",
          rsi_14: card.dataset.rsi || "",
          daily_change: card.dataset.dailyChange || "",
          from_52w_high: card.dataset.fromHigh || "",
          earnings_days: card.dataset.earningsDays || "",
          bull_case: plan.bull_case || "",
          bear_case: plan.bear_case || "",
          existing_fallback: fallback,
          headlines: headlines
        };
        return [
          "Draft a concise stock thesis from the provided report context.",
          "Return only minified JSON with keys state, trigger, note.",
          "Allowed state values: watching, building, active, weakening, broken.",
          "Allowed trigger values: guidance, valuation, execution, technicals, news, macro.",
          "The note must be one sentence, specific, and use only supplied facts.",
          JSON.stringify(context)
        ].join("\n");
      }
      function normalizeThesisDraft(text, fallback) {
        var data = null;
        try {
          var raw = String(text || "").trim();
          var start = raw.indexOf("{");
          var end = raw.lastIndexOf("}");
          if (start >= 0 && end > start) data = JSON.parse(raw.slice(start, end + 1));
        } catch (err) {
          data = null;
        }
        var states = ["watching", "building", "active", "weakening", "broken"];
        var triggers = ["guidance", "valuation", "execution", "technicals", "news", "macro"];
        return {
          state: data && states.indexOf(data.state) >= 0 ? data.state : fallback.state,
          trigger: data && triggers.indexOf(data.trigger) >= 0 ? data.trigger : fallback.trigger,
          note: data && data.note ? String(data.note).trim() : fallback.note
        };
      }
      function requestThesisDraft(card) {
        var fallback = buildThesisDraft(card);
        if (!(window.claude && typeof window.claude.complete === "function")) {
          return Promise.resolve(fallback);
        }
        return window.claude.complete(thesisDraftPrompt(card, fallback))
          .then(function (text) { return normalizeThesisDraft(text, fallback); })
          .catch(function () { return fallback; });
      }
      function isExtremeRisk(value) {
        return value === "Extreme" || value === "High";

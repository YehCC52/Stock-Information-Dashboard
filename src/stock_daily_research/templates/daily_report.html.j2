              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
            {% elif item.kind == "premarket" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="8 12 12 8 16 12"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
            {% elif item.kind == "risk" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            {% elif item.kind == "focus" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            {% elif item.kind == "valuation" %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M5 9l7-7 7 7M5 15l7 7 7-7"/></svg>
            {% else %}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="16" x2="12" y2="17"/></svg>
            {% endif %}
          </span>
          <div class="hero-body">
            <span class="hero-label">{{ item.label }}</span>
            <span class="hero-headline">{{ item.headline }}</span>
            <span class="hero-sub">{{ item.subtitle }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
      <aside class="command-side" id="summary">
        <div class="mode-bar" role="group" aria-label="Today work mode">
          <button type="button" class="tool-button mode-button" data-mode="overview" aria-pressed="true">概覽</button>
          <button type="button" class="tool-button mode-button" data-mode="review" aria-pressed="false">檢視模式</button>
          <button type="button" class="tool-button mode-button" data-mode="prep" aria-pressed="false">準備模式</button>
          <span id="mode-hint" class="mode-hint">完整儀表板</span>
        </div>
        {% if rule_alerts %}
        <div class="command-alerts">
          <div class="command-alerts-head">
            <span class="cc-label">警示</span>
            {% if rule_alerts|length > 3 %}<a href="#rule-alerts" class="cc-more">另 {{ rule_alerts|length - 3 }} 則</a>{% endif %}
          </div>
          <ul class="command-alert-list">
            {% for alert in rule_alerts[:3] %}
            <li class="command-alert {{ alert.tone }}">
              <a href="{{ alert.anchor }}">
                <span class="ca-label">{{ alert.symbol }}</span>
                <span class="ca-title">{{ alert.title|zh_text }}</span>
              </a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
      </aside>
    </section>

    <section id="todays-focus" class="section section-primary">
      <div class="section-header">
        <h2>決策清單</h2>
      </div>

<!doctype html>
<html lang="zh-Hant" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>右側交易回測｜{{ result.requested_start }} 至 {{ result.requested_end }}</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1015;
      --surface: #111820;
      --surface-2: #17212b;
      --line: #2a3947;
      --text: #e8f0f6;
      --muted: #91a6b7;
      --accent: #47a6ff;
      --good: #3ddc97;
      --bad: #ff6b6b;
      --warn: #f6c453;
      --chart-benchmark: #a9b7c4;
      --shadow: 0 8px 24px rgba(0, 0, 0, .2);
    }
    html[data-theme="light"] {
      color-scheme: light;
      --bg: #f4f7f9;
      --surface: #ffffff;
      --surface-2: #edf2f5;
      --line: #cbd6de;
      --text: #17232d;
      --muted: #5d7180;
      --accent: #006fbb;
      --good: #087b50;
      --bad: #bd3434;
      --warn: #8a6500;
      --chart-benchmark: #607482;
      --shadow: 0 8px 20px rgba(25, 45, 60, .08);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif;
      font-size: 15px;
      line-height: 1.5;
      letter-spacing: 0;
    }
    button, table { font: inherit; }
    button { letter-spacing: 0; }
    .shell { width: min(1480px, 100%); margin: 0 auto; padding: 22px; }
    .topbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 20px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
    }
    .eyebrow { color: var(--accent); font-weight: 700; font-size: 12px; }
    h1 { margin: 3px 0 4px; font-size: 26px; line-height: 1.25; }
    h2 { margin: 0; font-size: 19px; }
    h3 { margin: 0; font-size: 16px; }
    p { margin: 0; }
    .subtle { color: var(--muted); }
    .top-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .status {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      white-space: nowrap;
    }
    .status.pass { color: var(--good); }
    .status.fail { color: var(--bad); }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
    .command {
      min-height: 36px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      color: var(--text);
      padding: 0 12px;
      cursor: pointer;
    }
    .command:hover { border-color: var(--accent); }
    .market-switch {
      display: inline-flex;
      gap: 3px;
      margin: 18px 0;
      padding: 3px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: var(--surface);
      max-width: 100%;
      overflow-x: auto;
    }
    .market-tab {
      min-width: 92px;
      min-height: 38px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      white-space: nowrap;
    }
    .market-tab[aria-selected="true"] {
      background: var(--surface-2);
      color: var(--text);
      box-shadow: var(--shadow);
    }
    .market-panel[hidden] { display: none; }
    .market-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin: 2px 0 12px;
    }
    .currency-note { color: var(--muted); font-size: 13px; }
    .metrics {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: var(--surface);
    }
    .metric { min-width: 0; padding: 14px 15px; border-right: 1px solid var(--line); }
    .metric:last-child { border-right: 0; }
    .metric-label { color: var(--muted); font-size: 12px; }
    .metric-value {
      margin-top: 4px;
      font-size: 21px;
      font-weight: 750;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .positive { color: var(--good); }
    .negative { color: var(--bad); }
    .warning { color: var(--warn); }
    .section {
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
    }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 12px;
    }
    .chart-wrap {
      height: 300px;
      min-height: 220px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      padding: 12px;
    }
    .chart { width: 100%; height: 100%; display: block; }
    .gridline { stroke: var(--line); stroke-width: .25; }
    .strategy-line { fill: none; stroke: var(--accent); stroke-width: .7; vector-effect: non-scaling-stroke; }
    .benchmark-line { fill: none; stroke: var(--chart-benchmark); stroke-width: .5; vector-effect: non-scaling-stroke; opacity: .85; }
    .split-line { stroke: var(--warn); stroke-width: .45; stroke-dasharray: 1.5 1.5; vector-effect: non-scaling-stroke; }
    .chart-legend { display: flex; gap: 16px; margin-top: 8px; color: var(--muted); font-size: 12px; flex-wrap: wrap; }
    .legend-key::before { content: ""; display: inline-block; width: 16px; height: 2px; margin-right: 6px; vertical-align: middle; background: var(--accent); }
    .legend-key.benchmark::before { background: var(--chart-benchmark); }
    .legend-key.split::before { background: var(--warn); }
    .sample-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .sample {
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      padding: 14px;
    }
    .sample h3 { margin-bottom: 10px; }
    .sample dl { display: grid; grid-template-columns: 1fr auto; gap: 7px 14px; margin: 0; }
    .sample dt { color: var(--muted); }
    .sample dd { margin: 0; font-variant-numeric: tabular-nums; }
    .three-col { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .evidence {
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
      padding: 14px;
      min-width: 0;
    }
    .count-list { list-style: none; padding: 0; margin: 10px 0 0; }
    .count-list li { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-top: 1px solid var(--line); }
    .count-list span:first-child { min-width: 0; overflow-wrap: anywhere; color: var(--muted); }
    .method {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 6px;
      overflow: hidden;
    }
    .method-item { background: var(--surface); padding: 13px; min-width: 0; }
    .method-item strong { display: block; margin-bottom: 4px; font-size: 13px; }
    .method-item span { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
    .validation-summary {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1px;
      border: 1px solid var(--line);
      border-radius: 6px;
      overflow: hidden;
      background: var(--line);
    }
    .validation-item { min-width: 0; padding: 13px; background: var(--surface); }
    .validation-label { color: var(--muted); font-size: 12px; }
    .validation-value { margin: 3px 0; font-size: 18px; font-weight: 750; }
    .validation-meta { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
    .validation-details {
      margin-top: 12px;
      border: 1px solid var(--line);
      border-radius: 6px;
      background: var(--surface);
    }
    .validation-details > summary {
      cursor: pointer;
      padding: 12px 14px;
      color: var(--accent);
      font-weight: 650;
    }
    .detail-block { padding: 14px; border-top: 1px solid var(--line); }
    .detail-block h3 { margin-bottom: 10px; }
    .detail-block .table-wrap { border-radius: 4px; }
    .compact-table { min-width: 860px; }
    .quality-table { min-width: 920px; }
    .baseline-row td { background: color-mix(in srgb, var(--accent) 8%, var(--surface)); }
    table { width: 100%; border-collapse: collapse; min-width: 1020px; background: var(--surface); font-variant-numeric: tabular-nums; }
    th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
    th { color: var(--muted); font-size: 12px; font-weight: 650; background: var(--surface-2); position: sticky; top: 0; }
    th:first-child, td:first-child, th:nth-child(2), td:nth-child(2) { text-align: left; }
    tbody tr:last-child td { border-bottom: 0; }
    .empty { padding: 24px; text-align: center; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
    .warnings { margin: 0; padding-left: 20px; color: var(--muted); }
    .warnings li + li { margin-top: 5px; }
    .audit {
      margin-top: 20px;
      padding: 16px 0 4px;
      color: var(--muted);
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .audit code { color: var(--text); }
    @media (max-width: 1050px) {
      .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .metric:nth-child(3) { border-right: 0; }
      .metric:nth-child(-n+3) { border-bottom: 1px solid var(--line); }
      .three-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .method { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .validation-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 760px) {
      .shell { padding: 14px; }
      .topbar, .market-heading { align-items: stretch; flex-direction: column; }
      h1 { font-size: 23px; }
      .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .metric, .metric:nth-child(3) { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .metric:nth-child(even) { border-right: 0; }
      .metric:nth-last-child(-n+2) { border-bottom: 0; }
      .sample-grid, .method, .three-col, .validation-summary { grid-template-columns: 1fr; }
      .chart-wrap { height: 240px; }
    }
    @media (max-width: 480px) {
      .shell { padding: 10px; }
      .top-actions { align-items: stretch; }
      .status, .command { flex: 1 1 auto; justify-content: center; }
      .metric { padding: 11px; }
      .metric-value { font-size: 18px; }
      .section { padding: 16px 0; }
      .chart-wrap { height: 220px; padding: 8px; }
    }
    @media print {
      :root { color-scheme: light; }
      body { background: #fff; color: #111; }
      .command, .market-switch { display: none; }
      .market-panel[hidden] { display: block; }
      .market-panel { break-before: page; }
      .shell { width: 100%; padding: 0; }
      .table-wrap { overflow: visible; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <div class="eyebrow">RIGHT-SIDE STRATEGY LAB</div>
        <h1>右側交易回測</h1>
        <p class="subtle">{{ result.requested_start }} 至 {{ result.requested_end }} · {{ generated_label }}</p>
      </div>
      <div class="top-actions">
        <span class="status {{ 'pass' if result.deterministic_replay_passed else 'fail' }}">
          <span class="dot" aria-hidden="true"></span>
          {{ "重播一致" if result.deterministic_replay_passed else "重播不一致" }}
        </span>
        <button class="command" id="theme-toggle" type="button" aria-label="切換顯示主題">切換主題</button>
      </div>
    </header>

    <nav class="market-switch" aria-label="回測市場">
      {% for view in market_views %}
      <button class="market-tab" type="button" data-market="{{ view.result.market }}" aria-selected="{{ 'true' if loop.first else 'false' }}">
        {{ view.result.label }}
      </button>
      {% endfor %}
    </nav>

    {% for view in market_views %}
    {% set market = view.result %}
    {% set m = market.metrics %}
    <article class="market-panel" data-market-panel="{{ market.market }}" {% if not loop.first %}hidden{% endif %}>
      <div class="market-heading">
        <div>
          <h2>{{ market.label }}回測結果</h2>
          <p class="currency-note">幣別 {{ market.currency }} · 基準 {{ market.benchmark_symbol }} · 樣本外起點 {{ market.split_date }}</p>
        </div>
        <div class="currency-note">各市場資金與績效獨立計算</div>
      </div>

      <section class="metrics" aria-label="{{ market.label }}核心績效">
        <div class="metric">
          <div class="metric-label">策略報酬</div>
          <div class="metric-value {{ 'positive' if (m.total_return_pct or 0) > 0 else 'negative' if (m.total_return_pct or 0) < 0 else '' }}">{{ "%.2f%%"|format(m.total_return_pct) if m.total_return_pct is not none else "N/A" }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">{{ market.benchmark_symbol }} 基準報酬</div>
          <div class="metric-value">{{ "%.2f%%"|format(m.benchmark_return_pct) if m.benchmark_return_pct is not none else "N/A" }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">超額報酬</div>
          <div class="metric-value {{ 'positive' if (m.excess_return_pct or 0) > 0 else 'negative' if (m.excess_return_pct or 0) < 0 else '' }}">{{ "%+.2f%%"|format(m.excess_return_pct) if m.excess_return_pct is not none else "N/A" }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">最大回撤</div>
          <div class="metric-value negative">{{ "%.2f%%"|format(m.max_drawdown_pct) }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">交易／勝率</div>
          <div class="metric-value">{{ m.trade_count }} 筆 · {{ "%.1f%%"|format(m.win_rate_pct) }}</div>
        </div>
        <div class="metric">
          <div class="metric-label">期望值</div>
          <div class="metric-value {{ 'positive' if m.expectancy_r > 0 else 'negative' if m.expectancy_r < 0 else '' }}">{{ "%+.3fR"|format(m.expectancy_r) }}</div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h3>資金曲線</h3>
          <span class="subtle">{{ view.chart.start }} 至 {{ view.chart.end }}</span>
        </div>
        {% if view.chart.strategy %}
        <div class="chart-wrap">
          <svg class="chart" viewBox="0 0 100 38" preserveAspectRatio="none" role="img" aria-label="{{ market.label }}策略與基準資金曲線">
            <line class="gridline" x1="0" y1="4" x2="100" y2="4"></line>
            <line class="gridline" x1="0" y1="19" x2="100" y2="19"></line>
            <line class="gridline" x1="0" y1="34" x2="100" y2="34"></line>
            <line class="split-line" x1="{{ view.chart.split_x }}" y1="3" x2="{{ view.chart.split_x }}" y2="35"></line>
            {% if view.chart.benchmark %}<polyline class="benchmark-line" points="{{ view.chart.benchmark }}"></polyline>{% endif %}
            <polyline class="strategy-line" points="{{ view.chart.strategy }}"></polyline>
          </svg>
        </div>
        <div class="chart-legend">
          <span class="legend-key">策略</span>
          <span class="legend-key benchmark">{{ market.benchmark_symbol }}</span>
          <span class="legend-key split">樣本外起點</span>
        </div>
        {% else %}
        <div class="empty">沒有足夠資料可繪製資金曲線。</div>
        {% endif %}
      </section>

      <section class="section">
        <div class="section-head"><h3>樣本內／樣本外</h3><span class="subtle">最後 {{ result.settings.out_of_sample_pct|int }}% 的交易期間作為樣本外</span></div>
        <div class="sample-grid">
          {% for label, sample in [("樣本內", market.in_sample_metrics), ("樣本外", market.out_of_sample_metrics)] %}
          <div class="sample">
            <h3>{{ label }}</h3>
            <dl>
              <dt>策略報酬</dt><dd>{{ "%.2f%%"|format(sample.total_return_pct) if sample.total_return_pct is not none else "N/A" }}</dd>
              <dt>最大回撤</dt><dd>{{ "%.2f%%"|format(sample.max_drawdown_pct) }}</dd>
              <dt>交易筆數</dt><dd>{{ sample.trade_count }}</dd>
              <dt>勝率</dt><dd>{{ "%.1f%%"|format(sample.win_rate_pct) }}</dd>
              <dt>期望值</dt><dd>{{ "%+.3fR"|format(sample.expectancy_r) }}</dd>
              <dt>Sharpe</dt><dd>{{ "%.2f"|format(sample.sharpe) if sample.sharpe is not none else "N/A" }}</dd>
            </dl>
          </div>
          {% endfor %}
        </div>
      </section>

      {% set robust = view.robustness %}
      {% set wf = robust.walk_forward.summary %}
      {% set sensitivity = robust.sensitivity.summary %}
      {% set concentration = robust.concentration %}
      {% set quality = robust.data_quality %}
      <section class="section">
        <div class="section-head"><h3>穩健度驗證</h3><span class="subtle">用不同時間區段與鄰近參數檢查結果是否過度依賴單一情境</span></div>
        <div class="validation-summary">
          <div class="validation-item">
            <div class="validation-label">整體判讀</div>
            <div class="validation-value {{ robust.overall.status_tone }}">{{ robust.overall.status_label }}</div>
            <div class="validation-meta">綜合樣本外、參數與獲利集中度</div>
          </div>
          <div class="validation-item">
            <div class="validation-label">滾動樣本外</div>
            <div class="validation-value {{ wf.status_tone }}">{{ wf.status_label }}</div>
            <div class="validation-meta">{{ wf.completed_folds|default(0) }} 段 · {{ wf.trade_count|default(0) }} 筆交易{% if wf.positive_fold_pct is defined %} · {{ "%.0f%%"|format(wf.positive_fold_pct) }} 正報酬{% endif %}</div>
          </div>
          <div class="validation-item">
            <div class="validation-label">參數敏感度</div>
            <div class="validation-value {{ sensitivity.status_tone }}">{{ sensitivity.status_label }}</div>
            <div class="validation-meta">{{ sensitivity.scenario_count|default(0) }} 組情境{% if sensitivity.positive_return_pct is defined %} · {{ "%.0f%%"|format(sensitivity.positive_return_pct) }} 正報酬{% endif %}</div>
          </div>
          <div class="validation-item">
            <div class="validation-label">獲利集中度</div>
            <div class="validation-value {{ concentration.status_tone }}">{{ concentration.status_label }}</div>
            <div class="validation-meta">前五筆占{% if concentration.top_five_profit_share_pct is not none %} {{ "%.1f%%"|format(concentration.top_five_profit_share_pct) }}{% else %} N/A{% endif %}</div>
          </div>
          <div class="validation-item">
            <div class="validation-label">行情資料品質</div>
            <div class="validation-value {{ quality.status_tone }}">{{ quality.status_label }}</div>
            <div class="validation-meta">中位分數 {{ "%.0f"|format(quality.median_score) if quality.median_score is not none else "N/A" }} · {{ quality.warning_count|default(0) }} 檔需留意</div>
          </div>
        </div>

        <details class="validation-details">
          <summary>查看驗證明細</summary>
          <div class="detail-block">
            <h3>滾動樣本外區段</h3>
            {% if robust.walk_forward.rows %}
            <div class="table-wrap"><table class="compact-table">
              <thead><tr><th>區段</th><th>訓練截止</th><th>驗證期間</th><th>策略報酬</th><th>基準報酬</th><th>超額報酬</th><th>最大回撤</th><th>交易</th><th>期望值</th></tr></thead>
              <tbody>{% for row in robust.walk_forward.rows %}<tr>
                <td>{{ row.fold }}</td><td>{{ row.training_end }}</td><td>{{ row.validation_start }} 至 {{ row.validation_end }}</td>
                <td>{{ "%.2f%%"|format(row.total_return_pct) if row.total_return_pct is not none else "N/A" }}</td>
                <td>{{ "%.2f%%"|format(row.benchmark_return_pct) if row.benchmark_return_pct is not none else "N/A" }}</td>
                <td class="{{ 'positive' if (row.excess_return_pct or 0) > 0 else 'negative' if (row.excess_return_pct or 0) < 0 else '' }}">{{ "%+.2f%%"|format(row.excess_return_pct) if row.excess_return_pct is not none else "N/A" }}</td>
                <td>{{ "%.2f%%"|format(row.max_drawdown_pct) }}</td><td>{{ row.trade_count }}</td><td>{{ "%+.3fR"|format(row.expectancy_r) }}</td>
              </tr>{% endfor %}</tbody>
            </table></div>
            {% else %}<p class="subtle">有效交易日或交易筆數不足，無法切出可判讀區段。</p>{% endif %}
          </div>

          <div class="detail-block">
            <h3>鄰近參數情境</h3>
            {% if robust.sensitivity.rows %}
            <div class="table-wrap"><table class="compact-table">
              <thead><tr><th>目標 R</th><th>最長持有</th><th>情境</th><th>策略報酬</th><th>最大回撤</th><th>交易</th><th>期望值</th><th>Profit Factor</th></tr></thead>
              <tbody>{% for row in robust.sensitivity.rows %}<tr class="{{ 'baseline-row' if row.is_baseline else '' }}">
                <td>{{ "%.1fR"|format(row.target_r) }}</td><td>{{ row.max_holding_sessions }} 日</td><td>{{ "基準" if row.is_baseline else "鄰近測試" }}</td>
                <td class="{{ 'positive' if (row.total_return_pct or 0) > 0 else 'negative' if (row.total_return_pct or 0) < 0 else '' }}">{{ "%.2f%%"|format(row.total_return_pct) if row.total_return_pct is not none else "N/A" }}</td>
                <td>{{ "%.2f%%"|format(row.max_drawdown_pct) }}</td><td>{{ row.trade_count }}</td><td>{{ "%+.3fR"|format(row.expectancy_r) }}</td><td>{{ "%.2f"|format(row.profit_factor) if row.profit_factor is not none else "N/A" }}</td>
              </tr>{% endfor %}</tbody>
            </table></div>
            {% else %}<p class="subtle">參數敏感度驗證未啟用。</p>{% endif %}
          </div>

          <div class="detail-block">
            <h3>逐檔行情品質</h3>
            {% if quality.rows %}
            <div class="table-wrap"><table class="quality-table">
              <thead><tr><th>標的</th><th>狀態</th><th>分數</th><th>交易日</th><th>涵蓋率</th><th>最後資料日</th><th>延遲日數</th><th>零成交量</th><th>說明</th></tr></thead>
              <tbody>{% for row in quality.rows %}<tr>
                <td><strong>{{ row.ticker }}</strong></td><td class="{{ row.status_tone }}">{{ row.status_label }}</td><td>{{ row.score }}</td><td>{{ row.sessions }}</td>
                <td>{{ "%.1f%%"|format(row.coverage_pct) }}</td><td>{{ row.last_date or "N/A" }}</td><td>{{ row.stale_days if row.stale_days is not none else "N/A" }}</td>
                <td>{{ "%.1f%%"|format(row.zero_volume_pct) if row.zero_volume_pct is not none else "N/A" }}</td><td>{{ row.reason_label }}</td>
              </tr>{% endfor %}</tbody>
            </table></div>
            {% else %}<p class="subtle">沒有可供檢查的行情資料。</p>{% endif %}
          </div>
        </details>
      </section>

      <section class="section">
        <div class="section-head"><h3>執行假設</h3><span class="subtle">已納入成交時點、成本與保守成交規則</span></div>
        <div class="method">
          <div class="method-item"><strong>訊號與成交</strong><span>收盤產生訊號，下一交易日開盤成交；跳空超過 {{ result.settings.max_entry_gap_pct }}% 不追價。</span></div>
          <div class="method-item"><strong>風險與部位</strong><span>單筆風險 {{ result.settings.risk_per_trade_pct }}%，單一部位上限 {{ result.settings.max_position_pct }}%，最多 {{ result.settings.max_positions }} 個部位；成交量參與上限 {{ result.settings.max_volume_participation_pct }}%。</span></div>
          <div class="method-item"><strong>出場規則</strong><span>{{ result.settings.target_r }}R 目標、停損或持有 {{ result.settings.max_holding_sessions }} 個交易日；同日觸價先計停損，台股股票漲跌停鎖死時延後成交。</span></div>
          <div class="method-item"><strong>交易成本</strong><span>手續費 {{ market.assumptions.commission_bps }} bps、滑價 {{ market.assumptions.slippage_bps }} bps、賣出稅 {{ market.assumptions.sell_tax_bps }} bps；ETF {{ market.assumptions.etf_sell_tax_bps }} bps。</span></div>
        </div>
      </section>

      <section class="section">
        <div class="section-head"><h3>訊號漏斗</h3><span class="subtle">設定 {{ market.diagnostics.configured_symbols }} 檔 · 有效資料 {{ market.diagnostics.symbols_with_data }} 檔</span></div>
        <div class="three-col">
          {% for title, rows in [("有效訊號", view.setup_counts), ("訊號未成立", view.signal_rejections), ("模擬未成交", view.simulation_rejections), ("成交調整", view.execution_adjustments)] %}
          <div class="evidence">
            <h3>{{ title }}</h3>
            {% if rows %}
            <ul class="count-list">{% for row in rows %}<li><span>{{ row.label }}</span><strong>{{ row.count }}</strong></li>{% endfor %}</ul>
            {% else %}<p class="subtle">沒有資料</p>{% endif %}
          </div>
          {% endfor %}
        </div>
      </section>

      <section class="section">
        <div class="section-head"><h3>交易明細</h3><span class="subtle">{{ market.trades|length }} 筆 · 總成本 {{ market.currency }} {{ "{:,.2f}".format(m.total_cost) }}</span></div>
        {% if view.trade_rows %}
        <div class="table-wrap">
          <table>
            <thead><tr><th>標的</th><th>策略</th><th>訊號日</th><th>進場日</th><th>出場日</th><th>進場價</th><th>停損價</th><th>目標價</th><th>數量</th><th>淨損益</th><th>R 倍數</th><th>持有</th><th>出場原因</th></tr></thead>
            <tbody>
              {% for trade in view.trade_rows %}
              <tr>
                <td><strong>{{ trade.ticker }}</strong><br><span class="subtle">{{ trade.company_name }}</span></td>
                <td>{{ trade.setup_label }}</td>
                <td>{{ trade.signal_date }}</td><td>{{ trade.entry_date }}</td><td>{{ trade.exit_date }}</td>
                <td>{{ "%.4f"|format(trade.entry_price) }}</td><td>{{ "%.4f"|format(trade.initial_stop) }}</td><td>{{ "%.4f"|format(trade.target_price) }}</td>
                <td>{{ "{:,.4f}".format(trade.units).rstrip("0").rstrip(".") }}</td>
                <td class="{{ 'positive' if trade.net_pnl > 0 else 'negative' if trade.net_pnl < 0 else '' }}">{{ "{:+,.2f}".format(trade.net_pnl) }}</td>
                <td class="{{ 'positive' if trade.r_multiple > 0 else 'negative' if trade.r_multiple < 0 else '' }}">{{ "%+.3fR"|format(trade.r_multiple) }}</td>
                <td>{{ trade.holding_sessions }} 日</td><td>{{ trade.exit_label }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="empty">本區間沒有完成交易。請先檢查訊號漏斗、資料涵蓋率與參數設定。</div>
        {% endif %}
      </section>

      <section class="section">
        <div class="section-head"><h3>限制與注意事項</h3></div>
        <ul class="warnings">{% for warning in market.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
      </section>
    </article>
    {% endfor %}

    <section class="audit">
      <p><strong>共同限制</strong> {% for warning in result.warnings %}{{ warning }}{% if not loop.last %}；{% endif %}{% endfor %}</p>
      <p>Run ID <code>{{ result.run_id }}</code> · 規則 <code>{{ result.rule_version }}</code> · 樣本 <code>{{ result.universe_source }}</code>（{{ result.universe|length }} 檔）· Config <code>{{ result.config_hash[:12] }}</code> · Data <code>{{ result.data_fingerprint[:12] }}</code> · Result <code>{{ result.result_fingerprint[:12] }}</code></p>
    </section>
  </main>
  <script>
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll(".market-tab"));
      var panels = Array.prototype.slice.call(document.querySelectorAll(".market-panel"));
      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          var market = tab.getAttribute("data-market");
          tabs.forEach(function (item) {
            item.setAttribute("aria-selected", item === tab ? "true" : "false");
          });
          panels.forEach(function (panel) {
            panel.hidden = panel.getAttribute("data-market-panel") !== market;
          });
          try { localStorage.setItem("stock-backtest-market", market); } catch (error) {}
        });
      });
      try {
        var savedMarket = localStorage.getItem("stock-backtest-market");
        var savedTab = tabs.find(function (tab) { return tab.getAttribute("data-market") === savedMarket; });
        if (savedTab) { savedTab.click(); }
      } catch (error) {}
      var themeButton = document.getElementById("theme-toggle");
      var root = document.documentElement;
      try {
        var savedTheme = localStorage.getItem("stock-backtest-theme");
        if (savedTheme === "light" || savedTheme === "dark") { root.setAttribute("data-theme", savedTheme); }
      } catch (error) {}
      themeButton.addEventListener("click", function () {
        var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("stock-backtest-theme", next); } catch (error) {}
      });
    }());
  </script>
</body>
</html>
